// Painel de camadas da PAINT (website/docs/06-paint/workspace-ux.md §8, §9.8,
// §12), no padrão de editores como o Affinity: opacidade e mesclagem da camada
// ativa no topo, lista do topo da pilha para a base, linha enxuta
// `[tipo] Nome [olho] [cadeado]`, ações secundárias no menu da linha (⋯ ou
// botão direito) e criação/remoção no rodapé.
import { DesignTokens, Tr } from "../../tokens.slint";
import { IconButton, Segmented } from "../../components/base.slint";
import { PetuniaIcons } from "../../petunia_icons.slint";
import { PetuniaSlider } from "../../components/controls.slint";
import { PaintLayerEntry } from "../../types.slint";

component LayerRow inherits Rectangle {
    in property <PaintLayerEntry> layer;
    in property <bool> menu-open;
    callback activated;
    callback visibility-toggled;
    callback lock-toggled;
    callback menu-toggled;

    height: 32px;
    border-radius: DesignTokens.radius-control;
    background: root.layer.active ? DesignTokens.accent-subtle
        : (touch.has-hover ? DesignTokens.surface-hover : transparent);
    border-width: root.layer.active ? 1px : 0px;
    border-color: DesignTokens.accent;
    accessible-role: list-item;
    accessible-label: root.layer.name;
    accessible-description: root.layer.kind-label;
    accessible-item-selectable: true;
    accessible-item-selected: root.layer.active;
    accessible-action-default => { root.activated(); }

    // Fundo clicável: seleciona; botão direito abre as ações da linha.
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.activated();
                root.menu-toggled();
            }
        }
        clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: 8px + root.layer.depth * 14px;
        padding-right: 2px;
        spacing: 6px;

        Image {
            y: (parent.height - self.height) / 2;
            source: root.layer.kind == "group" ? PetuniaIcons.folder
                : root.layer.kind == "decal" ? PetuniaIcons.shape-layer
                : root.layer.kind == "effect" ? PetuniaIcons.material
                : PetuniaIcons.texture;
            width: 14px;
            height: 14px;
            colorize: root.layer.active ? DesignTokens.accent : DesignTokens.text-secondary;
        }
        Text {
            text: root.layer.name;
            horizontal-stretch: 1;
            color: root.layer.visible ? DesignTokens.text-primary : DesignTokens.text-muted;
            font-size: DesignTokens.font-small;
            font-weight: root.layer.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.layer.id != "": IconButton {
            width: self.size;
            y: (parent.height - self.height) / 2;
            size: 26px;
            icon-svg: root.layer.visible ? PetuniaIcons.eye : PetuniaIcons.eye-hidden;
            variant: "toggle";
            active: !root.layer.visible;
            semantic-label: Tr.t("sl.layer_visible");
            clicked => { root.visibility-toggled(); }
        }
        if root.layer.id != "": IconButton {
            width: self.size;
            y: (parent.height - self.height) / 2;
            size: 26px;
            icon-svg: root.layer.locked ? PetuniaIcons.lock : PetuniaIcons.unlock;
            variant: "toggle";
            active: root.layer.locked;
            semantic-label: Tr.t("sl.layer_locked");
            clicked => { root.lock-toggled(); }
        }
        // Ações secundárias só quando relevantes (spec: nada de sete botões fixos).
        if root.layer.id != "": IconButton {
            width: self.size;
            y: (parent.height - self.height) / 2;
            size: 26px;
            icon-svg: PetuniaIcons.more-vert;
            opacity: root.layer.active || touch.has-hover || root.menu-open ? 1.0 : 0.0;
            active: root.menu-open;
            variant: "toggle";
            semantic-label: Tr.t("sl.layer_options");
            clicked => { root.menu-toggled(); }
        }
    }
}

component LayerAction inherits Rectangle {
    in property <image> icon-svg;
    in property <string> label;
    in property <bool> danger;
    callback clicked;

    height: 28px;
    border-radius: DesignTokens.radius-control;
    background: touch.has-hover ? DesignTokens.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Image {
            y: (parent.height - self.height) / 2;
            source: root.icon-svg;
            width: 14px;
            height: 14px;
            colorize: root.danger ? DesignTokens.danger : DesignTokens.text-secondary;
        }
        Text {
            text: root.label;
            color: root.danger ? DesignTokens.danger : DesignTokens.text-primary;
            font-size: DesignTokens.font-small;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component PaintLayersPanel inherits VerticalLayout {
    in property <[PaintLayerEntry]> layers;
    in property <string> layer-count;
    callback activated(string);
    callback added();
    callback group-added();
    callback decal-added();
    callback import-decal();
    callback visibility-toggled(string);
    callback lock-toggled(string);
    callback merged-down(string);
    // Delta na pilha: +1 sobe (fica acima na lista).
    callback moved(string, int);
    callback opacity-set(string, float);
    callback blend-set(string, int);
    callback removed(string);

    // Linha com o menu de ações aberto (estado de apresentação).
    property <string> menu-layer: "";

    spacing: 6px;
    padding-top: 4px;
    padding-bottom: 4px;

    // Camada ativa: opacidade e mesclagem. Só a ativa gera elemento, então
    // as demais não ocupam espaço no layout.
    VerticalLayout {
        spacing: 0px;
        for layer in root.layers: VerticalLayout {
            spacing: 6px;
            if layer.active && layer.id != "": HorizontalLayout {
                spacing: 8px;
                height: 24px;
                Text {
                    text: Tr.t("sl.opacity");
                    color: DesignTokens.text-secondary;
                    font-size: DesignTokens.font-caption;
                    vertical-alignment: center;
                    width: 64px;
                }
                PetuniaSlider {
                    horizontal-stretch: 1;
                    minimum: 0.0;
                    maximum: 1.0;
                    value: layer.opacity;
                    controlled: true;
                    changed(value) => { root.opacity-set(layer.id, value); }
                }
                Text {
                    text: Math.round(layer.opacity * 100) + "%";
                    color: DesignTokens.text-secondary;
                    font-size: DesignTokens.font-caption;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    width: 40px;
                }
            }
            if layer.active && layer.id != "" && layer.kind != "group": Segmented {
                options: [Tr.t("sl.blend_normal"), Tr.t("sl.blend_multiply"), Tr.t("sl.blend_add"), Tr.t("sl.blend_screen")];
                selected: layer.blend;
                semantic-label: Tr.t("sl.layer_blend");
                changed(index) => { root.blend-set(layer.id, index); }
            }
        }
    }

    Rectangle { height: 1px; background: DesignTokens.border; }

    VerticalLayout {
        spacing: 2px;
        accessible-role: list;
        accessible-label: Tr.t("sl.layers");
        for layer in root.layers: VerticalLayout {
            spacing: 2px;
            LayerRow {
                layer: layer;
                menu-open: layer.id != "" && root.menu-layer == layer.id;
                activated => { root.activated(layer.id); }
                visibility-toggled => { root.visibility-toggled(layer.id); }
                lock-toggled => { root.lock-toggled(layer.id); }
                menu-toggled => { if layer.id == "" { return; } root.menu-layer = root.menu-layer == layer.id ? "" : layer.id; }
            }
            if layer.id != "" && root.menu-layer == layer.id: VerticalLayout {
                padding-left: 24px;
                spacing: 0px;
                LayerAction {
                    icon-svg: PetuniaIcons.chevron-up;
                    label: Tr.t("sl.move_layer_up");
                    clicked => { root.menu-layer = ""; root.moved(layer.id, 1); }
                }
                LayerAction {
                    icon-svg: PetuniaIcons.chevron-down;
                    label: Tr.t("sl.move_layer_down");
                    clicked => { root.menu-layer = ""; root.moved(layer.id, -1); }
                }
                LayerAction {
                    icon-svg: PetuniaIcons.tool-duplicate;
                    label: Tr.t("sl.merge_layer_down");
                    clicked => { root.menu-layer = ""; root.merged-down(layer.id); }
                }
                LayerAction {
                    icon-svg: PetuniaIcons.trash;
                    label: Tr.t("sl.remove_layer");
                    danger: true;
                    clicked => { root.menu-layer = ""; root.removed(layer.id); }
                }
            }
        }
    }

    Rectangle { vertical-stretch: 1; }

    // Rodapé: criação e remoção, como a barra inferior do painel de camadas.
    HorizontalLayout {
        spacing: 2px;
        height: 30px;
        IconButton {
            width: self.size;
            size: 28px;
            icon-svg: PetuniaIcons.plus;
            semantic-label: Tr.t("sl.add_layer");
            clicked => { root.added(); }
        }
        IconButton {
            width: self.size;
            size: 28px;
            icon-svg: PetuniaIcons.folder;
            semantic-label: Tr.t("sl.add_group");
            clicked => { root.group-added(); }
        }
        IconButton {
            width: self.size;
            size: 28px;
            icon-svg: PetuniaIcons.shape-layer;
            semantic-label: Tr.t("sl.add_decal_layer");
            clicked => { root.decal-added(); }
        }
        IconButton {
            width: self.size;
            size: 28px;
            icon-svg: PetuniaIcons.texture;
            semantic-label: Tr.t("sl.import_decal_image");
            clicked => { root.import-decal(); }
        }
        Text {
            horizontal-stretch: 1;
            text: root.layer-count;
            color: DesignTokens.text-muted;
            font-size: DesignTokens.font-caption;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
        for layer in root.layers: HorizontalLayout {
            if layer.active && layer.id != "": IconButton {
                width: self.size;
                size: 28px;
                icon-svg: PetuniaIcons.trash;
                semantic-label: Tr.t("sl.remove_layer");
                clicked => { root.removed(layer.id); }
            }
        }
    }
}
