// Painel flutuante do canvas PAINT.
import { DesignTokens, Motion, Tr } from "../../tokens.slint";
import { IconDisplay, IconSet } from "@lucide";
import { PaintCanvasSurface } from "../../components/paint_canvas.slint";
import { PanelDragHandle, PanelResizeGrip, TopAction } from "../../components/controls.slint";

export component PaintCanvasPanel inherits Rectangle {
    in-out property <length> canvas-panel-w;
    in-out property <length> canvas-panel-h;
    in-out property <length> canvas-panel-x;
    in-out property <length> canvas-panel-y;
    in property <string> paint-canvas-size;
    in property <bool> paint-show-uv;
    in-out property <bool> paint-canvas-panel-visible;
    in property <image> paint-canvas-image;
    in property <int> paint-canvas-zoom;
    in property <string> active-tool;
    in property <float> brush-size;
    in property <float> brush-hardness;
    in property <float> brush-opacity;
    in property <float> brush-flow;
    in property <color> paint-color;
    in property <string> uv-layout-commands;
    in property <bool> paint-pixel-grid;
    in property <string> paint-canvas-grid-commands;
    in property <string> uv-selected-commands;
    callback toggle-paint-show-uv();
    callback paint-2d-select(float, float, float, float, bool, bool, bool);
    callback paint-2d-stroke(float, float, int, bool, float);
    callback set-paint-canvas-zoom(int);
    pure callback brush-stroke-tool(string) -> bool;

    x: 0;
    y: 0;
    
    
    canvas-panel := Rectangle {
        width: min(root.canvas-panel-w > 0px ? root.canvas-panel-w : 520px, parent.width - 40px);
        height: min(root.canvas-panel-h > 0px ? root.canvas-panel-h : 576px, parent.height - 80px);
        x: root.canvas-panel-x < 0px ? min(60px, max(parent.width - self.width, 0px)) : clamp(root.canvas-panel-x, 0px, max(parent.width - self.width, 0px));
        y: root.canvas-panel-y < 0px ? min(56px, max(parent.height - self.height, 0px)) : clamp(root.canvas-panel-y, 0px, max(parent.height - self.height, 0px));
        border-radius: DesignTokens.radius-panel;
        background: DesignTokens.surface-raised;
        border-width: 1px;
        border-color: DesignTokens.border;
        drop-shadow-blur: DesignTokens.elevation-2-blur;
        drop-shadow-color: DesignTokens.elevation-2-color;
        drop-shadow-offset-y: DesignTokens.elevation-2-offset;
        TouchArea { }

        PanelResizeGrip {
            z: 10;
            x: parent.width - self.width;
            y: parent.height - self.height;
            panel-w: canvas-panel.width;
            panel-h: canvas-panel.height;
            min-w: 300px;
            min-h: 260px;
            max-w: root.width - 40px;
            max-h: root.height - 80px;
            resized-to(w, h) => { root.canvas-panel-w = w; root.canvas-panel-h = h; }
        }

        VerticalLayout {
            Rectangle {
                height: 40px;
                background: DesignTokens.surface;
                border-top-left-radius: DesignTokens.radius-panel;
                border-top-right-radius: DesignTokens.radius-panel;
                PanelDragHandle {
                    panel-x: canvas-panel.x;
                    panel-y: canvas-panel.y;
                    max-x: root.width - canvas-panel.width;
                    max-y: root.height - canvas-panel.height;
                    moved-to(x, y) => { root.canvas-panel-x = x; root.canvas-panel-y = y; }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 6px;
                    VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Image; size: 14px; stroke: DesignTokens.accent; } }
                    Text { text: Tr.t("sl.canvas") + "  " + root.paint-canvas-size; color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            width: max(72px, uv-label.preferred-width + 20px);
                            border-radius: DesignTokens.radius-control;
                            background: root.paint-show-uv ? DesignTokens.accent : (uv-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-raised);
                            animate background { duration: Motion.fast; easing: ease-out; }
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            accessible-role: button;
                            accessible-checked: root.paint-show-uv;
                            accessible-label: Tr.t("sl.uv_wireframe_overlay_2");
                            uv-label := Text { text: "UV"; color: root.paint-show-uv ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            uv-touch := TouchArea { clicked => { root.toggle-paint-show-uv(); } }
                        }
                    }
                    TopAction {
                        icon: IconSet.X;
                        semantic-label: Tr.t("sl.paint_canvas_close");
                        clicked => { root.paint-canvas-panel-visible = false; }
                    }
                }
            }
            Rectangle { height: 1px; background: DesignTokens.border; }
            PaintCanvasSurface {
                vertical-stretch: 1;
                canvas-image: root.paint-canvas-image;
                zoom: root.paint-canvas-zoom;
                show-brush: root.brush-stroke-tool(root.active-tool);
                brush-diameter: root.brush-size * 16px;
                brush-hardness: root.brush-hardness;
                brush-strength: root.brush-opacity * root.brush-flow;
                brush-tint: root.paint-color;
                brush-erase: root.active-tool == "eraser";
                brush-hard-edge: root.active-tool == "pixel";
                show-uv: root.paint-show-uv;
                uv-commands: root.uv-layout-commands;
                show-grid: root.paint-pixel-grid;
                grid-commands: root.paint-canvas-grid-commands;
                select-mode: root.active-tool == "select";
                selected-commands: root.uv-selected-commands;
                select-region(x0, y0, x1, y1, extend, subtract, island) => { root.paint-2d-select(x0, y0, x1, y1, extend, subtract, island); }
                stroke(x, y, phase, shift, raster) => { root.paint-2d-stroke(x, y, phase, shift, raster); }
                zoom-step(direction) => {
                    if direction > 0 && root.paint-canvas-zoom < 16 { root.set-paint-canvas-zoom(root.paint-canvas-zoom * 2); }
                    if direction < 0 && root.paint-canvas-zoom > 1 { root.set-paint-canvas-zoom(root.paint-canvas-zoom / 2); }
                }
            }
        }
    }

}
