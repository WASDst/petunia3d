import { DesignTokens, Tr } from "../../tokens.slint";
import { PetuniaIcons } from "../../petunia_icons.slint";
import { EmptyState } from "../../components/base.slint";
import { ToolButton } from "../../components/controls.slint";
import { InspectorSection, MaterialBody, ModifiersBody, ObjectBody, PartsBody, TransformBody } from "../../inspector/sections.slint";
import { StructureHost, PropertiesHost } from "../../shell/right_column.slint";
import { ModifierEntry, SceneItem, SectionState } from "../../types.slint";

/// Conteúdo MODEL: recebe projeções do shell e encaminha intenções sem domínio próprio.
/// Estado, validação numérica e comandos continuam sob responsabilidade do host Rust.
export component ModelInspector inherits VerticalLayout {
    in property <bool> model-parts-open;
    in property <string> hovered-inspector-section;
    in property <string> label-parts;
    in property <[SectionState]> section-states;
    callback section-open-toggled(string);
    callback toggle-all-sections();
    callback section-pin-open-toggled(string);
    in property <string> label-search-parts;
    in property <string> label-selected-parts-only;
    in property <string> label-sort-parts;
    in-out property <string> parts-query;
    in-out property <bool> parts-selected-only;
    in-out property <bool> parts-sort-by-name;
    in property <[SceneItem]> parts-items;
    in property <[SceneItem]> scene-items;
    in property <string> label-parts-row-size;
    in-out property <float> parts-row-height;
    in property <string> label-hide-part;
    in property <string> label-show-part;
    in property <string> label-lock-part;
    in property <string> label-unlock-part;
    in property <bool> rename-active;
    in property <string> rename-value;
    callback parts-query-changed(string);
    callback parts-selected-only-changed(bool);
    callback parts-sort-changed(bool);
    callback parts-row-height-changed(float);
    callback scene-select(string, bool);
    callback scene-toggle-visibility(string);
    callback scene-toggle-lock(string);
    callback scene-context-requested(string, float, float);
    callback part-color-picker-open(string);
    callback separate-selection-requested();
    callback rename-edited(string);
    callback rename-committed(string);
    in property <bool> object-has-selection;
    in property <string> selection-domain;
    in property <bool> model-transform-open;
    in property <string> label-tab-transform;
    in property <string> label-numeric-field-hint;
    in property <float> pos-x;
    in property <float> pos-y;
    in property <float> pos-z;
    in property <float> rot-x;
    in property <float> rot-y;
    in property <float> rot-z;
    in property <float> scale-x;
    in property <float> scale-y;
    in property <float> scale-z;
    callback transform-scrubbed(string, int, float, bool);
    callback transform-scrub-started(string);
    callback transform-scrub-finished();
    callback transform-text-committed(string, int, string) -> bool;
    callback transform-scrub-cancelled();
    in property <bool> model-material-open;
    in property <string> label-tab-material;
    in property <string> active-material-name;
    in-out property <int> active-material-slot;
    in property <[string]> material-slots;
    in property <string> material-profile;
    in property <color> material-base-color;
    in property <[color]> material-palette;
    in property <float> material-roughness;
    in property <float> material-metallic;
    in property <float> material-emission-strength;
    in-out property <bool> material-advanced-open;
    in property <float> material-normal-scale;
    in property <string> material-alpha-mode;
    in property <float> material-alpha-cutoff;
    in property <bool> material-has-albedo;
    in property <string> material-albedo-label;
    in property <string> label-material-assign;
    in property <string> label-material-new;
    in property <string> label-material-duplicate;
    in property <string> label-material-remove;
    in property <string> label-material-profile;
    in property <string> label-material-profile-pbr;
    in property <string> label-material-profile-unlit;
    in property <string> label-material-profile-toon;
    in property <string> label-material-profile-glass;
    in property <string> label-material-profile-emissive;
    in property <string> label-material-base-color;
    in property <string> label-material-roughness;
    in property <string> label-material-metallic;
    in property <string> label-material-emission-strength;
    in property <string> label-material-advanced;
    in property <string> label-material-normal-scale;
    in property <string> label-material-alpha-mode;
    in property <string> label-material-alpha-opaque;
    in property <string> label-material-alpha-mask;
    in property <string> label-material-alpha-blend;
    in property <string> label-material-alpha-cutoff;
    in property <string> label-material-texture-albedo;
    in property <string> label-material-create-texture;
    in property <string> label-material-clear-texture;
    in property <string> label-material-no-texture;
    callback assign-material-slot(int);
    callback create-material();
    callback duplicate-material(int);
    callback remove-material(int);
    callback material-slot-selected(int);
    callback material-base-color-changed(float, float, float);
    callback material-scalar-committed(string, int, string) -> bool;
    callback material-profile-changed(int);
    callback material-alpha-mode-changed(int);
    callback material-albedo-create();
    callback material-albedo-clear();
    in property <bool> model-object-open;
    in property <string> label-tab-object;
    in property <string> object-name;
    in property <string> object-id;
    in property <bool> object-visible;
    in property <bool> object-locked;
    in property <int> object-verts;
    in property <int> object-faces;
    in property <int> object-tris;
    in property <string> label-object-no-selection;
    in property <string> label-stats-verts;
    in property <string> label-stats-faces;
    in property <string> label-stats-tris;
    in property <string> label-duplicate;
    in property <string> label-delete;
    in property <bool> active-asset-is-parametric;
    in property <string> primitive-kind;
    in property <float> primitive-radius;
    in property <float> primitive-radius-b;
    in property <float> primitive-height;
    in property <float> primitive-depth;
    in property <float> primitive-width;
    in property <int> primitive-sides;
    in property <int> primitive-rings;
    in property <int> primitive-subdiv;
    in property <bool> primitive-cap-top;
    in property <bool> primitive-cap-bottom;
    in property <bool> primitive-fill-disc;
    in property <string> label-parametric-primitive;
    in property <string> label-freeze-primitive;
    in property <string> label-freeze-primitive-hint;
    callback duplicate-requested();
    callback delete-requested();
    callback primitive-param-float(string, float);
    callback primitive-param-bool(string, bool);
    callback freeze-primitive-requested();
    in property <string> label-tab-modifiers;
    in property <[ModifierEntry]> modifier-rows;
    in property <string> label-modifier-add-mirror;
    in property <string> label-modifier-add-symmetry;
    in property <string> label-modifier-apply;
    in property <string> label-modifier-direction;
    in property <string> label-modifier-negative-to-positive;
    in property <string> label-modifier-positive-to-negative;
    in property <string> label-modifiers-empty;
    callback modifier-add(string);
    callback modifier-toggle(string, bool);
    callback modifier-remove(string);
    callback modifier-move(string, int);
    callback modifier-apply(string);
    callback modifier-axis-changed(string, int);
    callback modifier-direction-changed(string, bool);
    in property <string> boolean-operand-name;
    callback command-executed(string);
    callback join-requested();
    in property <bool> boolean-keep-parts;
    callback boolean-keep-parts-set(bool);
    in property <bool> boolean-cleanup;
    callback boolean-cleanup-set(bool);
    callback boolean-operand-cleared();
    callback boolean-operand-set(string);

        spacing: 0px;
        vertical-stretch: 0;

        StructureHost {
            if (root.model-parts-open || root.hovered-inspector-section == "parts"): InspectorSection {
                title: root.label-parts;
                section-id: "parts";
                open: root.model-parts-open || root.hovered-inspector-section == "parts";
                pin-open: root.section-states.length > 0 ? root.section-states[0].pin-open : false;
                toggled => { root.section-open-toggled("parts"); }
                toggle-all => { root.toggle-all-sections(); }
                pin-toggled(id) => { root.section-pin-open-toggled(id); }

                PartsBody {
                    search-label: root.label-search-parts;
                    selected-only-label: root.label-selected-parts-only;
                    sort-label: root.label-sort-parts;
                    query <=> root.parts-query;
                    selected-only <=> root.parts-selected-only;
                    sort-by-name <=> root.parts-sort-by-name;
                    items: root.parts-items;
                    total-count: root.scene-items.length;
                    row-size-label: root.label-parts-row-size;
                    row-height <=> root.parts-row-height;
                    list-label: root.label-parts;
                    hide-label: root.label-hide-part;
                    show-label: root.label-show-part;
                    lock-label: root.label-lock-part;
                    unlock-label: root.label-unlock-part;
                    rename-active: root.rename-active;
                    rename-value: root.rename-value;
                    query-changed(query) => { root.parts-query-changed(query); }
                    selected-only-changed(enabled) => { root.parts-selected-only-changed(enabled); }
                    sort-changed(enabled) => { root.parts-sort-changed(enabled); }
                    row-height-changed(value) => { root.parts-row-height-changed(value); }
                    scene-select(id, extend) => { root.scene-select(id, extend); }
                    scene-toggle-visibility(id) => { root.scene-toggle-visibility(id); }
                    scene-toggle-lock(id) => { root.scene-toggle-lock(id); }
                    scene-context-requested(id, x, y) => { root.scene-context-requested(id, x, y); }
                    part-color-picker-open(id) => { root.part-color-picker-open(id); }
                    separate-selection-requested => { root.separate-selection-requested(); }
                    rename-edited(text) => { root.rename-edited(text); }
                    rename-committed(text) => { root.rename-committed(text); }
                }
            }
        }

        PropertiesHost {
            spacing: 0px;

            // Sem seleção: um estado vazio no lugar de Transform, para o painel
            // nunca mostrar valores de um objeto que o cabeçalho diz não estar
            // selecionado (critério de aceite da F4).
            if !root.object-has-selection: Rectangle {
                height: empty-state.preferred-height;
                Rectangle { y: 0; height: 1px; background: DesignTokens.border; }
                empty-state := EmptyState {
                    width: parent.width;
                    title: Tr.t("sl.nothing_selected");
                    message: Tr.t("sl.nothing_selected_hint");
                }
            }

            if (root.object-has-selection && root.selection-domain == "OBJECT" && (root.model-transform-open || root.hovered-inspector-section == "transform")): InspectorSection {
                title: root.label-tab-transform;
                section-id: "transform";
                open: root.model-transform-open || root.hovered-inspector-section == "transform";
                pin-open: root.section-states.length > 1 ? root.section-states[1].pin-open : false;
                toggled => { root.section-open-toggled("transform"); }
                toggle-all => { root.toggle-all-sections(); }
                pin-toggled(id) => { root.section-pin-open-toggled(id); }

                    TransformBody {
                        field-hint: root.label-numeric-field-hint;
                        pos-x: root.pos-x;
                        pos-y: root.pos-y;
                        pos-z: root.pos-z;
                        rot-x: root.rot-x;
                        rot-y: root.rot-y;
                        rot-z: root.rot-z;
                        scale-x: root.scale-x;
                        scale-y: root.scale-y;
                        scale-z: root.scale-z;
                        scrubbed(kind, axis, delta, fine) => { root.transform-scrubbed(kind, axis, delta, fine); }
                        scrub-started(kind) => { root.transform-scrub-started(kind); }
                        scrub-finished => { root.transform-scrub-finished(); }
                        text-committed(kind, axis, text) => { root.transform-text-committed(kind, axis, text) }
                        scrub-cancelled => { root.transform-scrub-cancelled(); }
                    }
            }
            if (root.model-material-open || root.hovered-inspector-section == "material"): InspectorSection {
                title: root.label-tab-material;
                section-id: "material";
                open: root.model-material-open || root.hovered-inspector-section == "material";
                pin-open: root.section-states.length > 2 ? root.section-states[2].pin-open : false;
                toggled => { root.section-open-toggled("material"); }
                toggle-all => { root.toggle-all-sections(); }
                pin-toggled(id) => { root.section-pin-open-toggled(id); }

                MaterialBody {
                    active-name: root.active-material-name;
                    active-slot <=> root.active-material-slot;
                    slots: root.material-slots;
                    profile: root.material-profile;
                    base-color: root.material-base-color;
                    palette: root.material-palette;
                    roughness: root.material-roughness;
                    metallic: root.material-metallic;
                    emission-strength: root.material-emission-strength;
                    advanced-open <=> root.material-advanced-open;
                    normal-scale: root.material-normal-scale;
                    alpha-mode: root.material-alpha-mode;
                    alpha-cutoff: root.material-alpha-cutoff;
                    has-albedo: root.material-has-albedo;
                    albedo-text-label: root.material-albedo-label;
                    assign-label: root.label-material-assign;
                    new-label: root.label-material-new;
                    duplicate-label: root.label-material-duplicate;
                    remove-label: root.label-material-remove;
                    profile-label: root.label-material-profile;
                    profile-pbr-label: root.label-material-profile-pbr;
                    profile-unlit-label: root.label-material-profile-unlit;
                    profile-toon-label: root.label-material-profile-toon;
                    profile-glass-label: root.label-material-profile-glass;
                    profile-emissive-label: root.label-material-profile-emissive;
                    base-color-label: root.label-material-base-color;
                    roughness-label: root.label-material-roughness;
                    metallic-label: root.label-material-metallic;
                    emission-label: root.label-material-emission-strength;
                    advanced-label: root.label-material-advanced;
                    normal-scale-label: root.label-material-normal-scale;
                    alpha-mode-label: root.label-material-alpha-mode;
                    alpha-opaque-label: root.label-material-alpha-opaque;
                    alpha-mask-label: root.label-material-alpha-mask;
                    alpha-blend-label: root.label-material-alpha-blend;
                    alpha-cutoff-label: root.label-material-alpha-cutoff;
                    albedo-label: root.label-material-texture-albedo;
                    create-texture-label: root.label-material-create-texture;
                    clear-texture-label: root.label-material-clear-texture;
                    no-texture-label: root.label-material-no-texture;
                    assign-material-slot(slot) => { root.assign-material-slot(slot); }
                    create-material => { root.create-material(); }
                    duplicate-material(slot) => { root.duplicate-material(slot); }
                    remove-material(slot) => { root.remove-material(slot); }
                    material-slot-selected(index) => { root.material-slot-selected(index); }
                    material-base-color-changed(r, g, b) => { root.material-base-color-changed(r, g, b); }
                    material-scalar-committed(field, slot, text) => { root.material-scalar-committed(field, slot, text) }
                    material-profile-changed(index) => { root.material-profile-changed(index); }
                    material-alpha-mode-changed(index) => { root.material-alpha-mode-changed(index); }
                    material-albedo-create => { root.material-albedo-create(); }
                    material-albedo-clear => { root.material-albedo-clear(); }
                }
            }
            if (root.model-object-open || root.hovered-inspector-section == "object"): InspectorSection {
                title: root.label-tab-object;
                section-id: "object";
                open: root.model-object-open || root.hovered-inspector-section == "object";
                pin-open: root.section-states.length > 3 ? root.section-states[3].pin-open : false;
                toggled => { root.section-open-toggled("object"); }
                toggle-all => { root.toggle-all-sections(); }
                pin-toggled(id) => { root.section-pin-open-toggled(id); }
                ObjectBody {
                    has-selection: root.object-has-selection;
                    object-name: root.object-name;
                    object-id: root.object-id;
                    object-visible: root.object-visible;
                    object-locked: root.object-locked;
                    object-verts: root.object-verts;
                    object-faces: root.object-faces;
                    object-tris: root.object-tris;
                    no-selection-label: root.label-object-no-selection;
                    verts-label: root.label-stats-verts;
                    faces-label: root.label-stats-faces;
                    tris-label: root.label-stats-tris;
                    duplicate-label: root.label-duplicate;
                    delete-label: root.label-delete;
                    is-parametric: root.active-asset-is-parametric;
                    primitive-kind: root.primitive-kind;
                    primitive-radius: root.primitive-radius;
                    primitive-radius-b: root.primitive-radius-b;
                    primitive-height: root.primitive-height;
                    primitive-depth: root.primitive-depth;
                    primitive-width: root.primitive-width;
                    primitive-sides: root.primitive-sides;
                    primitive-rings: root.primitive-rings;
                    primitive-subdiv: root.primitive-subdiv;
                    primitive-cap-top: root.primitive-cap-top;
                    primitive-cap-bottom: root.primitive-cap-bottom;
                    primitive-fill-disc: root.primitive-fill-disc;
                    label-parametric-primitive: root.label-parametric-primitive;
                    label-freeze-primitive: root.label-freeze-primitive;
                    label-freeze-primitive-hint: root.label-freeze-primitive-hint;
                    scene-toggle-visibility(id) => { root.scene-toggle-visibility(id); }
                    scene-toggle-lock(id) => { root.scene-toggle-lock(id); }
                    duplicate-requested => { root.duplicate-requested(); }
                    delete-requested => { root.delete-requested(); }
                    primitive-param-float(param, val) => { root.primitive-param-float(param, val); }
                    primitive-param-bool(param, val) => { root.primitive-param-bool(param, val); }
                    freeze-primitive-requested => { root.freeze-primitive-requested(); }
                }
                // Modificadores como subseção de Objeto (plano de UI F4, D2).
                if root.object-has-selection: VerticalLayout {
                    spacing: DesignTokens.space-xs;
                    padding-top: DesignTokens.space-sm;
                    Text {
                        text: root.label-tab-modifiers;
                        color: DesignTokens.text-secondary;
                        font-size: DesignTokens.font-small;
                        font-weight: 600;
                    }
                    ModifiersBody {
                        rows: root.modifier-rows;
                        add-mirror-label: root.label-modifier-add-mirror;
                        add-symmetry-label: root.label-modifier-add-symmetry;
                        apply-label: root.label-modifier-apply;
                        direction-label: root.label-modifier-direction;
                        neg-to-pos-label: root.label-modifier-negative-to-positive;
                        pos-to-neg-label: root.label-modifier-positive-to-negative;
                        empty-label: root.label-modifiers-empty;
                        modifier-add(kind) => { root.modifier-add(kind); }
                        modifier-toggle(id, enabled) => { root.modifier-toggle(id, enabled); }
                        modifier-remove(id) => { root.modifier-remove(id); }
                        modifier-move(id, direction) => { root.modifier-move(id, direction); }
                        modifier-apply(id) => { root.modifier-apply(id); }
                        modifier-axis-changed(id, axis) => { root.modifier-axis-changed(id, axis); }
                        modifier-direction-changed(id, direction) => { root.modifier-direction-changed(id, direction); }
                    }
                }
            }
             if root.scene-items.length > 1 || root.boolean-operand-name != "": InspectorSection {
                title: Tr.t("sl.combine");
                open: true;
                toggled => { self.open = !self.open; }
                VerticalLayout {
                    spacing: 6px;
                    if root.boolean-operand-name != "": VerticalLayout {
                        spacing: 6px;
                        Text { text: Tr.t("sl.operand") + ": \{root.boolean-operand-name}"; color: DesignTokens.accent; font-size: DesignTokens.font-caption; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 4px;
                            ToolButton { icon-svg: PetuniaIcons.boolean-fuse; semantic-label: Tr.t("sl.fuse"); description: Tr.t("sl.combine_the_active_part_with_the_operand"); clicked => { root.command-executed("model.fuse"); } }
                            ToolButton { icon-svg: PetuniaIcons.boolean-cut; semantic-label: Tr.t("sl.cut"); description: Tr.t("sl.subtract_the_operand_from_the_active_part"); clicked => { root.command-executed("model.cut"); } }
                            ToolButton { icon-svg: PetuniaIcons.boolean-intersect; semantic-label: Tr.t("sl.intersect"); description: Tr.t("sl.keep_the_overlapping_volume"); clicked => { root.command-executed("model.intersect"); } }
                            ToolButton { icon-svg: PetuniaIcons.boolean-join; semantic-label: Tr.t("sl.join"); description: Tr.t("sl.join_the_operand_into_the_active_part"); clicked => { root.join-requested(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                horizontal-stretch: 1; height: 26px;
                                background: root.boolean-keep-parts ? DesignTokens.accent : DesignTokens.surface-raised;
                                border-radius: 4px;
                                accessible-role: checkbox;
                                accessible-label: Tr.t("sl.keep_parts");
                                accessible-checked: root.boolean-keep-parts;
                                Text { text: root.boolean-keep-parts ? Tr.t("sl.keep_parts_on") : Tr.t("sl.keep_parts_off"); color: root.boolean-keep-parts ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.boolean-keep-parts-set(!root.boolean-keep-parts); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; height: 26px;
                                background: root.boolean-cleanup ? DesignTokens.accent : DesignTokens.surface-raised;
                                border-radius: 4px;
                                accessible-role: checkbox;
                                accessible-label: Tr.t("sl.clean_quads");
                                accessible-checked: root.boolean-cleanup;
                                Text { text: root.boolean-cleanup ? Tr.t("sl.clean_quads_on") : Tr.t("sl.clean_quads_off"); color: root.boolean-cleanup ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.boolean-cleanup-set(!root.boolean-cleanup); } }
                            }
                            Rectangle {
                                width: 92px; height: 26px;
                                background: DesignTokens.surface-raised;
                                border-radius: 4px;
                                accessible-role: button;
                                accessible-label: Tr.t("sl.clear_operand");
                                Text { text: Tr.t("sl.clear"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.boolean-operand-cleared(); } }
                            }
                        }
                    }
                    if root.boolean-operand-name == "": VerticalLayout {
                        spacing: 4px;
                        Text { text: Tr.t("sl.select_second_part_to_combine"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; }
                        for item in root.scene-items: Rectangle {
                            visible: !item.active;
                            height: !item.active ? 24px : 0px;
                            background: DesignTokens.surface-raised;
                            border-radius: 4px;
                            if !item.active: HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;
                                Text { text: item.name; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: Tr.t("sl.choose"); color: DesignTokens.accent; font-size: DesignTokens.font-caption; vertical-alignment: center; }
                            }
                            if !item.active: TouchArea { clicked => { root.boolean-operand-set(item.id); } }
                        }
                    }
                }
            }
        }
}
