export global DesignTokens {
    // Fundo da viewport: mais escuro e mais neutro que os painéis, para a área
    // de trabalho parecer um espaço independente (item 39 da spec).
    in-out property <color> canvas: #101114;
    /// Realce de hover sobre a geometria, mais sutil que a seleção.
    /// Mesma família do hover 3D ([0.62,0.72,0.88]) e do hover legado
    /// egui (#7DDCFF): ciano claro, nunca confundido com seleção.
    in-out property <color> hover: #7ddcff;
    in-out property <color> surface: #1d1f23;
    in-out property <color> surface-raised: #25282e;
    in-out property <color> surface-hover: #30343b;
    in-out property <color> surface-pressed: #3a3f48;
    in-out property <color> border: #3a3f48;
    in-out property <color> border-strong: #545b67;
    in-out property <color> text-primary: #edf0f4;
    in-out property <color> text-secondary: #aeb5c0;
    in-out property <color> text-muted: #737b88;
    in-out property <color> accent: #b58cff;
    /// Texto/ícone sobre `accent` (estado selecionado/ativo).
    in-out property <color> on-accent: #101114;
    in-out property <color> focus-ring: #d1b8ff;
    in-out property <color> success: #73d59b;
    in-out property <color> warning: #e5bd67;
    in-out property <color> danger: #ef6b73;
    in-out property <color> info: #6cb6ff;
    in-out property <color> scrim: #00000099;
    in-out property <color> disabled: #565d68;
    in-out property <color> axis-x: #ff6e6e;
    in-out property <color> axis-y: #69db7c;
    in-out property <color> axis-z: #4dabf7;
    /// Laranja Blender `selected_object` (#E96A00): a mesma cor do destaque
    /// 3D (faces/arestas/pontos selecionados). Uma cor por estado, em todas
    /// as superfícies — nunca roxo aqui e laranja lá.
    in-out property <color> selection: #e96a00;
    /// Amarelo Blender `active_object` (#FFAF29): no máximo um ativo por
    /// vez, sempre distinguível do selecionado.
    in-out property <color> selection-active: #ffaf29;
    in-out property <color> shadow: #00000088;
    in-out property <color> shadow-subtle: #00000055;
    in-out property <color> hud-surface: #14141ee6;
    in-out property <color> hud-border: #3a3f48;
    in-out property <color> badge-precision-bg: #3e63dd33;
    in-out property <color> badge-precision-border: #3e63dd;
    in-out property <color> badge-precision-text: #3e63dd;
    in-out property <color> badge-snap-bg: #46a75833;
    in-out property <color> badge-snap-border: #46a758;
    in-out property <color> badge-snap-text: #46a758;
    in-out property <color> live-mode: #e68a00;
    in-out property <color> live-mode-ring: #ffd54f;
    in-out property <color> armed-ring: #ffd54f;
    /// Texto sobre fundos fortes (accent, badges do viewport).
    in-out property <color> text-on-strong: #ffffff;
    // Overlays semânticos do viewport. Ficam sobre a cena 3D, não sobre os
    // painéis, por isso não acompanham o tema claro; centralizados aqui para
    // nenhum overlay reintroduzir cor solta em `app.slint`.
    in-out property <color> overlay-snap: #f59e0b;
    in-out property <color> overlay-measure: #f59e0b;
    in-out property <color> overlay-dimension: #3e63dd;
    in-out property <color> overlay-proportional: #e0e0e0;
    in-out property <color> overlay-cursor-3d: #e54d42;
    in-out property <color> overlay-pivot: #e54d42;
    in-out property <color> overlay-pivot-muted: #ffaaaa;
    in-out property <color> overlay-contrast-light: #ffffff;
    in-out property <color> overlay-contrast-dark: #000000;
    in-out property <color> overlay-uv-wire: #00ffff;
    in-out property <color> overlay-uv-selection: #ffaa00;
    in-out property <color> overlay-uv-seam: #ff4433;
    in-out property <color> overlay-uv-pin: #ff3344;
    in-out property <length> control-height: 28px;
    in-out property <length> radius-control: 4px;
    in-out property <length> radius-panel: 8px;
    in-out property <length> space-xs: 4px;
    in-out property <length> space-sm: 8px;
    in-out property <length> space-md: 12px;
}

/// Tradução por chave do catálogo (`assets/locales/*.toml`, tabela `[sl]`).
/// `revision` muda quando o idioma muda, reavaliando todo `Tr.t(...)`.
export global Tr {
    in property <int> revision: 0;
    pure callback lookup(string) -> string;
    pure public function t(key: string) -> string {
        return self.revision >= 0 ? self.lookup(key) : "";
    }
}

/// Tempos de movimento (cap. 36: hover ~90-120 ms, collapse ~140 ms, estrutural <= 180 ms).
/// `reduced` é sincronizado com a preferência de movimento reduzido.
export global Motion {
    in-out property <bool> reduced: false;
    out property <duration> fast: self.reduced ? 0ms : 100ms;
    out property <duration> medium: self.reduced ? 0ms : 140ms;
    out property <duration> slow: self.reduced ? 0ms : 180ms;
}
