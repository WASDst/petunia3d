/// Projeto recente listado na Home (cap. 23).
export struct RecentProject {
    name: string,
    path: string,
}

/// Textos traduzidos da Home, vindos do bridge por TextId.
export struct HomeTexts {
    title: string,
    subtitle: string,
    new: string,
    open: string,
    recover: string,
    recent: string,
    no-recent: string,
    settings: string,
    show-on-start: string,
}
