export struct CommandItem {
    id: string,
    label: string,
    shortcut: string,
    available: bool,
    disabled-reason: string,
}

export struct ThemeEntry {
    id: string,
    name: string,
    active: bool,
}

/// Perfil de atalhos (canônico ou do usuário) na lista de Configurações → Teclado.
export struct KeymapProfileEntry {
    id: string,
    name: string,
    custom: bool,
    active: bool,
}

/// Uma ação com seu atalho; `capturing` = aguardando a próxima combinação.
export struct KeymapActionEntry {
    action: string,
    label: string,
    shortcut: string,
    conflict: bool,
    capturing: bool,
}

export struct PaintEffectParamEntry {
    key: string,
    label: string,
    value: float,
    minimum: float,
    maximum: float,
}

export struct PaintLayerEntry {
    id: string,
    name: string,
    visible: bool,
    locked: bool,
    opacity: float,
    active: bool,
    is-group: bool,
    kind-label: string,
}

export struct MenuEntry {
    id: string,
    label: string,
    shortcut: string,
    separator: bool,
    disabled: bool,
    checked: bool,
}

export struct SceneItem {
    id: string,
    name: string,
    visible: bool,
    locked: bool,
    selected: bool,
    // Objeto ativo (referência das operações): no máximo um, com destaque
    // próprio amarelo, distinto do apenas-selecionado laranja.
    active: bool,
    verts: int,
    tris: int,
    has-custom-color: bool,
    custom-color: color,
}

export struct PrefabItem {
    id: string,
    name: string,
    parts: int,
    tris: int,
    verts: int,
    favorite: bool,
    instances: int,
    tags: string,
    thumbnail: image,
    has-thumbnail: bool,
}

export struct QuickActionEntry {
    id: string,
    label: string,
    enabled: bool,
    pinned: bool,
}

export struct SectionState {
    id: string,
    pin-open: bool,
    open: bool,
}

export struct ModifierEntry {
    id: string,
    title: string,
    subtitle: string,
    enabled: bool,
    kind: string,
    axis: int,
    positive-to-negative: bool,
    can-move-up: bool,
    can-move-down: bool,
}

export struct ReferenceSlotData {
    axis: string,
    axis-tag: string,
    title: string,
    has-image: bool,
    image-name: string,
    dimensions: string,
    visible: bool,
    locked: bool,
    opacity: float,
    size: float,
    offset: float,
    rotation: float,
    fine-open: bool,
    thumbnail: image,
}

export struct MeasureTag {
    text: string,
    x: float,
    y: float,
}

export struct WorldAxisTag {
    text: string,
    x: float,
    y: float,
    tint: color,
}

