                                    Text { text: Tr.t("sl.extensions_plugins"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    Rectangle {
                                        border-radius: 6px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                        VerticalLayout {
                                            padding: 12px; spacing: 8px;
                                            Text { text: Tr.t("sl.no_extension_is_loaded_by_this_interface_in_"); color: DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; wrap: word-wrap; }
                                            Text { text: Tr.t("sl.obj_import_and_gltf_export_are_native_featur"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                                        }
                                    }
                                }

                                // --- TAB 7: MCP & AUTOMAÇÃO ---
                                if root.settings-tab == 7: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: Tr.t("sl.automation_mcp"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }

                                    Rectangle {
                                        border-radius: 6px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                        VerticalLayout {
                                            padding: 12px; spacing: 8px;
                                            Text { text: Tr.t("sl.the_mcp_server_is_a_separate_component_this_"); color: DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; wrap: word-wrap; }
                                            Text { text: Tr.t("sl.document_mutations_go_through_transactional_"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                                        }
                                    }
                                }

                                // --- TAB 8: SOBRE --- (dados técnicos saíram do rodapé, F7)
                                if root.settings-tab == 8: VerticalLayout {
                                    spacing: 12px;
                                    Text { text: Tr.t("sl.settings_about"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    Text {
                                        text: root.shell-info;
                                        color: DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-small;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
