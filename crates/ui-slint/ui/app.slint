                                            HorizontalLayout { Text { text: Tr.t("sl.shift_a_add_primitive"); color: DesignTokens.text-secondary; font-size: 10px; } Rectangle { horizontal-stretch: 1; } Text { text: Tr.t("sl.ctrl_z_ctrl_y_undo_redo"); color: DesignTokens.text-secondary; font-size: 10px; } }
