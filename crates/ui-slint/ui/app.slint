            click-away-requested() => { root.click-away-requested(); }
            context-menu-action(a0) => { root.context-menu-action(a0); }
        }

        WorkspaceDrawer {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            open: root.asset-library-visible;
            drawer-height: root.asset-library-height;
            left-offset: 52px;
            right-clearance: 8px + (root.inspector-visible && !root.compact-shell ? root.inspector-width + 8px : 0px);
            bottom-offset: 30px;
            height-changed(height) => { root.asset-library-height-changed(height / 1px); }

            WorkspaceDrawerContent {
                region-focus-token: root.focus-region == 5 && root.region-available(5) && !root.regional-focus-blocked ? root.region-focus-epoch : 0;
                region-focus-enabled: !root.regional-focus-blocked;
                // Preenche o slot do @children (o pai léxico é o host, não o slot).
                tabs: root.active-workspace == "PAINT" ? [root.label-project-asset-library, Tr.t("sl.brush_presets"), Tr.t("sl.color_palette")]
                    : root.active-workspace == "UV" ? [root.label-project-asset-library, Tr.t("sl.uv_drawer_diagnostics")]
                    : root.active-workspace == "ANIMATE" ? [root.label-project-asset-library, Tr.t("sl.animate_drawer_timeline")]
                    : [root.label-project-asset-library];
                selected-tab: root.drawer-tab;
                tab-selected(index) => {
                    if root.active-workspace == "PAINT" { root.paint-drawer-tab = clamp(index, 0, 2); }
                    if root.active-workspace == "UV" { root.uv-drawer-tab = clamp(index, 0, 1); }
                    if root.active-workspace == "ANIMATE" { root.animate-drawer-tab = clamp(index, 0, 1); }
                }
                close-requested => { root.asset-library-requested(); }
                if root.drawer-tab == 0: AssetLibraryContent {
                    show-close-button: false;
                    show-title: false;
                    // Preenche o slot do @children (o pai léxico é o host, não o slot).
                    title: root.label-project-asset-library;
                    save-active-label: root.label-save-active-as-asset;
                    search-label: root.label-search-assets;
                    sort-label: root.label-sort-assets;
                    thumbnail-size-label: root.label-thumbnail-size;

                    query <=> root.asset-query;
                    only-favorites <=> root.asset-only-favorites;
                    sort-by-name <=> root.asset-sort-by-name;
                    thumbnail-size <=> root.asset-thumbnail-size;
                    items: root.prefab-items;

                    close-requested => { root.asset-library-requested(); }
                    save-active-requested => { root.save-active-as-asset-requested(); }
                    query-changed(query) => { root.asset-query-changed(query); }
                    only-favorites-changed(enabled) => { root.asset-only-favorites-changed(enabled); }
                    sort-changed(enabled) => { root.asset-sort-changed(enabled); }
                    thumbnail-size-changed(value) => { root.asset-thumbnail-size-changed(value); }
                    place-requested(id) => { root.prefab-place-requested(id); }
                    delete-requested(id) => { root.prefab-delete-requested(id); }
                    update-requested(id) => { root.prefab-update-requested(id); }
                    favorite-requested(id, favorite) => { root.prefab-favorite-requested(id, favorite); }
                }
                if root.drawer-tab != 0: ScrollView {
                    // Preenche o slot do @children (o pai léxico é o host, não o slot).
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: as-needed;
                    VerticalLayout {
                        width: parent.width;
                        vertical-stretch: 0;
                        if root.active-workspace == "PAINT" && root.drawer-tab == 1: PaintPresetsContent {
                            brush-presets: root.brush-presets;
                            brush-preset-index: root.brush-preset-index;
                            applied(index) => { root.brush-preset-applied(index); }
                            saved => { root.brush-preset-saved(); }
                            deleted(index) => { root.brush-preset-deleted(index); }
                        }
                        if root.active-workspace == "PAINT" && root.drawer-tab == 2: PaintPaletteContent {
                            paint-color: root.paint-color;
                            label-active-brush-color: root.label-active-brush-color;
                            paint-color-changed(r, g, b) => { root.paint-color-changed(r, g, b); }
                            command-file-action(id) => { root.command-file-action(id); }
                        }
                        if root.active-workspace == "UV": UvDiagnosticsContent {
                            stats: root.uv-stats;
                            island-count: root.uv-island-count;
                            selected-count: root.uv-selected-count;
                            command-executed(id) => { root.command-executed(id); }
                            equalize-density => { root.uv-equalize-texel-density(); }
                        }
                        if root.active-workspace == "ANIMATE": AnimateDrawerContent {
                            texts: root.animate-texts;
                            motions: root.animate-motions;
                            playing: root.animate-playing;
                            has-motion: root.animate-has-motion;
                            progress: root.animate-progress;
                            time-label: root.animate-time-label;
                            action(a, b, v) => { root.animate-action(a, b, v); }
                        }
                    }
                }
            }
        }

        // Paleta de comandos.
        if command-search-visible: CommandPalette {
            width: parent.width;
            height: parent.height;
            command-focus-active: root.command-focus-active;
            command-query <=> root.command-query;
            command-results: root.command-results;
            command-selection <=> root.command-selection;
