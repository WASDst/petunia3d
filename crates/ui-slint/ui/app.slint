                                            Text { text: root.label-studio-light-follows-camera; color: root.studio-light-follows-camera ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.studio-light-follows-camera-set(!root.studio-light-follows-camera); } }
                                    }
                                    Text { text: root.label-studio-light-follows-camera-hint; color: DesignTokens.text-muted; font-size: 10px; wrap: word-wrap; }

