    /// Nome estável da tecla (mesmo vocabulário de `petunia_config::keybinds`).
    pure function shortcut-key-name(text: string) -> string {
        return text == Key.Tab ? "Tab" :
            text == Key.Return ? "Enter" :
            text == Key.Backspace ? "Backspace" :
            text == Key.Delete ? "Delete" :
            text == Key.Home ? "Home" :
            text == Key.End ? "End" :
            text == Key.PageUp ? "PageUp" :
            text == Key.PageDown ? "PageDown" :
            text == Key.Insert ? "Insert" :
            text == Key.UpArrow ? "Up" :
            text == Key.DownArrow ? "Down" :
            text == Key.LeftArrow ? "Left" :
            text == Key.RightArrow ? "Right" :
            text == Key.F1 ? "F1" :
            text == Key.F2 ? "F2" :
            text == Key.F3 ? "F3" :
            text == Key.F4 ? "F4" :
            text == Key.F5 ? "F5" :
            text == Key.F6 ? "F6" :
            text == Key.F7 ? "F7" :
            text == Key.F8 ? "F8" :
            text == Key.F9 ? "F9" :
            text == Key.F10 ? "F10" :
            text == Key.F11 ? "F11" :
            text == Key.F12 ? "F12" :
            text;
    }

    /// Ferramentas de traço com pincel (têm cursor de tamanho/dureza/força).
    pure function brush-stroke-tool(tool: string) -> bool {
        return tool == "brush" || tool == "eraser" || tool == "airbrush" || tool == "pixel"
            || tool == "smudge" || tool == "blur" || tool == "dodge" || tool == "burn"
            || tool == "spray" || tool == "clone";
    }

    // Cor e espessura de um handle do gizmo conforme o estado da interação.
    function gizmo-handle-color(axis: int, base: color) -> color {
        if root.gizmo-constraint-axis-a == axis || root.gizmo-constraint-axis-b == axis {
            return base;
        }
        if root.gizmo-constraint-axis-a >= 0 {
            return base.transparentize(0.72);
        }
        if root.gizmo-active-axis == axis {
            return base;
        }
        if root.gizmo-active-axis >= 0 {
            // Durante o arrasto os outros eixos perdem presença.
            return base.transparentize(0.72);
        }
        if root.gizmo-hover-axis == axis {
            // Pré-seleção: o eixo sob o cursor ganha presença (clareia).
            return base.brighter(0.35);
        }
        return base;
    }

    function gizmo-handle-width(axis: int) -> length {
        if root.gizmo-constraint-axis-a == axis || root.gizmo-constraint-axis-b == axis {
            return 4px;
        }
        if root.gizmo-constraint-axis-a >= 0 {
            return 2px;
        }
        if root.gizmo-active-axis == axis {
            return 4px;
        }
        if root.gizmo-hover-axis == axis {
            return 3.5px;
        }
        return 2.5px;
    }

    changed command-search-visible => { root.command-selection = 0; }
    changed tool-modal-active => { if (root.tool-modal-active) { root.tool-properties-collapsed = false; } }
    changed loop-cut-active => { if (root.loop-cut-active) { root.tool-properties-collapsed = false; } }
    changed width => {
        root.compact-shell = self.width < 900px;
        if !root.compact-shell && root.scene-drawer-visible {
            root.scene-requested();
            root.model-parts-open = true;
        }
    }

    root-focus := FocusScope {
        init => { self.focus(); }
        key-released(event) => {
            root.precision-mode = event.modifiers.shift;
            root.snap-mode = event.modifiers.control;
            reject
        }
        key-pressed(event) => {
            root.precision-mode = event.modifiers.shift;
            root.snap-mode = event.modifiers.control;
            if root.settings-visible && (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                root.settings-tab = event.text == Key.DownArrow ? min(root.settings-tab + 1, 8) : max(root.settings-tab - 1, 0);
                return accept;
            }
            if event.text == Key.F6 {
                if root.f6-in-rail && !root-focus.has-focus && root.inspector-visible && !root.compact-shell {
                    root.f6-in-rail = false;
                    root-focus.focus();
                } else if root.inspector-visible && !root.compact-shell {
                    root.f6-in-rail = true;
                    root.f6-rail-token += 1;
                } else {
                    root-focus.focus();
                }
                return accept;
            }
            // Captura de atalho (Configurações → Teclado): a próxima combinação vai
            // para a ação pendente; Esc cancela sem fechar o painel.
            if root.keymap-capture-action != "" {
                if event.text == Key.Escape {
                    root.keymap-capture-cancelled();
                } else {
                    root.keymap-capture-key(root.shortcut-key-name(event.text), event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                }
                return accept;
            }
            if root.menu-open != "" {
                if event.text == Key.DownArrow { root.menu-step(1); return accept; }
                if event.text == Key.UpArrow { root.menu-step(-1); return accept; }
                if event.text == Key.RightArrow {
                    root.menu-opened(root.menu-open == "file" ? "edit" : (root.menu-open == "edit" ? "view" : (root.menu-open == "view" ? "window" : "file")));
                    return accept;
                }
                if event.text == Key.LeftArrow {
                    root.menu-opened(root.menu-open == "file" ? "window" : (root.menu-open == "edit" ? "file" : (root.menu-open == "view" ? "edit" : "view")));
                    return accept;
                }
                if event.text == Key.Return {
                    if root.menu-selectable(root.menu-highlight) {
                        root.menu-item-invoked(root.current-menu-entries[root.menu-highlight].id);
                    }
                    return accept;
                }
                if event.text == Key.Escape {
                    root.click-away-requested();
                    return accept;
                }
            }
            if event.text == Key.Escape {
                if root.home-open {
                    root.home-closed();
                    return accept;
                }
                if root.rail-flyout != "" {
                    root.rail-flyout = "";
                    return accept;
                }
                if root.quick-actions-open {
                    root.quick-actions-open = false;
                    return accept;
                }
                if root.context-menu-open {
                    root.context-menu-open = false;
                    root.click-away-requested();
                    return accept;
                }
                if root.paint-canvas-panel-visible {
                    root.paint-canvas-panel-visible = false;
                    return accept;
                }
                if root.settings-visible {
                    root.settings-visible = false;
                    root.settings-closed();
                    return accept;
                }
                if root.reference-manager-visible {
                    root.reference-manager-visible = false;
                    root.reference-manager-closed();
                    return accept;
                }
                viewport-touch.clear-gesture();
                root.escape-requested();
                return accept;
            }
            if !root.command-search-visible && !root.settings-visible {
                root.shortcut-requested(
                    root.shortcut-key-name(event.text),
                    event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

            ShellHeader {
                menu-open: root.menu-open;
                menu-file-label: root.menu-file-label;
                menu-edit-label: root.menu-edit-label;
                menu-view-label: root.menu-view-label;
                menu-window-label: root.menu-window-label;
                active-workspace: root.active-workspace;
                modeling-mode: root.modeling-mode;
                draw-title: root.label-workspace-draw-title;
                draw-description: root.label-workspace-draw-description;
                poly-title: root.label-workspace-poly-title;
                poly-description: root.label-workspace-poly-description;
                reduced-motion: root.reduced-motion;
                animate-available: root.animate-available;
                animate-label: root.animate-texts.workspace-label;
                animate-tip: root.animate-texts.workspace-tip;
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                shortcut-undo: root.shortcuts.undo;
                shortcut-redo: root.shortcuts.redo;
                shortcut-search: root.shortcuts.search;
                shortcut-settings: root.shortcuts.settings;

                menu-toggled(name, x) => {
                    root.menu-anchor-x = x;
                    root.menu-toggled(name);
                }
                menu-opened(name, x) => {
                    root.menu-anchor-x = x;
                    root.menu-opened(name);
                }
                workspace-changed(ws) => { root.workspace-changed(ws); }
                undo-requested => { root.undo-requested(); }
                redo-requested => { root.redo-requested(); }
                search-requested => { root.search-requested(); }
                settings-requested => { root.settings-requested(); }
            }

            HorizontalLayout {
                spacing: 0px;
                horizontal-stretch: 1;
                vertical-stretch: 1;

                // Contextual Tool Rail: estado permanece no shell; o componente só projeta e emite intents.
                ToolRail {
                    active-workspace: root.active-workspace;
                    modeling-mode: root.modeling-mode;
                    active-tool: root.active-tool;
                    transform-instant-active: root.transform-instant-active;
                    show-tool-labels: root.show-tool-labels;
                    add-menu-open: root.add-menu-open;
                    asset-library-visible: root.asset-library-visible;

                    select-tools: root.rail-select-tools;
                    helper-tools: root.rail-helper-tools;
                    paint-brush-tools: root.rail-paint-brush-tools;
                    paint-shape-tools: root.rail-paint-shape-tools;
                    paint-gradient-tools: root.rail-paint-gradient-tools;
                    animate-catalog: root.animate-catalog;
                    shortcuts: root.shortcuts;

                    label-model-position: root.label-model-position;
                    label-model-rotate: root.label-model-rotate;
                    label-model-scale: root.label-model-scale;
                    label-model-transform: root.label-model-transform;
                    label-model-push-pull: root.label-model-push-pull;
                    label-asset-library: root.label-asset-library;

                    activate-tool(id) => { root.active-tool-changed(id); }
                    execute-command(id) => { root.command-executed(id); }
                    rail-activate(id) => { root.rail-activate(id); }
                    flyout-requested(group, x, y) => {
                        root.rail-flyout-x = x;
                        root.rail-flyout-y = y;
                        root.rail-flyout = group;
                        if group == "select" {
                            root.rail-flyout-tools = root.rail-select-tools;
                        } else if group == "helpers" {
                            root.rail-flyout-tools = root.rail-helper-tools;
                        } else if group == "paint-brush" {
                            root.rail-flyout-tools = root.rail-paint-brush-tools;
                        } else if group == "paint-shapes" {
                            root.rail-flyout-tools = root.rail-paint-shape-tools;
                        } else if group == "paint-gradients" {
                            root.rail-flyout-tools = root.rail-paint-gradient-tools;
                        }
                    }
                    add-profile-rectangle(w, h) => { root.add-profile-rectangle(w, h); }
                    add-profile-circle(radius, segments) => { root.add-profile-circle(radius, segments); }
                    add-menu-toggled(open) => {
                        root.add-menu-open = open;
                        root.add-menu-changed(open);
                    }
                    animate-action(action, arg, value) => { root.animate-action(action, arg, value); }
                    asset-library-requested => { root.asset-library-requested(); }
                }

                // Contêiner da viewport: principal + (opcional) vista dividida, lado a lado.
                Rectangle {
                    horizontal-stretch: 1;
                viewport-region := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: root.split-enabled ? (parent.width - 4px) / 2 : parent.width;
                    height: parent.height;
                    clip: true;
                    background: DesignTokens.canvas;
                    border-width: 1px;
                    border-color: DesignTokens.border;

                    // Em px físicos a medida muda também quando só o fator de escala
                    // muda (UI scale, troca de monitor), o que recria o alvo nítido.
                    property <float> physical-width: self.width / 1phx;
                    property <float> physical-height: self.height / 1phx;
                    changed width => {
                        root.viewport-resized(self.width / 1px, self.height / 1px, self.physical-width, self.physical-height);
                    }
                    changed height => {
                        root.viewport-resized(self.width / 1px, self.height / 1px, self.physical-width, self.physical-height);
                    }
                    changed physical-width => {
                        root.viewport-resized(self.width / 1px, self.height / 1px, self.physical-width, self.physical-height);
                    }
                    changed physical-height => {
                        root.viewport-resized(self.width / 1px, self.height / 1px, self.physical-width, self.physical-height);
                    }

                    if has-gpu-viewport: Image {
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                        source: root.viewport-image;
                    }

                    if !has-gpu-viewport: Text {
                        text: Tr.t("sl.viewport_n_nslint_shell_bootstrap_ngpu_viewp");
                        color: DesignTokens.text-muted;
                        font-size: DesignTokens.font-exceptional;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Coordenadas já projetadas em pixels da viewport. Não
                    // normalizar os paths à caixa do item (fit padrão).
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: transparent;
                        stroke: DesignTokens.text-secondary;
                        stroke-width: 1.25px;
                        commands: root.selection-unselected-outline-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: transparent;
                        // Modo componente usa o mesmo laranja da seleção
                        // (Blender não pinta seleção de edit-mode de azul):
                        // o accent virou vestígio e sai na próxima limpeza.
                        stroke: root.selection-color;
                        stroke-width: max(2px, root.selection-thickness * 1px);
                        commands: root.selection-outline-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: transparent;
                        stroke: root.active-selection-color;
                        stroke-width: root.selection-thickness * 1.2 * 1px;
                        commands: root.selection-active-outline-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: DesignTokens.text-muted;
                        stroke: transparent;
                        commands: root.selection-unselected-point-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: root.active-selection-color;
                        stroke: transparent;
                        commands: root.selection-point-commands;
                    }

                    // Animate: esqueleto posado (ossos + articulações) em pixels
                    // da viewport, projetado pelo bridge — independe da GPU.
                    if root.active-workspace == "ANIMATE" && root.animate-show-bones: Path {
                        fit: ImageFit.preserve;
                        commands: root.animate-bone-commands;
                        fill: transparent;
                        stroke: DesignTokens.accent;
                        stroke-width: 2.5px;
                    }
                    if root.active-workspace == "ANIMATE" && root.animate-show-bones: Path {
                        fit: ImageFit.preserve;
                        commands: root.animate-joint-commands;
                        fill: transparent;
                        stroke: DesignTokens.text-primary;
                        stroke-width: 1.5px;
                    }

                    Path {
                        fit: ImageFit.preserve;
                        commands: root.operation-preview-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: 2.5px;
                    }
                    Path {
                        fit: ImageFit.preserve;
                        commands: root.loop-cut-preview-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: 2px;
                    }
                    // Poly Pen: pontos coletados até o cursor.
                    if root.poly-pen-preview-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.poly-pen-preview-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: 2px;
                    }

                    // Formas do Draw sempre visíveis: tinta leve das regiões e contorno
                    // dos perfis que não estão em edição.
                    if root.region-shapes-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.region-shapes-commands;
                        fill-rule: evenodd;
                        fill: DesignTokens.selection.transparentize(0.9);
                        stroke: DesignTokens.selection.transparentize(0.6);
                        stroke-width: 1px;
                    }
                    if root.profile-outline-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.profile-outline-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection.transparentize(0.35);
                        stroke-width: 1.5px;
                    }
                    // Segmento selecionado no domínio Curve (DRAW): traço largo.
                    if root.profile-selection-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.profile-selection-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection;
                        stroke-width: 3px;
                    }
                    // Região fechada sob o cursor (Draw/Push-Pull): tinta translúcida.
                    if root.region-hover-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.region-hover-commands;
                        fill-rule: evenodd;
                        fill: DesignTokens.selection.transparentize(0.78);
                        stroke: DesignTokens.selection;
                        stroke-width: 1.5px;
                    }
                    if root.parametric-handle-visible && root.parametric-handle-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.parametric-handle-commands;
                        fill: DesignTokens.accent;
                        stroke: DesignTokens.accent;
                        stroke-width: 2px;
                    }
                    if root.parametric-handle-visible: Rectangle {
                        x: root.parametric-handle-x - 12px;
                        y: root.parametric-handle-y - 12px;
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: root.parametric-handle-hover ? DesignTokens.accent : DesignTokens.surface-raised;
                        border-width: 2px;
                        border-color: DesignTokens.accent;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.parametric-handle-hover ? DesignTokens.on-accent : DesignTokens.accent;
                        }
                    }
                    // Depth Handle da forma ativa em DRAW: haste com diamante + cota
                    if root.depth-handle-visible && root.depth-handle-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.depth-handle-commands;
                        fill: DesignTokens.accent;
                        stroke: DesignTokens.accent;
                        stroke-width: 2px;
                    }
                    if root.depth-handle-visible: Rectangle {
                        x: root.depth-handle-x + 10px;
                        y: root.depth-handle-y - 12px;
                        width: depth-text.preferred-width + 8px;
                        height: 18px;
                        border-radius: 4px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.accent;
                        depth-text := Text {
                            text: root.depth-handle-label;
                            color: DesignTokens.text-primary;
                            font-size: DesignTokens.font-caption;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Path {
                        fit: ImageFit.preserve;
                        commands: root.profile-preview-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection;
                        stroke-width: 2px;
                    }

                    // Cordão da ferramenta ativa: tracejado amarelo da base da
                    // seleção até o mouse. Cresce/encolhe com a distância.
                    if root.drag-link-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.drag-link-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: 1.5px;
                    }

                    // Círculo pontilhado do raio de influência para Proportional Editing
                    if root.proportional-circle-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.proportional-circle-commands;
                        fill: transparent;
                        stroke: DesignTokens.guide-neutral;
                        stroke-width: 1.5px;
                    }

                    // Infinite Axis Guide Line (Fase 4: Linhas de Guia Infinitas)
                    if root.axis-guide-visible && root.axis-guide-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.axis-guide-commands;
                        fill: transparent;
                        stroke: root.axis-guide-color;
                        stroke-width: 1.5px;
                    }

                    // Rótulo discreto do eixo na linha de guia infinita
                    if root.axis-guide-visible && root.axis-guide-label != "" && active-workspace == "MODEL": Rectangle {
                        x: root.axis-guide-label-x - 9px;
                        y: root.axis-guide-label-y - 9px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: DesignTokens.hud-surface;
                        border-width: 1.5px;
                        border-color: root.axis-guide-color;
                        drop-shadow-blur: DesignTokens.elevation-1-blur;
                        drop-shadow-color: DesignTokens.elevation-1-color;
                        Text {
                            text: root.axis-guide-label;
                            color: root.axis-guide-color;
                            font-size: DesignTokens.font-caption;
                            font-weight: 700;
                            font-family: "monospace";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Dimension Line (Fase 4: Cotas Blueprint)
                    if root.dimension-visible && root.dimension-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.dimension-commands;
                        fill: transparent;
                        stroke: DesignTokens.badge-precision-border;
                        stroke-width: 1.5px;
                    }

                    // Quick Measure Line (Fase 6: Fita Métrica 3D)
                    if root.measure-visible && root.measure-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.measure-commands;
                        fill: transparent;
                        stroke: DesignTokens.measure.with-alpha(0.67);
                        stroke-width: 1.2px;
                    }

                    // Protractor (Transferidor Visual de Ângulo para Rotação Modal)
                    if root.protractor-visible && root.protractor-wedge-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.protractor-wedge-commands;
                        fill: DesignTokens.accent.transparentize(0.85);
                        stroke: DesignTokens.accent;
                        stroke-width: 1.5px;
                    }
                    if root.protractor-visible && root.protractor-ticks-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.protractor-ticks-commands;
                        fill: transparent;
                        stroke: DesignTokens.accent.transparentize(0.4);
                        stroke-width: 1px;
                    }

                    // 3D Decal Live Projection Manipulator (Sprint C: P3D-133 / P3D-160)
                    if root.active-workspace == "PAINT" && root.active-layer-is-decal && root.decal-preview-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.decal-preview-commands;
                        fill: DesignTokens.accent.transparentize(0.90);
                        stroke: DesignTokens.accent;
                        stroke-width: 1.5px;
                    }

                    if root.stencil-visible: Image {
                        width: parent.width; height: parent.height;
                        source: root.stencil-image; image-fit: fill;
                    }
                    viewport-touch := TouchArea {
                        mouse-cursor: self.is-orbit || self.is-pan || self.is-gizmo-drag ? grabbing
                            : (self.is-transform || self.is-keyboard-transform-drag) ? (root.active-tool == "scale" ? nesw-resize : (root.active-tool == "rotate" ? grabbing : move))
                            : (root.active-workspace == "PAINT") ? (root.brush-stroke-tool(root.active-tool) ? none : crosshair)
                            : (root.active-tool == "slice" || root.active-tool == "cut" || root.active-tool == "loop_cut" || root.active-tool == "measure" || root.active-tool == "draw_profile" || root.active-tool == "cursor" || root.active-tool == "cursor_3d" || self.is-box-select || self.is-lasso-select || root.active-tool == "lasso_select") ? crosshair
                            : (root.active-tool == "extrude" || root.active-tool == "push_pull") ? ns-resize
                            : root.active-tool == "bevel" ? nesw-resize
                            : root.active-tool == "inset" ? nwse-resize
                            : root.active-tool == "scale" ? nesw-resize
                            : root.active-tool == "rotate" ? grabbing
                            : root.active-tool == "move" ? move
                            : root.gizmo-has-hover ? grab
                            : default;
                        // Anel do pincel: mesmo diâmetro (px) que o carimbo e o pincel 2D usam.
                        // Cursor do pincel: mesmo diâmetro (px) que o carimbo e o canvas 2D;
                        // núcleo pela dureza e preenchimento pela opacidade × fluxo.
                        if root.active-workspace == "PAINT" && viewport-touch.has-hover && root.brush-stroke-tool(root.active-tool): BrushCursor {
                            diameter: root.brush-size * 16px;
                            hardness: root.brush-hardness;
                            strength: root.brush-opacity * root.brush-flow;
                            tint: root.paint-color;
                            erase: root.active-tool == "eraser";
                            hard-edge: root.active-tool == "pixel";
                            squash: root.brush-cursor-squash;
                            tilt: root.brush-cursor-tilt;
                            x: viewport-touch.mouse-x - self.width / 2;
                            y: viewport-touch.mouse-y - self.height / 2;
                        }
                        property <length> last-x;
                        property <length> last-y;
                        property <bool> is-box-select: false;
                        property <bool> is-lasso-select: false;
                        property <bool> pending-lasso-select: false;
                        property <string> lasso-points: "";
                        property <string> lasso-base-commands: "";
                        property <string> lasso-commands: "";
                        property <length> lasso-last-x;
                        property <length> lasso-last-y;
                        property <int> lasso-count: 0;
                        property <bool> subtract-selection: false;
                        property <bool> is-orbit: false;
                        property <bool> is-pan: false;
                        property <bool> moved-since-down: false;
                        property <bool> extend-selection: false;
                        property <bool> is-transform: false;
                        property <bool> pending-transform: false;
                        // Tweak do Blender: com a tool Select, o arrasto vira
                        // box select; o clique (sem arrasto) só seleciona.
                        property <bool> pending-box-select: false;
                        property <bool> is-painting: false;
                        property <bool> is-tool-drag: false;
                        property <bool> is-loop-drag: false;
                        property <bool> is-gizmo-drag: false;
                        property <bool> is-keyboard-transform-drag: false;
                        // Gesto da gramática única em andamento (botão pressionado).
                        property <bool> is-tool-gesture: false;
                        property <bool> is-profile-depth-drag: false;
                        property <bool> consume-click: false;
                        property <bool> tool-drag-fine: false;
                        property <bool> loop-selection: false;
                        property <string> local-kind: "";

                        function clear-gesture() {
                            self.is-box-select = false;
                            self.is-lasso-select = false;
                            self.pending-lasso-select = false;
                            self.lasso-points = "";
                            self.lasso-base-commands = "";
                            self.lasso-commands = "";
                            self.is-transform = false;
                            self.pending-transform = false;
                            self.pending-box-select = false;
                            self.is-tool-drag = false;
                            self.is-profile-depth-drag = false;
                            self.is-loop-drag = false;
                            self.is-gizmo-drag = false;
                            self.is-keyboard-transform-drag = false;
                            self.is-tool-gesture = false;
                            self.consume-click = false;
                            self.loop-selection = false;
                            self.is-painting = false;
                            self.is-orbit = false;
                            self.is-pan = false;
                            self.moved-since-down = true;
                        }

                        function transform-tool() -> string {
                            if root.active-workspace != "MODEL" {
                                return "";
                            }
                            if root.active-tool == "move" || root.active-tool == "transform" {
                                return "pos";
                            }
                            if root.active-tool == "rotate" {
                                return "rot";
                            }
                            if root.active-tool == "scale" {
                                return "scale";
                            }
                            return "";
                        }

                        pointer-event(event) => {
                            root.precision-mode = event.modifiers.shift;
                            root.snap-mode = event.modifiers.control;
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right
                                && (is-tool-gesture || root.tool-gesture-latched || is-transform || is-gizmo-drag
                                    || is-tool-drag || is-keyboard-transform-drag || root.transform-instant-active
                                    || is-loop-drag) {
                                // RMB nunca cancela um gesto (constituição 11); cancelar é Esc.
                            } else if event.kind == PointerEventKind.cancel || (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                if event.kind == PointerEventKind.cancel && (is-tool-gesture || root.tool-gesture-latched) {
                                    root.tool-pointer(3, self.mouse-x / 1px, self.mouse-y / 1px, false, false, false);
                                }
                                self.clear-gesture();
                                if event.kind == PointerEventKind.down && event.modifiers.shift {
                                    consume-click = true;
                                    root.viewport-place-cursor(self.mouse-x / self.width, self.mouse-y / self.height);
                                } else {
                                    // Sem gesto: abre o menu da viewport.
                                    root.viewport-context-requested(self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            } else if event.kind == PointerEventKind.down {
                                root-focus.focus();
                                last-x = self.mouse-x;
                                last-y = self.mouse-y;
                                moved-since-down = false;
                                consume-click = false;
                                extend-selection = event.modifiers.shift;
                                loop-selection = event.modifiers.alt;
                                is-transform = false;
                                pending-transform = false;
                                pending-box-select = false;
                                pending-lasso-select = false;
                                if event.button == PointerEventButton.left
                                    && (root.tool-gesture-latched
                                        || (root.tool-grammar-active && !root.transform-instant-active
                                            && (!event.modifiers.alt || root.active-tool == "draw_profile")
                                            && !(event.modifiers.alt && root.active-keymap-id == "maya"))) {
                                    // Gramática única (constituição 11): todas as ferramentas
                                    // de operação — Move/Rotate/Scale, Extrude, Inset, Round
                                    // Edge, Push/Pull, Poly Pen, Shape Builder, Draw Profile,
                                    // Knife, Loop Cut e Slice — e os modais por atalho
                                    // decidem clique × arrasto no bridge.
                                    is-tool-gesture = true;
                                    consume-click = true;
                                    root.tool-pointer(0, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
                                } else if event.button == PointerEventButton.left
                                    && root.active-workspace == "MODEL" && root.modeling-mode == "DRAW"
                                    && root.depth-handle-visible
                                    && abs(self.mouse-x - root.depth-handle-x) <= 20px
                                    && abs(self.mouse-y - root.depth-handle-y) <= 20px {
                                    is-profile-depth-drag = true;
                                    tool-drag-fine = event.modifiers.shift;
                                    consume-click = true;
                                } else if event.button == PointerEventButton.middle {
                                    if event.modifiers.shift {
                                        is-pan = true;
                                        is-orbit = false;
                                    } else {
                                        is-orbit = true;
                                        is-pan = false;
                                    }
                                } else if event.button == PointerEventButton.left && event.modifiers.alt && root.active-keymap-id == "maya" {
                                    is-orbit = true;
                                    is-pan = false;
                                } else if event.button == PointerEventButton.left && root.active-tool == "lasso_select" && !event.modifiers.alt {
                                    pending-lasso-select = true;
                                    is-lasso-select = false;
                                    subtract-selection = event.modifiers.control;
                                    lasso-last-x = self.mouse-x;
                                    lasso-last-y = self.mouse-y;
                                    lasso-count = 0;
                                    lasso-points = "";
                                    lasso-base-commands = "";
                                    lasso-commands = "";
                                } else if event.button == PointerEventButton.left && (root.active-tool == "cursor" || root.active-tool == "cursor_3d") {
                                    consume-click = true;
                                    root.viewport-place-cursor(self.mouse-x / self.width, self.mouse-y / self.height);
                                } else if event.button == PointerEventButton.left
                                    && (!event.modifiers.alt || root.active-keymap-id != "maya") {
                                    if root.gizmo-has-hover {
                                        is-gizmo-drag = true;
                                        root.gizmo-drag-begin(self.mouse-x / 1px, self.mouse-y / 1px);
                                    } else if root.transform-instant-active {
                                        // O atalho já abriu a operação modal. O mesmo
                                        // clique pode confirmar ou iniciar um arrasto;
                                        // não exigir um primeiro clique descartável.
                                        is-keyboard-transform-drag = true;
                                        consume-click = true;
                                    } else if root.active-workspace == "PAINT" && root.active-tool != "select" {
                                        is-painting = true;
                                        root.viewport-paint-begin(self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control);
                                    } else if root.loop-cut-active {
                                        is-loop-drag = true;
                                        tool-drag-fine = event.modifiers.shift;
                                    } else if root.tool-modal-active {
                                        is-tool-drag = true;
                                        tool-drag-fine = event.modifiers.shift;
                                    } else {
                                        local-kind = self.transform-tool();
                                        if local-kind != "" && !event.modifiers.alt {
                                            // A ferramenta só inicia uma operação após um
                                            // arrasto real; um clique continua selecionando.
                                            pending-transform = true;
                                        } else if (root.active-tool == "select" || root.active-tool == "box_select")
                                            && root.active-workspace == "MODEL"
                                            && !root.gizmo-has-hover
                                            && !root.transform-instant-active
                                            && !root.tool-modal-active
                                            && !root.loop-cut-active
                                            && !event.modifiers.alt {
                                            // Tweak / Box Select (Blender): arrastar
                                            // vira box select; o clique (sem
                                            // arrasto) cai no viewport-select.
                                            pending-box-select = true;
                                            subtract-selection = event.modifiers.control;
                                        }
                                    }
                                }
                            } else if event.kind == PointerEventKind.move {
                                if !self.pressed {
                                    // TouchArea.moved só dispara durante um grab. O
                                    // pointer-event Move também cobre hover livre,
                                    // necessário para operações iniciadas por atalho.
                                    root.gizmo-hover(self.mouse-x / 1px, self.mouse-y / 1px);
                                    if !root.gizmo-has-hover {
                                        root.viewport-hover(self.mouse-x / self.width, self.mouse-y / self.height);
                                    } else {
                                        root.viewport-hover-clear();
                                    }
                                }
                                if is-box-select {
                                    if abs(self.mouse-x - last-x) > 4px || abs(self.mouse-y - last-y) > 4px { moved-since-down = true; }
                                } else if pending-lasso-select && self.pressed
                                    && (abs(self.mouse-x - lasso-last-x) > 3px || abs(self.mouse-y - lasso-last-y) > 3px) {
                                    pending-lasso-select = false;
                                    is-lasso-select = true;
                                    moved-since-down = true;
                                    lasso-count = 2;
                                    lasso-points = "\{lasso-last-x / self.width},\{lasso-last-y / self.height};\{self.mouse-x / self.width},\{self.mouse-y / self.height};";
                                    lasso-base-commands = "M \{lasso-last-x / 1px} \{lasso-last-y / 1px} L \{self.mouse-x / 1px} \{self.mouse-y / 1px} ";
                                    lasso-commands = lasso-base-commands + "Z";
                                    lasso-last-x = self.mouse-x;
                                    lasso-last-y = self.mouse-y;
                                } else if is-lasso-select && self.pressed {
                                    if lasso-count < 4096 && (abs(self.mouse-x - lasso-last-x) > 3px || abs(self.mouse-y - lasso-last-y) > 3px) {
                                        lasso-last-x = self.mouse-x;
                                        lasso-last-y = self.mouse-y;
                                        lasso-count += 1;
                                        lasso-points += "\{self.mouse-x / self.width},\{self.mouse-y / self.height};";
                                        lasso-base-commands += "L \{self.mouse-x / 1px} \{self.mouse-y / 1px} ";
                                    }
                                    lasso-commands = lasso-base-commands + "L \{self.mouse-x / 1px} \{self.mouse-y / 1px} Z";
                                } else if pending-box-select && self.pressed
                                    && (self.mouse-x - last-x > 4px || last-x - self.mouse-x > 4px
                                        || self.mouse-y - last-y > 4px || last-y - self.mouse-y > 4px) {
                                    pending-box-select = false;
                                    is-box-select = true;
                                    moved-since-down = true;
                                } else if is-orbit {
                                    moved-since-down = true;
                                    root.viewport-orbit((self.mouse-x - last-x) / 1px, (self.mouse-y - last-y) / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-pan {
                                    moved-since-down = true;
                                    root.viewport-pan((self.mouse-x - last-x) / 1px, (self.mouse-y - last-y) / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if (is-tool-gesture && self.pressed) || root.tool-gesture-latched {
                                    // Gramática única: o bridge decide clique × arrasto e aplica.
                                    moved-since-down = true;
                                    root.tool-pointer(1, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
                                } else if event.modifiers.alt && root.active-keymap-id != "maya"
                                    && (abs(self.mouse-x - last-x) > 4px || abs(self.mouse-y - last-y) > 4px) {
                                    moved-since-down = true;
                                } else if root.transform-instant-active && (!self.pressed || is-keyboard-transform-drag) {
                                    if is-keyboard-transform-drag { moved-since-down = true; }
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if is-gizmo-drag {
                                    moved-since-down = true;
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if root.tool-modal-active && (root.tool-activation == "instant" || root.keyboard-tool-modal-active) && !self.pressed {
                                    root.tool-modal-hovered((self.mouse-y - last-y) / 1px, self.mouse-x / 1px, self.mouse-y / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-transform {
                                    moved-since-down = true;
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if pending-transform && self.pressed
                                    && (self.mouse-x - last-x > 4px || last-x - self.mouse-x > 4px
                                        || self.mouse-y - last-y > 4px || last-y - self.mouse-y > 4px) {
                                    pending-transform = false;
                                    is-transform = true;
                                    moved-since-down = true;
                                    root.viewport-transform-begin(local-kind, last-x / 1px, last-y / 1px);
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if is-painting {
                                    moved-since-down = true;
                                    root.viewport-paint-update(self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control);
                                } else if is-tool-drag {
                                    moved-since-down = true;
                                    root.tool-modal-scrubbed((self.mouse-y - last-y) / 1px, tool-drag-fine, self.mouse-x / 1px, self.mouse-y / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-profile-depth-drag {
                                    moved-since-down = true;
                                    let delta = (last-y - self.mouse-y) / 1px * (tool-drag-fine ? 0.005 : 0.02);
                                    root.profile-depth-set("\{max(0.05, root.profile-depth + delta)}");
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-loop-drag {
                                    moved-since-down = true;
                                    root.loop-cut-scrubbed((self.mouse-x - last-x) / 1px, (self.mouse-y - last-y) / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                }
                            } else if event.kind == PointerEventKind.up {
                                if is-tool-gesture {
                                    root.tool-pointer(2, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
                                    is-tool-gesture = false;
                                }
                                if is-box-select {
                                    if moved-since-down {
                                        root.viewport-box-select(last-x / self.width, last-y / self.height, self.mouse-x / self.width, self.mouse-y / self.height, extend-selection, subtract-selection);
                                    }
                                    is-box-select = false;
                                }
                                if is-lasso-select {
                                    if abs(self.mouse-x - lasso-last-x) > 1px || abs(self.mouse-y - lasso-last-y) > 1px {
                                        lasso-points += "\{self.mouse-x / self.width},\{self.mouse-y / self.height};";
                                        lasso-count += 1;
                                    }
                                    if lasso-count >= 3 {
                                        root.viewport-lasso-select(lasso-points, extend-selection, subtract-selection);
                                    }
                                    is-lasso-select = false;
                                    pending-lasso-select = false;
                                    lasso-points = "";
                                    lasso-base-commands = "";
                                    lasso-commands = "";
                                }
                                pending-lasso-select = false;
                                is-orbit = false;
                                is-pan = false;
                                is-profile-depth-drag = false;
                                if is-transform {
                                    root.viewport-transform-end();
                                    is-transform = false;
                                }
                                if is-keyboard-transform-drag {
                                    // No modal por atalho, clique confirma e
                                    // clique-arrasto edita sem clique preparatório.
                                    root.viewport-transform-end();
                                    is-keyboard-transform-drag = false;
                                }
                                pending-transform = false;
                                pending-box-select = false;
                                if is-painting {
                                    root.viewport-paint-end(self.mouse-x / 1px, self.mouse-y / 1px);
                                    is-painting = false;
                                }
                                if is-tool-drag {
                                    if moved-since-down {
                                        root.tool-modal-apply();
                                    }
                                    is-tool-drag = false;
                                }
                                if is-loop-drag {
                                    root.loop-cut-apply();
                                    is-loop-drag = false;
                                }

                                if is-gizmo-drag {
                                    root.gizmo-drag-end();
                                    is-gizmo-drag = false;
                                }
                                root.viewport-hover(self.mouse-x / self.width, self.mouse-y / self.height);
                            }
                        }

                        clicked => {
                            if !consume-click && !moved-since-down && !is-transform && !is-painting
                                && (root.active-workspace != "PAINT" || root.active-tool == "select") {
                                root.viewport-select(self.mouse-x / self.width, self.mouse-y / self.height, extend-selection, loop-selection);
                            }
                            consume-click = false;
                        }

                        scroll-event(event) => {
                            // A roda sempre faz zoom (constituição 11). Ctrl+roda ajusta
                            // contagens (Loop Cut) e o raio da edição proporcional.
                            if event.modifiers.control {
                                root.viewport-ctrl-scroll(event.delta-y / 1px);
                            } else {
                                root.viewport-zoom(event.delta-y / 1px);
                            }
                            accept
                        }
                    }

                    if viewport-touch.is-box-select: Rectangle {
                        x: min(viewport-touch.last-x, viewport-touch.mouse-x);
                        y: min(viewport-touch.last-y, viewport-touch.mouse-y);
                        width: abs(viewport-touch.mouse-x - viewport-touch.last-x);
                        height: abs(viewport-touch.mouse-y - viewport-touch.last-y);
                        background: DesignTokens.selection.transparentize(0.9);
                        border-color: DesignTokens.selection;
                        border-width: 1px;
                    }
                    if viewport-touch.is-lasso-select: Path {
                        width: 100%;
                        height: 100%;
                        fit: ImageFit.preserve;
                        commands: viewport-touch.lasso-commands;
                        fill: DesignTokens.selection.transparentize(0.85);
                        stroke: DesignTokens.selection;
                        stroke-width: 1.5px;
                    }

                    // 3D Cursor overlay (âncora 3D para criação de primitivas e foco de câmera)
                    if root.cursor-visible && active-workspace == "MODEL": Rectangle {
                        x: root.cursor-screen-x - 14px;
                        y: root.cursor-screen-y - 14px;
                        width: 28px;
                        height: 28px;

                        // Outer ring (white)
                        Rectangle {
                            x: 2px; y: 2px;
                            width: 24px; height: 24px;
                            border-radius: 12px;
                            border-width: 1.5px;
                            border-color: DesignTokens.cursor-light;
                            background: transparent;
                        }
                        // Inner ring (accent / red)
                        Rectangle {
                            x: 4px; y: 4px;
                            width: 20px; height: 20px;
                            border-radius: 10px;
                            border-width: 1.5px;
                            border-color: DesignTokens.marker-pivot.with-alpha(0.87);
                            background: transparent;
                        }
                        // Horizontal crosshair
                        Rectangle {
                            x: 0px; y: 13px;
                            width: 28px; height: 2px;
                            background: DesignTokens.cursor-light;
                        }
                        // Vertical crosshair
                        Rectangle {
                            x: 13px; y: 0px;
                            width: 2px; height: 28px;
                            background: DesignTokens.cursor-light;
                        }
                        // Center dot
                        Rectangle {
                            x: 12px; y: 12px;
                            width: 4px; height: 4px;
                            border-radius: 2px;
                            background: DesignTokens.marker-pivot;
                        }
                    }

                    // Edit Pivot Mode visual banner / badge
                    if root.edit-pivot && active-workspace == "MODEL": Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 58px;
                        height: 30px;
                        width: edit-pivot-row.preferred-width + 24px;
                        border-radius: 6px;
                        background: DesignTokens.marker-pivot.with-alpha(0.13);
                        border-width: 1.5px;
                        border-color: DesignTokens.marker-pivot;
                        drop-shadow-blur: DesignTokens.elevation-1-blur;
                        drop-shadow-color: DesignTokens.elevation-1-color;

                        edit-pivot-row := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            alignment: center;
                            Rectangle {
                                width: 8px; height: 8px;
                                border-radius: 4px;
                                background: DesignTokens.marker-pivot;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "\{root.label-edit-pivot} (Insert)";
                                color: DesignTokens.hud-text;
                                font-size: DesignTokens.font-small;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: Tr.t("sl.g_to_move_origin");
                                color: DesignTokens.marker-pivot-text;
                                font-size: DesignTokens.font-caption;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Marcador magnético de snap (Fase 4: Feedback Magnético)
                    if root.snap-marker-visible && active-workspace == "MODEL": Rectangle {
                        x: root.snap-marker-x - 8px;
                        y: root.snap-marker-y - 8px;
                        width: 16px;
                        height: 16px;
                        Rectangle {
                            x: 2px; y: 2px; width: 12px; height: 12px;
                            border-radius: root.snap-marker-round ? 6px : 2px;
                            background: transparent;
                            border-width: 2px;
                            border-color: DesignTokens.measure;
                            drop-shadow-blur: DesignTokens.glow-blur;
                            drop-shadow-color: DesignTokens.measure.with-alpha(0.8);
                        }
                        Rectangle {
                            x: 6px; y: 6px; width: 4px; height: 4px;
                            border-radius: 2px;
                            background: DesignTokens.measure;
                        }
                    }

                    // Rótulo do alvo de snap (P3D-040: forma + cor + texto)
                    if root.snap-marker-visible && root.snap-marker-label != "" && active-workspace == "MODEL": Rectangle {
                        x: root.snap-marker-x + 12px;
                        y: root.snap-marker-y + 10px;
                        width: snap-label.preferred-width + 10px;
                        height: 18px;
                        border-radius: 4px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        snap-label := Text {
                            text: root.snap-marker-label;
                            color: DesignTokens.text-primary;
                            font-size: DesignTokens.font-caption;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Rótulo da cota blueprint (Fase 4: Cotas Blueprint)
                    if root.dimension-visible && root.dimension-text != "" && active-workspace == "MODEL": Rectangle {
                        x: root.dimension-x - self.width / 2;
                        y: root.dimension-y - self.height / 2;
                        width: dim-label.preferred-width + 12px;
                        height: 20px;
                        border-radius: 4px;
                        background: DesignTokens.hud-surface;
                        border-width: 1px;
                        border-color: DesignTokens.badge-precision-border;
                        drop-shadow-blur: DesignTokens.elevation-1-blur;
                        drop-shadow-color: DesignTokens.elevation-1-color;
                        dim-label := Text {
                            text: root.dimension-text;
                            color: DesignTokens.hud-text;
                            font-size: DesignTokens.font-caption;
                            font-weight: 700;
                            font-family: "monospace";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Rótulos de Medição nos Edges (Fase 6: Medição Rápida Compacta e Translúcida)
                    if root.measure-visible && active-workspace == "MODEL": Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;

                        for tag in root.measure-tags: Rectangle {
                            x: tag.x * 1px - self.width / 2;
                            y: tag.y * 1px - self.height / 2;
                            width: tag-label.preferred-width + 10px;
                            height: 18px;
                            border-radius: 4px;
                            background: DesignTokens.hud-surface;
                            border-width: 1px;
                            border-color: DesignTokens.measure.with-alpha(0.53);
                            drop-shadow-blur: DesignTokens.elevation-1-blur;
                            drop-shadow-color: DesignTokens.elevation-1-color;

                            tag-label := Text {
                                text: tag.text;
                                color: DesignTokens.measure;
                                font-size: DesignTokens.font-caption;
                                font-weight: 700;
                                font-family: "monospace";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.measure-tags.length == 0 && root.measure-text != "": Rectangle {
                            x: root.measure-x - self.width / 2;
                            y: root.measure-y - self.height / 2;
                            width: fallback-label.preferred-width + 10px;
                            height: 18px;
                            border-radius: 4px;
                            background: DesignTokens.hud-surface;
                            border-width: 1px;
                            border-color: DesignTokens.measure.with-alpha(0.53);
                            drop-shadow-blur: DesignTokens.elevation-1-blur;
                            drop-shadow-color: DesignTokens.elevation-1-color;

                            fallback-label := Text {
                                text: root.measure-text;
                                color: DesignTokens.measure;
                                font-size: DesignTokens.font-caption;
                                font-weight: 700;
                                font-family: "monospace";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Rótulos não-cromáticos dos eixos do mundo no chão 3D (Grid Viewport)
                    if root.colorblind-axes && active-workspace == "MODEL": Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;

                        for tag in root.world-axis-labels: Rectangle {
                            x: tag.x * 1px - 8px;
                            y: tag.y * 1px - 8px;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            background: DesignTokens.hud-surface;
                            border-width: 1px;
                            border-color: tag.tint.transparentize(0.2);
                            drop-shadow-blur: DesignTokens.elevation-1-blur;
                            drop-shadow-color: DesignTokens.elevation-1-color;

                            Text {
                                text: tag.text;
                                color: tag.tint;
                                font-size: DesignTokens.font-caption;
                                font-weight: 700;
                                font-family: "monospace";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // HUD Flutuante no Cursor (Fase 4: HUD Numérico em Tempo Real)
                    if root.hud-pill-visible && active-workspace == "MODEL": Rectangle {
                        x: min(max(8px, root.hud-pill-x), parent.width - self.width - 8px);
                        y: min(max(8px, root.hud-pill-y), parent.height - self.height - 8px);
                        width: hud-pill-layout.preferred-width + 20px;
                        height: hud-pill-layout.preferred-height + 12px;
                        border-radius: 8px;
                        background: DesignTokens.hud-surface;
                        border-width: 1px;
                        border-color: DesignTokens.accent.transparentize(0.3);
                        drop-shadow-blur: DesignTokens.elevation-2-blur;
                        drop-shadow-color: DesignTokens.elevation-2-color;

                        hud-pill-layout := VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: space-between;
                                Text {
                                    text: root.hud-pill-title;
                                    color: DesignTokens.accent;
                                    font-size: DesignTokens.font-small;
                                    font-weight: 700;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    if root.hud-pill-badge != "": Rectangle {
                                        border-radius: 3px;
                                        background: DesignTokens.accent.transparentize(0.8);
                                        border-width: 1px;
                                        border-color: DesignTokens.accent;
                                        HorizontalLayout {
                                            padding-left: 4px; padding-right: 4px;
                                            Text { text: root.hud-pill-badge; color: DesignTokens.accent; font-size: DesignTokens.font-caption; font-weight: 700; }
                                        }
                                    }
                                    if root.precision-mode: Rectangle {
                                        border-radius: 3px;
                                        background: DesignTokens.badge-precision-bg;
                                        border-width: 1px;
                                        border-color: DesignTokens.badge-precision-border;
                                        HorizontalLayout {
                                            padding-left: 4px; padding-right: 4px;
                                            Text { text: Tr.t("sl.precision_0_1"); color: DesignTokens.badge-precision-text; font-size: DesignTokens.font-caption; font-weight: 700; font-family: "monospace"; }
                                        }
                                    }
                                    if root.snap-mode: Rectangle {
                                        border-radius: 3px;
                                        background: DesignTokens.badge-snap-bg;
                                        border-width: 1px;
                                        border-color: DesignTokens.badge-snap-border;
                                        HorizontalLayout {
                                            padding-left: 4px; padding-right: 4px;
                                            Text { text: Tr.t("sl.snap"); color: DesignTokens.badge-snap-text; font-size: DesignTokens.font-caption; font-weight: 700; font-family: "monospace"; }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.hud-pill-value;
                                color: DesignTokens.text-primary;
                                font-size: DesignTokens.font-default;
                                font-weight: 600;
                                font-family: "monospace";
                            }
                            if root.hud-pill-hint != "": Text {
                                text: root.hud-pill-hint;
                                color: DesignTokens.text-muted;
                                font-size: DesignTokens.font-caption;
                            }
                        }
                    }

                    // View bar única (plano de UI 2026-10-04, F3; cap. 23 "Viewport control bar"):
                    // LEFT = o que estou editando, CENTER = auxiliares da ferramenta,
                    // RIGHT = como estou vendo. Substitui as três ilhas soltas anteriores.
                    view-bar := Rectangle {
                        x: max(14px, (parent.width - root.right-clearance - self.width) / 2);
                        y: 14px;
                        width: view-row.preferred-width + 12px;
                        height: 38px;
                        border-radius: DesignTokens.radius-panel;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: DesignTokens.elevation-1-blur;
                        drop-shadow-color: DesignTokens.elevation-1-color;
                        drop-shadow-offset-y: DesignTokens.elevation-1-offset;
                        animate x { duration: Motion.slow; easing: ease-out; }

                        view-row := HorizontalLayout {
                            x: 6px;
                            y: 5px;
                            spacing: 3px;
                            alignment: center;

                            // LEFT — domínio de seleção do workspace.
                            if active-workspace == "MODEL" || active-workspace == "PAINT": HorizontalLayout {
                                spacing: 3px;
                                for domain in (active-workspace == "MODEL" && root.modeling-mode == "DRAW") ? [
                                    { id: "OBJECT", icon: IconSet.Box, icon-svg: PetuniaIcons.object-mesh, label: Tr.t("sl.shape"), shortcut: root.shortcuts.select-object, description: Tr.t("sl.select_entire_shape") },
                                    { id: "EDGE", icon: IconSet.Spline, icon-svg: PetuniaIcons.tool-profile, label: Tr.t("sl.curve"), shortcut: root.shortcuts.select-edge, description: Tr.t("sl.select_curve_segment") },
                                    { id: "POINT", icon: IconSet.CircleDot, icon-svg: PetuniaIcons.select-vertex, label: Tr.t("sl.point"), shortcut: root.shortcuts.select-point, description: Tr.t("sl.select_and_transform_individual_vertices_poi") },
                                    { id: "FACE", icon: IconSet.Square, icon-svg: PetuniaIcons.select-face, label: Tr.t("sl.region"), shortcut: root.shortcuts.select-face, description: Tr.t("sl.select_region_face") },
                                ] : active-workspace == "PAINT" ? [
                                    { id: "OBJECT", icon: IconSet.Box, icon-svg: PetuniaIcons.object-mesh, label: Tr.t("sl.object"), shortcut: root.shortcuts.select-object, description: Tr.t("sl.select_and_manipulate_entire_objects_as_disc") },
                                    { id: "FACE", icon: IconSet.Square, icon-svg: PetuniaIcons.select-face, label: Tr.t("sl.face"), shortcut: root.shortcuts.select-face, description: Tr.t("sl.select_and_transform_polygonal_planar_faces") },
                                ] : [
                                    { id: "OBJECT", icon: IconSet.Box, icon-svg: PetuniaIcons.object-mesh, label: Tr.t("sl.object"), shortcut: root.shortcuts.select-object, description: Tr.t("sl.select_and_manipulate_entire_objects_as_disc") },
                                    { id: "POINT", icon: IconSet.CircleDot, icon-svg: PetuniaIcons.select-vertex, label: Tr.t("sl.point"), shortcut: root.shortcuts.select-point, description: Tr.t("sl.select_and_transform_individual_vertices_poi") },
                                    { id: "EDGE", icon: IconSet.SquareDashed, icon-svg: PetuniaIcons.select-edge, label: Tr.t("sl.edge"), shortcut: root.shortcuts.select-edge, description: Tr.t("sl.select_and_transform_polygonal_boundary_edge") },
                                    { id: "FACE", icon: IconSet.Square, icon-svg: PetuniaIcons.select-face, label: Tr.t("sl.face"), shortcut: root.shortcuts.select-face, description: Tr.t("sl.select_and_transform_polygonal_planar_faces") },
                                ]: ViewportBarButton {
                                    icon: domain.icon;
                                    icon-svg: domain.icon-svg;
                                    label: domain.label;
                                    shortcut: domain.shortcut;
                                    description: domain.description;
                                    active: selection-domain == domain.id;
                                    emphasized: true;
                                    clicked => { root.selection-domain-changed(domain.id); }
                                }
                            }
                            if active-workspace == "MODEL" || active-workspace == "PAINT": Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }

                            // CENTER — pivô, snap e edição proporcional (modelagem).
                            if active-workspace == "MODEL" && root.viewport-region-width >= 600: HorizontalLayout {
                                spacing: 3px;
                                IconButton {
                                    icon: IconSet.Crosshair;
                                    variant: "toggle";
                                    semantic-label: "\{root.label-model-pivot}: \{root.pivot-label}";
                                    shortcut: root.shortcuts.view-pivot;
                                    description: Tr.t("sl.change_pivot_point_origin_for_transformation");
                                    active: root.pivot-menu-open;
                                    clicked => { root.pivot-menu-toggled(!root.pivot-menu-open); }
                                }
                                if root.viewport-region-width >= 680: IconButton {
                                    icon: IconSet.Magnet;
                                    variant: "toggle";
                                    semantic-label: root.snap-enabled ? Tr.t("sl.snap_2") + " (\{root.snap-target})" : Tr.t("sl.snap_2");
                                    shortcut: root.shortcuts.view-snap;
                                    description: Tr.t("sl.snap_transformations_to_grid_intervals_verti");
                                    active: root.snap-enabled;
                                    clicked => { root.toggle-snap-enabled(); }
                                }
                                if root.viewport-region-width >= 750: IconButton {
                                    icon: IconSet.CircleDot;
                                    variant: "toggle";
                                    semantic-label: root.proportional-editing ? Tr.t("sl.prop") + " (\{round(root.proportional-radius * 10) / 10})" : Tr.t("sl.prop");
                                    shortcut: root.shortcuts.view-prop;
                                    description: Tr.t("sl.smoothly_deform_neighboring_vertices_with_pr");
                                    active: root.proportional-editing;
                                    clicked => { root.toggle-proportional-editing(); }
                                }
                                Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }
                            }

                            // RIGHT — câmera e sombreamento.
                            IconButton {
                                icon: IconSet.Camera;
                                label: is-orthographic ? Tr.t("sl.ortho") : Tr.t("sl.persp");
                                semantic-label: Tr.t("sl.projection");
                                shortcut: root.shortcuts.view-proj;
                                description: Tr.t("sl.toggle_between_perspective_3d_projection_and");
                                clicked => { root.toggle-projection-requested(); }
                            }
                            IconButton {
                                icon: IconSet.Maximize2;
                                semantic-label: Tr.t("sl.frame");
                                shortcut: root.shortcuts.view-frame;
                                description: Tr.t("sl.frame_and_center_camera_view_on_currently_se");
                                clicked => { root.command-executed("view.frame_selection"); }
                            }
                            Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }
                            // Sombreamento num só botão (mostra o modo atual); modos e X-Ray ficam
                            // no popover (plano de UI F0/§11: menos controles em repouso).
                            ViewportSvgButton {
                                glyph: root.shading-mode == "wireframe" ? PetuniaIcons.view-wire : (root.shading-mode == "material" ? PetuniaIcons.view-material : (root.shading-mode == "rendered" ? PetuniaIcons.view-lit : PetuniaIcons.view-solid));
                                label: Tr.t("sl.shading_options");
                                description: Tr.t("sl.configure_studio_matcaps_cavity_highlights_a");
                                active: root.shading-popover-open || root.show-xray;
                                clicked => { root.shading-popover-toggled(!root.shading-popover-open); }
                            }
                        }
                    }

                    // Pílula de Ferramenta Ativa e Modo de Operação (Feedback visual contínuo)
                    if !root.measure-visible && active-workspace == "MODEL" && (root.tool-modal-active || root.active-tool == "extrude" || root.active-tool == "bevel" || root.active-tool == "inset" || root.active-tool == "push_pull" || root.active-tool == "cut" || root.active-tool == "loop_cut" || root.active-tool == "slice" || root.active-tool == "move" || root.active-tool == "rotate" || root.active-tool == "scale"): Rectangle {
                        width: min(parent.width - 40px, active-tool-hud-row.preferred-width + 24px);
                        x: (parent.width - self.width) / 2;
                        y: 58px;
                        height: 28px;
                        border-radius: 14px;
                        background: DesignTokens.hud-surface;
                        border-width: 1px;
                        border-color: root.is-instant-tool-mode ? DesignTokens.accent : DesignTokens.border;
                        drop-shadow-blur: DesignTokens.elevation-1-blur;
                        drop-shadow-color: DesignTokens.elevation-1-color;

                        active-tool-hud-row := HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: root.tool-modal-active ? root.tool-modal-title : (root.tool-options-title != "" ? root.tool-options-title : root.active-tool);
                                color: DesignTokens.accent;
                                font-size: DesignTokens.font-small;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle {
                                border-radius: 3px;
                                background: root.is-instant-tool-mode ? DesignTokens.accent : DesignTokens.surface-raised;
                                border-width: 1px;
                                border-color: root.is-instant-tool-mode ? DesignTokens.accent : DesignTokens.border;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    Text {
                                        text: root.is-instant-tool-mode ? Tr.t("sl.free_mode") : Tr.t("sl.card_gizmo");
                                        color: root.is-instant-tool-mode ? DesignTokens.on-accent : DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: root.active-tool == "slice"
                                    ? "Arraste o corte · T: Trim/Split · Enter/Clique Confirma · Esc Cancela"
                                    : (root.is-instant-tool-mode
                                        ? "Mova o mouse · LMB/Enter Confirma · RMB/Esc Cancela"
                                        : "2 Toques no atalho: Modo Livre · Enter Confirma");
                                color: DesignTokens.text-muted;
                                font-size: DesignTokens.font-caption;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Pílula Flutuante de Medição / Dimensões (Centro: Resumo HUD no Topo)
                    if root.measure-visible && root.measure-hud-text != "" && active-workspace == "MODEL": Rectangle {
                        width: min(parent.width - 40px, measure-hud-row.preferred-width + 24px);
                        x: (parent.width - self.width) / 2;
                        y: 58px;
                        height: 26px;
                        border-radius: 6px;
                        background: DesignTokens.hud-surface;
                        border-width: 1px;
                        border-color: DesignTokens.measure.with-alpha(0.53);
                        drop-shadow-blur: DesignTokens.elevation-1-blur;
                        drop-shadow-color: DesignTokens.elevation-1-color;
                        drop-shadow-offset-y: DesignTokens.elevation-1-offset;

                        measure-hud-row := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            IconDisplay {
                                icon: IconSet.ArrowUpDown;
                                size: 12px;
                                stroke: DesignTokens.measure;
                            }

                            Text {
                                text: root.measure-hud-text;
                                color: DesignTokens.measure;
                                font-size: DesignTokens.font-small;
                                font-weight: 700;
                                font-family: "monospace";
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Barra de transporte: interativa, então fica DEPOIS do
                    // `viewport-touch` (irmãos posteriores recebem o clique antes).
                    if root.active-workspace == "ANIMATE" && root.animate-has-creature: AnimateTransport {
                        // Centrada na parte livre da viewport (fora do painel aberto)
                        // e ACIMA da barra contextual (40px + 14px de margem + respiro).
                        x: (parent.width - root.right-clearance - self.width) / 2;
                        y: parent.height - self.height - 64px;
                        width: min(640px, parent.width - root.right-clearance - 32px);
                        texts: root.animate-texts;
                        playing: root.animate-playing;
                        has-motion: root.animate-has-motion;
                        progress: root.animate-progress;
                        time-label: root.animate-time-label;
                        action(a, b, v) => { root.animate-action(a, b, v); }
                    }

                    // Tool Cards dedicados por ferramenta (Decisões D5, D6, D7)
                    if loop-cut-active || loop-cut-armed: ToolCard {
                        x: 14px;
                        y: 58px;
                        title: Tr.t("sl.loop_cut");
                        collapsed: root.tool-properties-collapsed;
                        collapse-toggled => { root.tool-properties-collapsed = !root.tool-properties-collapsed; }

                        if loop-cut-active: HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Text { text: Tr.t("sl.slide"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-small; width: 44px; vertical-alignment: center; }
                            NumericField {
                                label: "";
                                value: root.loop-cut-slide;
                                horizontal-stretch: 1;
                                step: 0.01;
                                scrubbed(delta, fine) => { root.loop-cut-slide-committed("\{root.loop-cut-slide + delta * (fine ? 0.001 : 0.01)}"); }
                                scrub-cancelled(value) => { root.loop-cut-slide-committed("\{value}"); }
                                text-committed(text) => { root.loop-cut-slide-committed(text); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Text { text: Tr.t("sl.cuts"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-small; width: 44px; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                Text {
                                    text: "\{root.loop-cut-cuts}";
                                    color: DesignTokens.text-primary;
                                    font-size: DesignTokens.font-small;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.loop-cut-count-committed("\{max(1, root.loop-cut-cuts - 1)}"); } }
                            }
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.loop-cut-count-committed("\{root.loop-cut-cuts + 1}"); } }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: root.loop-cut-balanced ? DesignTokens.accent : DesignTokens.surface;
                                border-width: 1px;
                                border-color: root.loop-cut-balanced ? DesignTokens.accent : DesignTokens.border;
                                Text {
                                    text: root.loop-cut-balanced ? Tr.t("sl.dual_balanced_on") : Tr.t("sl.dual_balanced_off");
                                    color: root.loop-cut-balanced ? DesignTokens.on-accent : DesignTokens.text-primary;
                                    font-size: DesignTokens.font-caption;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea { clicked => { root.toggle-loop-cut-balanced(); } }
                            }
                        }

                        Text {
                            text: loop-cut-active ? Tr.t("sl.enter_confirm_esc_cancel_drag_slide") : Tr.t("sl.click_edge_to_cut_scroll_to_adjust_cuts");
                            color: DesignTokens.text-muted;
                            font-size: DesignTokens.font-caption;
                        }

                        if loop-cut-active: HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                Text { text: root.label-cancel; color: DesignTokens.text-primary; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.loop-cut-cancel(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: DesignTokens.accent;
                                Text { text: root.label-apply; color: DesignTokens.on-accent; font-size: DesignTokens.font-small; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.loop-cut-apply(); } }
                            }
                        }
                    }

                    if tool-modal-active && !loop-cut-active && !loop-cut-armed: ToolCard {
                        x: 14px;
                        y: 58px;
                        title: root.tool-modal-title;
                        collapsed: root.tool-properties-collapsed;
                        collapse-toggled => { root.tool-properties-collapsed = !root.tool-properties-collapsed; }

                        if root.tool-modal-id == "extrude" || root.tool-modal-id == "extrude_individual": VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 4px;
                                height: 24px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.tool-modal-id == "extrude" ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: root.tool-modal-id == "extrude" ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: Tr.t("sl.region");
                                        color: root.tool-modal-id == "extrude" ? DesignTokens.on-accent : DesignTokens.text-primary;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            if root.tool-modal-id == "extrude_individual" {
                                                root.tool-modal-toggle-extrude-mode();
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.tool-modal-id == "extrude_individual" ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: root.tool-modal-id == "extrude_individual" ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: Tr.t("sl.individual");
                                        color: root.tool-modal-id == "extrude_individual" ? DesignTokens.on-accent : DesignTokens.text-primary;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            if root.tool-modal-id == "extrude" {
                                                root.tool-modal-toggle-extrude-mode();
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                height: 22px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+0.2"; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.tool-modal-text-committed("0.2"); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+0.5"; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.tool-modal-text-committed("0.5"); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+1.0"; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.tool-modal-text-committed("1.0"); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: Tr.t("sl.invert"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.tool-modal-text-committed("\{-root.tool-modal-value}"); } }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Text {
                                text: root.tool-modal-label;
                                color: DesignTokens.text-secondary;
                                font-size: DesignTokens.font-small;
                                width: 56px;
                                vertical-alignment: center;
                            }
                            NumericField {
                                label: "";
                                value: root.tool-modal-value;
                                horizontal-stretch: 1;
                                step: root.tool-modal-step;
                                scrubbed(delta, fine) => { root.tool-modal-text-committed("\{root.tool-modal-value + delta * root.tool-modal-step * (fine ? 0.1 : 1)}"); }
                                scrub-cancelled(value) => { root.tool-modal-text-committed("\{value}"); }
                                text-committed(text) => { root.tool-modal-text-committed(text); }
                            }
                        }

                        Text {
                            text: Tr.t("sl.enter_confirm_esc_cancel");
                            color: DesignTokens.text-muted;
                            font-size: DesignTokens.font-caption;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                Text { text: root.label-cancel; color: DesignTokens.text-primary; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.tool-modal-cancel(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: DesignTokens.accent;
                                Text { text: root.label-apply; color: DesignTokens.on-accent; font-size: DesignTokens.font-small; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.tool-modal-apply(); } }
                            }
                        }
                    }

                    if profile-active && !tool-modal-active && !loop-cut-active && !loop-cut-armed: ToolCard {
                        x: 14px;
                        y: 58px;
                        title: root.label-model-profile;
                        collapsed: root.tool-properties-collapsed;
                        collapse-toggled => { root.tool-properties-collapsed = !root.tool-properties-collapsed; }

                        HorizontalLayout {
                            spacing: 4px;
                            height: 24px;
                            Text { text: root.label-profile-plane; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 44px; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px;
                                background: !root.profile-workplane-locked ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
                                border-width: 1px; border-color: !root.profile-workplane-locked ? DesignTokens.accent : DesignTokens.border;
                                Text { text: root.label-profile-plane-auto; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
                                TouchArea { clicked => { root.profile-set-workplane-auto(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px;
                                background: root.profile-workplane-locked && root.profile-workplane == "Ground" ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
                                border-width: 1px; border-color: root.profile-workplane-locked && root.profile-workplane == "Ground" ? DesignTokens.accent : DesignTokens.border;
                                Text { text: root.label-profile-plane-ground; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
                                TouchArea { clicked => { root.profile-set-workplane-ground(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px;
                                background: root.profile-workplane-locked && root.profile-workplane == "Face" ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
                                border-width: 1px; border-color: root.profile-workplane-locked && root.profile-workplane == "Face" ? DesignTokens.accent : DesignTokens.border;
                                Text { text: root.label-profile-plane-face; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
                                TouchArea { clicked => { root.profile-set-workplane-face(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px;
                                background: root.profile-workplane-locked && root.profile-workplane == "View" ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
                                border-width: 1px; border-color: root.profile-workplane-locked && root.profile-workplane == "View" ? DesignTokens.accent : DesignTokens.border;
                                Text { text: root.label-profile-plane-view; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
                                TouchArea { clicked => { root.profile-set-workplane-view(); } }
                            }
                        }

                        Rectangle {
                            height: 24px; border-radius: 4px; background: DesignTokens.surface;
                            border-width: 1px; border-color: DesignTokens.border;
                            Text { text: root.label-profile-look-at-plane; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.profile-look-at-plane(); } }
                        }

                        NumericField {label:Tr.t("extensions.threshold");value:root.trace-threshold;step:1;
                            text-committed(text)=>{return root.extension-parameter-set("threshold",text);}
                            scrubbed(delta,fine)=>{root.extension-parameter-set("threshold","\{root.trace-threshold+delta*(fine?0.1:1)}");}
                        }
                        NumericField { label: Tr.t("extensions.radius"); value: root.extension-radius; step: 0.01; scrubbed(delta,fine) => { root.extension-parameter-set("radius","\{root.extension-radius + delta * 0.01 * (fine ? 0.1 : 1)}"); } text-committed(text) => { return root.extension-parameter-set("radius",text); } }
                        NumericField { label: Tr.t("extensions.length"); value: root.extension-length; step: 0.01; scrubbed(delta,fine) => { root.extension-parameter-set("length","\{root.extension-length + delta * 0.01 * (fine ? 0.1 : 1)}"); } text-committed(text) => { return root.extension-parameter-set("length",text); } }
                        NumericField { label: Tr.t("extensions.angle"); value: root.extension-angle; step: 1; scrubbed(delta,fine) => { root.extension-parameter-set("angle","\{root.extension-angle + delta * 1 * (fine ? 0.1 : 1)}"); } text-committed(text) => { return root.extension-parameter-set("angle",text); } }
                        NumericField { label: Tr.t("extensions.sides"); value: root.extension-sides; step: 1; scrubbed(delta,fine) => { root.extension-parameter-set("sides","\{root.extension-sides + delta * 1 * (fine ? 0.1 : 1)}"); } text-committed(text) => { return root.extension-parameter-set("sides",text); } }
                        NumericField { label: Tr.t("extensions.tolerance"); value: root.extension-tolerance; step: 0.001; scrubbed(delta,fine) => { root.extension-parameter-set("tolerance","\{root.extension-tolerance + delta * 0.001 * (fine ? 0.1 : 1)}"); } text-committed(text) => { return root.extension-parameter-set("tolerance",text); } }
                        Text { text: "\{root.label-profile-points}: \{root.profile-point-count}"; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; }
                        if !root.profile-closed: Rectangle {
                            height: 26px; border-radius: 4px; background: DesignTokens.surface;
                            border-width: 1px; border-color: DesignTokens.border;
                            Text { text: root.label-profile-close; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.profile-close(); } }
                        }
                        if root.profile-parametric: VerticalLayout {
                            spacing: 5px;
                            NumericField { label: Tr.t("sl.width"); value: root.profile-width; step: 0.1;
                                scrub-started => { root.profile-dimension-gesture(0); }
                                scrub-finished => { root.profile-dimension-gesture(1); }
                                scrub-cancelled(value) => { root.profile-dimension-gesture(2); }
                                text-committed(text) => { return root.profile-dimension-set("width",text); }
                                scrubbed(delta,fine) => { root.profile-dimension-set("width","\{root.profile-width + delta * (fine ? 0.01 : 0.1)}"); }
                            }
                            NumericField { label: Tr.t("sl.height"); value: root.profile-height; step: 0.1;
                                scrub-started => { root.profile-dimension-gesture(0); }
                                scrub-finished => { root.profile-dimension-gesture(1); }
                                scrub-cancelled(value) => { root.profile-dimension-gesture(2); }
                                text-committed(text) => { return root.profile-dimension-set("height",text); }
                                scrubbed(delta,fine) => { root.profile-dimension-set("height","\{root.profile-height + delta * (fine ? 0.01 : 0.1)}"); }
                            }
                            if root.profile-ellipse: NumericField { label: Tr.t("extensions.sides"); value: root.profile-segments; step: 1;
                                text-committed(text) => { return root.profile-dimension-set("segments",text); }
                            }
                        }
                        if root.profile-closed: HorizontalLayout {
                            spacing: 5px; height: 28px;
                            Text { text: root.label-profile-depth; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 56px; vertical-alignment: center; }
                            NumericField {
                                label: ""; value: root.profile-depth; horizontal-stretch: 1; step: 0.1;
                                text-committed(text) => { root.profile-depth-set(text); }
                                scrubbed(delta, fine) => { root.profile-depth-set("\{root.profile-depth + delta * (fine ? 0.01 : 0.1)}"); }
                            }
                        }
                        if root.profile-closed: HorizontalLayout {
                            spacing: 5px; height: 28px;
                            Text { text: root.label-profile-wall-thickness; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 80px; vertical-alignment: center; }
                            NumericField {
                                label: ""; value: root.profile-wall-thickness; horizontal-stretch: 1; step: 0.05;
                                text-committed(text) => { root.profile-wall-thickness-set(text); }
                                scrubbed(delta, fine) => { root.profile-wall-thickness-set("\{root.profile-wall-thickness + delta * (fine ? 0.01 : 0.05)}"); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 5px; height: 26px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px;
                                background: root.profile-has-curves ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface;
                                border-width: 1px; border-color: root.profile-has-curves ? DesignTokens.accent : DesignTokens.border;
                                Text {
                                    text: root.profile-has-curves ? root.label-profile-sharp-corners : root.label-profile-smooth-curves;
                                    color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        if root.profile-has-curves {
                                            root.profile-clear-curves();
                                        } else {
                                            root.profile-smooth-curves();
                                        }
                                    }
                                }
                            }
                        }
                        if root.profile-has-curves: HorizontalLayout {
                            spacing: 5px; height: 28px;
                            Text { text: root.label-profile-smoothness; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 80px; vertical-alignment: center; }
                            NumericField {
                                label: ""; value: root.profile-smoothness; horizontal-stretch: 1; step: 0.01;
                                text-committed(text) => { root.profile-smoothness-set(text); }
                                scrubbed(delta, fine) => { root.profile-smoothness-set("\{root.profile-smoothness + delta * (fine ? 0.002 : 0.01)}"); }
                            }
                        }
                        if root.profile-volume-mode == "none" && root.profile-point-count >= 2: HorizontalLayout {
                            spacing: 5px; height: 28px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                Text { text: root.label-profile-revolve; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.profile-enter-revolve(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                Text { text: root.label-profile-sweep; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.profile-enter-sweep(); } }
                            }
                            if root.profile-closed: Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.accent;
                                Text { text: root.label-profile-generate; color: DesignTokens.on-accent; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.profile-generate(); } }
                            }
                        }
                        if root.profile-volume-mode != "none": VerticalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 24px; border-radius: 4px; background: DesignTokens.accent.transparentize(0.85);
                                border-width: 1px; border-color: DesignTokens.accent;
                                Text {
                                    text: root.profile-volume-mode == "extrude" ? Tr.t("sl.extrude_preview_live") :
                                          (root.profile-volume-mode == "revolve" ? "Revolve Preview (Live)" : "Sweep Preview (Live)");
                                    color: DesignTokens.accent; font-size: DesignTokens.font-caption; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            if root.profile-volume-mode == "revolve": HorizontalLayout {
                                spacing: 5px; height: 28px;
                                Text { text: Tr.t("sl.angle"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 56px; vertical-alignment: center; }
                                NumericField {
                                    label: ""; value: root.profile-revolve-angle; horizontal-stretch: 1; step: 5.0;
                                    text-committed(text) => { root.profile-revolve-angle-set(text); }
                                    scrubbed(delta, fine) => { root.profile-revolve-angle-set("\{root.profile-revolve-angle + delta * (fine ? 1.0 : 5.0)}"); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px; height: 28px;
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.accent;
                                    Text { text: Tr.t("sl.confirm_enter"); color: DesignTokens.on-accent; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.profile-volume-confirm(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                    Text { text: Tr.t("sl.cancel_esc"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.profile-volume-cancel(); } }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 5px; height: 26px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                Text { text: root.label-profile-add-rect; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.add-profile-rectangle(2.0, 1.0); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                Text { text: root.label-profile-add-circle; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.add-profile-circle(1.0, 16); } }
                            }
                        }
                        Text { text: root.hint-model-profile; color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                    }

                    if operation-hud-active && !tool-modal-active && !loop-cut-active && !loop-cut-armed && !profile-active: ToolCard {
                        x: 14px;
                        y: 58px;
                        title: root.operation-hud-title;
                        collapsed: false;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: root.operation-hud-subject;
                                color: DesignTokens.accent;
                                font-size: DesignTokens.font-small;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        for line in root.operation-hud-lines: Text {
                            text: line;
                            color: DesignTokens.text-primary;
                            font-size: DesignTokens.font-default;
                            font-weight: 600;
                            font-family: "monospace";
                        }
                        if root.operation-hud-hint != "": Text {
                            text: root.operation-hud-hint;
                            color: DesignTokens.text-muted;
                            font-size: DesignTokens.font-caption;
                            wrap: word-wrap;
                        }
                    }

                    if primitive-active && !tool-modal-active && !loop-cut-active && !loop-cut-armed && !profile-active: ToolCard {
                        x: 14px;
                        y: 58px;
                        title: root.primitive-title != "" ? root.primitive-title : Tr.t("sl.primitive_properties");
                        collapsed: false;

                        if root.primitive-kind == "box" || root.primitive-kind == "wedge": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: Tr.t("sl.width"); value: root.primitive-width; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("width", root.primitive-width + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("width", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.height"); value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.depth"); value: root.primitive-depth; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("depth", root.primitive-depth + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("depth", t.to-float()); true } }
                        }

                        if root.primitive-kind == "plane": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: Tr.t("sl.width"); value: root.primitive-width; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("width", root.primitive-width + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("width", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.height"); value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                        }

                        if root.primitive-kind == "cylinder": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: Tr.t("sl.radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.height"); value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.sides"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            HorizontalLayout {
                                spacing: 4px; height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px;
                                    background: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px; border-color: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.border;
                                    Text { text: root.primitive-cap-top ? Tr.t("sl.top_cap_on") : Tr.t("sl.top_cap_off"); color: root.primitive-cap-top ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.primitive-param-bool("cap_top", !root.primitive-cap-top); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px;
                                    background: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px; border-color: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.border;
                                    Text { text: root.primitive-cap-bottom ? Tr.t("sl.bottom_cap_on") : Tr.t("sl.bottom_cap_off"); color: root.primitive-cap-bottom ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.primitive-param-bool("cap_bottom", !root.primitive-cap-bottom); } }
                                }
                            }
                        }

                        if root.primitive-kind == "cone": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: Tr.t("sl.bottom_radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.top_radius"); value: root.primitive-radius-b; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius_b", root.primitive-radius-b + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius_b", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.height"); value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.sides"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            HorizontalLayout {
                                spacing: 4px; height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px;
                                    background: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px; border-color: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.border;
                                    Text { text: root.primitive-cap-bottom ? Tr.t("sl.base_cap_on") : Tr.t("sl.base_cap_off"); color: root.primitive-cap-bottom ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.primitive-param-bool("cap_bottom", !root.primitive-cap-bottom); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px;
                                    background: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px; border-color: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.border;
                                    Text { text: root.primitive-cap-top ? Tr.t("sl.top_cap_on") : Tr.t("sl.top_cap_off"); color: root.primitive-cap-top ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.primitive-param-bool("cap_top", !root.primitive-cap-top); } }
                                }
                            }
                        }

                        if root.primitive-kind == "sphere": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: Tr.t("sl.radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.segments"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.rings"); value: root.primitive-rings; step: 1; scrubbed(d, f) => { root.primitive-param-float("rings", root.primitive-rings + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("rings", t.to-float()); true } }
                        }

                        if root.primitive-kind == "icosphere": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: Tr.t("sl.radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.subdivisions"); value: root.primitive-subdiv; step: 1; scrubbed(d, f) => { root.primitive-param-float("subdiv", root.primitive-subdiv + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("subdiv", t.to-float()); true } }
                        }

                        if root.primitive-kind == "torus": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: Tr.t("sl.ring_radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.pipe_radius"); value: root.primitive-radius-b; step: 0.05; scrubbed(d, f) => { root.primitive-param-float("radius_b", root.primitive-radius-b + d * (f ? 0.005 : 0.05)); } text-committed(t) => { root.primitive-param-float("radius_b", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.ring_segments"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.pipe_segments"); value: root.primitive-rings; step: 1; scrubbed(d, f) => { root.primitive-param-float("rings", root.primitive-rings + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("rings", t.to-float()); true } }
                        }

                        if root.primitive-kind == "capsule": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: Tr.t("sl.radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.height"); value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.sides"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.cap_rings"); value: root.primitive-rings; step: 1; scrubbed(d, f) => { root.primitive-param-float("rings", root.primitive-rings + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("rings", t.to-float()); true } }
                        }

                        if root.primitive-kind == "circle": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: Tr.t("sl.radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: Tr.t("sl.vertices"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            Rectangle {
                                height: 26px; border-radius: 4px;
                                background: root.primitive-fill-disc ? DesignTokens.accent : DesignTokens.surface-raised;
                                border-width: 1px; border-color: root.primitive-fill-disc ? DesignTokens.accent : DesignTokens.border;
                                Text { text: root.primitive-fill-disc ? Tr.t("sl.fill_disc") : Tr.t("sl.fill_open_loop"); color: root.primitive-fill-disc ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.primitive-param-bool("fill_disc", !root.primitive-fill-disc); } }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 26px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                Text { text: Tr.t("sl.cancel"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.primitive-cancel(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.accent;
                                Text { text: Tr.t("sl.confirm"); color: DesignTokens.on-accent; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.primitive-confirm(); } }
                            }
                        }
                        Text { text: Tr.t("sl.enter_confirm_esc_cancel"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; }
                    }

                    if !tool-modal-active && !loop-cut-active && !loop-cut-armed && !profile-active && !operation-hud-active && !primitive-active && ((root.active-workspace == "PAINT" && root.last-operation-active) || root.active-tool == "move" || root.active-tool == "rotate" || root.active-tool == "scale" || root.active-tool == "extrude" || root.active-tool == "inset" || root.active-tool == "push_pull" || root.active-tool == "cut" || root.active-tool == "slice" || root.active-tool == "bevel" || root.active-tool == "cursor" || root.active-tool == "cursor_3d" || root.active-tool == "poly_pen"): ToolCard {
                        x: 14px;
                        y: 58px;
                        title: root.tool-options-title != "" ? root.tool-options-title : Tr.t("sl.tool_options");
                        collapsed: root.tool-properties-collapsed;
                        collapse-toggled => { root.tool-properties-collapsed = !root.tool-properties-collapsed; }

                        // Última operação (constituição 11): o valor do gesto confirmado
                        // continua ajustável aqui, dentro da mesma entrada de Undo.
                        if root.last-operation-active: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.label-last-operation + " · " + root.last-operation-title;
                                color: DesignTokens.text-secondary;
                                font-size: DesignTokens.font-caption;
                                font-weight: 600;
                            }
                            NumericField {
                                label: root.last-operation-unit != "" ? root.last-operation-unit : "#";
                                full-label: root.label-last-operation + " — " + root.last-operation-title;
                                hint: root.label-last-operation-hint;
                                value: root.last-operation-value;
                                step: root.last-operation-step;
                                label-color: DesignTokens.accent;
                                text-committed(text) => { root.last-operation-committed(text) }
                            }
                        }

                        // Modos do Poly Pen (cap. 46 §4).
                        if root.active-tool == "poly_pen": VerticalLayout {
                            spacing: 6px;
                            Text { text: root.label-poly-pen-mode; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 4px;
                                BrushChip { label: root.label-poly-pen-mode-auto; active: root.poly-pen-mode == "auto"; clicked => { root.poly-pen-mode-selected("auto"); } }
                                BrushChip { label: root.label-poly-pen-mode-points; active: root.poly-pen-mode == "points"; clicked => { root.poly-pen-mode-selected("points"); } }
                                BrushChip { label: root.label-poly-pen-mode-edges; active: root.poly-pen-mode == "edges"; clicked => { root.poly-pen-mode-selected("edges"); } }
                                BrushChip { label: root.label-poly-pen-mode-polygons; active: root.poly-pen-mode == "polygons"; clicked => { root.poly-pen-mode-selected("polygons"); } }
                            }
                            Text { text: root.label-poly-pen-mode-hint; color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                        }

                        if root.active-tool == "extrude": VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 4px;
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.accent;
                                    Text { text: Tr.t("sl.extrude_region_e"); color: DesignTokens.on-accent; font-size: DesignTokens.font-caption; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.command-executed("model.extrude"); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: Tr.t("sl.individual_alt_e"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.command-executed("model.extrude_individual"); } }
                                }
                            }
                            Text { text: Tr.t("sl.click_and_drag_or_press_e_alt_e_to_extrude_s"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                        }

                        // Common adjustments row (Snap, Proportional Editing and Pivot) / Linha de ajustes comuns (Snap, Proportional Editing e Pivot)
                        if root.active-tool == "move" || root.active-tool == "rotate" || root.active-tool == "scale": HorizontalLayout {
                            spacing: 4px;
                            height: 24px;

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: root.snap-enabled ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface;
                                border-width: 1px;
                                border-color: root.snap-enabled ? DesignTokens.accent : DesignTokens.border;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    IconDisplay {
                                        icon: IconSet.Magnet;
                                        size: 11px;
                                        stroke: root.snap-enabled ? DesignTokens.accent : DesignTokens.text-secondary;
                                    }
                                    Text {
                                        text: root.snap-enabled ? root.snap-target : Tr.t("sl.snap_2");
                                        color: root.snap-enabled ? DesignTokens.accent : DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.toggle-snap-enabled(); } }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: root.proportional-editing ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface;
                                border-width: 1px;
                                border-color: root.proportional-editing ? DesignTokens.accent : DesignTokens.border;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    IconDisplay {
                                        icon: IconSet.CircleDot;
                                        size: 11px;
                                        stroke: root.proportional-editing ? DesignTokens.accent : DesignTokens.text-secondary;
                                    }
                                    Text {
                                        text: root.proportional-editing ? "\{round(root.proportional-radius * 10) / 10}" : Tr.t("sl.prop");
                                        color: root.proportional-editing ? DesignTokens.accent : DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.toggle-proportional-editing(); } }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: root.pivot-menu-open ? DesignTokens.surface-raised : DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.pivot-label != "" ? root.pivot-label : Tr.t("sl.pivot");
                                        color: DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-caption;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.pivot-menu-toggled(!root.pivot-menu-open); } }
                            }
                        }

                        if root.active-tool == "move": Vector3Field {
                            row-label: Tr.t("sl.position");
                            field-hint: root.label-numeric-field-hint;
                            x-value: root.pos-x;
                            y-value: root.pos-y;
                            z-value: root.pos-z;
                            scrubbed(axis, delta, fine) => { root.transform-scrubbed("pos", axis, delta, fine); }
                            scrub-started => { root.transform-scrub-started("pos"); }
                            scrub-finished => { root.transform-scrub-finished(); }
                            text-committed(axis, text) => { root.transform-text-committed("pos", axis, text) }
                            scrub-cancelled => { root.transform-scrub-cancelled(); }
                        }

                        if root.active-tool == "rotate": VerticalLayout {
                            spacing: 6px;
                            Vector3Field {
                                row-label: Tr.t("sl.rotation");
                                field-hint: root.label-numeric-field-hint;
                                step: 1;
                                x-value: root.rot-x;
                                y-value: root.rot-y;
                                z-value: root.rot-z;
                                scrubbed(axis, delta, fine) => { root.transform-scrubbed("rot", axis, delta, fine); }
                                scrub-started => { root.transform-scrub-started("rot"); }
                                scrub-finished => { root.transform-scrub-finished(); }
                                text-committed(axis, text) => { root.transform-text-committed("rot", axis, text) }
                                scrub-cancelled => { root.transform-scrub-cancelled(); }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                height: 22px;
                                Text { text: Tr.t("sl.step_90"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+90° X"; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.transform-scrubbed("rot", 0, 90, false); root.transform-scrub-finished(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+90° Y"; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.transform-scrubbed("rot", 1, 90, false); root.transform-scrub-finished(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+90° Z"; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.transform-scrubbed("rot", 2, 90, false); root.transform-scrub-finished(); } }
                                }
                            }
                        }

                        if root.active-tool == "scale": Vector3Field {
                            row-label: Tr.t("sl.scale");
                            field-hint: root.label-numeric-field-hint;
                            x-value: root.scale-x;
                            y-value: root.scale-y;
                            z-value: root.scale-z;
                            scrubbed(axis, delta, fine) => { root.transform-scrubbed("scale", axis, delta, fine); }
                            scrub-started => { root.transform-scrub-started("scale"); }
                            scrub-finished => { root.transform-scrub-finished(); }
                            text-committed(axis, text) => { root.transform-text-committed("scale", axis, text) }
                            scrub-cancelled => { root.transform-scrub-cancelled(); }
                        }

                        if root.active-tool == "cut": VerticalLayout {
                            spacing: 6px;
                            Text { text: Tr.t("sl.click_vertices_or_edges_to_draw_cut_path"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 6px;
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: root.label-cancel; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.command-executed("model.knife_cancel"); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.accent;
                                    Text { text: Tr.t("sl.cut"); color: DesignTokens.on-accent; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.command-executed("model.knife_apply"); } }
                                }
                            }
                            Text { text: Tr.t("sl.enter_confirm_esc_cancel"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; }
                        }

                        if root.active-tool == "slice": VerticalLayout {
                            spacing: 6px;
                            Text { text: Tr.t("sl.drag_a_cut_line_across_the_mesh_to_bisect"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 4px;
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: !root.slice-trim ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: !root.slice-trim ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: Tr.t("sl.split_t");
                                        color: !root.slice-trim ? DesignTokens.on-accent : DesignTokens.text-primary;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: !root.slice-trim ? 700 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.slice-trim-set(false); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.slice-trim ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: root.slice-trim ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: Tr.t("sl.trim_t");
                                        color: root.slice-trim ? DesignTokens.on-accent : DesignTokens.text-primary;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: root.slice-trim ? 700 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.slice-trim-set(true); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: root.label-cancel; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.slice-cancel(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.accent;
                                    Text { text: Tr.t("sl.confirm_cut"); color: DesignTokens.on-accent; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.slice-confirm(); } }
                                }
                            }
                            Text { text: Tr.t("sl.enter_confirm_esc_cancel_t_toggle_trim"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                        }

                        if root.active-tool == "bevel": VerticalLayout {
                            spacing: 6px;
                            Text { text: Tr.t("sl.round_edge_bevel_options"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                            HorizontalLayout {
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.bevel-clamp-overlap ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: root.bevel-clamp-overlap ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: root.bevel-clamp-overlap ? Tr.t("sl.clamp_overlap_active") : Tr.t("sl.clamp_overlap_off");
                                        color: root.bevel-clamp-overlap ? DesignTokens.accent : DesignTokens.text-primary;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: root.bevel-clamp-overlap ? 700 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.toggle-bevel-clamp-overlap(); } }
                                }
                            }
                            HorizontalLayout {
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.bevel-affect-vertices ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: root.bevel-affect-vertices ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: root.bevel-affect-vertices ? Tr.t("sl.point_vertex_mode") : Tr.t("sl.point_mode_off");
                                        color: root.bevel-affect-vertices ? DesignTokens.accent : DesignTokens.text-primary;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: root.bevel-affect-vertices ? 700 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.toggle-bevel-affect-vertices(); } }
                                }
                            }
                        }

                        if root.active-tool == "cursor" || root.active-tool == "cursor_3d": VerticalLayout {
                            spacing: 6px;
                            Vector3Field {
                                row-label: Tr.t("sl.cursor");
                                field-hint: root.label-numeric-field-hint;
                                x-value: root.cursor-x;
                                y-value: root.cursor-y;
                                z-value: root.cursor-z;
                                scrubbed(axis, delta, fine) => {
                                    root.cursor-coord-committed(axis, (axis == 0 ? root.cursor-x : (axis == 1 ? root.cursor-y : root.cursor-z)) + delta * (fine ? 0.01 : 0.1));
                                }
                                text-committed(axis, text) => {
                                    root.cursor-coord-committed(axis, text.to-float());
                                    return true;
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text {
                                        text: Tr.t("sl.focus_camera");
                                        color: DesignTokens.text-primary;
                                        font-size: DesignTokens.font-caption;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.frame-cursor-requested(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text {
                                        text: Tr.t("sl.reset_0_0_0");
                                        color: DesignTokens.text-primary;
                                        font-size: DesignTokens.font-caption;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.reset-cursor-requested(); } }
                                }
                            }
                        }

                        Text {
                            text: (root.active-tool == "cursor" || root.active-tool == "cursor_3d") ? Tr.t("sl.lmb_click_to_place_shift_rmb_in_any_tool") : ((root.active-tool == "move" || root.active-tool == "rotate" || root.active-tool == "scale") ? Tr.t("sl.g_move_r_rotate_s_scale_shift_precision") : "");
                            color: DesignTokens.text-muted;
                            font-size: DesignTokens.font-caption;
                        }
                    }


                    // Gizmo de transformação: hastes curtas de tamanho fixo em
                    // tela, com setas, só com Move/Rotate/Scale. Nunca linhas
                    // infinitas: o padrão é controle de tamanho aparente constante.
                    if gizmo-visible && active-workspace == "MODEL": Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        // Hierarquia do gizmo: o eixo ativo domina, o eixo sob o
                        // cursor clareia, os demais esmaecem durante o arrasto.
                        Path {
                            commands: root.gizmo-x-commands;
                            fit: ImageFit.preserve;
                            stroke: root.gizmo-handle-color(0, DesignTokens.axis-x);
                            stroke-width: root.gizmo-handle-width(0);
                            fill: transparent;
                        }
                        Path {
                            commands: root.gizmo-y-commands;
                            fit: ImageFit.preserve;
                            stroke: root.gizmo-handle-color(1, DesignTokens.axis-y);
                            stroke-width: root.gizmo-handle-width(1);
                            fill: transparent;
                        }
                        Path {
                            commands: root.gizmo-z-commands;
                            fit: ImageFit.preserve;
                            stroke: root.gizmo-handle-color(2, DesignTokens.axis-z);
                            stroke-width: root.gizmo-handle-width(2);
                            fill: transparent;
                        }
                        Path {
                            commands: root.gizmo-x-arrow-commands;
                            fit: ImageFit.preserve;
                            stroke: transparent;
                            fill: root.gizmo-handle-color(0, DesignTokens.axis-x);
                        }
                        Path {
                            commands: root.gizmo-y-arrow-commands;
                            fit: ImageFit.preserve;
                            stroke: transparent;
                            fill: root.gizmo-handle-color(1, DesignTokens.axis-y);
                        }
                        Path {
                            commands: root.gizmo-z-arrow-commands;
                            fit: ImageFit.preserve;
                            stroke: transparent;
                            fill: root.gizmo-handle-color(2, DesignTokens.axis-z);
                        }
                        Path { commands: root.gizmo-x-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(0, DesignTokens.axis-x); }
                        Path { commands: root.gizmo-y-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(1, DesignTokens.axis-y); }
                        Path { commands: root.gizmo-z-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(2, DesignTokens.axis-z); }
                        Path { commands: root.gizmo-x-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(0, DesignTokens.axis-x).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
                        Path { commands: root.gizmo-y-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(1, DesignTokens.axis-y).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
                        Path { commands: root.gizmo-z-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(2, DesignTokens.axis-z).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
                        Path { commands: root.gizmo-plane-yz-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(0, DesignTokens.axis-x); stroke-width: 1px; fill: root.gizmo-handle-color(0, DesignTokens.axis-x).transparentize(0.65); }
                        Path { commands: root.gizmo-plane-xz-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(1, DesignTokens.axis-y); stroke-width: 1px; fill: root.gizmo-handle-color(1, DesignTokens.axis-y).transparentize(0.65); }
                        Path { commands: root.gizmo-plane-xy-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(2, DesignTokens.axis-z); stroke-width: 1px; fill: root.gizmo-handle-color(2, DesignTokens.axis-z).transparentize(0.65); }
                        Path { commands: root.gizmo-view-roll-commands; fit: ImageFit.preserve; stroke: root.gizmo-center-active || root.gizmo-center-hover ? DesignTokens.accent : DesignTokens.text-secondary.transparentize(0.4); stroke-width: 1.5px; fill: transparent; }
                        if !root.gizmo-gpu: Rectangle {
                            x: gizmo-origin-x - 6px;
                            y: gizmo-origin-y - 6px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.gizmo-center-active ? DesignTokens.accent : (root.gizmo-center-hover ? DesignTokens.accent.transparentize(0.2) : DesignTokens.text-primary);
                            border-width: 1.5px;
                            border-color: DesignTokens.canvas;
                        }
                        if root.colorblind-axes: Rectangle {
                            for axis-badge in [
                                { label: "X", x: root.gizmo-x-label-x != 0px ? root.gizmo-x-label-x : root.gizmo-x-end-x, y: root.gizmo-x-label-y != 0px ? root.gizmo-x-label-y : root.gizmo-x-end-y, tint: DesignTokens.axis-x },
                                { label: "Y", x: root.gizmo-y-label-x != 0px ? root.gizmo-y-label-x : root.gizmo-y-end-x, y: root.gizmo-y-label-y != 0px ? root.gizmo-y-label-y : root.gizmo-y-end-y, tint: DesignTokens.axis-y },
                                { label: "Z", x: root.gizmo-z-label-x != 0px ? root.gizmo-z-label-x : root.gizmo-z-end-x, y: root.gizmo-z-label-y != 0px ? root.gizmo-z-label-y : root.gizmo-z-end-y, tint: DesignTokens.axis-z },
                            ]: Rectangle {
                                x: axis-badge.x - 8px;
                                y: axis-badge.y - 8px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: DesignTokens.hud-surface;
                                border-width: 1px;
                                border-color: axis-badge.tint.transparentize(0.2);
                                drop-shadow-blur: DesignTokens.elevation-1-blur;
                                drop-shadow-color: DesignTokens.elevation-1-color;
                                Text {
                                    text: axis-badge.label;
                                    color: axis-badge.tint;
                                    font-size: DesignTokens.font-caption;
                                    font-weight: 700;
                                    font-family: "monospace";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Tripé de navegação no alto à direita. Arrastar orbita a
                    // câmera; clicar em um eixo mantém o alinhamento da vista.
                    Rectangle {
                        x: view-gizmo-origin-x - 54px - root.right-clearance;
                        y: view-gizmo-origin-y - 54px;
                        width: 108px;
                        height: 108px;
                        clip: true;
                        background: transparent;
                        accessible-role: groupbox;
                        accessible-label: root.label-view-gizmo;
                        accessible-description: root.label-view-gizmo-hint;
                        animate x { duration: Motion.medium; easing: ease-out; }

                        TouchArea {
                            mouse-cursor: self.pressed ? grabbing : grab;
                            property <length> last-x;
                            property <length> last-y;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.viewport-orbit((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                }
                            }
                        }

                        Path {
                            commands: root.view-gizmo-x-commands;
                            fit: ImageFit.preserve;
                            stroke: DesignTokens.axis-x;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                        Path {
                            commands: root.view-gizmo-y-commands;
                            fit: ImageFit.preserve;
                            stroke: DesignTokens.axis-y;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                        Path {
                            commands: root.view-gizmo-z-commands;
                            fit: ImageFit.preserve;
                            stroke: DesignTokens.axis-z;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                        for axis in [
                            { id: "x", label: "X", x: root.view-gizmo-x-end-x, y: root.view-gizmo-x-end-y, tint: DesignTokens.axis-x },
                            { id: "y", label: "Y", x: root.view-gizmo-y-end-x, y: root.view-gizmo-y-end-y, tint: DesignTokens.axis-y },
                            { id: "z", label: "Z", x: root.view-gizmo-z-end-x, y: root.view-gizmo-z-end-y, tint: DesignTokens.axis-z },
                        ]: Rectangle {
                            // 24 px: alvo mínimo da WCAG 2.5.8 (plano de UI F8).
                            x: axis.x - 12px;
                            y: axis.y - 12px;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: DesignTokens.surface-raised;
                            border-width: 1px;
                            border-color: axis.tint;
                            accessible-role: button;
                            accessible-label: axis.label;
                            Text { text: axis.label; color: axis.tint; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea {
                                mouse-cursor: self.pressed ? grabbing : pointer;
                                property <length> last-x;
                                property <length> last-y;
                                property <bool> dragged: false;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                        self.last-x = self.mouse-x;
                                        self.last-y = self.mouse-y;
                                        self.dragged = false;
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        if abs(self.mouse-x - self.last-x) > 1px || abs(self.mouse-y - self.last-y) > 1px {
                                            self.dragged = true;
                                            root.viewport-orbit((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                                            self.last-x = self.mouse-x;
                                            self.last-y = self.mouse-y;
                                        }
                                    }
                                }
                                clicked => { if !self.dragged { root.view-axis-clicked(axis.id); } }
                            }
                        }
                    }

                    // Barra contextual flutuante na base da viewport.
                    context-bar := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 14px;
                        width: bar-row.preferred-width + 16px;
                        height: 40px;
                        border-radius: 10px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: DesignTokens.elevation-2-blur;
                        drop-shadow-color: DesignTokens.elevation-2-color;
                        drop-shadow-offset-y: DesignTokens.elevation-2-offset;

                        bar-row := HorizontalLayout {
                            x: 8px;
                            y: 4px;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            spacing: 4px;
                            alignment: center;

                            // --- MODEL: Ferramentas de modelagem (Shapes / 2D Profiles hero position) ---


                            // --- MODEL: Ferramentas principais de edição poligonal ---
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.poly-tool-visible("extrude"): ToolButton {
                                icon-svg: PetuniaIcons.tool-extrude;
                                semantic-label: Tr.t("sl.extrude");
                                shortcut: root.shortcuts.model-extrude;
                                description: Tr.t("sl.pull_new_vertices_and_faces_outward_from_sel");
                                clicked => { root.command-executed("model.extrude"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760 && root.poly-tool-visible("push_pull"): ToolButton {
                                icon-svg: PetuniaIcons.tool-pushpull;
                                active: active-tool == "push_pull";
                                semantic-label: root.label-model-push-pull;
                                shortcut: root.shortcuts.model-push-pull;
                                description: Tr.t("sl.push_or_pull_faces_along_surface_normals_dir");
                                clicked => { root.command-executed("model.push_pull"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.poly-tool-visible("inset"): ToolButton {
                                icon-svg: PetuniaIcons.tool-inset;
                                semantic-label: Tr.t("sl.inset");
                                shortcut: root.shortcuts.model-inset;
                                description: Tr.t("sl.inset_new_polygonal_boundary_inside_selected");
                                clicked => { root.command-executed("model.inset"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.poly-tool-visible("bevel"): ToolButton {
                                icon-svg: PetuniaIcons.tool-bevel;
                                semantic-label: Tr.t("sl.bevel");
                                shortcut: root.shortcuts.model-bevel;
                                description: Tr.t("sl.round_edges_or_vertices_with_smooth_chamfer_");
                                clicked => { root.command-executed("model.bevel"); }
                            }

                            if active-workspace == "MODEL" && root.modeling-mode == "POLY": Rectangle {
                                width: 1px;
                                height: 20px;
                                background: DesignTokens.border;
                            }

                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.poly-tool-visible("poly_pen"): ToolButton {
                                icon-svg: PetuniaIcons.tool-poly-pen;
                                semantic-label: root.label-poly-pen;
                                description: root.label-poly-pen-hint;
                                active: active-tool == "poly_pen";
                                clicked => { root.active-tool-changed("poly_pen"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760 && root.poly-tool-visible("loop_cut"): ToolButton {
                                icon-svg: PetuniaIcons.tool-loopcut;
                                semantic-label: root.label-model-loop-cut;
                                shortcut: root.shortcuts.model-loop-cut;
                                description: Tr.t("sl.insert_a_connected_edge_loop_ring_across_qua");
                                active: active-tool == "loop_cut";
                                clicked => { root.active-tool-changed("loop_cut"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760 && root.poly-tool-visible("subdivide"): ToolButton {
                                icon-svg: PetuniaIcons.tool-subdivide;
                                semantic-label: Tr.t("sl.subdivide");
                                shortcut: root.shortcuts.model-subdivide;
                                description: Tr.t("sl.subdivide_faces_into_quad_quarters_creating_");
                                clicked => { root.command-executed("model.subdivide"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760 && root.poly-tool-visible("merge"): ToolButton {
                                icon-svg: PetuniaIcons.tool-merge;
                                semantic-label: Tr.t("sl.merge_center");
                                shortcut: root.shortcuts.model-merge;
                                description: Tr.t("sl.collapse_and_merge_all_selected_vertices_to_");
                                clicked => { root.command-executed("model.merge"); }
                            }
                            // Knife e Slice cortam pelo gesto: um grupo com flyout (F0/§11).
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.poly-tool-visible("knife") && root.poly-tool-visible("slice"): ToolGroup {
                                y: (parent.height - self.height) / 2;
                                tools: root.rail-cut-tools;
                                more-hint: Tr.t("sl.rail_more_hint");
                                activated(id) => { root.rail-activate(id); }
                                more-requested(x, y) => { root.rail-flyout-tools = root.rail-cut-tools; root.rail-flyout-x = x; root.rail-flyout-y = y; root.rail-flyout = "cut"; }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760 && root.poly-tool-visible("connect"): ToolButton {
                                icon-svg: PetuniaIcons.tool-connect;
                                semantic-label: Tr.t("sl.connect");
                                shortcut: root.shortcuts.model-connect;
                                description: Tr.t("sl.bridge_edge_loops_with_configurable_quad_seg");
                                clicked => { root.command-executed("model.connect"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 720 && root.poly-tool-visible("make_face"): ToolButton {
                                icon: IconSet.Square;
                                semantic-label: Tr.t("sl.make_face");
                                shortcut: "F";
                                description: Tr.t("sl.create_face_or_edge_connecting_selected_vert");
                                clicked => { root.command-executed("model.make_face"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760 && root.poly-tool-visible("spin"): ToolButton {
                                icon-svg: PetuniaIcons.tool-spin;
                                semantic-label: Tr.t("sl.spin");
                                shortcut: root.shortcuts.model-spin;
                                description: Tr.t("sl.revolve_selection_around_cursor_or_axis_into");
                                clicked => { root.command-executed("model.spin"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760 && root.poly-tool-visible("dissolve"): ToolButton {
                                icon-svg: PetuniaIcons.tool-dissolve;
                                semantic-label: Tr.t("sl.dissolve");
                                shortcut: root.shortcuts.model-dissolve;
                                description: Tr.t("sl.dissolve_selected_vertices_edges_or_faces_wi");
                                clicked => { root.command-executed("model.dissolve"); }
                            }

                            if active-workspace == "PAINT": ToolButton {
                                icon: root.isolate-active ? IconSet.EyeOff : IconSet.Eye;
                                semantic-label: root.isolate-active ? Tr.t("sl.un_isolate") : Tr.t("sl.isolate");
                                shortcut: root.shortcuts.paint-isolate;
                                description: Tr.t("sl.paint_isolate_description");
                                active: root.isolate-active;
                                clicked => { root.command-executed("view.isolate"); }
                            }
                            // Ajustes do pincel ativo (F6): cor, tamanho, opacidade e simetria.
                            if active-workspace == "PAINT": Rectangle {
                                width: 1px;
                                height: 22px;
                                background: DesignTokens.border;
                            }
                            if active-workspace == "PAINT": Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: root.paint-color;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                accessible-role: image;
                                accessible-label: Tr.t("sl.paint_color");
                            }
                            if active-workspace == "PAINT": IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: IconSet.Minus;
                                semantic-label: Tr.t("sl.brush_smaller");
                                clicked => { root.brush-size-changed(Math.max(0.1, root.brush-size - 0.2)); }
                            }
                            if active-workspace == "PAINT": Text {
                                text: Tr.t("sl.size") + " \{Math.round(root.brush-size * 10) / 10}";
                                color: DesignTokens.text-secondary;
                                font-size: DesignTokens.font-small;
                                vertical-alignment: center;
                            }
                            if active-workspace == "PAINT": IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: IconSet.Plus;
                                semantic-label: Tr.t("sl.brush_larger");
                                clicked => { root.brush-size-changed(Math.min(10.0, root.brush-size + 0.2)); }
                            }
                            if active-workspace == "PAINT": IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: IconSet.Minus;
                                semantic-label: Tr.t("sl.opacity_less");
                                clicked => { root.brush-opacity-changed(Math.max(0.05, root.brush-opacity - 0.1)); }
                            }
                            if active-workspace == "PAINT": Text {
                                text: Tr.t("sl.opacity") + " \{Math.round(root.brush-opacity * 100)}%";
                                color: DesignTokens.text-secondary;
                                font-size: DesignTokens.font-small;
                                vertical-alignment: center;
                            }
                            if active-workspace == "PAINT": IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: IconSet.Plus;
                                semantic-label: Tr.t("sl.opacity_more");
                                clicked => { root.brush-opacity-changed(Math.min(1.0, root.brush-opacity + 0.1)); }
                            }
                            if active-workspace == "PAINT": Rectangle {
                                width: 1px;
                                height: 22px;
                                background: DesignTokens.border;
                            }
                            if active-workspace == "PAINT": IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: IconSet.FlipHorizontal2;
                                semantic-label: Tr.t("sl.symmetry_x");
                                label: "X";
                                variant: "toggle";
                                active: root.paint-symmetry-x;
                                clicked => { root.paint-symmetry-x-toggled(); }
                            }
                            if active-workspace == "PAINT": IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: IconSet.FlipHorizontal2;
                                semantic-label: Tr.t("sl.symmetry_y");
                                label: "Y";
                                variant: "toggle";
                                active: root.paint-symmetry-y;
                                clicked => { root.paint-symmetry-y-toggled(); }
                            }
                            if active-workspace == "PAINT": IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: IconSet.FlipHorizontal2;
                                semantic-label: Tr.t("sl.symmetry_z");
                                label: "Z";
                                variant: "toggle";
                                active: root.paint-symmetry-z;
                                clicked => { root.paint-symmetry-z-toggled(); }
                            }

                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Maximize2;
                                semantic-label: Tr.t("sl.unwrap");
                                shortcut: root.shortcuts.uv-unwrap;
                                description: Tr.t("sl.unfold_3d_mesh_surface_into_flat_2d_uv_layou");
                                clicked => { root.command-executed("uv.unwrap_auto"); }
                            }
                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Grid2x2;
                                semantic-label: Tr.t("sl.pack_islands");
                                shortcut: root.shortcuts.uv-pack;
                                description: Tr.t("sl.pack_and_arrange_uv_islands_efficiently_with");
                                clicked => { root.command-executed("uv.pack_islands"); }
                            }
                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Camera;
                                semantic-label: Tr.t("sl.project_ref");
                                shortcut: root.shortcuts.uv-project-ref;
                                description: Tr.t("sl.project_uv_coordinates_from_active_camera_pe");
                                clicked => { root.command-executed("uv.project_reference"); }
                            }
                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Link;
                                semantic-label: Tr.t("sl.stitch");
                                shortcut: root.shortcuts.uv-stitch;
                                description: Tr.t("sl.weld_coincident_3d_edges_that_have_split_uv_");
                                clicked => { root.command-executed("uv.stitch"); }
                            }
                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Minimize2;
                                semantic-label: Tr.t("sl.relax");
                                shortcut: root.shortcuts.uv-relax;
                                description: Tr.t("sl.smooth_unpinned_uv_island_corners_to_minimiz");
                                clicked => { root.command-executed("uv.relax"); }
                            }

                            // Ações rápidas do usuário: saíram do Inspector (D2) e moram
                            // aqui, com rótulo. A lixeira saiu da barra (D10): Delete no
                            // teclado e o menu do botão direito continuam excluindo.
                            if active-workspace == "MODEL": Rectangle {
                                width: 1px;
                                height: 22px;
                                background: DesignTokens.border;
                            }
                            if active-workspace == "MODEL": HorizontalLayout {
                                spacing: 4px;
                                for action in root.quick-actions: IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: IconSet.Zap;
                                    label: action.label;
                                    semantic-label: action.label;
                                    enabled: action.enabled;
                                    clicked => { root.quick-action-executed(action.id); }
                                }
                                IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: IconSet.SlidersHorizontal;
                                    variant: "toggle";
                                    semantic-label: root.label-quick-action-customize;
                                    active: root.quick-actions-open;
                                    clicked => { root.quick-actions-open = !root.quick-actions-open; }
                                }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width < 760: ToolButton {
                                icon: IconSet.MoreHorizontal;
                                semantic-label: root.label-more-model-tools;
                                shortcut: "";
                                description: Tr.t("sl.open_overflow_menu_with_additional_modeling_");
                                active: root.shelf-overflow-open;
                                clicked => { root.shelf-overflow-open = !root.shelf-overflow-open; }
                            }
                        }
                    }

                    // Personalizar ações rápidas: cartão não modal acima da barra.
                    if active-workspace == "MODEL" && root.quick-actions-open: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: context-bar.y - self.height - 8px;
                        width: 300px;
                        height: qa-body.preferred-height + 24px;
                        border-radius: DesignTokens.radius-panel;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: DesignTokens.elevation-2-blur;
                        drop-shadow-color: DesignTokens.elevation-2-color;
                        drop-shadow-offset-y: DesignTokens.elevation-2-offset;
                        TouchArea { }
                        qa-body := QuickActionsBody {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            title-label: root.label-quick-actions;
                            customize-open <=> root.quick-actions-open;
                            actions: root.quick-actions;
                            candidates: root.quick-action-candidates;
                            customize-label: root.label-quick-action-customize;
                            remove-label: root.label-quick-action-remove;
                            add-label: root.label-quick-action-add;
                            reset-label: root.label-quick-action-reset;
                            done-label: root.label-quick-action-done;
                            action-executed(id) => { root.quick-action-executed(id); }
                            action-toggled(id) => { root.quick-action-toggled(id); }
                            actions-reset => { root.quick-actions-reset(); }
                        }
                    }

                    if root.pivot-menu-open: Rectangle {
                        x: min(max(8px, (parent.width - self.width) / 2), parent.width - self.width - 8px);
                        y: 54px;
                        width: 240px;
                        height: 356px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: DesignTokens.elevation-2-blur;
                        drop-shadow-color: DesignTokens.elevation-2-color;
                        VerticalLayout {
                            padding: 10px; spacing: 4px;
                            Text { text: root.label-model-pivot; color: DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 700; }
                            for item in [
                                { id: "median", label: root.pivot-median-label },
                                { id: "bounds", label: root.pivot-bounds-label },
                                { id: "cursor", label: root.pivot-cursor-label },
                                { id: "individual", label: root.pivot-individual-label },
                            ]: Rectangle {
                                height: 26px; border-radius: 4px;
                                background: root.pivot-id == item.id ? DesignTokens.surface-hover : transparent;
                                Text { text: item.label; x: 8px; color: root.pivot-id == item.id ? DesignTokens.accent : DesignTokens.text-primary; font-size: DesignTokens.font-caption; vertical-alignment: center; }
                                TouchArea { clicked => { root.pivot-set(item.id); root.pivot-menu-toggled(false); } }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            Rectangle {
                                height: 26px; border-radius: 4px;
                                background: root.edit-pivot ? DesignTokens.accent.transparentize(0.8) : transparent;
                                border-width: root.edit-pivot ? 1px : 0px;
                                border-color: DesignTokens.accent;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px;
                                    alignment: space-between;
                                    Text { text: root.label-edit-pivot; color: root.edit-pivot ? DesignTokens.accent : DesignTokens.text-primary; font-size: DesignTokens.font-caption; vertical-alignment: center; }
                                    Text { text: Tr.t("sl.insert"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.command-executed("object.toggle_edit_pivot"); root.pivot-menu-toggled(false); } }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            Text { text: Tr.t("sl.set_origin"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; font-weight: 700; }
                            for origin-item in [
                                { id: "object.origin_to_geometry", label: root.label-origin-to-geometry },
                                { id: "object.origin_to_bottom", label: root.label-origin-to-bottom },
                                { id: "object.origin_to_cursor", label: root.label-origin-to-cursor },
                                { id: "object.origin_to_selection", label: root.label-origin-to-selection },
                                { id: "object.geometry_to_origin", label: root.label-geometry-to-origin },
                            ]: Rectangle {
                                height: 24px; border-radius: 4px;
                                background: transparent;
                                Text { text: origin-item.label; x: 8px; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; vertical-alignment: center; }
                                TouchArea { clicked => { root.command-executed(origin-item.id); root.pivot-menu-toggled(false); } }
                            }
                        }
                    }

                    // Micro-Inspector Flutuante sob o Cursor (Fase 6: Micro-Inspector Flutuante)
                    if root.micro-inspector-open && active-workspace == "MODEL": Rectangle {
                        x: min(max(14px, root.micro-inspector-x), parent.width - self.width - 14px);
                        y: min(max(14px, root.micro-inspector-y), parent.height - self.height - 14px);
                        width: 250px;
                        height: 200px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1.5px;
                        border-color: DesignTokens.accent;
                        drop-shadow-blur: DesignTokens.elevation-2-blur;
                        drop-shadow-color: DesignTokens.elevation-2-color;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            // Cabeçalho com título e botão de fechar
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: Tr.t("sl.micro_inspector");
                                    color: DesignTokens.accent;
                                    font-size: DesignTokens.font-small;
                                    font-weight: 700;
                                }
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 4px;
                                    background: close-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                    IconDisplay {
                                        icon: IconSet.X;
                                        size: 12px;
                                        stroke: DesignTokens.text-muted;
                                    }
                                    close-touch := TouchArea {
                                        clicked => { root.micro-inspector-toggle(); }
                                    }
                                }
                            }

                            // Ferramentas de Transformação Rápida
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: stretch;
                                for tool in [
                                    { id: "select", label: Tr.t("sl.select"), icon: IconSet.MousePointer2 },
                                    { id: "move", label: Tr.t("sl.move"), icon: IconSet.Move3d },
                                    { id: "rotate", label: Tr.t("sl.rotate"), icon: IconSet.RotateCcw },
                                    { id: "scale", label: Tr.t("sl.scale"), icon: IconSet.Maximize2 },
                                    { id: "measure", label: Tr.t("sl.measure"), icon: IconSet.ArrowUpDown },
                                ]: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 28px;
                                    border-radius: 4px;
                                    background: root.active-tool == tool.id ? DesignTokens.accent.transparentize(0.75) : (tool-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface);
                                    border-width: root.active-tool == tool.id ? 1px : 0px;
                                    border-color: DesignTokens.accent;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        IconDisplay {
                                            icon: tool.icon;
                                            size: 13px;
                                            stroke: root.active-tool == tool.id ? DesignTokens.accent : DesignTokens.text-primary;
                                        }
                                    }
                                    tool-touch := TouchArea {
                                        clicked => {
                                            root.active-tool-changed(tool.id);
                                            root.micro-inspector-toggle();
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            // Resumo de Dados: Se fita métrica visível ou coordenadas de posição
                            if root.measure-visible: VerticalLayout {
                                spacing: 2px;
                                Text { text: Tr.t("sl.distance") + root.measure-distance + "m"; color: DesignTokens.measure; font-size: DesignTokens.font-small; font-weight: 700; font-family: "monospace"; }
                                Text { text: "Δ: X " + root.measure-dx + "  Y " + root.measure-dy + "  Z " + root.measure-dz; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-family: "monospace"; }
                                Text { text: Tr.t("sl.angle_2") + root.measure-angle-deg + "°"; color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; }
                            }

                            if !root.measure-visible: VerticalLayout {
                                spacing: 2px;
                                Text { text: Tr.t("sl.transform_quick_readout"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; font-weight: 700; }
                                Text { text: Tr.t("sl.pos") + root.pos-x + ", " + root.pos-y + ", " + root.pos-z; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-family: "monospace"; }
                                Text { text: Tr.t("sl.rot") + root.rot-x + "°, " + root.rot-y + "°, " + root.rot-z + "°"; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; font-family: "monospace"; }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            // Ações de Modelagem Direta
                            HorizontalLayout {
                                spacing: 4px;
                                for act in [
                                    { id: "model.extrude", label: Tr.t("sl.extrude") },
                                    { id: "model.inset", label: Tr.t("sl.inset") },
                                    { id: "model.bevel", label: Tr.t("sl.bevel") },
                                    { id: "model.loop_cut", label: Tr.t("sl.loop_cut") },
                                ]: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: act-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface;
                                    Text {
                                        text: act.label;
                                        color: DesignTokens.text-primary;
                                        font-size: DesignTokens.font-caption;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    act-touch := TouchArea {
                                        clicked => {
                                            root.command-executed(act.id);
                                            root.micro-inspector-toggle();
                                        }
                                    }
                                }
                            }

                            // Rodapé com atalho
                            Text {
                                text: Tr.t("sl.space_close_esc_cancel");
                                color: DesignTokens.text-muted;
                                font-size: DesignTokens.font-caption;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.shelf-overflow-open && active-workspace == "MODEL" && root.viewport-region-width < 760: Rectangle {
                        x: min(parent.width - self.width - 14px, context-bar.x + context-bar.width - self.width);
                        y: context-bar.y - self.height - 8px;
                        width: 190px;
                        height: 380px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;
                            ContextMenuItem { label: Tr.t("sl.duplicate"); shortcut: root.shortcuts.model-duplicate; clicked => { root.shelf-overflow-open = false; root.duplicate-requested(); } }
                            ContextMenuItem { label: Tr.t("sl.loop_cut"); shortcut: root.shortcuts.model-loop-cut; clicked => { root.shelf-overflow-open = false; root.command-executed("model.loop_cut"); } }
                            ContextMenuItem { label: root.label-model-push-pull; shortcut: root.shortcuts.model-push-pull; clicked => { root.shelf-overflow-open = false; root.command-executed("model.push_pull"); } }
                            ContextMenuItem { label: root.label-model-profile; shortcut: root.shortcuts.model-profile; clicked => { root.shelf-overflow-open = false; root.active-tool-changed("draw_profile"); } }
                            ContextMenuItem { label: root.label-model-slice; shortcut: root.shortcuts.model-slice; clicked => { root.shelf-overflow-open = false; root.active-tool-changed("slice"); } }
                            ContextMenuItem { label: Tr.t("sl.connect_loops"); shortcut: root.shortcuts.model-connect; clicked => { root.shelf-overflow-open = false; root.command-executed("model.connect"); } }
                            ContextMenuItem { label: Tr.t("sl.make_face_edge"); shortcut: "F"; clicked => { root.shelf-overflow-open = false; root.command-executed("model.make_face"); } }
                            ContextMenuItem { label: Tr.t("sl.spin_lathe"); shortcut: root.shortcuts.model-spin; clicked => { root.shelf-overflow-open = false; root.command-executed("model.spin"); } }
                            ContextMenuItem { label: Tr.t("sl.subdivide"); shortcut: root.shortcuts.model-subdivide; clicked => { root.shelf-overflow-open = false; root.command-executed("model.subdivide"); } }
                            ContextMenuItem { label: Tr.t("sl.merge_center"); shortcut: root.shortcuts.model-merge; clicked => { root.shelf-overflow-open = false; root.command-executed("model.merge"); } }
                            ContextMenuItem { label: Tr.t("sl.dissolve"); shortcut: root.shortcuts.model-dissolve; clicked => { root.shelf-overflow-open = false; root.command-executed("model.dissolve"); } }
                            ContextMenuItem { label: Tr.t("sl.slice"); shortcut: root.shortcuts.model-slice; clicked => { root.shelf-overflow-open = false; root.command-executed("model.slice"); } }
                            ContextMenuItem { label: Tr.t("sl.delete"); shortcut: root.shortcuts.model-delete; danger: true; clicked => { root.shelf-overflow-open = false; root.delete-requested(); } }
                        }
                    }

                    // Flyout de um grupo do trilho (F5b): clique fora ou Esc fecha.
                    if root.rail-flyout != "": TouchArea {
                        clicked => { root.rail-flyout = ""; }
                    }
                    if root.rail-flyout != "": Rectangle {
                        // Ao lado do botão de origem, sempre dentro da viewport.
                        x: clamp(root.rail-flyout-x - parent.absolute-position.x, 6px, max(6px, parent.width - self.width - 6px));
                        y: clamp(root.rail-flyout-y - parent.absolute-position.y, 6px, max(6px, parent.height - self.height - 6px));
                        width: 220px;
                        height: fly-col.preferred-height;
                        border-radius: DesignTokens.radius-panel;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: DesignTokens.elevation-2-blur;
                        drop-shadow-color: DesignTokens.elevation-2-color;
                        drop-shadow-offset-y: DesignTokens.elevation-2-offset;
                        TouchArea { }
                        fly-col := VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            for tool in root.rail-flyout-tools: ContextMenuItem {
                                label: tool.label;
                                shortcut: tool.shortcut;
                                clicked => { root.rail-activate(tool.id); }
                            }
                        }
                    }

                    // Menu de criação aberto a partir do trilho esquerdo.
                    if add-menu-open && active-workspace == "MODEL": Rectangle {
                        x: 14px;
                        y: 58px;
                        width: 2 * 34px + 216px;
                        height: 88px;
                        border-radius: 10px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: DesignTokens.elevation-2-blur;
                        drop-shadow-color: DesignTokens.elevation-2-color;
                        drop-shadow-offset-y: DesignTokens.elevation-2-offset;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 6px;
                            alignment: center;

                            ToolButton {
                                icon-svg: PetuniaIcons.cube;
                                semantic-label: Tr.t("sl.cube");
                                shortcut: "1";
                                description: Tr.t("sl.parametric_6_sided_hexahedral_box_with_width");
                                clicked => { root.add-primitive-requested("cube"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.sphere;
                                semantic-label: Tr.t("sl.sphere");
                                shortcut: "2";
                                description: Tr.t("sl.uv_sphere_parameterized_by_longitude_segment");
                                clicked => { root.add-primitive-requested("sphere"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.cylinder;
                                semantic-label: Tr.t("sl.cylinder");
                                shortcut: "3";
                                description: Tr.t("sl.parametric_circular_cylinder_with_top_bottom");
                                clicked => { root.add-primitive-requested("cylinder"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.plane;
                                semantic-label: Tr.t("sl.plane_2");
                                shortcut: "4";
                                description: Tr.t("sl.flat_2d_quad_rectangular_plane_surface_posit");
                                clicked => { root.add-primitive-requested("plane"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.cone;
                                semantic-label: Tr.t("sl.cone");
                                shortcut: "5";
                                description: Tr.t("sl.conical_geometry_tapering_to_a_single_apex_v");
                                clicked => { root.add-primitive-requested("cone"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.capsule;
                                semantic-label: Tr.t("sl.capsule");
                                shortcut: "6";
                                description: Tr.t("sl.cylindrical_body_capped_by_two_hemispherical");
                                clicked => { root.add-primitive-requested("capsule"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.torus;
                                semantic-label: Tr.t("sl.torus");
                                shortcut: "7";
                                description: Tr.t("sl.donut_shaped_revolution_ring_with_major_and_");
                                clicked => { root.add-primitive-requested("torus"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.circle;
                                semantic-label: Tr.t("sl.circle");
                                shortcut: "8";
                                description: Tr.t("sl.2d_planar_boundary_circle_polygon_or_n_gon_d");
                                clicked => { root.add-primitive-requested("circle"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.icosphere;
                                semantic-label: Tr.t("sl.icosphere");
                                shortcut: "9";
                                description: Tr.t("sl.polyhedral_geodesic_sphere_composed_of_equil");
                                clicked => { root.add-primitive-requested("icosphere"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.wedge;
                                semantic-label: Tr.t("sl.wedge");
                                shortcut: "0";
                                description: Tr.t("sl.right_angled_triangular_prism_3d_ramp_mesh");
                                clicked => { root.add-primitive-requested("wedge"); root.add-menu-changed(false); }
                            }
                        }
                    }
                
                    // Trilho de pílulas: sobreposto à borda direita da viewport e
                    // visível com o Inspector recolhido, ao lado da prévia de hover
                    // (plano de UI F4, D1). Fica antes do painel na ordem de desenho.
                    if inspector-visible && !compact-shell: Rectangle {
                        x: parent.width - self.width - 6px;
                        y: 8px;
                        width: 50px;
                        height: rail-col.preferred-height;
                        visible: !root.inspector-expanded;
                        opacity: root.inspector-expanded ? 0.0 : 1.0;
                        animate opacity { duration: Motion.fast; }
                        background: DesignTokens.surface-raised.with-alpha(0.9);
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        border-radius: 8px;

                        rail-touch := TouchArea {
                            changed has-hover => {
                                root.rail-hovered = self.has-hover;
                                if !self.has-hover && !root.flyout-hovered {
                                    root.hovered-inspector-section = "";
                                }
                            }
                        }

                        rail-col := VerticalLayout {
                            padding: 7px;
                            spacing: 8px;
                            alignment: start;

                            InspectorPill {
                                focus-token: root.f6-rail-token;
                                section-id: "parts";
                                icon: IconSet.Layers3;
                                icon-svg: PetuniaIcons.parts;
                                semantic-label: root.label-tab-parts;
                                description: Tr.t("sl.manage_scene_parts_groups_and_hierarchy");
                                active: root.model-parts-open;
                                clicked => { root.section-pill-clicked("parts"); }
                                hovered(id) => { root.hovered-inspector-section = id; }
                            }
                            InspectorPill {
                                section-id: "transform";
                                icon: IconSet.Move3d;
                                icon-svg: PetuniaIcons.transform;
                                semantic-label: root.label-tab-transform;
                                description: Tr.t("sl.position_rotation_and_scale_coordinates");
                                active: root.model-transform-open;
                                clicked => { root.section-pill-clicked("transform"); }
                                hovered(id) => { root.hovered-inspector-section = id; }
                            }
                            InspectorPill {
                                section-id: "material";
                                icon: IconSet.Paintbrush;
                                icon-svg: PetuniaIcons.material;
                                semantic-label: root.label-tab-material;
                                description: Tr.t("sl.surface_shaders_colors_and_textures");
                                active: root.model-material-open;
                                clicked => { root.section-pill-clicked("material"); }
                                hovered(id) => { root.hovered-inspector-section = id; }
                            }
                            InspectorPill {
                                section-id: "object";
                                icon: IconSet.Box;
                                icon-svg: PetuniaIcons.object-mesh;
                                semantic-label: root.label-tab-object;
                                description: Tr.t("sl.object_metadata_visibility_and_display_optio");
                                active: root.model-object-open;
                                clicked => { root.section-pill-clicked("object"); }
                                hovered(id) => { root.hovered-inspector-section = id; }
                            }
                        }
                    }

                    // Inspector Flyout flutuante sobre a Viewport (Peek-on-Hover e Pin/Unpin)
                    if inspector-visible && !compact-shell: inspector-flyout := Rectangle {
                        visible: root.inspector-flyout-open || self.opacity > 0.01;
                        x: parent.width - (root.inspector-flyout-open ? (self.width + 6px + root.rail-clearance) : 0px);
                        y: 8px;
                        width: min(320px, parent.width - 60px);
                        height: parent.height - 16px;
                        // Superfície única (D3): um painel translúcido com elevação 2;
                        // as seções dentro dele são planas.
                        background: DesignTokens.surface-raised.with-alpha(0.9);
                        border-radius: DesignTokens.radius-panel;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: DesignTokens.elevation-2-blur;
                        drop-shadow-color: DesignTokens.elevation-2-color;
                        drop-shadow-offset-y: DesignTokens.elevation-2-offset;
                        clip: true;
                        opacity: root.inspector-flyout-open ? 1.0 : 0.0;

                        // A posição muda imediatamente: animar x atravessa as
                        // pílulas e intercepta cliques durante o peek. A opacidade
                        // preserva a transição sem mover os alvos de interação.
                        animate opacity { duration: Motion.fast; easing: ease-out; }

                        flyout-touch := TouchArea {
                            changed has-hover => {
                                root.flyout-hovered = self.has-hover;
                                if !self.has-hover && !root.rail-hovered {
                                    root.hovered-inspector-section = "";
                                }
                            }
                            pointer-event(_e) => { }
                        }

                        VerticalLayout {
                            // Cabeçalho de contexto (F4): o que está selecionado,
                            // ações do objeto e Recolher (completa a D1).
                            Rectangle {
                                height: 44px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    alignment: start;
                                    if root.active-workspace != "ANIMATE": IconButton {
                                        y: (parent.height - self.height) / 2;
                                        icon: IconSet.ChevronsRight;
                                        semantic-label: Tr.t("sl.collapse_inspector");
                                        description: Tr.t("sl.collapse_inspector_hint");
                                        clicked => {
                                            root.hovered-inspector-section = "";
                                            root.flyout-hovered = false;
                                            root.rail-hovered = false;
                                            root.inspector-collapse-requested();
                                        }
                                    }
                                    Rectangle {
                                        width: DesignTokens.icon-control;
                                        horizontal-stretch: 0;
                                        IconDisplay {
                                            icon: root.object-has-selection ? IconSet.Box : IconSet.MousePointerClick;
                                            size: DesignTokens.icon-control;
                                            stroke: DesignTokens.text-secondary;
                                        }
                                    }
                                    Text {
                                        text: root.object-has-selection ? root.object-name : Tr.t("sl.nothing_selected");
                                        color: root.object-has-selection ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-strong;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    if root.object-has-selection && root.active-workspace == "MODEL": IconButton {
                                        y: (parent.height - self.height) / 2;
                                        icon: IconSet.Copy;
                                        semantic-label: root.label-duplicate;
                                        clicked => { root.duplicate-requested(); }
                                    }
                                    if root.object-has-selection && root.active-workspace == "MODEL": IconButton {
                                        y: (parent.height - self.height) / 2;
                                        icon: IconSet.Trash2;
                                        semantic-label: root.label-delete;
                                        clicked => { root.delete-requested(); }
                                    }
                                }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                horizontal-scrollbar-policy: always-off;
                                vertical-scrollbar-policy: as-needed;
                                VerticalLayout {
                                    spacing: 10px;
                                    width: parent.width;
                                    vertical-stretch: 0;

                            if active-workspace == "MODEL": VerticalLayout {
                                spacing: 0px;
                                vertical-stretch: 0;

                                if (root.model-parts-open || root.hovered-inspector-section == "parts"): InspectorSection {
                                    title: root.label-parts;
                                    section-id: "parts";
                                    open: root.model-parts-open || root.hovered-inspector-section == "parts";
                                    pin-open: root.section-states.length > 0 ? root.section-states[0].pin-open : false;
                                    toggled => { root.section-open-toggled("parts"); }
                                    toggle-all => { root.toggle-all-sections(); }
                                    pin-toggled(id) => { root.section-pin-open-toggled(id); }

                                    PartsBody {
                                        search-label: root.label-search-parts;
                                        selected-only-label: root.label-selected-parts-only;
                                        sort-label: root.label-sort-parts;
                                        query <=> root.parts-query;
                                        selected-only <=> root.parts-selected-only;
                                        sort-by-name <=> root.parts-sort-by-name;
                                        items: root.parts-items;
                                        total-count: root.scene-items.length;
                                        row-size-label: root.label-parts-row-size;
                                        row-height <=> root.parts-row-height;
                                        list-label: root.label-parts;
                                        hide-label: root.label-hide-part;
                                        show-label: root.label-show-part;
                                        lock-label: root.label-lock-part;
                                        unlock-label: root.label-unlock-part;
                                        rename-active: root.rename-active;
                                        rename-value: root.rename-value;
                                        query-changed(query) => { root.parts-query-changed(query); }
                                        selected-only-changed(enabled) => { root.parts-selected-only-changed(enabled); }
                                        sort-changed(enabled) => { root.parts-sort-changed(enabled); }
                                        row-height-changed(value) => { root.parts-row-height-changed(value); }
                                        scene-select(id, extend) => { root.scene-select(id, extend); }
                                        scene-toggle-visibility(id) => { root.scene-toggle-visibility(id); }
                                        scene-toggle-lock(id) => { root.scene-toggle-lock(id); }
                                        scene-context-requested(id, x, y) => { root.scene-context-requested(id, x, y); }
                                        part-color-picker-open(id) => { root.part-color-picker-open(id); }
                                        separate-selection-requested => { root.separate-selection-requested(); }
                                        rename-edited(text) => { root.rename-edited(text); }
                                        rename-committed(text) => { root.rename-committed(text); }
                                    }
                                }

                                // Sem seleção: um estado vazio no lugar de Transform, para o painel
                                // nunca mostrar valores de um objeto que o cabeçalho diz não estar
                                // selecionado (critério de aceite da F4).
                                if !root.object-has-selection: Rectangle {
                                    height: empty-state.preferred-height;
                                    Rectangle { y: 0; height: 1px; background: DesignTokens.border; }
                                    empty-state := EmptyState {
                                        width: parent.width;
                                        title: Tr.t("sl.nothing_selected");
                                        message: Tr.t("sl.nothing_selected_hint");
                                    }
                                }

                                if (root.object-has-selection && selection-domain == "OBJECT" && (root.model-transform-open || root.hovered-inspector-section == "transform")): InspectorSection {
                                    title: root.label-tab-transform;
                                    section-id: "transform";
                                    open: root.model-transform-open || root.hovered-inspector-section == "transform";
                                    pin-open: root.section-states.length > 1 ? root.section-states[1].pin-open : false;
                                    toggled => { root.section-open-toggled("transform"); }
                                    toggle-all => { root.toggle-all-sections(); }
                                    pin-toggled(id) => { root.section-pin-open-toggled(id); }

                                        TransformBody {
                                            field-hint: root.label-numeric-field-hint;
                                            pos-x: root.pos-x;
                                            pos-y: root.pos-y;
                                            pos-z: root.pos-z;
                                            rot-x: root.rot-x;
                                            rot-y: root.rot-y;
                                            rot-z: root.rot-z;
                                            scale-x: root.scale-x;
                                            scale-y: root.scale-y;
                                            scale-z: root.scale-z;
                                            scrubbed(kind, axis, delta, fine) => { root.transform-scrubbed(kind, axis, delta, fine); }
                                            scrub-started(kind) => { root.transform-scrub-started(kind); }
                                            scrub-finished => { root.transform-scrub-finished(); }
                                            text-committed(kind, axis, text) => { root.transform-text-committed(kind, axis, text) }
                                            scrub-cancelled => { root.transform-scrub-cancelled(); }
                                        }
                                }
                                if (root.model-material-open || root.hovered-inspector-section == "material"): InspectorSection {
                                    title: root.label-tab-material;
                                    section-id: "material";
                                    open: root.model-material-open || root.hovered-inspector-section == "material";
                                    pin-open: root.section-states.length > 2 ? root.section-states[2].pin-open : false;
                                    toggled => { root.section-open-toggled("material"); }
                                    toggle-all => { root.toggle-all-sections(); }
                                    pin-toggled(id) => { root.section-pin-open-toggled(id); }

                                    MaterialBody {
                                        active-name: root.active-material-name;
                                        active-slot <=> root.active-material-slot;
                                        slots: root.material-slots;
                                        profile: root.material-profile;
                                        base-color: root.material-base-color;
                                        palette: root.material-palette;
                                        roughness: root.material-roughness;
                                        metallic: root.material-metallic;
                                        emission-strength: root.material-emission-strength;
                                        advanced-open <=> root.material-advanced-open;
                                        normal-scale: root.material-normal-scale;
                                        alpha-mode: root.material-alpha-mode;
                                        alpha-cutoff: root.material-alpha-cutoff;
                                        has-albedo: root.material-has-albedo;
                                        albedo-text-label: root.material-albedo-label;
                                        assign-label: root.label-material-assign;
                                        new-label: root.label-material-new;
                                        duplicate-label: root.label-material-duplicate;
                                        remove-label: root.label-material-remove;
                                        profile-label: root.label-material-profile;
                                        profile-pbr-label: root.label-material-profile-pbr;
                                        profile-unlit-label: root.label-material-profile-unlit;
                                        profile-toon-label: root.label-material-profile-toon;
                                        profile-glass-label: root.label-material-profile-glass;
                                        profile-emissive-label: root.label-material-profile-emissive;
                                        base-color-label: root.label-material-base-color;
                                        roughness-label: root.label-material-roughness;
                                        metallic-label: root.label-material-metallic;
                                        emission-label: root.label-material-emission-strength;
                                        advanced-label: root.label-material-advanced;
                                        normal-scale-label: root.label-material-normal-scale;
                                        alpha-mode-label: root.label-material-alpha-mode;
                                        alpha-opaque-label: root.label-material-alpha-opaque;
                                        alpha-mask-label: root.label-material-alpha-mask;
                                        alpha-blend-label: root.label-material-alpha-blend;
                                        alpha-cutoff-label: root.label-material-alpha-cutoff;
                                        albedo-label: root.label-material-texture-albedo;
                                        create-texture-label: root.label-material-create-texture;
                                        clear-texture-label: root.label-material-clear-texture;
                                        no-texture-label: root.label-material-no-texture;
                                        assign-material-slot(slot) => { root.assign-material-slot(slot); }
                                        create-material => { root.create-material(); }
                                        duplicate-material(slot) => { root.duplicate-material(slot); }
                                        remove-material(slot) => { root.remove-material(slot); }
                                        material-slot-selected(index) => { root.material-slot-selected(index); }
                                        material-base-color-changed(r, g, b) => { root.material-base-color-changed(r, g, b); }
                                        material-scalar-committed(field, slot, text) => { root.material-scalar-committed(field, slot, text) }
                                        material-profile-changed(index) => { root.material-profile-changed(index); }
                                        material-alpha-mode-changed(index) => { root.material-alpha-mode-changed(index); }
                                        material-albedo-create => { root.material-albedo-create(); }
                                        material-albedo-clear => { root.material-albedo-clear(); }
                                    }
                                }
                                if (root.model-object-open || root.hovered-inspector-section == "object"): InspectorSection {
                                    title: root.label-tab-object;
                                    section-id: "object";
                                    open: root.model-object-open || root.hovered-inspector-section == "object";
                                    pin-open: root.section-states.length > 3 ? root.section-states[3].pin-open : false;
                                    toggled => { root.section-open-toggled("object"); }
                                    toggle-all => { root.toggle-all-sections(); }
                                    pin-toggled(id) => { root.section-pin-open-toggled(id); }
                                    ObjectBody {
                                        has-selection: root.object-has-selection;
                                        object-name: root.object-name;
                                        object-id: root.object-id;
                                        object-visible: root.object-visible;
                                        object-locked: root.object-locked;
                                        object-verts: root.object-verts;
                                        object-faces: root.object-faces;
                                        object-tris: root.object-tris;
                                        no-selection-label: root.label-object-no-selection;
                                        verts-label: root.label-stats-verts;
                                        faces-label: root.label-stats-faces;
                                        tris-label: root.label-stats-tris;
                                        duplicate-label: root.label-duplicate;
                                        delete-label: root.label-delete;
                                        is-parametric: root.active-asset-is-parametric;
                                        primitive-kind: root.primitive-kind;
                                        primitive-radius: root.primitive-radius;
                                        primitive-radius-b: root.primitive-radius-b;
                                        primitive-height: root.primitive-height;
                                        primitive-depth: root.primitive-depth;
                                        primitive-width: root.primitive-width;
                                        primitive-sides: root.primitive-sides;
                                        primitive-rings: root.primitive-rings;
                                        primitive-subdiv: root.primitive-subdiv;
                                        primitive-cap-top: root.primitive-cap-top;
                                        primitive-cap-bottom: root.primitive-cap-bottom;
                                        primitive-fill-disc: root.primitive-fill-disc;
                                        label-parametric-primitive: root.label-parametric-primitive;
                                        label-freeze-primitive: root.label-freeze-primitive;
                                        label-freeze-primitive-hint: root.label-freeze-primitive-hint;
                                        scene-toggle-visibility(id) => { root.scene-toggle-visibility(id); }
                                        scene-toggle-lock(id) => { root.scene-toggle-lock(id); }
                                        duplicate-requested => { root.duplicate-requested(); }
                                        delete-requested => { root.delete-requested(); }
                                        primitive-param-float(param, val) => { root.primitive-param-float(param, val); }
                                        primitive-param-bool(param, val) => { root.primitive-param-bool(param, val); }
                                        freeze-primitive-requested => { root.freeze-primitive-requested(); }
                                    }
                                    // Modificadores como subseção de Objeto (plano de UI F4, D2).
                                    if root.object-has-selection: VerticalLayout {
                                        spacing: DesignTokens.space-xs;
                                        padding-top: DesignTokens.space-sm;
                                        Text {
                                            text: root.label-tab-modifiers;
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-small;
                                            font-weight: 600;
                                        }
                                        ModifiersBody {
                                            rows: root.modifier-rows;
                                            add-mirror-label: root.label-modifier-add-mirror;
                                            add-symmetry-label: root.label-modifier-add-symmetry;
                                            apply-label: root.label-modifier-apply;
                                            direction-label: root.label-modifier-direction;
                                            neg-to-pos-label: root.label-modifier-negative-to-positive;
                                            pos-to-neg-label: root.label-modifier-positive-to-negative;
                                            empty-label: root.label-modifiers-empty;
                                            modifier-add(kind) => { root.modifier-add(kind); }
                                            modifier-toggle(id, enabled) => { root.modifier-toggle(id, enabled); }
                                            modifier-remove(id) => { root.modifier-remove(id); }
                                            modifier-move(id, direction) => { root.modifier-move(id, direction); }
                                            modifier-apply(id) => { root.modifier-apply(id); }
                                            modifier-axis-changed(id, axis) => { root.modifier-axis-changed(id, axis); }
                                            modifier-direction-changed(id, direction) => { root.modifier-direction-changed(id, direction); }
                                        }
                                    }
                                }
                                 if root.scene-items.length > 1 || root.boolean-operand-name != "": InspectorSection {
                                    title: Tr.t("sl.combine");
                                    open: true;
                                    toggled => { self.open = !self.open; }
                                    VerticalLayout {
                                        spacing: 6px;
                                        if root.boolean-operand-name != "": VerticalLayout {
                                            spacing: 6px;
                                            Text { text: Tr.t("sl.operand") + ": \{root.boolean-operand-name}"; color: DesignTokens.accent; font-size: DesignTokens.font-caption; font-weight: 700; }
                                            HorizontalLayout {
                                                spacing: 4px;
                                                ToolButton { icon-svg: PetuniaIcons.boolean-fuse; semantic-label: Tr.t("sl.fuse"); description: Tr.t("sl.combine_the_active_part_with_the_operand"); clicked => { root.command-executed("model.fuse"); } }
                                                ToolButton { icon-svg: PetuniaIcons.boolean-cut; semantic-label: Tr.t("sl.cut"); description: Tr.t("sl.subtract_the_operand_from_the_active_part"); clicked => { root.command-executed("model.cut"); } }
                                                ToolButton { icon-svg: PetuniaIcons.boolean-intersect; semantic-label: Tr.t("sl.intersect"); description: Tr.t("sl.keep_the_overlapping_volume"); clicked => { root.command-executed("model.intersect"); } }
                                                ToolButton { icon-svg: PetuniaIcons.boolean-join; semantic-label: Tr.t("sl.join"); description: Tr.t("sl.join_the_operand_into_the_active_part"); clicked => { root.join-requested(); } }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            HorizontalLayout {
                                                spacing: 4px;
                                                Rectangle {
                                                    horizontal-stretch: 1; height: 26px;
                                                    background: root.boolean-keep-parts ? DesignTokens.accent : DesignTokens.surface-raised;
                                                    border-radius: 4px;
                                                    accessible-role: checkbox;
                                                    accessible-label: Tr.t("sl.keep_parts");
                                                    accessible-checked: root.boolean-keep-parts;
                                                    Text { text: root.boolean-keep-parts ? Tr.t("sl.keep_parts_on") : Tr.t("sl.keep_parts_off"); color: root.boolean-keep-parts ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                    TouchArea { clicked => { root.boolean-keep-parts-set(!root.boolean-keep-parts); } }
                                                }
                                                Rectangle {
                                                    horizontal-stretch: 1; height: 26px;
                                                    background: root.boolean-cleanup ? DesignTokens.accent : DesignTokens.surface-raised;
                                                    border-radius: 4px;
                                                    accessible-role: checkbox;
                                                    accessible-label: Tr.t("sl.clean_quads");
                                                    accessible-checked: root.boolean-cleanup;
                                                    Text { text: root.boolean-cleanup ? Tr.t("sl.clean_quads_on") : Tr.t("sl.clean_quads_off"); color: root.boolean-cleanup ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                    TouchArea { clicked => { root.boolean-cleanup-set(!root.boolean-cleanup); } }
                                                }
                                                Rectangle {
                                                    width: 92px; height: 26px;
                                                    background: DesignTokens.surface-raised;
                                                    border-radius: 4px;
                                                    accessible-role: button;
                                                    accessible-label: Tr.t("sl.clear_operand");
                                                    Text { text: Tr.t("sl.clear"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                    TouchArea { clicked => { root.boolean-operand-cleared(); } }
                                                }
                                            }
                                        }
                                        if root.boolean-operand-name == "": VerticalLayout {
                                            spacing: 4px;
                                            Text { text: Tr.t("sl.select_second_part_to_combine"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; }
                                            for item in root.scene-items: Rectangle {
                                                visible: !item.active;
                                                height: !item.active ? 24px : 0px;
                                                background: DesignTokens.surface-raised;
                                                border-radius: 4px;
                                                if !item.active: HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    spacing: 4px;
                                                    Text { text: item.name; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; vertical-alignment: center; horizontal-stretch: 1; }
                                                    Text { text: Tr.t("sl.choose"); color: DesignTokens.accent; font-size: DesignTokens.font-caption; vertical-alignment: center; }
                                                }
                                                if !item.active: TouchArea { clicked => { root.boolean-operand-set(item.id); } }
                                            }
                                        }
                                    }
                                }
                            }

                            if active-workspace == "PAINT": VerticalLayout {
                            spacing: 10px;

                            // Preparar superfície (UV): desembrulhar e empacotar ilhas dentro do fluxo de pintura.
                            InspectorSection {
                                title: Tr.t("sl.prepare_surface");
                                open: true;
                                toggled => { self.open = !self.open; }

                                HorizontalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;
                                    Rectangle {
                                        height: 28px;
                                        horizontal-stretch: 1;
                                        border-radius: DesignTokens.radius-control;
                                        background: unwrap-touch.pressed ? DesignTokens.accent.darker(0.15) : (unwrap-touch.has-hover ? DesignTokens.accent.brighter(0.1) : DesignTokens.accent);
                                        animate background { duration: Motion.fast; easing: ease-out; }
                                        accessible-role: button;
                                        accessible-label: root.label-unwrap-mesh;
                                        Text { text: root.label-unwrap-mesh; color: DesignTokens.on-accent; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        unwrap-touch := TouchArea { clicked => { root.command-executed("uv.unwrap"); } }
                                    }
                                    Rectangle {
                                        height: 28px;
                                        horizontal-stretch: 1;
                                        border-radius: DesignTokens.radius-control;
                                        background: pack-touch.pressed ? DesignTokens.surface-pressed : (pack-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-raised);
                                        animate background { duration: Motion.fast; easing: ease-out; }
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        accessible-role: button;
                                        accessible-label: root.label-pack-islands;
                                        Text { text: root.label-pack-islands; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                        pack-touch := TouchArea { clicked => { root.command-executed("uv.pack_islands"); } }
                                    }
                                }
                            }

                            InspectorSection {
                                title: Tr.t("sl.effects");
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    Text {
                                        text: Tr.t("sl.add_an_effect_layer");
                                        color: DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-caption;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for effect in ["Pixelate", "Posterize", "Invert"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: effect;
                                            Text { text: effect; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            TouchArea { clicked => { root.paint-effect-layer-added(effect); } }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for effect in ["Grain", "Levels", "BrightnessContrast", "HueSaturation"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: effect;
                                            Text { text: effect; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            TouchArea { clicked => { root.paint-effect-layer-added(effect); } }
                                        }
                                    }

                                    if paint-effect-kind != "": Text {
                                        text: Tr.t("sl.active_effect") + ": \{root.paint-effect-kind}";
                                        color: DesignTokens.accent;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: 600;
                                    }
                                    if paint-effect-kind != "" && paint-effect-params.length == 0: Text {
                                        text: Tr.t("sl.this_effect_has_no_parameters");
                                        color: DesignTokens.text-muted;
                                        font-size: DesignTokens.font-caption;
                                    }

                                    for param in root.paint-effect-params: HorizontalLayout {
                                        spacing: 6px;
                                        height: 24px;

                                        Text {
                                            text: param.label;
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-caption;
                                            width: 78px;
                                            vertical-alignment: center;
                                        }
                                        PetuniaSlider {
                                            horizontal-stretch: 1;
                                            minimum: param.minimum;
                                            maximum: param.maximum;
                                            value: param.value;
                                            controlled: true;
                                            changed(value) => { root.paint-effect-param-set(param.key, value); }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: Tr.t("sl.canvas");
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    // Resolução da textura de pintura (reamostra todas as camadas).
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text {
                                            text: Tr.t("paint.canvas_size");
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-caption;
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            for side in [256, 512, 1024, 2048]: BrushChip {
                                                label: side;
                                                active: root.paint-texture-side == side;
                                                clicked => { root.paint-texture-side-selected(side); }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: root.paint-canvas-size;
                                                color: DesignTokens.text-muted;
                                                font-size: DesignTokens.font-caption;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: root.paint-pip ? DesignTokens.accent : (pipbtn-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-raised);
                                                animate background { duration: Motion.fast; easing: ease-out; }
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                accessible-role: button;
                                                accessible-checked: root.paint-pip;
                                                accessible-label: Tr.t("sl.paint_pip");
                                                IconDisplay { icon: IconSet.PictureInPicture2; size: 11px; stroke: root.paint-pip ? DesignTokens.on-accent : DesignTokens.text-primary; }
                                                pipbtn-touch := TouchArea {
                                                    clicked => { root.paint-pip-toggle-requested(); }
                                                    Tooltip { VerticalLayout { padding: 6px; Text { text: Tr.t("sl.paint_pip"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; } } }
                                                }
                                            }
                                            Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: root.paint-canvas-panel-visible ? DesignTokens.accent : (expand-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-raised);
                                                animate background { duration: Motion.fast; easing: ease-out; }
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.paint_canvas_open");
                                                IconDisplay { icon: IconSet.Maximize2; size: 11px; stroke: root.paint-canvas-panel-visible ? DesignTokens.on-accent : DesignTokens.text-primary; }
                                                expand-touch := TouchArea {
                                                    clicked => { root.paint-canvas-panel-visible = !root.paint-canvas-panel-visible; }
                                                    Tooltip { VerticalLayout { padding: 6px; Text { text: Tr.t("sl.paint_canvas_open"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; } } }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            // Pixel Grid toggle button
                                            Rectangle {
                                                width: 42px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: root.paint-pixel-grid ? DesignTokens.accent : DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text {
                                                    text: Tr.t("sl.grid");
                                                    color: root.paint-pixel-grid ? DesignTokens.on-accent : DesignTokens.text-secondary;
                                                    font-size: DesignTokens.font-caption;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => { root.toggle-paint-pixel-grid(); }
                                                }
                                            }
                                            // Zoom In / Out
                                            Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text {
                                                    text: "-";
                                                    color: DesignTokens.text-primary;
                                                    font-size: DesignTokens.font-small;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => {
                                                        if root.paint-canvas-zoom > 1 {
                                                            root.set-paint-canvas-zoom(root.paint-canvas-zoom / 2);
                                                        }
                                                    }
                                                }
                                            }
                                            Text {
                                                text: root.paint-canvas-zoom + "x";
                                                color: DesignTokens.text-primary;
                                                font-size: DesignTokens.font-caption;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text {
                                                    text: "+";
                                                    color: DesignTokens.text-primary;
                                                    font-size: DesignTokens.font-small;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => {
                                                        if root.paint-canvas-zoom < 16 {
                                                            root.set-paint-canvas-zoom(root.paint-canvas-zoom * 2);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    PaintCanvasSurface {
                                        width: 256px;
                                        height: 256px;
                                        horizontal-stretch: 0;
                                        canvas-image: root.paint-canvas-image;
                                        zoom: root.paint-canvas-zoom;
                                        show-brush: root.brush-stroke-tool(root.active-tool);
                                        brush-diameter: root.brush-size * 16px;
                                        brush-hardness: root.brush-hardness;
                                        brush-strength: root.brush-opacity * root.brush-flow;
                                        brush-tint: root.paint-color;
                                        brush-erase: root.active-tool == "eraser";
                                        brush-hard-edge: root.active-tool == "pixel";
                                        show-uv: root.paint-show-uv;
                                        uv-commands: root.uv-layout-commands;
                                        show-grid: root.paint-pixel-grid;
                                        grid-commands: root.paint-canvas-grid-commands;
                                        select-mode: root.active-tool == "select";
                                        selected-commands: root.uv-selected-commands;
                                        select-region(x0, y0, x1, y1, extend, subtract, island) => { root.paint-2d-select(x0, y0, x1, y1, extend, subtract, island); }
                                        stroke(x, y, phase, shift, raster) => { root.paint-2d-stroke(x, y, phase, shift, raster); }
                                        zoom-step(direction) => {
                                            if direction > 0 && root.paint-canvas-zoom < 16 { root.set-paint-canvas-zoom(root.paint-canvas-zoom * 2); }
                                            if direction < 0 && root.paint-canvas-zoom > 1 { root.set-paint-canvas-zoom(root.paint-canvas-zoom / 2); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 26px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-show-uv ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: root.paint-show-uv ? DesignTokens.accent : DesignTokens.border;
                                            Text {
                                                text: root.paint-show-uv ? Tr.t("sl.uv_wireframe_overlay") : Tr.t("sl.uv_wireframe_overlay_2");
                                                color: root.paint-show-uv ? DesignTokens.accent : DesignTokens.text-primary;
                                                font-size: DesignTokens.font-caption;
                                                font-weight: root.paint-show-uv ? 700 : 400;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.toggle-paint-show-uv(); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: Tr.t("sl.fill_projection");
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    Text {
                                        text: Tr.t("sl.fill_scope");
                                        color: DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-caption;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for scope in ["ConnectedPixels", "Face", "SelectedFaces", "UvIsland", "Object"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-fill-scope == scope ? DesignTokens.accent : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: radio-button;
                                            accessible-label: scope;
                                            accessible-checked: root.paint-fill-scope == scope;
                                            Text {
                                                text: scope;
                                                color: root.paint-fill-scope == scope ? DesignTokens.on-accent : DesignTokens.text-secondary;
                                                font-size: DesignTokens.font-caption;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            TouchArea { clicked => { root.paint-fill-scope-set(scope); } }
                                        }
                                    }

                                    Text {
                                        text: Tr.t("sl.projection");
                                        color: DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-caption;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for projection in ["Surface", "ScreenSpace"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-projection == projection ? DesignTokens.accent : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: radio-button;
                                            accessible-label: projection;
                                            accessible-checked: root.paint-projection == projection;
                                            Text {
                                                text: projection;
                                                color: root.paint-projection == projection ? DesignTokens.on-accent : DesignTokens.text-secondary;
                                                font-size: DesignTokens.font-caption;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.paint-projection-set(projection); } }
                                        }
                                    }

                                    // Ação: Bake Reference to Texture
                                    Rectangle {
                                        height: 26px;
                                        border-radius: 4px;
                                        background: DesignTokens.surface-raised;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            IconDisplay {
                                                icon: IconSet.Camera;
                                                size: 13px;
                                                stroke: DesignTokens.accent;
                                            }
                                            Text {
                                                text: Tr.t("sl.bake_reference_to_texture");
                                                color: DesignTokens.text-primary;
                                                font-size: DesignTokens.font-caption;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.command-executed("paint.bake_reference"); }
                                        }
                                    }

                                    Text {
                                        text: Tr.t("sl.brush_lock");
                                        color: DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-caption;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for lock in ["None", "FirstObject", "FirstFace"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-lock == lock ? DesignTokens.accent : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: radio-button;
                                            accessible-label: lock;
                                            accessible-checked: root.paint-lock == lock;
                                            Text {
                                                text: lock;
                                                color: root.paint-lock == lock ? DesignTokens.on-accent : DesignTokens.text-secondary;
                                                font-size: DesignTokens.font-caption;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            TouchArea { clicked => { root.paint-lock-set(lock); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: Tr.t("sl.layers");
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 4px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 24px;

                                        Text {
                                            text: root.paint-layer-count;
                                            color: DesignTokens.text-muted;
                                            font-size: DesignTokens.font-caption;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 3px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            IconDisplay { icon: IconSet.Plus; size: 12px; stroke: DesignTokens.text-secondary; }
                                            accessible-role: button;
                                            accessible-label: Tr.t("sl.add_layer");
                                            TouchArea { clicked => { root.paint-layer-added(); } }
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 3px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            IconDisplay { icon: IconSet.FolderOpen; size: 12px; stroke: DesignTokens.text-secondary; }
                                            accessible-role: button;
                                            accessible-label: Tr.t("sl.add_group");
                                            TouchArea { clicked => { root.paint-layer-group-added(); } }
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 3px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            IconDisplay { icon: IconSet.Square; size: 12px; stroke: DesignTokens.text-secondary; }
                                            accessible-role: button;
                                            accessible-label: Tr.t("sl.add_decal_layer");
                                            TouchArea { clicked => { root.paint-decal-layer-added(); } }
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 3px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            IconDisplay { icon: IconSet.Image; size: 12px; stroke: DesignTokens.text-secondary; }
                                            accessible-role: button;
                                            accessible-label: Tr.t("sl.import_decal_image");
                                            TouchArea { clicked => { root.command-file-action("paint.import_decal"); } }
                                        }
                                    }

                                    for layer in root.paint-layers: Rectangle {
                                        height: 30px;
                                        border-radius: 4px;
                                        background: layer.active ? DesignTokens.surface-hover : transparent;
                                        border-width: layer.active ? 1px : 0px;
                                        border-color: DesignTokens.accent;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;

                                            TouchArea {
                                                horizontal-stretch: 1;
                                                clicked => { root.paint-layer-activated(layer.id); }

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: center;

                                                    IconDisplay {
                                                        icon: layer.is-group ? IconSet.FolderOpen : IconSet.Square;
                                                        size: 12px;
                                                        stroke: layer.active ? DesignTokens.accent : DesignTokens.text-muted;
                                                    }
                                                    Text {
                                                        text: layer.name;
                                                        color: layer.active ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                                        font-size: DesignTokens.font-small;
                                                        font-weight: layer.active ? 600 : 400;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: layer.kind-label;
                                                        color: DesignTokens.text-muted;
                                                        font-size: DesignTokens.font-caption;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.ChevronUp; size: 11px; stroke: DesignTokens.text-muted; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.move_layer_up");
                                                TouchArea { clicked => { root.paint-layer-moved(layer.id, 1); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.ChevronDown; size: 11px; stroke: DesignTokens.text-muted; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.move_layer_down");
                                                TouchArea { clicked => { root.paint-layer-moved(layer.id, -1); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay {
                                                    icon: layer.visible ? IconSet.Eye : IconSet.EyeOff;
                                                    size: 12px;
                                                    stroke: layer.visible ? DesignTokens.text-secondary : DesignTokens.text-muted;
                                                }
                                                accessible-role: checkbox;
                                                accessible-label: Tr.t("sl.layer_visible");
                                                accessible-checked: layer.visible;
                                                TouchArea { clicked => { root.paint-layer-visibility-toggled(layer.id); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay {
                                                    icon: layer.locked ? IconSet.Lock : IconSet.LockOpen;
                                                    size: 12px;
                                                    stroke: layer.locked ? DesignTokens.accent : DesignTokens.text-muted;
                                                }
                                                accessible-role: checkbox;
                                                accessible-label: Tr.t("sl.layer_locked");
                                                accessible-checked: layer.locked;
                                                TouchArea { clicked => { root.paint-layer-lock-toggled(layer.id); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.Merge; size: 11px; stroke: DesignTokens.text-muted; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.merge_layer_down");
                                                TouchArea { clicked => { root.paint-layer-merged-down(layer.id); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.Trash2; size: 11px; stroke: DesignTokens.danger; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.remove_layer");
                                                TouchArea { clicked => { root.paint-layer-removed(layer.id); } }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 22px;

                                        Text {
                                            text: Tr.t("sl.opacity");
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-caption;
                                            width: 52px;
                                            vertical-alignment: center;
                                        }
                                        for layer in root.paint-layers: Rectangle {
                                            visible: layer.active;
                                            horizontal-stretch: 1;
                                            height: 22px;

                                            PetuniaSlider {
                                                minimum: 0.0;
                                                maximum: 1.0;
                                                value: layer.opacity;
                                                controlled: true;
                                                changed(value) => { root.paint-layer-opacity-set(layer.id, value); }
                                            }
                                        }
                                    }

                                    if root.active-layer-is-decal: VerticalLayout {
                                        spacing: 6px;
                                        padding-top: 4px;

                                        Text {
                                            text: root.label-decal-transform;
                                            color: DesignTokens.text-primary;
                                            font-size: DesignTokens.font-small;
                                            font-weight: 600;
                                        }

                                        if root.label-decal-hint != "": Text {
                                            text: root.label-decal-hint;
                                            color: DesignTokens.text-muted;
                                            font-size: DesignTokens.font-caption;
                                            wrap: word-wrap;
                                        }

                                        if !root.decal-surface: HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: root.label-decal-position;
                                                color: DesignTokens.text-secondary;
                                                font-size: DesignTokens.font-caption;
                                                width: 52px;
                                                vertical-alignment: center;
                                            }
                                            NumericField {
                                                label: "U";
                                                value: root.decal-center-u;
                                                step: 0.05;
                                                scrubbed(delta, _) => {
                                                    root.decal-center-u = Math.clamp(root.decal-center-u + delta * 0.01, 0.0, 1.0);
                                                    root.decal-transform-changed("", root.decal-center-u, root.decal-center-v, root.decal-scale-u, root.decal-scale-v, root.decal-rotation-deg);
                                                }
                                            }
                                            NumericField {
                                                label: "V";
                                                value: root.decal-center-v;
                                                step: 0.05;
                                                scrubbed(delta, _) => {
                                                    root.decal-center-v = Math.clamp(root.decal-center-v + delta * 0.01, 0.0, 1.0);
                                                    root.decal-transform-changed("", root.decal-center-u, root.decal-center-v, root.decal-scale-u, root.decal-scale-v, root.decal-rotation-deg);
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: root.decal-surface ? root.label-decal-width : root.label-decal-scale;
                                                color: DesignTokens.text-secondary;
                                                font-size: DesignTokens.font-caption;
                                                width: 52px;
                                                vertical-alignment: center;
                                            }
                                            NumericField {
                                                label: root.decal-surface ? "" : "U";
                                                value: root.decal-scale-u;
                                                step: 0.05;
                                                scrubbed(delta, _) => {
                                                    root.decal-scale-u = Math.max(0.01, root.decal-scale-u + delta * 0.01);
                                                    root.decal-transform-changed("", root.decal-center-u, root.decal-center-v, root.decal-scale-u, root.decal-scale-v, root.decal-rotation-deg);
                                                }
                                            }
                                            if !root.decal-surface: NumericField {
                                                label: "V";
                                                value: root.decal-scale-v;
                                                step: 0.05;
                                                scrubbed(delta, _) => {
                                                    root.decal-scale-v = Math.max(0.01, root.decal-scale-v + delta * 0.01);
                                                    root.decal-transform-changed("", root.decal-center-u, root.decal-center-v, root.decal-scale-u, root.decal-scale-v, root.decal-rotation-deg);
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: root.label-decal-rotation;
                                                color: DesignTokens.text-secondary;
                                                font-size: DesignTokens.font-caption;
                                                width: 52px;
                                                vertical-alignment: center;
                                            }
                                            NumericField {
                                                label: Tr.t("sl.deg");
                                                value: root.decal-rotation-deg;
                                                step: 5.0;
                                                scrubbed(delta, _) => {
                                                    root.decal-rotation-deg = root.decal-rotation-deg + delta * 1.0;
                                                    root.decal-transform-changed("", root.decal-center-u, root.decal-center-v, root.decal-scale-u, root.decal-scale-v, root.decal-rotation-deg);
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 26px;
                                            border-radius: 4px;
                                            background: bake-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                IconDisplay { icon: IconSet.Check; size: 12px; stroke: DesignTokens.accent; }
                                                Text {
                                                    text: root.label-decal-bake;
                                                    color: DesignTokens.text-primary;
                                                    font-size: DesignTokens.font-small;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            bake-touch := TouchArea {
                                                clicked => { root.bake-active-decal(); }
                                            }
                                        }

                                        // Decal Set (cap. 39): variantes equivalentes e troca em degraus.
                                        Text {
                                            text: Tr.t("ui.decal_variants");
                                            color: DesignTokens.text-primary;
                                            font-size: DesignTokens.font-small;
                                            font-weight: 600;
                                        }
                                        VerticalLayout {
                                            spacing: 4px;
                                            for name[index] in root.decal-variant-names: BrushChip {
                                                label: name;
                                                active: index == root.decal-variant-index;
                                                clicked => { root.decal-variant-selected(index); }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            BrushChip {
                                                label: Tr.t("ui.decal_add_variant");
                                                clicked => { root.command-file-action("paint.add_decal_variant"); }
                                            }
                                            if root.decal-variant-names.length > 1: BrushChip {
                                                label: Tr.t("ui.decal_remove_variant");
                                                clicked => { root.decal-variant-remove-requested(); }
                                            }
                                        }

                                        Text {
                                            text: Tr.t("ui.decal_animation");
                                            color: DesignTokens.text-primary;
                                            font-size: DesignTokens.font-small;
                                            font-weight: 600;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            NumericField {
                                                label: Tr.t("ui.decal_frame");
                                                full-label: Tr.t("ui.decal_frame");
                                                value: root.decal-frame;
                                                step: 1;
                                                scrubbed(delta, _) => { root.decal-frame-changed(root.decal-frame + Math.round(delta)); }
                                                text-committed(text) => {
                                                    if !text.is-float() { return false; }
                                                    root.decal-frame-changed(Math.round(text.to-float()));
                                                    return true;
                                                }
                                            }
                                            NumericField {
                                                label: Tr.t("ui.decal_fps");
                                                full-label: Tr.t("ui.decal_fps");
                                                value: root.decal-track-fps;
                                                step: 1;
                                                scrubbed(delta, _) => { root.decal-fps-changed(root.decal-track-fps + Math.round(delta)); }
                                                text-committed(text) => {
                                                    if !text.is-float() { return false; }
                                                    root.decal-fps-changed(text.to-float());
                                                    return true;
                                                }
                                            }
                                            NumericField {
                                                label: Tr.t("ui.decal_length");
                                                full-label: Tr.t("ui.decal_length");
                                                value: root.decal-track-length;
                                                step: 1;
                                                scrubbed(delta, _) => { root.decal-length-changed(root.decal-track-length + Math.round(delta)); }
                                                text-committed(text) => {
                                                    if !text.is-float() { return false; }
                                                    root.decal-length-changed(Math.round(text.to-float()));
                                                    return true;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            BrushChip {
                                                label: Tr.t("ui.decal_set_key");
                                                active: root.decal-frame-keyed;
                                                clicked => { root.decal-key-set-requested(); }
                                            }
                                            if root.decal-frame-keyed: BrushChip {
                                                label: Tr.t("ui.decal_remove_key");
                                                clicked => { root.decal-key-remove-requested(); }
                                            }
                                            if root.decal-has-keys: BrushChip {
                                                label: root.decal-playing ? Tr.t("ui.decal_stop") : Tr.t("ui.decal_play");
                                                active: root.decal-playing;
                                                clicked => { root.decal-play-toggled(); }
                                            }
                                        }
                                        Text {
                                            text: root.decal-has-keys ? root.decal-keys-text : Tr.t("ui.decal_no_keys");
                                            color: DesignTokens.text-muted;
                                            font-size: DesignTokens.font-caption;
                                            wrap: word-wrap;
                                        }
                                        BrushChip {
                                            label: Tr.t("ui.decal_export_frames");
                                            clicked => { root.command-file-action("paint.export_decal_frames"); }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: Tr.t("sl.color_palette");
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 6px;
                                            background: root.paint-color;
                                            border-width: 2px;
                                            border-color: DesignTokens.accent;
                                        }

                                        Text {
                                            text: root.label-active-brush-color;
                                            color: DesignTokens.text-primary;
                                            font-size: DesignTokens.font-small;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        ColorSwatch {
                                            swatch-color: ColorPresets.paint-violet;
                                            selected: root.paint-color == ColorPresets.paint-violet;
                                            clicked => { root.paint-color-changed(0.71, 0.55, 1.0); }
                                        }
                                        ColorSwatch {
                                            swatch-color: ColorPresets.paint-red;
                                            selected: root.paint-color == ColorPresets.paint-red;
                                            clicked => { root.paint-color-changed(0.93, 0.27, 0.27); }
                                        }
                                        ColorSwatch {
                                            swatch-color: ColorPresets.paint-green;
                                            selected: root.paint-color == ColorPresets.paint-green;
                                            clicked => { root.paint-color-changed(0.13, 0.77, 0.37); }
                                        }
                                        ColorSwatch {
                                            swatch-color: ColorPresets.paint-blue;
                                            selected: root.paint-color == ColorPresets.paint-blue;
                                            clicked => { root.paint-color-changed(0.23, 0.51, 0.96); }
                                        }
                                        ColorSwatch {
                                            swatch-color: ColorPresets.paint-yellow;
                                            selected: root.paint-color == ColorPresets.paint-yellow;
                                            clicked => { root.paint-color-changed(0.92, 0.70, 0.03); }
                                        }
                                        ColorSwatch {
                                            swatch-color: ColorPresets.paint-white;
                                            selected: root.paint-color == ColorPresets.paint-white;
                                            clicked => { root.paint-color-changed(1.0, 1.0, 1.0); }
                                        }
                                        ColorSwatch {
                                            swatch-color: ColorPresets.paint-gray;
                                            selected: root.paint-color == ColorPresets.paint-gray;
                                            clicked => { root.paint-color-changed(0.42, 0.45, 0.50); }
                                        }
                                        ColorSwatch {
                                            swatch-color: ColorPresets.paint-black;
                                            selected: root.paint-color == ColorPresets.paint-black;
                                            clicked => { root.paint-color-changed(0.07, 0.07, 0.07); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        padding-top: 4px;
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                IconDisplay { icon: IconSet.Download; size: 12px; stroke: DesignTokens.text-primary; }
                                                Text { text: Tr.t("sl.import"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.command-file-action("palette.import"); } }
                                        }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                IconDisplay { icon: IconSet.Upload; size: 12px; stroke: DesignTokens.text-primary; }
                                                Text { text: Tr.t("sl.export"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.command-file-action("palette.export"); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: Tr.t("sl.brush_settings");
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: Tr.t("sl.size") + ": \{Math.round(root.brush-size * 10) / 10}";
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-small;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-size-changed(Math.max(0.1, root.brush-size - 0.2)); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-size-changed(Math.min(10.0, root.brush-size + 0.2)); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: Tr.t("sl.opacity") + ": \{Math.round(root.brush-opacity * 100)}%";
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-small;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-opacity-changed(Math.max(0.05, root.brush-opacity - 0.1)); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-opacity-changed(Math.min(1.0, root.brush-opacity + 0.1)); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: Tr.t("sl.hardness") + ": \{Math.round(root.brush-hardness * 100)}%";
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-small;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-hardness-changed(Math.max(0.0, root.brush-hardness - 0.1)); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-hardness-changed(Math.min(1.0, root.brush-hardness + 0.1)); } }
                                        }
                                    }

                                    // --- Pincel: tipo, fluxo, estabilizador, variação, ponta, mistura ---
                                    Text { text: Tr.t("sl.brush_type"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-small; }
                                    HorizontalLayout { spacing: 4px;
                                        BrushChip { label: Tr.t("sl.brush"); active: root.active-tool == "brush"; clicked => { root.active-tool-changed("brush"); } }
                                        BrushChip { label: Tr.t("sl.brush_type_pixel"); active: root.active-tool == "pixel"; clicked => { root.active-tool-changed("pixel"); } }
                                        BrushChip { label: Tr.t("sl.airbrush"); active: root.active-tool == "airbrush"; clicked => { root.active-tool-changed("airbrush"); } }
                                    }
                                    HorizontalLayout { spacing: 4px;
                                        BrushChip { label: Tr.t("sl.brush_type_spray"); active: root.active-tool == "spray"; clicked => { root.active-tool-changed("spray"); } }
                                        BrushChip { label: Tr.t("sl.brush_type_smudge"); active: root.active-tool == "smudge"; clicked => { root.active-tool-changed("smudge"); } }
                                        BrushChip { label: Tr.t("sl.brush_type_blur"); active: root.active-tool == "blur"; clicked => { root.active-tool-changed("blur"); } }
                                    }
                                    HorizontalLayout { spacing: 4px;
                                        BrushChip { label: Tr.t("sl.brush_type_dodge"); active: root.active-tool == "dodge"; clicked => { root.active-tool-changed("dodge"); } }
                                        BrushChip { label: Tr.t("sl.brush_type_burn"); active: root.active-tool == "burn"; clicked => { root.active-tool-changed("burn"); } }
                                        BrushChip { label: Tr.t("sl.brush_type_clone"); active: root.active-tool == "clone"; clicked => { root.active-tool-changed("clone"); } }
                                    }
                                    if root.active-tool == "clone": Text {
                                        text: root.clone-source-set ? Tr.t("sl.brush_clone_ready") : Tr.t("sl.brush_clone_hint");
                                        color: DesignTokens.text-muted;
                                        font-size: DesignTokens.font-caption;
                                        wrap: word-wrap;
                                    }
                                    BrushStepper {
                                        label: Tr.t("sl.brush_flow");
                                        value-text: "\{Math.round(root.brush-flow * 100)}%";
                                        minus => { root.brush-param-changed("flow", Math.max(0.0, root.brush-flow - 0.1)); }
                                        plus => { root.brush-param-changed("flow", Math.min(1.0, root.brush-flow + 0.1)); }
                                    }
                                    BrushStepper {
                                        label: Tr.t("sl.brush_spacing");
                                        value-text: "\{Math.round(root.brush-spacing * 100)}%";
                                        minus => { root.brush-param-changed("spacing", Math.max(0.01, root.brush-spacing - 0.05)); }
                                        plus => { root.brush-param-changed("spacing", Math.min(1.0, root.brush-spacing + 0.05)); }
                                    }
                                    BrushStepper {
                                        label: Tr.t("sl.brush_smoothing");
                                        value-text: "\{Math.round(root.brush-smoothing * 100)}%";
                                        minus => { root.brush-param-changed("smoothing", Math.max(0.0, root.brush-smoothing - 0.1)); }
                                        plus => { root.brush-param-changed("smoothing", Math.min(0.95, root.brush-smoothing + 0.1)); }
                                    }
                                    BrushStepper {
                                        label: Tr.t("sl.brush_size_jitter");
                                        value-text: "\{Math.round(root.brush-size-jitter * 100)}%";
                                        minus => { root.brush-param-changed("size_jitter", Math.max(0.0, root.brush-size-jitter - 0.1)); }
                                        plus => { root.brush-param-changed("size_jitter", Math.min(1.0, root.brush-size-jitter + 0.1)); }
                                    }
                                    BrushStepper {
                                        label: Tr.t("sl.brush_opacity_jitter");
                                        value-text: "\{Math.round(root.brush-opacity-jitter * 100)}%";
                                        minus => { root.brush-param-changed("opacity_jitter", Math.max(0.0, root.brush-opacity-jitter - 0.1)); }
                                        plus => { root.brush-param-changed("opacity_jitter", Math.min(1.0, root.brush-opacity-jitter + 0.1)); }
                                    }
                                    BrushStepper {
                                        label: Tr.t("sl.brush_scatter");
                                        value-text: "\{Math.round(root.brush-scatter * 100)}%";
                                        minus => { root.brush-param-changed("scatter", Math.max(0.0, root.brush-scatter - 0.1)); }
                                        plus => { root.brush-param-changed("scatter", Math.min(2.0, root.brush-scatter + 0.1)); }
                                    }
                                    if root.active-tool == "spray": BrushStepper {
                                        label: Tr.t("sl.brush_spray_density");
                                        value-text: "\{Math.round(root.brush-spray-density * 100)}%";
                                        minus => { root.brush-param-changed("spray_density", Math.max(0.05, root.brush-spray-density - 0.05)); }
                                        plus => { root.brush-param-changed("spray_density", Math.min(1.0, root.brush-spray-density + 0.05)); }
                                    }
                                    Text { text: Tr.t("sl.brush_tip"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-small; }
                                    HorizontalLayout { spacing: 4px;
                                        BrushChip { label: Tr.t("sl.brush_tip_round"); active: root.brush-tip == "round"; clicked => { root.brush-tip-changed("round"); } }
                                        BrushChip { label: Tr.t("sl.brush_tip_square"); active: root.brush-tip == "square"; clicked => { root.brush-tip-changed("square"); } }
                                        BrushChip { label: Tr.t("sl.brush_tip_diamond"); active: root.brush-tip == "diamond"; clicked => { root.brush-tip-changed("diamond"); } }
                                    }
                                    if root.brush-tip != "round": BrushStepper {
                                        label: Tr.t("sl.brush_angle");
                                        value-text: "\{Math.round(root.brush-angle)}°";
                                        minus => { root.brush-param-changed("angle", Math.max(-180.0, root.brush-angle - 15.0)); }
                                        plus => { root.brush-param-changed("angle", Math.min(180.0, root.brush-angle + 15.0)); }
                                    }
                                    BrushStepper {
                                        label: Tr.t("sl.brush_roundness");
                                        value-text: "\{Math.round(root.brush-roundness * 100)}%";
                                        minus => { root.brush-param-changed("roundness", Math.max(0.1, root.brush-roundness - 0.1)); }
                                        plus => { root.brush-param-changed("roundness", Math.min(1.0, root.brush-roundness + 0.1)); }
                                    }
                                    Text { text: Tr.t("sl.brush_blend"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-small; }
                                    HorizontalLayout { spacing: 4px;
                                        BrushChip { label: Tr.t("sl.brush_blend_normal"); active: root.brush-blend == "normal"; clicked => { root.brush-blend-changed("normal"); } }
                                        BrushChip { label: Tr.t("sl.brush_blend_multiply"); active: root.brush-blend == "multiply"; clicked => { root.brush-blend-changed("multiply"); } }
                                        BrushChip { label: Tr.t("sl.brush_blend_screen"); active: root.brush-blend == "screen"; clicked => { root.brush-blend-changed("screen"); } }
                                    }
                                    HorizontalLayout { spacing: 4px;
                                        BrushChip { label: Tr.t("sl.brush_blend_add"); active: root.brush-blend == "add"; clicked => { root.brush-blend-changed("add"); } }
                                        BrushChip { label: Tr.t("sl.brush_blend_darken"); active: root.brush-blend == "darken"; clicked => { root.brush-blend-changed("darken"); } }
                                        BrushChip { label: Tr.t("sl.brush_blend_lighten"); active: root.brush-blend == "lighten"; clicked => { root.brush-blend-changed("lighten"); } }
                                    }
                                    Text { text: Tr.t("sl.brush_presets"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-small; }
                                    VerticalLayout { spacing: 3px;
                                        for preset-name[preset-index] in root.brush-presets: BrushChip {
                                            label: preset-name;
                                            active: root.brush-preset-index == preset-index;
                                            clicked => { root.brush-preset-applied(preset-index); }
                                        }
                                    }
                                    HorizontalLayout { spacing: 4px;
                                        BrushChip { label: Tr.t("sl.brush_preset_save"); clicked => { root.brush-preset-saved(); } }
                                        BrushChip { label: Tr.t("sl.brush_preset_delete"); clicked => { root.brush-preset-deleted(root.brush-preset-index); } }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: Tr.t("sl.symmetry");
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-small;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.paint-symmetry-x ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: "X"; color: root.paint-symmetry-x ? DesignTokens.on-accent : DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-symmetry-x-toggled(); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.paint-symmetry-y ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: "Y"; color: root.paint-symmetry-y ? DesignTokens.on-accent : DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-symmetry-y-toggled(); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.paint-symmetry-z ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: "Z"; color: root.paint-symmetry-z ? DesignTokens.on-accent : DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-symmetry-z-toggled(); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: Tr.t("sl.target");
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-small;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 64px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: !root.paint-target-vertex ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: Tr.t("sl.texture"); color: !root.paint-target-vertex ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-target-vertex-changed(false); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 58px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.paint-target-vertex ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: Tr.t("sl.vertex"); color: root.paint-target-vertex ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-target-vertex-changed(true); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: Tr.t("sl.mask_selection");
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-small;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 44px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.paint-mask-selection ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: root.paint-mask-selection ? Tr.t("sl.on") : Tr.t("sl.off"); color: root.paint-mask-selection ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-mask-selection-toggled(); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: Tr.t("sl.texture_layers");
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        height: 28px;
                                        background: DesignTokens.surface-raised;
                                        border-radius: 4px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            alignment: center;
                                            IconDisplay { icon: IconSet.Layers3; size: 14px; stroke: DesignTokens.accent; }
                                            Text { text: root.label-albedo-base-color; color: DesignTokens.text-primary; font-size: DesignTokens.font-small; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: Tr.t("sl.active"); color: DesignTokens.success; font-size: DesignTokens.font-caption; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                            // Animate: Creature → Motions → Motion (Styles + sliders).
                            // Só a moldura vem daqui; o conteúdo é de animate.slint.
                            if active-workspace == "ANIMATE": VerticalLayout {
                                spacing: 10px;

                                // Recolhe sozinha quando já existe uma criatura (divulgação
                                // progressiva: o espaço vai para os sliders); o usuário
                                // reabre com um clique.
                                InspectorSection {
                                    title: root.animate-texts.title-creature;
                                    open: !root.animate-has-creature;
                                    toggled => { self.open = !self.open; }

                                    AnimateCreatureBody {
                                        texts: root.animate-texts;
                                        creatures: root.animate-creatures;
                                        presets: root.animate-creature-presets;
                                        has-creature: root.animate-has-creature;
                                        action(a, b, v) => { root.animate-action(a, b, v); }
                                    }
                                }

                                InspectorSection {
                                    title: root.animate-texts.title-picker;
                                    open: true;
                                    toggled => { self.open = !self.open; }

                                    AnimateMotionBody {
                                        texts: root.animate-texts;
                                        catalog: root.animate-catalog;
                                        motions: root.animate-motions;
                                        has-motion: root.animate-has-motion;
                                        has-creature: root.animate-has-creature;
                                        can-fit: root.animate-can-fit;
                                        fit-tip: root.animate-fit-tip;
                                        linked-models: root.animate-linked-models;
                                        action(a, b, v) => { root.animate-action(a, b, v); }
                                    }
                                }

                                if root.animate-has-motion: InspectorSection {
                                    title: root.animate-texts.title-motion;
                                    open: true;
                                    toggled => { self.open = !self.open; }

                                    AnimateTweakBody {
                                        texts: root.animate-texts;
                                        styles: root.animate-styles;
                                        params: root.animate-params;
                                        has-motion: root.animate-has-motion;
                                        rig-error: root.animate-rig-error;
                                        show-advanced: root.animate-show-advanced;
                                        show-bones: root.animate-show-bones;
                                        stepped: root.animate-stepped;
                                        root-motion: root.animate-root-motion;
                                        root-motion-supported: root.animate-root-motion-supported;
                                        action(a, b, v) => { root.animate-action(a, b, v); }
                                    }
                                }

                            }

                            if active-workspace == "UV": VerticalLayout {
                                spacing: 10px;

                                InspectorSection {
                                    title: Tr.t("sl.uv_operations");
                                    open: true;
                                    toggled => { self.open = !self.open; }

                                    VerticalLayout {
                                        spacing: 8px;
                                        padding-top: 4px;

                                        Rectangle {
                                            height: 32px;
                                            border-radius: 5px;
                                            background: DesignTokens.accent;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                IconDisplay { icon: IconSet.Maximize2; size: 14px; stroke: DesignTokens.on-accent; }
                                                Text { text: root.label-unwrap-mesh; color: DesignTokens.on-accent; font-size: DesignTokens.font-small; font-weight: 700; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.command-executed("uv.unwrap"); } }
                                        }

                                        Rectangle {
                                            height: 32px;
                                            border-radius: 5px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                IconDisplay { icon: IconSet.Grid2x2; size: 14px; stroke: DesignTokens.text-primary; }
                                                Text { text: root.label-pack-islands; color: DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.command-executed("uv.pack_islands"); } }
                                        }
                                    }
                                }

                                InspectorSection {
                                    title: Tr.t("sl.uv_editor");
                                    open: true;
                                    toggled => { self.open = !self.open; }

                                    VerticalLayout {
                                        spacing: 6px;
                                        padding-top: 4px;

                                        // Caixa 0..1 com o layout real das UVs.
                                        uv-box := Rectangle {
                                            width: 256px;
                                            height: 256px;
                                            horizontal-stretch: 0;
                                            background: DesignTokens.canvas;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            clip: true;

                                            // Textura ativa sob a malha UV
                                            if root.uv-show-texture: Image {
                                                width: 100%;
                                                height: 100%;
                                                image-fit: fill;
                                                source: root.paint-canvas-image;
                                                opacity: 0.65;
                                            }

                                            // Selected UV faces / Faces UV selecionadas
                                            Path {
                                                fill: DesignTokens.uv-selected.with-alpha(0.2);
                                                stroke: DesignTokens.uv-selected;
                                                stroke-width: 1.5px;
                                                commands: root.uv-selected-commands;
                                            }

                                            // Base UV mesh wireframe / Malha de arame UV base
                                            Path {
                                                fill: transparent;
                                                stroke: DesignTokens.accent.with-alpha(0.65);
                                                stroke-width: 1px;
                                                commands: root.uv-layout-commands;
                                            }

                                            // Seam edges / Arestas de costura
                                            Path {
                                                fill: transparent;
                                                stroke: DesignTokens.uv-seam;
                                                stroke-width: 2px;
                                                commands: root.uv-seam-commands;
                                            }

                                            // Pinned UV vertices / Vértices UV fixados
                                            Path {
                                                fill: DesignTokens.uv-pinned;
                                                stroke: DesignTokens.uv-pinned-outline;
                                                stroke-width: 1px;
                                                commands: root.uv-pinned-commands;
                                            }

                                            TouchArea {
                                                property <bool> extend: false;
                                                property <bool> dragging: false;
                                                property <float> last-u: 0.0;
                                                property <float> last-v: 0.0;
                                                pointer-event(event) => {
                                                    extend = event.modifiers.shift;
                                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                        dragging = true;
                                                        last-u = self.mouse-x / self.width;
                                                        last-v = 1.0 - self.mouse-y / self.height;
                                                        // O domínio usa UV com origem embaixo; a caixa desenha
                                                        // com origem em cima, então o V é invertido aqui.
                                                        root.uv-editor-clicked(
                                                            last-u,
                                                            last-v,
                                                            extend,
                                                        );
                                                    } else if event.kind == PointerEventKind.up {
                                                        dragging = false;
                                                    }
                                                }
                                                moved => {
                                                    if self.pressed && dragging {
                                                        let cur-u = self.mouse-x / self.width;
                                                        let cur-v = 1.0 - self.mouse-y / self.height;
                                                        let du = cur-u - last-u;
                                                        let dv = cur-v - last-v;
                                                        if Math.abs(du) > 0.002 || Math.abs(dv) > 0.002 {
                                                            root.uv-moved(du, dv);
                                                            last-u = cur-u;
                                                            last-v = cur-v;
                                                        }
                                                    }
                                                }
                                            }

                                            // Contorno do espaço 0..1.
                                            Rectangle { x: 0; y: 0; width: 100%; height: 1px; background: DesignTokens.border; }
                                            Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: DesignTokens.border; }
                                            Rectangle { x: 0; y: 0; width: 1px; height: 100%; background: DesignTokens.border; }
                                            Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: 100%; background: DesignTokens.border; }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            height: 26px;
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: root.uv-show-texture ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: root.uv-show-texture ? DesignTokens.accent : DesignTokens.border;
                                                Text {
                                                    text: root.uv-show-texture ? Tr.t("sl.show_texture") : Tr.t("sl.show_texture_2");
                                                    color: root.uv-show-texture ? DesignTokens.accent : DesignTokens.text-primary;
                                                    font-size: DesignTokens.font-caption;
                                                    font-weight: root.uv-show-texture ? 700 : 400;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea { clicked => { root.toggle-uv-show-texture(); } }
                                            }
                                        }

                                        Text {
                                            text: "\{root.uv-island-count} island(s)  ·  \{root.uv-face-count} face(s)  ·  selected: \{root.uv-selected-face}  ·  UV set: \{root.uv-selected-count}";
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-caption;
                                        }

                                        HorizontalLayout {
                                            spacing: 4px;
                                            height: 26px;

                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: "← U"; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.move_uv_left");
                                                TouchArea { clicked => { root.uv-moved(-0.05, 0.0); } }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: "U →"; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.move_uv_right");
                                                TouchArea { clicked => { root.uv-moved(0.05, 0.0); } }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: "↓ V"; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.move_uv_down");
                                                TouchArea { clicked => { root.uv-moved(0.0, -0.05); } }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: "V ↑"; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.move_uv_up");
                                                TouchArea { clicked => { root.uv-moved(0.0, 0.05); } }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 4px;
                                            height: 26px;

                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.scale_2"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.scale_uv_down");
                                                TouchArea { clicked => { root.uv-scaled(0.9); } }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.scale_3"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.scale_uv_up");
                                                TouchArea { clicked => { root.uv-scaled(1.1); } }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.rotate_2"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.rotate_uv_counter_clockwise");
                                                TouchArea { clicked => { root.uv-rotated(-15.0); } }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.rotate_3"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.rotate_uv_clockwise");
                                                TouchArea { clicked => { root.uv-rotated(15.0); } }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            height: 28px;

                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.90_ccw"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.rotate_uv_90_degrees_counter_clockwise");
                                                TouchArea { clicked => { root.uv-rotated(-90.0); } }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.90_cw"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.rotate_uv_90_degrees_clockwise");
                                                TouchArea { clicked => { root.uv-rotated(90.0); } }
                                            }
                                        }
                                        if root.uv-layout-truncated: Text {
                                            text: Tr.t("sl.layout_truncated_only_the_first_2000_faces_a");
                                            color: DesignTokens.text-muted;
                                            font-size: DesignTokens.font-caption;
                                            wrap: word-wrap;
                                        }

                                        if !root.decal-surface: HorizontalLayout {
                                            spacing: 6px;
                                            height: 28px;

                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.mark_unmark_seams"); color: DesignTokens.text-primary; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.toggle_seams_on_the_selected_face");
                                                TouchArea { clicked => { root.uv-seam-toggled(); } }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.clear_seams"); color: DesignTokens.danger; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.clear_all_seams");
                                                TouchArea { clicked => { root.uv-seams-cleared(); } }
                                            }
                                        }

                                        HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.pin_unpin_p"); color: DesignTokens.text-primary; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.pin_or_unpin_uv_vertices_of_the_selected_fac");
                                                TouchArea { clicked => { root.toggle-uv-pins(); } }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.clear_pins"); color: DesignTokens.danger; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.clear_all_uv_pins");
                                                TouchArea { clicked => { root.clear-all-uv-pins(); } }
                                            }
                                        }

                                        HorizontalLayout {
                                            height: 28px;
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.equalize_texel_density"); color: DesignTokens.text-primary; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.equalize_texel_density_across_uv_islands");
                                                TouchArea { clicked => { root.uv-equalize-texel-density(); } }
                                            }
                                        }

                                        HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.stitch_seams"); color: DesignTokens.text-primary; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.weld_coincident_3d_edges_that_have_split_uv_");
                                                TouchArea { clicked => { root.command-executed("uv.stitch"); } }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text { text: Tr.t("sl.relax_uv"); color: DesignTokens.text-primary; font-size: DesignTokens.font-small; horizontal-alignment: center; vertical-alignment: center; }
                                                accessible-role: button;
                                                accessible-label: Tr.t("sl.smooth_unpinned_uv_island_corners_to_minimiz");
                                                TouchArea { clicked => { root.command-executed("uv.relax"); } }
                                            }
                                        }
                                    }
                                }

                                InspectorSection {
                                    title: Tr.t("sl.uv_statistics");
                                    open: true;
                                    toggled => { self.open = !self.open; }

                                    NumericField { label: Tr.t("surface.export_padding"); value: root.export-padding; step:1;
                                        text-committed(text) => {return root.extension-parameter-set("padding",text);}
                                        scrubbed(delta,fine) => {root.extension-parameter-set("padding","\{root.export-padding+delta*(fine?0.1:1)}");}
                                    }
                                    Text {
                                        text: root.uv-stats;
                                        wrap: word-wrap;
                                        color: DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-small;
                                    }
                                }
                            }

                            }
                        }
                        }
                    }

                    // Picture-in-picture do Paint: o canvas 2D ocupa a viewport e o 3D vira um inset
                    // (clique no inset para voltar). A câmera 3D enquadra a área pintada.
                    if root.paint-pip && root.active-workspace == "PAINT": Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        background: DesignTokens.canvas;

                        PaintCanvasSurface {
                            width: parent.width;
                            height: parent.height;
                            canvas-image: root.paint-canvas-image;
                            zoom: root.paint-canvas-zoom;
                            show-brush: root.brush-stroke-tool(root.active-tool);
                            brush-diameter: root.brush-size * 16px;
                            brush-hardness: root.brush-hardness;
                            brush-strength: root.brush-opacity * root.brush-flow;
                            brush-tint: root.paint-color;
                            brush-erase: root.active-tool == "eraser";
                            brush-hard-edge: root.active-tool == "pixel";
                            show-uv: root.paint-show-uv;
                            uv-commands: root.uv-layout-commands;
                            show-grid: root.paint-pixel-grid;
                            grid-commands: root.paint-canvas-grid-commands;
                            select-mode: root.active-tool == "select";
                            selected-commands: root.uv-selected-commands;
                            select-region(x0, y0, x1, y1, extend, subtract, island) => { root.paint-2d-select(x0, y0, x1, y1, extend, subtract, island); }
                            stroke(x, y, phase, shift, raster) => { root.paint-2d-stroke(x, y, phase, shift, raster); }
                            zoom-step(direction) => {
                                if direction > 0 && root.paint-canvas-zoom < 16 { root.set-paint-canvas-zoom(root.paint-canvas-zoom * 2); }
                                if direction < 0 && root.paint-canvas-zoom > 1 { root.set-paint-canvas-zoom(root.paint-canvas-zoom / 2); }
                            }
                        }

                        // Inset 3D ao vivo (mesma imagem da viewport), com cantos arredondados.
                        Rectangle {
                            width: min(300px, parent.width * 0.32);
                            height: self.width * (parent.height / max(parent.width, 1px));
                            x: parent.width - self.width - 14px;
                            y: parent.height - self.height - 14px;
                            border-radius: DesignTokens.radius-panel;
                            background: DesignTokens.canvas;
                            border-width: 2px;
                            border-color: pip-touch.has-hover ? DesignTokens.accent : DesignTokens.border-strong;
                            animate border-color { duration: Motion.fast; easing: ease-out; }
                            drop-shadow-blur: DesignTokens.elevation-2-blur;
                            drop-shadow-color: DesignTokens.elevation-2-color;
                            drop-shadow-offset-y: DesignTokens.elevation-2-offset;
                            clip: true;
                            accessible-role: button;
                            accessible-label: Tr.t("sl.paint_pip_back");
                            Image { width: 100%; height: 100%; image-fit: contain; source: root.viewport-image; }
                            pip-touch := TouchArea {
                                clicked => { root.paint-pip-toggle-requested(); }
                                Tooltip { VerticalLayout { padding: 6px; Text { text: Tr.t("sl.paint_pip_back"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; } } }
                            }
                        }
                    }
}

                    // Viewport dividida (opcional): segunda vista 3D só de navegação.
                    if root.split-enabled: Rectangle {
                        x: (parent.width - 4px) / 2;
                        y: 0px;
                        width: 4px;
                        height: parent.height;
                        background: DesignTokens.border-strong;
                    }

                    if root.split-enabled: split-region := Rectangle {
                        x: (parent.width + 4px) / 2;
                        y: 0px;
                        width: (parent.width - 4px) / 2;
                        height: parent.height;
                        clip: true;
                        background: DesignTokens.canvas;
                        border-width: 1px;
                        border-color: DesignTokens.border;

                        changed width => { root.split-resized(self.width / 1px, self.height / 1px); }
                        changed height => { root.split-resized(self.width / 1px, self.height / 1px); }
                        init => { root.split-resized(self.width / 1px, self.height / 1px); }

                        Image {
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                            source: root.split-view-image;
                        }

                        split-touch := TouchArea {
                            property <bool> orbiting: false;
                            property <bool> panning: false;
                            property <length> last-x;
                            property <length> last-y;
                            mouse-cursor: (self.orbiting || self.panning) ? grabbing : default;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                    if event.button == PointerEventButton.left { self.orbiting = true; }
                                    else if event.button == PointerEventButton.middle || event.button == PointerEventButton.right { self.panning = true; }
                                } else if event.kind == PointerEventKind.up {
                                    self.orbiting = false;
                                    self.panning = false;
                                }
                            }
                            moved => {
                                if self.orbiting {
                                    root.split-orbit((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                                } else if self.panning {
                                    root.split-pan((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                                }
                                self.last-x = self.mouse-x;
                                self.last-y = self.mouse-y;
                            }
                            scroll-event(event) => {
                                root.split-zoom(event.delta-y / 1px);
                                return accept;
                            }
                        }

                        // Presets da vista secundária + fechar
                        Rectangle {
                            x: 8px;
                            y: 8px;
                            height: 28px;
                            width: split-presets.preferred-width + 8px;
                            border-radius: DesignTokens.radius-panel;
                            background: DesignTokens.surface-raised.with-alpha(0.94);
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            split-presets := HorizontalLayout {
                                padding: 3px;
                                spacing: 2px;
                                for entry in [
                                    { id: "persp", label: Tr.t("sl.split_persp") },
                                    { id: "front", label: Tr.t("sl.split_front") },
                                    { id: "back", label: Tr.t("sl.split_back") },
                                    { id: "left", label: Tr.t("sl.split_left") },
                                    { id: "right", label: Tr.t("sl.split_right") },
                                    { id: "top", label: Tr.t("sl.split_top") },
                                ]: Rectangle {
                                    width: max(34px, pill-text.preferred-width + 14px);
                                    border-radius: DesignTokens.radius-control;
                                    background: root.split-preset == entry.id ? DesignTokens.accent : (pill-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-hover.with-alpha(0));
                                    animate background { duration: Motion.fast; easing: ease-out; }
                                    accessible-role: button;
                                    accessible-label: entry.label;
                                    accessible-checked: root.split-preset == entry.id;
                                    pill-text := Text { text: entry.label; color: root.split-preset == entry.id ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    pill-touch := TouchArea { clicked => { root.split-preset-requested(entry.id); } }
                                }
                                TopAction {
                                    icon: IconSet.X;
                                    semantic-label: Tr.t("sl.split_close");
                                    width: 24px;
                                    height: 22px;
                                    clicked => { root.split-toggle-requested(); }
                                }
                            }
                        }
                    }
                }


            }

            Rectangle {
                height: 30px;
                background: DesignTokens.surface;
                border-width: 1px;
                border-color: DesignTokens.border;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: center;

                    // Status indicator dot
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: root.status-color;
                        animate background { duration: Motion.medium; easing: ease-out; }
                    }

                    // Mensagem de status: destaque só quando é aviso/erro/sucesso;
                    // feedback neutro (ex.: clique no vazio) fica discreto.
                    Text {
                        text: root.status-message;
                        color: root.status-severity > 0 ? DesignTokens.text-primary : DesignTokens.text-secondary;
                        font-size: DesignTokens.font-small;
                        font-weight: root.status-severity > 0 ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 280px;
                    }
                    // Dica da ferramenta, ou os gestos básicos como chips de tecla.
                    // Os chips somem da direita para a esquerda em janelas estreitas,
                    // em vez de truncar o texto (plano de UI F3).
                    if root.context-hint != "": Text { text: root.context-hint; color: DesignTokens.text-muted; font-size: DesignTokens.font-small; vertical-alignment: center; overflow: elide; max-width: 420px; }
                    // Sem depender da largura da janela (isso cria binding loop
                    // com o layout): o grupo recorta à direita quando falta espaço.
                    if root.context-hint == "": Rectangle {
                        clip: true;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        preferred-width: hints-row.preferred-width;
                        hints-row := HorizontalLayout {
                            spacing: DesignTokens.space-md;
                            alignment: start;
                            KeyHint { key: Tr.t("sl.key_lmb"); action: Tr.t("sl.hint_select"); }
                            KeyHint { key: Tr.t("sl.key_mmb"); action: Tr.t("sl.hint_orbit"); }
                            KeyHint { key: Tr.t("sl.key_shift_mmb"); action: Tr.t("sl.hint_pan"); }
                            KeyHint { key: Tr.t("sl.key_wheel"); action: Tr.t("sl.hint_zoom"); }
                        }
                    }

                    if root.precision-mode: Rectangle {
                        border-radius: 3px;
                        background: DesignTokens.badge-precision-bg;
                        border-width: 1px;
                        border-color: DesignTokens.badge-precision-border;
                        HorizontalLayout {
                            padding-left: 5px; padding-right: 5px;
                            Text { text: Tr.t("sl.shift_precision_0_1"); color: DesignTokens.badge-precision-text; font-size: DesignTokens.font-caption; font-weight: 700; font-family: "monospace"; }
                        }
                    }
                    if root.snap-mode: Rectangle {
                        border-radius: 3px;
                        background: DesignTokens.badge-snap-bg;
                        border-width: 1px;
                        border-color: DesignTokens.badge-snap-border;
                        HorizontalLayout {
                            padding-left: 5px; padding-right: 5px;
                            Text { text: Tr.t("sl.ctrl_snap"); color: DesignTokens.badge-snap-text; font-size: DesignTokens.font-caption; font-weight: 700; font-family: "monospace"; }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if (root.hover-label != "" || root.selection-summary != ""): Text {
                        text: root.hover-label != "" ? root.hover-label : root.selection-summary;
                        color: root.hover-label != "" ? DesignTokens.hover : DesignTokens.text-primary;
                        font-size: DesignTokens.font-small;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    if (root.hover-label != "" || root.selection-summary != ""): Rectangle {
                        width: 1px;
                        height: 14px;
                        background: DesignTokens.border;
                    }

                    Text { text: root.scene-stats; color: DesignTokens.text-secondary; font-size: DesignTokens.font-small; font-weight: 500; vertical-alignment: center; }

                    Rectangle { width: 1px; height: 14px; background: DesignTokens.border; }

                    Text {
                        text: saved ? Tr.t("sl.saved") : Tr.t("sl.unsaved");
                        color: saved ? DesignTokens.success : DesignTokens.warning;
                        font-size: DesignTokens.font-small;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Overlay: Scene Drawer
        if scene-drawer-visible && compact-shell: Rectangle {
            x: parent.width - self.width - 8px;
            y: 42px;
            width: 250px;
            height: parent.height - 72px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            border-radius: 6px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: root.label-parts;
                        color: DesignTokens.text-primary;
                        font-size: DesignTokens.font-default;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TopAction {
                        icon: IconSet.Pin;
                        semantic-label: scene-drawer-pinned ? Tr.t("sl.unpin_parts") : Tr.t("sl.pin_parts");
                        clicked => {
                            root.scene-drawer-pinned = !root.scene-drawer-pinned;
                            root.scene-pin-requested(root.scene-drawer-pinned);
                        }
                    }
                    TopAction {
                        icon: IconSet.X;
                        semantic-label: Tr.t("sl.close_scene_drawer");
                        clicked => { root.scene-requested(); }
                    }
                }

                Rectangle { height: 1px; background: DesignTokens.border; }

                PartsFilterRow {
                    horizontal-stretch: 1;
                    search-label: root.label-search-parts;
                    search-id: "compact-parts-search";
                    selected-only-label: root.label-selected-parts-only;
                    sort-label: root.label-sort-parts;
                    query <=> root.parts-query;
                    selected-only <=> root.parts-selected-only;
                    sort-by-name <=> root.parts-sort-by-name;
                    visible-count: root.parts-items.length;
                    total-count: root.scene-items.length;
                    query-changed(query) => { root.parts-query-changed(query); }
                    selected-only-changed(enabled) => { root.parts-selected-only-changed(enabled); }
                    sort-changed(enabled) => { root.parts-sort-changed(enabled); }
                }
                PartsRowSizeControl {
                    horizontal-stretch: 1;
                    semantic-label: root.label-parts-row-size;
                    accessibility-id: "compact-parts-row-height";
                    value <=> root.parts-row-height;
                    value-changed(value) => { root.parts-row-height-changed(value); }
                }

                ScrollView {
                    accessible-role: list;
                    accessible-label: root.label-parts;
                    accessible-item-count: root.parts-items.length;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        for item in root.parts-items: Rectangle {
                            height: root.parts-row-height * 1px;
                            accessible-role: list-item;
                            accessible-label: item.name;
                            accessible-item-selectable: true;
                            accessible-item-selected: item.selected;
                            border-radius: 4px;
                            background: item.selected ? DesignTokens.surface-hover : transparent;
                            border-width: item.selected ? 1px : 0px;
                            // Ativo (amarelo) ≠ selecionado (laranja): a
                            // referência das operações sempre identificável.
                            border-color: item.active ? DesignTokens.selection-active : DesignTokens.selection;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: center;

                                TouchArea {
                                    property <bool> extend: false;
                                    pointer-event(event) => {
                                        self.extend = event.modifiers.shift;
                                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                            root.scene-context-requested(
                                                item.id,
                                                (self.absolute-position.x + self.mouse-x) / 1px,
                                                (self.absolute-position.y + self.mouse-y) / 1px,
                                            );
                                        }
                                    }
                                    clicked => { root.scene-select(item.id, self.extend); }
                                    horizontal-stretch: 1;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                         IconDisplay {
                                             icon: item.tris == 0 ? IconSet.Spline : IconSet.Box;
                                             size: 12px;
                                             stroke: item.selected ? DesignTokens.accent : DesignTokens.text-muted;
                                         }

                                         if root.rename-active && item.selected: TextInput {
                                             text: root.rename-value;
                                             horizontal-stretch: 1;
                                             font-size: DesignTokens.font-default;
                                             color: DesignTokens.text-primary;
                                             single-line: true;
                                             init => { self.focus(); }
                                             edited => { root.rename-edited(self.text); }
                                             accepted => { root.rename-committed(self.text); }
                                         }

                                         if !(root.rename-active && item.selected): Text {
                                             text: item.name;
                                             color: item.selected ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                             font-size: DesignTokens.font-default;
                                             font-weight: item.selected ? 600 : 400;
                                             vertical-alignment: center;
                                             horizontal-stretch: 1;
                                             overflow: elide;
                                         }

                                         Text {
                                             text: item.tris == 0 ? "\{item.verts} pts · 2D" : "\{item.verts}v · \{item.tris}t";
                                             color: DesignTokens.text-muted;
                                             font-size: DesignTokens.font-caption;
                                             vertical-alignment: center;
                                         }
                                    }
                                }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    IconDisplay {
                                        icon: item.visible ? IconSet.Eye : IconSet.EyeOff;
                                        size: 13px;
                                        stroke: item.visible ? DesignTokens.text-secondary : DesignTokens.text-muted;
                                    }
                                    TouchArea {
                                        clicked => { root.scene-toggle-visibility(item.id); }
                                    }
                                }

                                 Rectangle {
                                     width: 20px;
                                     height: 20px;
                                     IconDisplay {
                                         icon: item.locked ? IconSet.Lock : IconSet.LockOpen;
                                         size: 13px;
                                         stroke: item.locked ? DesignTokens.accent : DesignTokens.text-muted;
                                     }
                                     TouchArea {
                                         clicked => { root.scene-toggle-lock(item.id); }
                                     }
                                 }

                                 Rectangle {
                                     width: 20px;
                                     height: 20px;
                                     accessible-role: button;
                                     accessible-label: Tr.t("sl.part_selection_color");
                                     Rectangle {
                                         width: 13px;
                                         height: 13px;
                                         border-radius: 3px;
                                         background: item.has-custom-color ? item.custom-color : DesignTokens.selection;
                                         border-width: 1px;
                                         border-color: item.has-custom-color ? DesignTokens.text-primary : DesignTokens.border;
                                     }
                                     TouchArea {
                                         clicked => {
                                             root.part-color-picker-open(item.id);
                                         }
                                     }
                                 }
                            }
                        }
                    }
                }
            }
        }


        // Overlay: recuperação de autosave (P3D-002 §Recuperação segura).
        // Home (cap. 23): Novo, Abrir, Recuperar, Recentes, Ajustes. Some ao
        // escolher qualquer caminho; Esc também fecha.
        if home-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;
            TouchArea { }

            Rectangle {
                width: min(560px, parent.width - 48px);
                height: home-layout.preferred-height;
                x: (parent.width - self.width) / 2;
                y: max(24px, (parent.height - self.height) / 3);
                border-radius: DesignTokens.radius-panel;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                drop-shadow-blur: DesignTokens.elevation-2-blur;
                drop-shadow-color: DesignTokens.elevation-2-color;
                drop-shadow-offset-y: DesignTokens.elevation-2-offset;

                home-layout := VerticalLayout {
                    padding: 24px;
                    spacing: 14px;

                    Text {
                        text: root.home-texts.title;
                        color: DesignTokens.text-primary;
                        font-size: DesignTokens.font-exceptional;
                        font-weight: 700;
                    }
                    Text {
                        text: root.home-texts.subtitle;
                        color: DesignTokens.text-secondary;
                        font-size: DesignTokens.font-default;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        IconButton {
                            icon: IconSet.Plus;
                            label: root.home-texts.new;
                            semantic-label: root.home-texts.new;
                            variant: "tool";
                            active: true;
                            clicked => {
                                if root.recovery-open { root.recovery-keep-requested(); }
                                root.home-closed();
                            }
                        }
                        IconButton {
                            icon: IconSet.FolderOpen;
                            label: root.home-texts.open;
                            semantic-label: root.home-texts.open;
                            clicked => {
                                if root.recovery-open { root.recovery-keep-requested(); }
                                root.home-closed();
                                root.open-project-requested();
                            }
                        }
                        if root.recovery-open: IconButton {
                            icon: IconSet.History;
                            label: root.home-texts.recover;
                            semantic-label: root.home-texts.recover;
                            clicked => {
                                root.recovery-recover-requested();
                                root.home-closed();
                            }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Text {
                        text: root.home-texts.recent;
                        color: DesignTokens.text-primary;
                        font-size: DesignTokens.font-strong;
                        font-weight: 600;
                    }
                    if root.recent-projects.length == 0: Text {
                        text: root.home-texts.no-recent;
                        color: DesignTokens.text-muted;
                        font-size: DesignTokens.font-small;
                        wrap: word-wrap;
                    }
                    for recent in root.recent-projects: Rectangle {
                        height: 40px;
                        border-radius: 6px;
                        background: recent-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-hover.with-alpha(0);
                        accessible-role: button;
                        accessible-label: recent.name;
                        accessible-description: recent.path;
                        accessible-action-default => {
                            if root.recovery-open { root.recovery-keep-requested(); }
                            root.home-recent-opened(recent.path);
                        }
                        recent-touch := TouchArea {
                            clicked => {
                                if root.recovery-open { root.recovery-keep-requested(); }
                                root.home-recent-opened(recent.path);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            IconDisplay {
                                y: (parent.height - self.height) / 2;
                                icon: IconSet.File;
                                size: 16px;
                                stroke: DesignTokens.text-secondary;
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: recent.name;
                                    color: DesignTokens.text-primary;
                                    font-size: DesignTokens.font-default;
                                    overflow: elide;
                                }
                                Text {
                                    text: recent.path;
                                    color: DesignTokens.text-muted;
                                    font-size: DesignTokens.font-caption;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;
                        Rectangle {
                            height: 28px;
                            width: home-start-row.preferred-width;
                            accessible-role: checkbox;
                            accessible-checkable: true;
                            accessible-checked: root.show-home-on-start;
                            accessible-label: root.home-texts.show-on-start;
                            accessible-action-default => { root.show-home-on-start-set(!root.show-home-on-start); }
                            TouchArea { clicked => { root.show-home-on-start-set(!root.show-home-on-start); } }
                            home-start-row := HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 16px;
                                    height: 16px;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: root.show-home-on-start ? DesignTokens.accent : DesignTokens.border-strong;
                                    background: root.show-home-on-start ? DesignTokens.accent : DesignTokens.surface;
                                    if root.show-home-on-start: IconDisplay {
                                        icon: IconSet.Check;
                                        size: 12px;
                                        stroke: DesignTokens.on-accent;
                                    }
                                }
                                Text {
                                    text: root.home-texts.show-on-start;
                                    color: DesignTokens.text-secondary;
                                    font-size: DesignTokens.font-small;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        IconButton {
                            icon: IconSet.Settings;
                            label: root.home-texts.settings;
                            semantic-label: root.home-texts.settings;
                            clicked => {
                                root.home-closed();
                                root.settings-visible = true;
                            }
                        }
                    }
                }
            }
        }

        if recovery-open && !home-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            Rectangle {
                width: 460px;
                height: recovery-layout.preferred-height;
                x: (parent.width - self.width) / 2;
                y: 96px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;

                recovery-layout := VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    Text {
                        text: root.recovery-title;
                        color: DesignTokens.text-primary;
                        font-size: DesignTokens.font-exceptional;
                        font-weight: 700;
                    }
                    Text {
                        text: root.recovery-body;
                        color: DesignTokens.text-secondary;
                        font-size: DesignTokens.font-small;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.recovery-detail;
                        color: DesignTokens.text-muted;
                        font-size: DesignTokens.font-caption;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        height: 30px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            Text { text: root.recovery-discard; color: DesignTokens.danger; font-size: DesignTokens.font-small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.recovery-discard-requested(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            Text { text: root.recovery-keep; color: DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.recovery-keep-requested(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: DesignTokens.accent;
                            Text { text: root.recovery-recover; color: DesignTokens.on-accent; font-size: DesignTokens.font-small; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.recovery-recover-requested(); } }
                        }
                    }
                }
            }
        }

        // Overlay: dropdown de um menu da barra superior.
        if root.menu-open != "": Rectangle {
            x: 0;
            y: 42px;
            width: parent.width;
            height: parent.height - 42px;

            TouchArea {
                clicked => { root.click-away-requested(); }
            }

            MenuDropdown {
                x: min(max(8px, root.menu-anchor-x), max(8px, parent.width - self.width - 8px));
                y: 2px;
                entries: root.menu-open == "file"
                    ? root.menu-file-items
                    : (root.menu-open == "edit"
                        ? root.menu-edit-items
                        : (root.menu-open == "view" ? root.menu-view-items : root.menu-window-items));
                highlight: root.menu-highlight;
                invoked(id) => { root.menu-item-invoked(id); }
            }
        }


        // Popover de shading: só opções com backend real.
        if shading-popover-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            TouchArea {
                clicked => { root.shading-popover-toggled(false); }
            }

            Rectangle {
                x: min(max(8px, (parent.width - self.width) / 2), parent.width - self.width - 8px);
                y: 54px;
                width: 280px;
                height: shading-options.preferred-height + 24px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                drop-shadow-blur: DesignTokens.elevation-2-blur;
                drop-shadow-color: DesignTokens.elevation-2-color;
                drop-shadow-offset-y: DesignTokens.elevation-2-offset;

                // O scrim só fecha ao clicar fora. Capturar o fundo do painel
                // evita que o clique no slider atravesse para a viewport.
                TouchArea { clicked => {} }

                shading-options := VerticalLayout {
                    width: parent.width;
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: Tr.t("sl.shading");
                        color: DesignTokens.text-primary;
                        font-size: DesignTokens.font-default;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        ViewportSvgButton { glyph: PetuniaIcons.view-wire; label: root.label-view-wireframe; shortcut: root.shortcuts.view-wireframe; description: Tr.t("sl.display_mesh_edges_with_transparent_wirefram"); active: root.shading-mode == "wireframe"; clicked => { root.shading-mode-set("wireframe"); } }
                        ViewportSvgButton { glyph: PetuniaIcons.view-solid; label: root.label-view-solid; shortcut: root.shortcuts.view-solid; description: Tr.t("sl.standard_matte_shaded_surfaces_with_basic_di"); active: root.shading-mode == "solid"; clicked => { root.shading-mode-set("solid"); } }
                        ViewportSvgButton { glyph: PetuniaIcons.view-material; label: root.label-view-material; shortcut: root.shortcuts.view-material; description: Tr.t("sl.preview_base_color_texture_and_emission_with"); active: root.shading-mode == "material"; clicked => { root.shading-mode-set("material"); } }
                        ViewportSvgButton { glyph: PetuniaIcons.view-lit; label: root.label-view-lit; shortcut: root.shortcuts.view-lit; description: Tr.t("sl.lit_preview_with_a_single_directional_light_"); active: root.shading-mode == "rendered"; clicked => { root.shading-mode-set("rendered"); } }
                        Rectangle { width: 1px; height: 18px; y: 5px; background: DesignTokens.border; }
                        IconButton {
                            icon: IconSet.Eye;
                            variant: "toggle";
                            semantic-label: Tr.t("sl.x_ray");
                            shortcut: root.shortcuts.view-xray;
                            description: Tr.t("sl.semi_transparent_surfaces_allowing_selection");
                            active: root.show-xray;
                            clicked => { root.toggle-xray-requested(); }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    // Estilo do Solid: matcap procedural e oclusão ambiente (GTAO).
                    for option in [
                        { on: root.viewport-matcap, label: root.label-viewport-matcap, hint: root.label-viewport-matcap-hint, which: 0 },
                        { on: root.viewport-ambient-occlusion, label: root.label-viewport-ambient-occlusion, hint: root.label-viewport-ambient-occlusion-hint, which: 1 },
                    ]: Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: option.on ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-checkable: true;
                        accessible-label: option.label;
                        accessible-description: option.hint;
                        accessible-checked: option.on;
                        accessible-action-default => {
                            if option.which == 0 { root.viewport-matcap-set(!option.on); } else { root.viewport-ambient-occlusion-set(!option.on); }
                        }
                        Text {
                            text: option.label;
                            color: option.on ? DesignTokens.on-accent : DesignTokens.text-primary;
                            font-size: DesignTokens.font-small;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                if option.which == 0 { root.viewport-matcap-set(!option.on); } else { root.viewport-ambient-occlusion-set(!option.on); }
                            }
                            Tooltip {
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 2px;
                                    Text { text: option.label; color: DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 700; }
                                    Text { text: option.hint; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Text {
                        text: Tr.t("sl.x_ray");
                        color: DesignTokens.text-primary;
                        font-size: DesignTokens.font-small;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 24px;
                        alignment: center;
                        Text {
                            text: Tr.t("sl.opacity");
                            color: DesignTokens.text-secondary;
                            font-size: DesignTokens.font-caption;
                            width: 56px;
                            vertical-alignment: center;
                        }
                        PetuniaSlider {
                            horizontal-stretch: 1;
                            min-width: 110px;
                            minimum: 0.1;
                            maximum: 0.9;
                            value <=> root.xray-opacity;
                            accessible-label: root.label-xray-opacity;
                            changed(value) => { root.xray-opacity-set(value); }
                        }
                        Text {
                            text: "\{round(root.xray-opacity * 100)}%";
                            color: DesignTokens.text-muted;
                            font-size: DesignTokens.font-caption;
                            width: 36px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.show-xray ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: Tr.t("sl.x_ray_enabled");
                        accessible-checked: root.show-xray;
                        Text {
                            text: root.show-xray ? Tr.t("sl.x_ray_on") : Tr.t("sl.x_ray_off");
                            color: root.show-xray ? DesignTokens.on-accent : DesignTokens.text-primary;
                            font-size: DesignTokens.font-small;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.toggle-xray-requested(); } }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.is-wireframe ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: root.label-wire-overlay;
                        accessible-checked: root.is-wireframe;
                        Text {
                            text: root.label-wire-overlay;
                            color: root.is-wireframe ? DesignTokens.on-accent : DesignTokens.text-primary;
                            font-size: DesignTokens.font-small;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.toggle-wireframe-requested(); }
                            Tooltip {
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 2px;
                                    Text { text: root.label-wire-overlay; color: DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 700; }
                                    Text { text: root.label-wire-overlay-hint; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.show-face-orientation ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: Tr.t("sl.face_orientation");
                        accessible-checked: root.show-face-orientation;
                        Text {
                            text: root.show-face-orientation ? Tr.t("sl.face_orientation_front_blue_back_red") : Tr.t("sl.face_orientation_off");
                            color: root.show-face-orientation ? DesignTokens.on-accent : DesignTokens.text-primary;
                            font-size: DesignTokens.font-caption;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.toggle-face-orientation(); } }
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.show-uv-checker ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: Tr.t("sl.uv_checkerboard");
                        accessible-checked: root.show-uv-checker;
                        Text {
                            text: root.show-uv-checker ? Tr.t("sl.uv_checkerboard_on") : Tr.t("sl.uv_checkerboard_off");
                            color: root.show-uv-checker ? DesignTokens.on-accent : DesignTokens.text-primary;
                            font-size: DesignTokens.font-caption;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.toggle-uv-checker(); } }
                    }
                }
            }
        }

        // Popover da roda de cores para seleção de parte
        if part-color-popover-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            TouchArea {
                clicked => { root.part-color-popover-open = false; }
            }

            Rectangle {
                x: min(max(8px, parent.width - self.width - 340px), parent.width - self.width - 8px);
                y: 80px;
                width: 220px;
                height: part-color-layout.preferred-height + 20px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                drop-shadow-blur: DesignTokens.elevation-2-blur;
                drop-shadow-color: DesignTokens.elevation-2-color;
                drop-shadow-offset-y: DesignTokens.elevation-2-offset;

                TouchArea { clicked => {} }

                part-color-layout := VerticalLayout {
                    width: parent.width;
                    padding: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        Text {
                            text: root.part-color-popover-name != "" ? "\{Tr.t("sl.part_selection_color")}: \{root.part-color-popover-name}" : Tr.t("sl.part_selection_color");
                            color: DesignTokens.text-primary;
                            font-size: DesignTokens.font-small;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Rectangle {
                            width: 18px; height: 18px; border-radius: 3px;
                            IconDisplay { icon: IconSet.X; size: 12px; stroke: DesignTokens.text-secondary; }
                            TouchArea { clicked => { root.part-color-popover-open = false; } }
                        }
                    }

                    // Roda de cores circular interativa
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 130px;
                            height: 130px;
                            border-radius: 65px;
                            clip: true;

                            Image {
                                width: 130px;
                                height: 130px;
                                source: root.color-wheel-image;
                            }

                            TouchArea {
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                                        root.part-color-wheel-interacted(self.mouse-x / 1px, self.mouse-y / 1px);
                                    }
                                }
                            }
                        }
                    }

                    // Amostra + Hex
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        Rectangle {
                            width: 24px; height: 24px; border-radius: 4px;
                            background: root.part-color-preview;
                            border-width: 1px; border-color: DesignTokens.border;
                        }
                        Rectangle {
                            width: 90px; height: 24px; border-radius: 4px;
                            background: DesignTokens.surface;
                            border-width: 1px; border-color: DesignTokens.border;
                            TextInput {
                                x: 6px; y: 2px; width: parent.width - 12px; height: parent.height - 4px;
                                text: root.part-color-hex;
                                color: DesignTokens.text-primary;
                                font-size: DesignTokens.font-small;
                                single-line: true;
                                accepted => { root.part-color-hex-entered(self.text); }
                            }
                        }
                    }

                    // Presets
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;

                        Rectangle {
                            width: 20px; height: 20px; border-radius: 3px; background: ColorPresets.tag-orange;
                            border-width: 1px; border-color: DesignTokens.border;
                            TouchArea { clicked => { root.part-color-preset-clicked(ColorPresets.tag-orange); } }
                        }
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 3px; background: ColorPresets.tag-cyan;
                            border-width: 1px; border-color: DesignTokens.border;
                            TouchArea { clicked => { root.part-color-preset-clicked(ColorPresets.tag-cyan); } }
                        }
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 3px; background: ColorPresets.tag-violet;
                            border-width: 1px; border-color: DesignTokens.border;
                            TouchArea { clicked => { root.part-color-preset-clicked(ColorPresets.tag-violet); } }
                        }
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 3px; background: ColorPresets.tag-green;
                            border-width: 1px; border-color: DesignTokens.border;
                            TouchArea { clicked => { root.part-color-preset-clicked(ColorPresets.tag-green); } }
                        }
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 3px; background: ColorPresets.tag-amber;
                            border-width: 1px; border-color: DesignTokens.border;
                            TouchArea { clicked => { root.part-color-preset-clicked(ColorPresets.tag-amber); } }
                        }
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 3px; background: ColorPresets.tag-red;
                            border-width: 1px; border-color: DesignTokens.border;
                            TouchArea { clicked => { root.part-color-preset-clicked(ColorPresets.tag-red); } }
                        }
                    }

                    // Botão Restaurar cor padrão
                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: rst-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            IconDisplay { icon: IconSet.RotateCcw; size: 11px; stroke: DesignTokens.text-secondary; }
                            Text {
                                text: Tr.t("sl.reset_to_default_color");
                                color: DesignTokens.text-secondary;
                                font-size: DesignTokens.font-caption;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        rst-touch := TouchArea { clicked => { root.part-color-reset-requested(); } }
                    }
                }
            }
        }

        // Overlay: menu de contexto do Outliner (botão direito numa linha).
        if context-menu-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.context-menu-open = false;
                        root.click-away-requested();
                    }
                }
                clicked => {
                    root.context-menu-open = false;
                    root.click-away-requested();
                }
            }

            context-menu-panel := Rectangle {
                x: min(root.context-menu-x, max(0px, parent.width - self.width - 8px));
                y: min(root.context-menu-y, max(0px, parent.height - self.height - 8px));
                width: 220px;
                height: context-menu-layout.preferred-height;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                border-radius: 6px;
                drop-shadow-blur: DesignTokens.elevation-2-blur;
                drop-shadow-color: DesignTokens.elevation-2-color;
                drop-shadow-offset-y: DesignTokens.elevation-2-offset;

                context-menu-layout := VerticalLayout {
                    padding: 4px;
                    spacing: 1px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            text: root.context-menu-title;
                            color: DesignTokens.text-muted;
                            font-size: DesignTokens.font-caption;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: Tr.t("sl.rename");
                        shortcut: "F2";
                        clicked => { root.context-menu-open = false; root.context-menu-action("rename"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: Tr.t("sl.duplicate");
                        shortcut: "Shift+D";
                        clicked => { root.context-menu-open = false; root.context-menu-action("duplicate"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: root.context-menu-visible ? Tr.t("sl.hide") : Tr.t("sl.show");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("visibility"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: root.context-menu-locked ? Tr.t("sl.unlock") : Tr.t("sl.lock");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("lock"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: root.context-menu-isolated ? Tr.t("sl.un_isolate") : Tr.t("sl.isolate");
                        shortcut: "Numpad /";
                        clicked => { root.context-menu-open = false; root.context-menu-action("isolate"); }
                    }
                    if root.context-menu-mode != "viewport" && root.context-menu-can-move-up: ContextMenuItem {
                        label: Tr.t("sl.move_up");
                        shortcut: "Alt+Up";
                        clicked => { root.context-menu-open = false; root.context-menu-action("move_up"); }
                    }
                    if root.context-menu-mode != "viewport" && root.context-menu-can-move-down: ContextMenuItem {
                        label: Tr.t("sl.move_down");
                        shortcut: "Alt+Down";
                        clicked => { root.context-menu-open = false; root.context-menu-action("move_down"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: Tr.t("sl.select_all");
                        shortcut: "A";
                        clicked => { root.context-menu-open = false; root.context-menu-action("select_all"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: Tr.t("sl.clear_selection");
                        shortcut: "Alt+A";
                        clicked => { root.context-menu-open = false; root.context-menu-action("clear_selection"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: Tr.t("sl.invert_selection");
                        shortcut: "Ctrl+I";
                        clicked => { root.context-menu-open = false; root.context-menu-action("invert_selection"); }
                    }
                    if root.context-menu-mode == "viewport" && root.modeling-mode == "DRAW": ContextMenuItem {
                        label: Tr.t("sl.shape_unite");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("draw_unite"); }
                    }
                    if root.context-menu-mode == "viewport" && root.modeling-mode == "DRAW": ContextMenuItem {
                        label: Tr.t("sl.shape_subtract");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("draw_subtract"); }
                    }
                    if root.context-menu-mode == "viewport" && root.modeling-mode == "DRAW": ContextMenuItem {
                        label: Tr.t("sl.shape_intersect");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("draw_intersect"); }
                    }
                    if root.context-menu-mode == "viewport" && root.modeling-mode == "DRAW": ContextMenuItem {
                        label: Tr.t("sl.shape_exclude");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("draw_exclude"); }
                    }
                    if root.context-menu-mode == "viewport" && root.modeling-mode == "DRAW": ContextMenuItem {
                        label: Tr.t("sl.workplane_from_selection");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("workplane_from_selection"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                        label: Tr.t("sl.edge_loop");
                        shortcut: "Alt+Click";
                        clicked => { root.context-menu-open = false; root.context-menu-action("edge_loop"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                        label: Tr.t("sl.edge_ring");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("edge_ring"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                        label: Tr.t("sl.face_loop");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("face_loop"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                        label: Tr.t("sl.separate_selection");
                        shortcut: "P";
                        clicked => { root.context-menu-open = false; root.context-menu-action("separate_selection"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                        label: Tr.t("sl.extrude");
                        shortcut: "E";
                        clicked => { root.context-menu-open = false; root.context-menu-action("extrude"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain == "FACE": ContextMenuItem {
                        label: Tr.t("sl.inset");
                        shortcut: "I";
                        clicked => { root.context-menu-open = false; root.context-menu-action("inset"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                        label: Tr.t("sl.bevel");
                        shortcut: "Ctrl+B";
                        clicked => { root.context-menu-open = false; root.context-menu-action("bevel"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: Tr.t("sl.subdivide");
                        shortcut: "Alt+W";
                        clicked => { root.context-menu-open = false; root.context-menu-action("subdivide"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain == "EDGE": ContextMenuItem {
                        label: Tr.t("sl.loop_cut");
                        shortcut: "Ctrl+R";
                        clicked => { root.context-menu-open = false; root.context-menu-action("loop_cut"); }
                    }
                    if root.context-menu-mode == "viewport" && (root.selection-domain == "VERTEX" || root.selection-domain == "EDGE"): ContextMenuItem {
                        label: Tr.t("sl.connect");
                        shortcut: "J";
                        clicked => { root.context-menu-open = false; root.context-menu-action("connect"); }
                    }
                    if root.context-menu-mode == "viewport" && (root.selection-domain == "VERTEX" || root.selection-domain == "EDGE"): ContextMenuItem {
                        label: Tr.t("sl.make_face_edge");
                        shortcut: "F";
                        clicked => { root.context-menu-open = false; root.context-menu-action("make_face"); }
                    }
                    if root.context-menu-mode == "viewport" && (root.selection-domain == "VERTEX" || root.selection-domain == "EDGE"): ContextMenuItem {
                        label: Tr.t("sl.merge");
                        shortcut: "M";
                        clicked => { root.context-menu-open = false; root.context-menu-action("merge"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                        label: Tr.t("sl.dissolve");
                        shortcut: "Ctrl+X";
                        clicked => { root.context-menu-open = false; root.context-menu-action("dissolve"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: Tr.t("sl.slice");
                        shortcut: "Shift+K";
                        clicked => { root.context-menu-open = false; root.context-menu-action("slice"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain == "EDGE": ContextMenuItem {
                        label: Tr.t("sl.mark_clear_seam");
                        shortcut: "U";
                        clicked => { root.context-menu-open = false; root.context-menu-action("mark_seam"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain == "FACE": ContextMenuItem {
                        label: Tr.t("sl.flip_normals");
                        shortcut: "Alt+N";
                        clicked => { root.context-menu-open = false; root.context-menu-action("flip_normals"); }
                    }
                    if root.context-menu-mode == "viewport" && (root.selection-domain == "OBJECT" || root.selection-domain == "FACE"): ContextMenuItem {
                        label: Tr.t("sl.shade_smooth");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("shade_smooth"); }
                    }
                    if root.context-menu-mode == "viewport" && (root.selection-domain == "OBJECT" || root.selection-domain == "FACE"): ContextMenuItem {
                        label: Tr.t("sl.shade_flat");
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("shade_flat"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain == "OBJECT": ContextMenuItem {
                        label: Tr.t("sl.duplicate");
                        shortcut: "Shift+D";
                        clicked => { root.context-menu-open = false; root.context-menu-action("duplicate"); }
                    }
                    ContextMenuItem {
                        label: Tr.t("sl.frame_selection");
                        shortcut: "F";
                        clicked => { root.context-menu-action("frame"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: Tr.t("sl.set_as_boolean_operand");
                        shortcut: "";
                        clicked => { root.context-menu-action("boolean_operand"); }
                    }

                    if root.selection-domain == "OBJECT": Rectangle { height: 1px; background: DesignTokens.border; }

                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-edit-pivot;
                        shortcut: "Insert";
                        clicked => { root.context-menu-action("toggle_edit_pivot"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-origin-to-geometry;
                        shortcut: "";
                        clicked => { root.context-menu-action("origin_to_geometry"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-origin-to-bottom;
                        shortcut: "";
                        clicked => { root.context-menu-action("origin_to_bottom"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-origin-to-cursor;
                        shortcut: "";
                        clicked => { root.context-menu-action("origin_to_cursor"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-origin-to-selection;
                        shortcut: "";
                        clicked => { root.context-menu-action("origin_to_selection"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-geometry-to-origin;
                        shortcut: "";
                        clicked => { root.context-menu-action("geometry_to_origin"); }
                    }

                    if root.selection-domain == "OBJECT" || root.context-menu-mode != "viewport": Rectangle { height: 1px; background: DesignTokens.border; }

                    if root.selection-domain == "OBJECT" || root.context-menu-mode != "viewport": ContextMenuItem {
                        label: Tr.t("sl.clear_all_transforms");
                        shortcut: "Alt+Backspace";
                        clicked => { root.context-menu-open = false; root.context-menu-action("clear_all_transforms"); }
                    }
                    if root.selection-domain == "OBJECT" || root.context-menu-mode != "viewport": ContextMenuItem {
                        label: Tr.t("sl.clear_location");
                        shortcut: "Alt+G";
                        clicked => { root.context-menu-open = false; root.context-menu-action("clear_location"); }
                    }
                    if root.selection-domain == "OBJECT" || root.context-menu-mode != "viewport": ContextMenuItem {
                        label: Tr.t("sl.clear_rotation");
                        shortcut: "Alt+R";
                        clicked => { root.context-menu-open = false; root.context-menu-action("clear_rotation"); }
                    }
                    if root.selection-domain == "OBJECT" || root.context-menu-mode != "viewport": ContextMenuItem {
                        label: Tr.t("sl.clear_scale");
                        shortcut: "Alt+S";
                        clicked => { root.context-menu-open = false; root.context-menu-action("clear_scale"); }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    ContextMenuItem {
                        label: Tr.t("sl.delete");
                        shortcut: "Del";
                        danger: true;
                        clicked => { root.context-menu-action("delete"); }
                    }
                }
            }
        }

        // Divisor da Asset Library: arrasta na vertical e devolve a altura.
        if asset-library-visible: SplitterHorizontal {
            x: 52px;
            y: parent.height - 36px - asset-library-height;
            width: parent.width - 60px - (inspector-visible && !compact-shell ? inspector-width + 8px : 0px);
            value: root.asset-library-height;
            direction: -1.0;
            moved(height) => { root.asset-library-height-changed(height / 1px); }
        }

        // Overlay / Bottom Drawer: Asset Library (AGENTS.md §3: Asset Library-abaixo).
        // Guarda PREFABS (snapshots reutilizáveis), nunca os objetos soltos da cena.
        if asset-library-visible: Rectangle {
            x: 52px;
            y: parent.height - 30px - asset-library-height;
            width: parent.width - 60px - (inspector-visible && !compact-shell ? inspector-width + 8px : 0px);
            height: asset-library-height;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            border-radius: 6px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 28px;

                    VerticalLayout {
                        alignment: center;
                        IconDisplay { icon: IconSet.FolderArchive; size: 16px; stroke: DesignTokens.accent; }
                    }

                    Text {
                        text: root.label-project-asset-library;
                        color: DesignTokens.text-primary;
                        font-size: DesignTokens.font-default;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "(\{root.prefab-items.length})";
                        color: DesignTokens.text-muted;
                        font-size: DesignTokens.font-small;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            width: max(140px, save-label.preferred-width + 44px);
                            border-radius: DesignTokens.radius-control;
                            background: save-touch.pressed ? DesignTokens.accent.darker(0.15) : (save-touch.has-hover ? DesignTokens.accent.brighter(0.1) : DesignTokens.accent);
                            animate background { duration: Motion.fast; easing: ease-out; }
                            accessible-role: button;
                            accessible-label: root.label-save-active-as-asset;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 5px;
                                alignment: center;
                                VerticalLayout { alignment: center; IconDisplay { icon: IconSet.BookmarkPlus; size: 12px; stroke: DesignTokens.on-accent; } }
                                save-label := Text { text: root.label-save-active-as-asset; color: DesignTokens.on-accent; font-size: DesignTokens.font-caption; font-weight: 700; vertical-alignment: center; }
                            }
                            save-touch := TouchArea { clicked => { root.save-active-as-asset-requested(); } }
                        }
                    }

                    TopAction {
                        icon: IconSet.X;
                        semantic-label: Tr.t("sl.close_asset_library");
                        clicked => { root.asset-library-requested(); }
                    }
                }

                Rectangle { height: 1px; background: DesignTokens.border; }

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: DesignTokens.radius-control;
                        background: DesignTokens.surface;
                        border-width: 1px;
                        border-color: asset-search-input.has-focus ? DesignTokens.focus-ring : DesignTokens.border;
                        animate border-color { duration: Motion.fast; easing: ease-out; }
                        accessible-role: search;
                        accessible-label: root.label-search-assets;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 5px;
                            VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Search; size: 13px; stroke: DesignTokens.text-muted; } }
                            asset-search-input := TextInput {
                                text: root.asset-query;
                                color: DesignTokens.text-primary;
                                font-size: DesignTokens.font-small;
                                single-line: true;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                accessible-label: root.label-search-assets;
                                edited => { root.asset-query-changed(self.text); }
                            }
                        }
                    }
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: DesignTokens.radius-control;
                        background: root.asset-only-favorites ? DesignTokens.accent : (fav-filter-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface);
                        animate background { duration: Motion.fast; easing: ease-out; }
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: button;
                        accessible-label: Tr.t("sl.prefab_only_favorites");
                        accessible-checked: root.asset-only-favorites;
                        IconDisplay { icon: IconSet.Star; size: 13px; stroke: root.asset-only-favorites ? DesignTokens.on-accent : DesignTokens.text-primary; }
                        fav-filter-touch := TouchArea {
                            clicked => { root.asset-only-favorites-changed(!root.asset-only-favorites); }
                            Tooltip { VerticalLayout { padding: 6px; Text { text: Tr.t("sl.prefab_only_favorites"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; } } }
                        }
                    }
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: DesignTokens.radius-control;
                        background: root.asset-sort-by-name ? DesignTokens.accent : (sort-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface);
                        animate background { duration: Motion.fast; easing: ease-out; }
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: button;
                        accessible-label: root.label-sort-assets;
                        accessible-checked: root.asset-sort-by-name;
                        IconDisplay { icon: IconSet.ArrowDownAz; size: 14px; stroke: root.asset-sort-by-name ? DesignTokens.on-accent : DesignTokens.text-primary; }
                        sort-touch := TouchArea { clicked => { root.asset-sort-changed(!root.asset-sort-by-name); } }
                    }
                    Text { text: root.label-thumbnail-size; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; vertical-alignment: center; }
                    PetuniaSlider {
                        width: 100px;
                        minimum: 48;
                        maximum: 128;
                        value <=> root.asset-thumbnail-size;
                        changed(value) => { root.asset-thumbnail-size-changed(value); }
                    }
                }

                if root.prefab-items.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 4px;
                    Text { text: Tr.t("sl.prefab_empty_title"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-default; font-weight: 700; horizontal-alignment: center; }
                    Text { text: Tr.t("sl.prefab_empty_hint"); color: DesignTokens.text-muted; font-size: DesignTokens.font-small; horizontal-alignment: center; wrap: word-wrap; }
                }

                if root.prefab-items.length > 0: ScrollView {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        for item in root.prefab-items: Rectangle {
                            width: root.asset-thumbnail-size * 1px + 16px;
                            height: root.asset-thumbnail-size * 1px + 50px;
                            border-radius: DesignTokens.radius-panel;
                            background: card-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface;
                            animate background { duration: Motion.fast; easing: ease-out; }
                            border-width: 1px;
                            border-color: card-touch.has-hover ? DesignTokens.border-strong : DesignTokens.border;
                            animate border-color { duration: Motion.fast; easing: ease-out; }
                            accessible-role: button;
                            accessible-label: item.name;
                            accessible-action-default => { root.prefab-place-requested(item.id); }

                            card-touch := TouchArea {
                                clicked => { root.prefab-place-requested(item.id); }
                                Tooltip {
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 2px;
                                        Text { text: item.name; color: DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 700; }
                                        Text { text: Tr.t("sl.prefab_place"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; }
                                        if item.tags != "": Text { text: item.tags; color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; }
                                    }
                                }
                            }

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                Rectangle {
                                    height: root.asset-thumbnail-size * 1px;
                                    border-radius: DesignTokens.radius-control;
                                    background: DesignTokens.canvas;
                                    clip: true;

                                    if item.has-thumbnail: Image {
                                        source: item.thumbnail;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }
                                    if !item.has-thumbnail: IconDisplay {
                                        icon: IconSet.Box;
                                        size: 24px;
                                        stroke: DesignTokens.text-muted;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    // Favorito (canto superior esquerdo)
                                    Rectangle {
                                        x: 4px;
                                        y: 4px;
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: item.favorite ? DesignTokens.accent : DesignTokens.surface-raised.with-alpha(card-touch.has-hover ? 0.9 : 0.0);
                                        animate background { duration: Motion.fast; easing: ease-out; }
                                        accessible-role: button;
                                        accessible-label: Tr.t("sl.prefab_favorite");
                                        accessible-checked: item.favorite;
                                        opacity: (item.favorite || card-touch.has-hover || fav-touch.has-hover) ? 1.0 : 0.0;
                                        animate opacity { duration: Motion.fast; easing: ease-out; }
                                        IconDisplay { icon: IconSet.Star; size: 12px; stroke: item.favorite ? DesignTokens.on-accent : DesignTokens.text-primary; }
                                        fav-touch := TouchArea { clicked => { root.prefab-favorite-requested(item.id, !item.favorite); } }
                                    }

                                    // Instâncias na cena (canto superior direito)
                                    if item.instances > 0: Rectangle {
                                        x: parent.width - self.width - 4px;
                                        y: 4px;
                                        height: 18px;
                                        width: max(22px, inst-text.preferred-width + 10px);
                                        border-radius: 9px;
                                        background: DesignTokens.surface-raised.with-alpha(0.9);
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        inst-text := Text {
                                            text: "×\{item.instances}";
                                            color: DesignTokens.text-secondary;
                                            font-size: DesignTokens.font-caption;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Ações no hover (canto inferior direito)
                                    HorizontalLayout {
                                        x: parent.width - self.preferred-width - 4px;
                                        y: parent.height - 26px;
                                        height: 22px;
                                        spacing: 4px;
                                        opacity: card-touch.has-hover || upd-touch.has-hover || del-touch.has-hover ? 1.0 : 0.0;
                                        animate opacity { duration: Motion.fast; easing: ease-out; }

                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: DesignTokens.radius-control;
                                            background: upd-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-raised.with-alpha(0.92);
                                            accessible-role: button;
                                            accessible-label: Tr.t("sl.prefab_update");
                                            IconDisplay { icon: IconSet.RefreshCw; size: 12px; stroke: DesignTokens.text-primary; }
                                            upd-touch := TouchArea {
                                                clicked => { root.prefab-update-requested(item.id); }
                                                Tooltip { VerticalLayout { padding: 6px; Text { text: Tr.t("sl.prefab_update"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; } } }
                                            }
                                        }
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: DesignTokens.radius-control;
                                            background: del-touch.has-hover ? DesignTokens.danger : DesignTokens.surface-raised.with-alpha(0.92);
                                            accessible-role: button;
                                            accessible-label: Tr.t("sl.prefab_delete");
                                            IconDisplay { icon: IconSet.Trash2; size: 12px; stroke: del-touch.has-hover ? DesignTokens.on-accent : DesignTokens.text-primary; }
                                            del-touch := TouchArea {
                                                clicked => { root.prefab-delete-requested(item.id); }
                                                Tooltip { VerticalLayout { padding: 6px; Text { text: Tr.t("sl.prefab_delete"); color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; } } }
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: item.name;
                                    color: DesignTokens.text-primary;
                                    font-size: DesignTokens.font-small;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: "\{item.parts} " + Tr.t("sl.prefab_parts") + "  ·  \{item.tris} tris";
                                    color: DesignTokens.text-muted;
                                    font-size: DesignTokens.font-caption;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Overlay: Command Search Modal
        if command-search-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            TouchArea {
                clicked => { root.click-away-requested(); }
            }

            Rectangle {
                width: 480px;
                height: 320px;
                x: (parent.width - self.width) / 2;
                y: 80px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        alignment: center;

                        IconDisplay {
                            icon: IconSet.Search;
                            size: 16px;
                            stroke: DesignTokens.text-secondary;
                        }

                        search-input := TextInput {
                            accessible-role: text-input;
                            accessible-label: Tr.t("sl.search_commands");
                            font-size: DesignTokens.font-exceptional;
                            color: DesignTokens.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            text <=> root.command-query;
                            edited => { root.command-query-changed(self.text); }
                            key-pressed(event) => {
                                if event.text == Key.DownArrow && root.command-results.length > 0 {
                                    root.command-selection = Math.min(root.command-selection + 1, root.command-results.length - 1);
                                    return accept;
                                }
                                if event.text == Key.UpArrow && root.command-results.length > 0 {
                                    root.command-selection = Math.max(root.command-selection - 1, 0);
                                    return accept;
                                }
                                reject
                            }
                            accepted => {
                                if root.command-results.length > 0 {
                                    if !root.command-results[root.command-selection].available {
                                    } else if root.command-results[root.command-selection].id == "draw.import_svg" || root.command-results[root.command-selection].id == "file.save" || root.command-results[root.command-selection].id == "file.save_as" || root.command-results[root.command-selection].id == "file.open" {
                                        root.command-file-action(root.command-results[root.command-selection].id);
                                    } else {
                                        root.command-executed(root.command-results[root.command-selection].id);
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: DesignTokens.border;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for cmd[index] in root.command-results: Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                background: index == root.command-selection || item-touch.has-hover ? DesignTokens.surface-hover : transparent;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;

                                    Text {
                                        text: cmd.label;
                                        color: DesignTokens.text-primary;
                                        font-size: DesignTokens.font-default;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    if cmd.shortcut != "": Text {
                                        text: cmd.shortcut;
                                        color: DesignTokens.text-muted;
                                        font-size: DesignTokens.font-caption;
                                        vertical-alignment: center;
                                    }
                                }

                                item-touch := TouchArea {
                                    clicked => {
                                        root.command-selection = index;
                                        if !cmd.available {
                                        } else if cmd.id == "draw.import_svg" || cmd.id == "file.save" || cmd.id == "file.save_as" || cmd.id == "file.open" {
                                            root.command-file-action(cmd.id);
                                        } else {
                                            root.command-executed(cmd.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Toast de status: componente transversal do design system.
        StatusToast {
            shown: root.toast-visible;
            message: root.status-message;
            severity-color: root.status-color;
            available-width: root.width - 32px;
            x: (root.width - self.width) / 2;
            y: root.toast-visible ? root.height - 30px - self.height - 20px : root.height - 30px - self.height - 6px;
            animate y { duration: Motion.medium; easing: ease-out; }
        }

        // Painel flutuante: Paint Canvas 2D em escala maior, sincronizado com a viewport 3D.
        if paint-canvas-panel-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            canvas-panel := Rectangle {
                width: min(root.canvas-panel-w > 0px ? root.canvas-panel-w : 520px, parent.width - 40px);
                height: min(root.canvas-panel-h > 0px ? root.canvas-panel-h : 576px, parent.height - 80px);
                x: root.canvas-panel-x < 0px ? min(60px, max(parent.width - self.width, 0px)) : clamp(root.canvas-panel-x, 0px, max(parent.width - self.width, 0px));
                y: root.canvas-panel-y < 0px ? min(56px, max(parent.height - self.height, 0px)) : clamp(root.canvas-panel-y, 0px, max(parent.height - self.height, 0px));
                border-radius: DesignTokens.radius-panel;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                drop-shadow-blur: DesignTokens.elevation-2-blur;
                drop-shadow-color: DesignTokens.elevation-2-color;
                drop-shadow-offset-y: DesignTokens.elevation-2-offset;
                TouchArea { }

                PanelResizeGrip {
                    z: 10;
                    x: parent.width - self.width;
                    y: parent.height - self.height;
                    panel-w: canvas-panel.width;
                    panel-h: canvas-panel.height;
                    min-w: 300px;
                    min-h: 260px;
                    max-w: root.width - 40px;
                    max-h: root.height - 80px;
                    resized-to(w, h) => { root.canvas-panel-w = w; root.canvas-panel-h = h; }
                }

                VerticalLayout {
                    Rectangle {
                        height: 40px;
                        background: DesignTokens.surface;
                        border-top-left-radius: DesignTokens.radius-panel;
                        border-top-right-radius: DesignTokens.radius-panel;
                        PanelDragHandle {
                            panel-x: canvas-panel.x;
                            panel-y: canvas-panel.y;
                            max-x: root.width - canvas-panel.width;
                            max-y: root.height - canvas-panel.height;
                            moved-to(x, y) => { root.canvas-panel-x = x; root.canvas-panel-y = y; }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 6px;
                            VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Image; size: 14px; stroke: DesignTokens.accent; } }
                            Text { text: Tr.t("sl.canvas") + "  " + root.paint-canvas-size; color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 24px;
                                    width: max(72px, uv-label.preferred-width + 20px);
                                    border-radius: DesignTokens.radius-control;
                                    background: root.paint-show-uv ? DesignTokens.accent : (uv-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-raised);
                                    animate background { duration: Motion.fast; easing: ease-out; }
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    accessible-role: button;
                                    accessible-checked: root.paint-show-uv;
                                    accessible-label: Tr.t("sl.uv_wireframe_overlay_2");
                                    uv-label := Text { text: "UV"; color: root.paint-show-uv ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    uv-touch := TouchArea { clicked => { root.toggle-paint-show-uv(); } }
                                }
                            }
                            TopAction {
                                icon: IconSet.X;
                                semantic-label: Tr.t("sl.paint_canvas_close");
                                clicked => { root.paint-canvas-panel-visible = false; }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: DesignTokens.border; }
                    PaintCanvasSurface {
                        vertical-stretch: 1;
                        canvas-image: root.paint-canvas-image;
                        zoom: root.paint-canvas-zoom;
                        show-brush: root.brush-stroke-tool(root.active-tool);
                        brush-diameter: root.brush-size * 16px;
                        brush-hardness: root.brush-hardness;
                        brush-strength: root.brush-opacity * root.brush-flow;
                        brush-tint: root.paint-color;
                        brush-erase: root.active-tool == "eraser";
                        brush-hard-edge: root.active-tool == "pixel";
                        show-uv: root.paint-show-uv;
                        uv-commands: root.uv-layout-commands;
                        show-grid: root.paint-pixel-grid;
                        grid-commands: root.paint-canvas-grid-commands;
                        select-mode: root.active-tool == "select";
                        selected-commands: root.uv-selected-commands;
                        select-region(x0, y0, x1, y1, extend, subtract, island) => { root.paint-2d-select(x0, y0, x1, y1, extend, subtract, island); }
                        stroke(x, y, phase, shift, raster) => { root.paint-2d-stroke(x, y, phase, shift, raster); }
                        zoom-step(direction) => {
                            if direction > 0 && root.paint-canvas-zoom < 16 { root.set-paint-canvas-zoom(root.paint-canvas-zoom * 2); }
                            if direction < 0 && root.paint-canvas-zoom > 1 { root.set-paint-canvas-zoom(root.paint-canvas-zoom / 2); }
                        }
                    }
                }
            }
        }

        // Overlay: Reference Image Manager Modal (P3D-013)
        if reference-manager-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            // Painel flutuante não modal: sem scrim, a viewport continua visível e utilizável.
            ref-panel := Rectangle {
                // Compacto e ancorado à esquerda por padrão: a viewport segue visível.
                width: min(root.ref-panel-w > 0px ? root.ref-panel-w : 600px, parent.width - 40px);
                height: min(root.ref-panel-h > 0px ? root.ref-panel-h : ref-content.preferred-height + 49px, parent.height - 80px);
                x: root.ref-panel-x < 0px ? min(60px, max(parent.width - self.width, 0px)) : clamp(root.ref-panel-x, 0px, max(parent.width - self.width, 0px));
                y: root.ref-panel-y < 0px ? min(56px, max(parent.height - self.height, 0px)) : clamp(root.ref-panel-y, 0px, max(parent.height - self.height, 0px));
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                drop-shadow-blur: DesignTokens.elevation-2-blur;
                drop-shadow-color: DesignTokens.elevation-2-color;
                drop-shadow-offset-y: DesignTokens.elevation-2-offset;

                TouchArea { clicked => {} }

                PanelResizeGrip {
                    z: 10;
                    x: parent.width - self.width;
                    y: parent.height - self.height;
                    panel-w: ref-panel.width;
                    panel-h: ref-panel.height;
                    max-w: root.width - 40px;
                    max-h: root.height - 80px;
                    resized-to(w, h) => { root.ref-panel-w = w; root.ref-panel-h = h; }
                }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // Header
                    Rectangle {
                        height: 48px;
                        background: DesignTokens.surface;
                        border-top-left-radius: 8px;
                        border-top-right-radius: 8px;

                        PanelDragHandle {
                            panel-x: ref-panel.x;
                            panel-y: ref-panel.y;
                            max-x: root.width - ref-panel.width;
                            max-y: root.height - ref-panel.height;
                            moved-to(x, y) => { root.ref-panel-x = x; root.ref-panel-y = y; }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;

                            VerticalLayout { alignment: center; HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                IconDisplay {
                                    icon: IconSet.Image;
                                    size: 16px;
                                    stroke: DesignTokens.accent;
                                }
                                Text {
                                    text: Tr.t("sl.reference_images");
                                    color: DesignTokens.text-primary;
                                    font-size: DesignTokens.font-exceptional;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "(\{root.reference-total-count} " + Tr.t("sl.active").to-lowercase() + ")";
                                    color: DesignTokens.text-muted;
                                    font-size: DesignTokens.font-default;
                                    vertical-alignment: center;
                                }
                            } }

                            VerticalLayout { alignment: center; HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                if !root.ref-clear-confirm && root.reference-total-count > 0: IconButton {
                                    icon: IconSet.Trash2;
                                    label: Tr.t("sl.clear_all");
                                    semantic-label: Tr.t("sl.clear_all");
                                    clicked => { root.ref-clear-confirm = true; }
                                }
                                if root.ref-clear-confirm: Text {
                                    text: Tr.t("sl.ref_clear_confirm");
                                    color: DesignTokens.text-secondary;
                                    font-size: DesignTokens.font-small;
                                    vertical-alignment: center;
                                }
                                if root.ref-clear-confirm: IconButton {
                                    icon: IconSet.Trash2;
                                    label: Tr.t("sl.ref_clear_yes");
                                    semantic-label: Tr.t("sl.ref_clear_yes");
                                    clicked => {
                                        root.ref-clear-confirm = false;
                                        root.reference-clear-all();
                                    }
                                }
                                if root.ref-clear-confirm: IconButton {
                                    icon: IconSet.X;
                                    label: Tr.t("sl.cancel");
                                    semantic-label: Tr.t("sl.cancel");
                                    clicked => { root.ref-clear-confirm = false; }
                                }

                                TopAction {
                                    icon: IconSet.X;
                                    semantic-label: Tr.t("sl.close_reference_manager");
                                    clicked => {
                                        root.reference-manager-visible = false;
                                        root.reference-manager-closed();
                                    }
                                }
                            } }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    // Grade 3 × 2 de vistas + ajustes da selecionada: as seis cabem
                    // sem rolagem em 1280 × 800 (plano de UI F7, §5.5).
                    ref-content := VerticalLayout {
                        vertical-stretch: 1;
                        padding: 12px;
                        spacing: 10px;

                        Text {
                            text: Tr.t("sl.ref_help");
                            color: DesignTokens.text-muted;
                            font-size: DesignTokens.font-caption;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            for i in 3: ReferenceTile {
                                horizontal-stretch: 1;
                                slot: root.reference-slots[i];
                                selected: root.ref-selected == i;
                                load-label: Tr.t("sl.load_image");
                                select => { root.ref-selected = i; }
                                pick-image => { root.reference-slot-pick(root.reference-slots[i].axis); }
                                remove-image => { root.reference-slot-remove(root.reference-slots[i].axis); }
                                align-view => { root.reference-slot-align(root.reference-slots[i].axis); }
                                toggle-visible => { root.reference-slot-toggle-visible(root.reference-slots[i].axis); }
                                toggle-lock => { root.reference-slot-toggle-lock(root.reference-slots[i].axis); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            for i in 3: ReferenceTile {
                                horizontal-stretch: 1;
                                slot: root.reference-slots[i + 3];
                                selected: root.ref-selected == i + 3;
                                load-label: Tr.t("sl.load_image");
                                select => { root.ref-selected = i + 3; }
                                pick-image => { root.reference-slot-pick(root.reference-slots[i + 3].axis); }
                                remove-image => { root.reference-slot-remove(root.reference-slots[i + 3].axis); }
                                align-view => { root.reference-slot-align(root.reference-slots[i + 3].axis); }
                                toggle-visible => { root.reference-slot-toggle-visible(root.reference-slots[i + 3].axis); }
                                toggle-lock => { root.reference-slot-toggle-lock(root.reference-slots[i + 3].axis); }
                            }
                        }
                        if root.reference-slots[root.ref-selected].has-image: ReferenceDetails {
                            slot: root.reference-slots[root.ref-selected];
                            set-param(param, val) => { root.reference-slot-set-param(root.reference-slots[root.ref-selected].axis, param, val); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        // Overlay: Settings Modal
        if settings-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            settings-panel := Rectangle {
                width: min(root.settings-panel-w > 0px ? root.settings-panel-w : 660px, parent.width - 40px);
                height: min(root.settings-panel-h > 0px ? root.settings-panel-h : 520px, parent.height - 40px);
                x: root.settings-panel-x < 0px ? (parent.width - self.width) / 2 : clamp(root.settings-panel-x, 0px, max(parent.width - self.width, 0px));
                y: root.settings-panel-y < 0px ? (parent.height - self.height) / 2 : clamp(root.settings-panel-y, 0px, max(parent.height - self.height, 0px));
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                drop-shadow-blur: DesignTokens.elevation-2-blur;
                drop-shadow-color: DesignTokens.elevation-2-color;
                drop-shadow-offset-y: DesignTokens.elevation-2-offset;

                // Captura cliques no card para que não atravessem para o scrim de fundo
                TouchArea { clicked => {} }

                PanelResizeGrip {
                    z: 10;
                    x: parent.width - self.width;
                    y: parent.height - self.height;
                    panel-w: settings-panel.width;
                    panel-h: settings-panel.height;
                    max-w: root.width - 40px;
                    max-h: root.height - 40px;
                    resized-to(w, h) => { root.settings-panel-w = w; root.settings-panel-h = h; }
                }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // Cabeçalho do painel (arraste para mover, duplo clique recentraliza)
                    Rectangle {
                        height: 48px;
                        background: DesignTokens.surface;
                        border-top-left-radius: 8px;
                        border-top-right-radius: 8px;

                        PanelDragHandle {
                            panel-x: settings-panel.x;
                            panel-y: settings-panel.y;
                            max-x: root.width - settings-panel.width;
                            max-y: root.height - settings-panel.height;
                            moved-to(x, y) => { root.settings-panel-x = x; root.settings-panel-y = y; }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;

                            VerticalLayout { alignment: center; HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                IconDisplay {
                                    icon: IconSet.Settings2;
                                    size: 16px;
                                    stroke: DesignTokens.accent;
                                }
                                Text {
                                    text: root.label-preferences != "" ? root.label-preferences : Tr.t("sl.settings");
                                    color: DesignTokens.text-primary;
                                    font-size: DesignTokens.font-exceptional;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            } }

                            VerticalLayout { alignment: center;
                            TopAction {
                                icon: IconSet.X;
                                semantic-label: Tr.t("sl.close_settings");
                                clicked => {
                                    root.settings-visible = false;
                                    root.settings-closed();
                                }
                            }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    // Corpo: Barra lateral de categorias + Painel de conteúdo
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        // Sidebar de seções
                        Rectangle {
                            width: 175px;
                            background: DesignTokens.surface;
                            border-bottom-left-radius: 8px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 3px;

                                // Busca: filtra as abas por nome e palavras-chave (F7, §5.4).
                                Rectangle {
                                    height: 30px;
                                    border-radius: 4px;
                                    background: DesignTokens.canvas;
                                    border-width: 1px;
                                    border-color: settings-search.has-focus ? DesignTokens.focus-ring : DesignTokens.border;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        IconDisplay { y: (parent.height - self.height) / 2; icon: IconSet.Search; size: 13px; stroke: DesignTokens.text-muted; }
                                        settings-search := TextInput {
                                            text <=> root.settings-query;
                                            color: DesignTokens.text-primary;
                                            font-size: DesignTokens.font-small;
                                            vertical-alignment: center;
                                            single-line: true;
                                            accessible-label: Tr.t("sl.settings_search");
                                        }
                                    }
                                    if root.settings-query == "": Text {
                                        x: 27px;
                                        text: Tr.t("sl.settings_search");
                                        color: DesignTokens.text-muted;
                                        font-size: DesignTokens.font-small;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.text-matches(Tr.t("sl.appearance") + " " + Tr.t("sl.settings_kw_0"), root.settings-query): Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 0 ? DesignTokens.accent : (tab0-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: Tr.t("sl.appearance");
                                    accessible-checked: root.settings-tab == 0;
                                    accessible-action-default => { root.settings-tab = 0; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Palette; size: 14px; stroke: root.settings-tab == 0 ? DesignTokens.on-accent : DesignTokens.text-secondary; } }
                                        Text { text: Tr.t("sl.appearance"); color: root.settings-tab == 0 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab0-touch := TouchArea { clicked => { root.settings-tab = 0; } }
                                }
                                if root.text-matches(Tr.t("sl.language_region") + " " + Tr.t("sl.settings_kw_1"), root.settings-query): Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 1 ? DesignTokens.accent : (tab1-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: Tr.t("sl.language_region");
                                    accessible-checked: root.settings-tab == 1;
                                    accessible-action-default => { root.settings-tab = 1; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Globe; size: 14px; stroke: root.settings-tab == 1 ? DesignTokens.on-accent : DesignTokens.text-secondary; } }
                                        Text { text: Tr.t("sl.language_region"); color: root.settings-tab == 1 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab1-touch := TouchArea { clicked => { root.settings-tab = 1; } }
                                }
                                if root.text-matches(Tr.t("sl.keyboard_shortcuts") + " " + Tr.t("sl.settings_kw_2"), root.settings-query): Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 2 ? DesignTokens.accent : (tab2-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: Tr.t("sl.keyboard_shortcuts");
                                    accessible-checked: root.settings-tab == 2;
                                    accessible-action-default => { root.settings-tab = 2; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Keyboard; size: 14px; stroke: root.settings-tab == 2 ? DesignTokens.on-accent : DesignTokens.text-secondary; } }
                                        Text { text: Tr.t("sl.keyboard_shortcuts"); color: root.settings-tab == 2 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab2-touch := TouchArea { clicked => { root.settings-tab = 2; } }
                                }
                                if root.text-matches(Tr.t("sl.accessibility") + " " + Tr.t("sl.settings_kw_3"), root.settings-query): Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 3 ? DesignTokens.accent : (tab3-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: Tr.t("sl.accessibility");
                                    accessible-checked: root.settings-tab == 3;
                                    accessible-action-default => { root.settings-tab = 3; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Eye; size: 14px; stroke: root.settings-tab == 3 ? DesignTokens.on-accent : DesignTokens.text-secondary; } }
                                        Text { text: Tr.t("sl.accessibility"); color: root.settings-tab == 3 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab3-touch := TouchArea { clicked => { root.settings-tab = 3; } }
                                }
                                if root.text-matches(Tr.t("sl.tools") + " " + Tr.t("sl.settings_kw_4"), root.settings-query): Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 4 ? DesignTokens.accent : (tab4-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: Tr.t("sl.tools");
                                    accessible-checked: root.settings-tab == 4;
                                    accessible-action-default => { root.settings-tab = 4; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Box; size: 14px; stroke: root.settings-tab == 4 ? DesignTokens.on-accent : DesignTokens.text-secondary; } }
                                        Text { text: Tr.t("sl.tools"); color: root.settings-tab == 4 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab4-touch := TouchArea { clicked => { root.settings-tab = 4; } }
                                }
                                if root.text-matches(Tr.t("sl.3d_viewport") + " " + Tr.t("sl.settings_kw_5"), root.settings-query): Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 5 ? DesignTokens.accent : (tab5-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: Tr.t("sl.3d_viewport");
                                    accessible-checked: root.settings-tab == 5;
                                    accessible-action-default => { root.settings-tab = 5; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Monitor; size: 14px; stroke: root.settings-tab == 5 ? DesignTokens.on-accent : DesignTokens.text-secondary; } }
                                        Text { text: Tr.t("sl.3d_viewport"); color: root.settings-tab == 5 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab5-touch := TouchArea { clicked => { root.settings-tab = 5; } }
                                }
                                if root.text-matches(Tr.t("sl.plugins") + " " + Tr.t("sl.settings_kw_6"), root.settings-query): Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 6 ? DesignTokens.accent : (tab6-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: Tr.t("sl.plugins");
                                    accessible-checked: root.settings-tab == 6;
                                    accessible-action-default => { root.settings-tab = 6; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Cpu; size: 14px; stroke: root.settings-tab == 6 ? DesignTokens.on-accent : DesignTokens.text-secondary; } }
                                        Text { text: Tr.t("sl.plugins"); color: root.settings-tab == 6 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab6-touch := TouchArea { clicked => { root.settings-tab = 6; } }
                                }
                                if root.text-matches(Tr.t("sl.mcp_automation") + " " + Tr.t("sl.settings_kw_7"), root.settings-query): Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 7 ? DesignTokens.accent : (tab7-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: Tr.t("sl.mcp_automation");
                                    accessible-checked: root.settings-tab == 7;
                                    accessible-action-default => { root.settings-tab = 7; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Terminal; size: 14px; stroke: root.settings-tab == 7 ? DesignTokens.on-accent : DesignTokens.text-secondary; } }
                                        Text { text: Tr.t("sl.mcp_automation"); color: root.settings-tab == 7 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab7-touch := TouchArea { clicked => { root.settings-tab = 7; } }
                                }
                                if root.text-matches(Tr.t("sl.settings_about") + " " + Tr.t("sl.settings_kw_8"), root.settings-query): Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 8 ? DesignTokens.accent : (tab8-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: Tr.t("sl.settings_about");
                                    accessible-checked: root.settings-tab == 8;
                                    accessible-action-default => { root.settings-tab = 8; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout { alignment: center; IconDisplay { icon: IconSet.Info; size: 14px; stroke: root.settings-tab == 8 ? DesignTokens.on-accent : DesignTokens.text-secondary; } }
                                        Text { text: Tr.t("sl.settings_about"); color: root.settings-tab == 8 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab8-touch := TouchArea { clicked => { root.settings-tab = 8; } }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }

                        Rectangle { width: 1px; background: DesignTokens.border; }

                        // Painel de Conteúdo com rolagem
                        ScrollView {
                            horizontal-stretch: 1;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;

                                // --- TAB 0: APARÊNCIA ---
                                if root.settings-tab == 0: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: Tr.t("sl.interface_theme"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        for theme in root.themes: Rectangle {
                                            width: 140px; height: 30px; border-radius: 4px;
                                            background: theme.active ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text {
                                                text: theme.name;
                                                color: theme.active ? DesignTokens.on-accent : DesignTokens.text-primary;
                                                font-size: DesignTokens.font-small; font-weight: 600;
                                                vertical-alignment: center; horizontal-alignment: center;
                                            }
                                            TouchArea { clicked => { root.theme-changed(theme.id); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: Tr.t("sl.ui_scale_zoom"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 60px; height: 28px; border-radius: 4px;
                                            background: (root.ui-scale <= 1.05) ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "100%"; color: (root.ui-scale <= 1.05) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.ui-scale-set(1.0); } }
                                        }
                                        Rectangle {
                                            width: 60px; height: 28px; border-radius: 4px;
                                            background: (root.ui-scale > 1.05 && root.ui-scale <= 1.35) ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "125%"; color: (root.ui-scale > 1.05 && root.ui-scale <= 1.35) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.ui-scale-set(1.25); } }
                                        }
                                        Rectangle {
                                            width: 60px; height: 28px; border-radius: 4px;
                                            background: (root.ui-scale > 1.35 && root.ui-scale <= 1.6) ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "150%"; color: (root.ui-scale > 1.35 && root.ui-scale <= 1.6) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.ui-scale-set(1.5); } }
                                        }
                                        Rectangle {
                                            width: 60px; height: 28px; border-radius: 4px;
                                            background: (root.ui-scale > 1.6 && root.ui-scale <= 1.85) ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "175%"; color: (root.ui-scale > 1.6 && root.ui-scale <= 1.85) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.ui-scale-set(1.75); } }
                                        }
                                        Rectangle {
                                            width: 60px; height: 28px; border-radius: 4px;
                                            background: (root.ui-scale > 1.85) ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "200%"; color: (root.ui-scale > 1.85) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.ui-scale-set(2.0); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: Tr.t("sl.icon_style"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 100px; height: 30px; border-radius: 4px;
                                            background: root.icon-theme == "outline" ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                padding-left: 10px;
                                                alignment: start;
                                                Image { source: PetuniaIcons.cube; colorize: DesignTokens.text-primary; width: 16px; height: 16px; y: (parent.height - self.height) / 2; image-fit: contain; }
                                                Text { text: Tr.t("sl.outline"); color: root.icon-theme == "outline" ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.icon-theme-set("outline"); } }
                                        }
                                        Rectangle {
                                            width: 100px; height: 30px; border-radius: 4px;
                                            background: root.icon-theme == "filled" ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                padding-left: 10px;
                                                alignment: start;
                                                Image { source: PetuniaIcons.cube; colorize: DesignTokens.text-primary; width: 16px; height: 16px; y: (parent.height - self.height) / 2; image-fit: contain; }
                                                Text { text: Tr.t("sl.filled"); color: root.icon-theme == "filled" ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.icon-theme-set("filled"); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: root.label-accent-color; color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    Text { text: root.label-accent-color-hint; color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-violet;
                                            border-width: root.accent-color-hex == "#B58CFF" ? 2px : 1px;
                                            border-color: root.accent-color-hex == "#B58CFF" ? DesignTokens.focus-ring : DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: root.label-accent-color + " #B58CFF";
                                            TouchArea { clicked => { root.accent-color-set("#B58CFF"); } }
                                        }
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.accent-blue;
                                            border-width: root.accent-color-hex == "#5B8CFF" ? 2px : 1px;
                                            border-color: root.accent-color-hex == "#5B8CFF" ? DesignTokens.focus-ring : DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: root.label-accent-color + " #5B8CFF";
                                            TouchArea { clicked => { root.accent-color-set("#5B8CFF"); } }
                                        }
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.accent-teal;
                                            border-width: root.accent-color-hex == "#2BB5A0" ? 2px : 1px;
                                            border-color: root.accent-color-hex == "#2BB5A0" ? DesignTokens.focus-ring : DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: root.label-accent-color + " #2BB5A0";
                                            TouchArea { clicked => { root.accent-color-set("#2BB5A0"); } }
                                        }
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.accent-pink;
                                            border-width: root.accent-color-hex == "#E86FB0" ? 2px : 1px;
                                            border-color: root.accent-color-hex == "#E86FB0" ? DesignTokens.focus-ring : DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: root.label-accent-color + " #E86FB0";
                                            TouchArea { clicked => { root.accent-color-set("#E86FB0"); } }
                                        }
                                        Rectangle {
                                            width: 110px; height: 28px; border-radius: 4px;
                                            background: DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: Tr.t("sl.reset_accent");
                                            Text { text: Tr.t("sl.reset_accent"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.accent-color-set(""); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: Tr.t("sl.viewport_selection_color"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        // Preset 1: Blender Orange
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-orange;
                                            border-width: root.selection-color-hex == "#E96A00" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#E96A00" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#E96A00"); } }
                                        }
                                        // Preset 2: Electric Cyan
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-cyan;
                                            border-width: root.selection-color-hex == "#00D2FF" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#00D2FF" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#00D2FF"); } }
                                        }
                                        // Preset 4: Emerald Green
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-green;
                                            border-width: root.selection-color-hex == "#10B981" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#10B981" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#10B981"); } }
                                        }
                                        // Preset 5: Amber Gold
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-amber;
                                            border-width: root.selection-color-hex == "#F59E0B" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#F59E0B" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#F59E0B"); } }
                                        }
                                        // Preset 6: Coral Red
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-red;
                                            border-width: root.selection-color-hex == "#EF4444" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#EF4444" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#EF4444"); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        Rectangle {
                                            width: 30px; height: 30px; border-radius: 4px;
                                            background: root.selection-color;
                                            border-width: 1px; border-color: DesignTokens.border;
                                        }
                                        Rectangle {
                                            width: 110px; height: 30px; border-radius: 4px;
                                            background: DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            TextInput {
                                                x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px;
                                                text: root.selection-color-hex;
                                                color: DesignTokens.text-primary;
                                                font-size: DesignTokens.font-small;
                                                single-line: true;
                                                accessible-label: root.label-selection-color;
                                                accepted => { root.selection-color-set(self.text); }
                                            }
                                        }
                                        Rectangle {
                                            width: 90px; height: 30px; border-radius: 4px;
                                            background: DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text {
                                                text: Tr.t("sl.reset_e96a00");
                                                color: DesignTokens.text-secondary;
                                                font-size: DesignTokens.font-caption;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                            TouchArea { clicked => { root.selection-color-set("#E96A00"); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: root.label-highlight-thickness; color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        PetuniaSlider {
                                            horizontal-stretch: 1;
                                            minimum: 1; maximum: 6;
                                            value <=> root.selection-thickness;
                                            accessible-label: root.label-highlight-thickness;
                                            changed(value) => { root.selection-thickness-set(value); }
                                            released(value) => { root.selection-thickness-released(value); }
                                        }
                                        Text { text: "\{round(root.selection-thickness * 10) / 10} px"; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 44px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }

                                // --- TAB 1: IDIOMA & REGIÃO ---
                                if root.settings-tab == 1: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: Tr.t("sl.interface_language"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 160px; height: 32px; border-radius: 4px;
                                            background: root.active-language == "pt-BR" ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text {
                                                text: Tr.t("sl.portugues_brasil");
                                                color: root.active-language == "pt-BR" ? DesignTokens.on-accent : DesignTokens.text-primary;
                                                font-size: DesignTokens.font-small; font-weight: 600;
                                                vertical-alignment: center; horizontal-alignment: center;
                                            }
                                            TouchArea { clicked => { root.language-changed("pt-BR"); } }
                                        }
                                        Rectangle {
                                            width: 160px; height: 32px; border-radius: 4px;
                                            background: root.active-language == "en" ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text {
                                                text: Tr.t("sl.english_us");
                                                color: root.active-language == "en" ? DesignTokens.on-accent : DesignTokens.text-primary;
                                                font-size: DesignTokens.font-small; font-weight: 600;
                                                vertical-alignment: center; horizontal-alignment: center;
                                            }
                                            TouchArea { clicked => { root.language-changed("en"); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: Tr.t("sl.localization_status"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    Rectangle {
                                        border-radius: 6px; background: DesignTokens.surface;
                                        border-width: 1px; border-color: DesignTokens.border;
                                        VerticalLayout {
                                            padding: 12px; spacing: 6px;
                                            Text { text: Tr.t("sl.partial_coverage_menus_and_tooltips_are_tran"); color: DesignTokens.warning; font-size: DesignTokens.font-small; font-weight: 600; wrap: word-wrap; }
                                            Text { text: Tr.t("sl.migration_of_literal_strings_to_textid_in_pr"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                                            Text { text: Tr.t("sl.automatic_fallback_to_english_when_a_key_is_"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; }
                                            Text { text: Tr.t("sl.target_canonical_vocabulary_point_round_edge"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                                        }
                                    }
                                }

                                // --- TAB 2: TECLADO & ATALHOS ---
                                if root.settings-tab == 2: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: Tr.t("sl.keyboard_shortcut_profile"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    // Lista vertical: nunca corta o nome do perfil, qualquer que seja a largura do painel.
                                    VerticalLayout {
                                        spacing: 4px;
                                        for profile in root.keymap-profiles: Rectangle {
                                            height: 30px;
                                            border-radius: 4px;
                                            background: profile.active ? DesignTokens.accent : (profile-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface);
                                            border-width: 1px;
                                            border-color: profile.active ? DesignTokens.focus-ring : DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: profile.name;
                                            accessible-checked: profile.active;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                Text {
                                                    text: profile.name;
                                                    color: profile.active ? DesignTokens.on-accent : DesignTokens.text-primary;
                                                    font-size: DesignTokens.font-small;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                                if profile.custom: Text {
                                                    text: Tr.t("sl.keymap_custom_badge");
                                                    color: profile.active ? DesignTokens.on-accent : DesignTokens.text-muted;
                                                    font-size: DesignTokens.font-caption;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            profile-touch := TouchArea { clicked => { root.keymap-changed(profile.id); } }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            height: 28px;
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: new-keymap-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: Tr.t("sl.keymap_new_profile");
                                            Text { text: Tr.t("sl.keymap_new_profile"); color: DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            new-keymap-touch := TouchArea { clicked => { root.keymap-profile-create(); } }
                                        }
                                        if root.active-keymap-id.starts-with("user-"): Rectangle {
                                            height: 28px;
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: del-keymap-touch.has-hover ? DesignTokens.danger.transparentize(0.8) : DesignTokens.surface;
                                            border-width: 1px;
                                            border-color: DesignTokens.danger;
                                            accessible-role: button;
                                            accessible-label: Tr.t("sl.keymap_delete_profile");
                                            Text { text: Tr.t("sl.keymap_delete_profile"); color: DesignTokens.danger; font-size: DesignTokens.font-small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            del-keymap-touch := TouchArea { clicked => { root.keymap-profile-delete(root.active-keymap-id); } }
                                        }
                                    }
                                    Text { text: Tr.t("sl.keymap_editor_hint"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                                    VerticalLayout {
                                        spacing: 2px;
                                        for row in root.keymap-rows: Rectangle {
                                            height: 26px;
                                            border-radius: 4px;
                                            background: row.capturing ? DesignTokens.accent.transparentize(0.8) : (row-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 4px;
                                                spacing: 6px;
                                                Text {
                                                    text: row.label;
                                                    color: DesignTokens.text-primary;
                                                    font-size: DesignTokens.font-caption;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                                Rectangle {
                                                    width: 118px;
                                                    height: 22px;
                                                    y: 2px;
                                                    border-radius: 3px;
                                                    background: DesignTokens.surface;
                                                    border-width: 1px;
                                                    border-color: row.capturing ? DesignTokens.focus-ring : (row.conflict ? DesignTokens.warning : DesignTokens.border);
                                                    accessible-role: button;
                                                    accessible-label: row.label + ": " + row.shortcut;
                                                    Text {
                                                        text: row.capturing ? Tr.t("sl.keymap_press_key") : (row.shortcut == "" ? "—" : row.shortcut);
                                                        color: row.conflict ? DesignTokens.warning : DesignTokens.text-primary;
                                                        font-size: DesignTokens.font-caption;
                                                        font-weight: 600;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    row-touch := TouchArea { clicked => { root.keymap-capture-requested(row.action); } }
                                                }
                                                Rectangle {
                                                    width: 22px;
                                                    height: 22px;
                                                    y: 2px;
                                                    border-radius: 3px;
                                                    background: reset-row-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                                    accessible-role: button;
                                                    accessible-label: Tr.t("sl.keymap_reset_binding");
                                                    IconDisplay { icon: IconSet.X; size: 11px; stroke: DesignTokens.text-muted; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                                    reset-row-touch := TouchArea { clicked => { root.keymap-binding-reset(row.action); } }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: Tr.t("sl.tool_confirmation_mode"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
