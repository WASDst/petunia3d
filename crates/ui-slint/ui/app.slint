    // Cor e espessura de um handle do gizmo conforme o estado da interação.
    function gizmo-handle-color(axis: int, base: color) -> color {
        if root.gizmo-constraint-axis-a == axis || root.gizmo-constraint-axis-b == axis {
            return base;
        }
        if root.gizmo-constraint-axis-a >= 0 {
            return base.transparentize(0.72);
        }
        if root.gizmo-active-axis == axis {
            return base;
        }
        if root.gizmo-active-axis >= 0 {
            // Durante o arrasto os outros eixos perdem presença.
            return base.transparentize(0.72);
        }
        if root.gizmo-hover-axis == axis {
            // Pré-seleção: o eixo sob o cursor ganha presença (clareia).
            return base.brighter(0.35);
        }
        return base;
    }

    function gizmo-handle-width(axis: int) -> length {
        if root.gizmo-constraint-axis-a == axis || root.gizmo-constraint-axis-b == axis {
            return 4px;
        }
        if root.gizmo-constraint-axis-a >= 0 {
            return 2px;
        }
        if root.gizmo-active-axis == axis {
            return 4px;
        }
        if root.gizmo-hover-axis == axis {
            return 3.5px;
        }
        return 2.5px;
    }

    changed command-search-visible => { root.command-selection = 0; }
    changed tool-modal-active => { if (root.tool-modal-active) { root.tool-properties-collapsed = false; } }
    changed loop-cut-active => { if (root.loop-cut-active) { root.tool-properties-collapsed = false; } }
    changed width => {
        root.compact-shell = self.width < 900px;
        if !root.compact-shell && root.scene-drawer-visible {
            root.scene-requested();
            root.model-parts-open = true;
        }
    }

    root-focus := FocusScope {
        init => { self.focus(); }
        key-released(event) => {
            root.precision-mode = event.modifiers.shift;
            root.snap-mode = event.modifiers.control;
            reject
        }
        key-pressed(event) => {
            root.precision-mode = event.modifiers.shift;
            root.snap-mode = event.modifiers.control;
            if root.settings-visible && (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                root.settings-tab = event.text == Key.DownArrow ? min(root.settings-tab + 1, 7) : max(root.settings-tab - 1, 0);
                return accept;
            }
            if event.text == Key.F6 {
                if root.f6-in-rail && !root-focus.has-focus && root.inspector-visible && !root.compact-shell {
                    root.f6-in-rail = false;
                    root-focus.focus();
                } else if root.inspector-visible && !root.compact-shell {
                    root.f6-in-rail = true;
                    root.f6-rail-token += 1;
                } else {
                    root-focus.focus();
                }
                return accept;
            }
            if event.text == Key.Escape {
                if root.context-menu-open {
                    root.context-menu-open = false;
                    root.click-away-requested();
                    return accept;
                }
                if root.settings-visible {
                    root.settings-visible = false;
                    root.settings-closed();
                    return accept;
                }
                if root.reference-manager-visible {
                    root.reference-manager-visible = false;
                    root.reference-manager-closed();
                    return accept;
                }
                viewport-touch.clear-gesture();
                root.escape-requested();
                return accept;
            }
            if !root.command-search-visible && !root.settings-visible && !root.reference-manager-visible {
                let key-name = event.text == Key.Tab ? "Tab" :
                    event.text == Key.Return ? "Enter" :
                    event.text == Key.Backspace ? "Backspace" :
                    event.text == Key.Delete ? "Delete" :
                    event.text == Key.Home ? "Home" :
                    event.text == Key.End ? "End" :
                    event.text == Key.PageUp ? "PageUp" :
                    event.text == Key.PageDown ? "PageDown" :
                    event.text == Key.Insert ? "Insert" :
                    event.text == Key.UpArrow ? "Up" :
                    event.text == Key.DownArrow ? "Down" :
                    event.text == Key.LeftArrow ? "Left" :
                    event.text == Key.RightArrow ? "Right" :
                    event.text == Key.F1 ? "F1" :
                    event.text == Key.F2 ? "F2" :
                    event.text == Key.F3 ? "F3" :
                    event.text == Key.F4 ? "F4" :
                    event.text == Key.F5 ? "F5" :
                    event.text == Key.F6 ? "F6" :
                    event.text == Key.F7 ? "F7" :
                    event.text == Key.F8 ? "F8" :
                    event.text == Key.F9 ? "F9" :
                    event.text == Key.F10 ? "F10" :
                    event.text == Key.F11 ? "F11" :
                    event.text == Key.F12 ? "F12" :
                    event.text;
                root.shortcut-requested(
                    key-name,
                    event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 42px;
                background: DesignTokens.surface;
                border-width: 1px;
                border-color: DesignTokens.border;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 0px;

                    // 1. Esquerda: Logo + Barra de Menus (alinhados à extrema esquerda)
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 6px;

                        Image {
                            source: @image-url("icons/logo.svg");
                            width: 22px;
                            height: 22px;
                        }

                        Rectangle { width: 4px; }

                        MenuButton {
                            label: root.menu-file-label;
                            shortcut: "Alt+F";
                            description: "New, open, save, import/export projects and scene files";
                            open: root.menu-open == "file";
                            clicked => {
                                root.menu-anchor-x = self.absolute-position.x;
                                root.menu-toggled("file");
                            }
                            hovered => {
                                if root.menu-open != "" && root.menu-open != "file" {
                                    root.menu-anchor-x = self.absolute-position.x;
                                    root.menu-opened("file");
                                }
                            }
                        }
                        MenuButton {
                            label: root.menu-edit-label;
                            shortcut: "Alt+E";
                            description: "Undo, redo, history and global application preferences";
                            open: root.menu-open == "edit";
                            clicked => {
                                root.menu-anchor-x = self.absolute-position.x;
                                root.menu-toggled("edit");
                            }
                            hovered => {
                                if root.menu-open != "" && root.menu-open != "edit" {
                                    root.menu-anchor-x = self.absolute-position.x;
                                    root.menu-opened("edit");
                                }
                            }
                        }
                        MenuButton {
                            label: root.menu-view-label;
                            shortcut: "Alt+V";
                            description: "Camera viewpoints, viewport overlays and rendering display modes";
                            open: root.menu-open == "view";
                            clicked => {
                                root.menu-anchor-x = self.absolute-position.x;
                                root.menu-toggled("view");
                            }
                            hovered => {
                                if root.menu-open != "" && root.menu-open != "view" {
                                    root.menu-anchor-x = self.absolute-position.x;
                                    root.menu-opened("view");
                                }
                            }
                        }
                        MenuButton {
                            label: root.menu-window-label;
                            shortcut: "Alt+W";
                            description: "Toggle panels, layouts, fullscreen mode and accessibility options";
                            open: root.menu-open == "window";
                            clicked => {
                                root.menu-anchor-x = self.absolute-position.x;
                                root.menu-toggled("window");
                            }
                            hovered => {
                                if root.menu-open != "" && root.menu-open != "window" {
                                    root.menu-anchor-x = self.absolute-position.x;
                                    root.menu-opened("window");
                                }
                            }
                        }
                    }

                    // 2. Centro: Seletor de Workspace rigorosamente centralizado
                    WorkspaceSegment {
                        active: active-workspace == "MODEL" ? root.modeling-mode : active-workspace;
                        draw-title: root.label-workspace-draw-title;
                        draw-description: root.label-workspace-draw-description;
                        poly-title: root.label-workspace-poly-title;
                        poly-description: root.label-workspace-poly-description;
                        reduced-motion: root.reduced-motion;
                        changed(ws) => { root.workspace-changed(ws); }
                    }

                    // 3. Direita: Ações e Ferramentas (alinhadas à extrema direita)
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        spacing: 4px;

                        TopAction {
                            icon: IconSet.Undo;
                            icon-svg: PetuniaIcons.undo;
                            semantic-label: "Undo";
                            shortcut: root.shortcuts.undo;
                            description: "Revert the most recent modeling or editing operation";
                            enabled: root.can-undo;
                            clicked => { root.undo-requested(); }
                        }
                        TopAction {
                            icon: IconSet.Redo;
                            icon-svg: PetuniaIcons.redo;
                            semantic-label: "Redo";
                            shortcut: root.shortcuts.redo;
                            description: "Reapply the most recently undone operation";
                            enabled: root.can-redo;
                            clicked => { root.redo-requested(); }
                        }

                        Rectangle { width: 1px; height: 16px; background: DesignTokens.border; }

                        TopAction {
                            icon: IconSet.PanelLeft;
                            icon-svg: PetuniaIcons.parts;
                            semantic-label: "Parts";
                            shortcut: root.shortcuts.parts;
                            description: "Toggle the scene parts outliner and hierarchy list";
                            clicked => { root.scene-requested(); }
                        }
                        TopAction {
                            icon: IconSet.FolderOpen;
                            semantic-label: "Open project";
                            shortcut: root.shortcuts.open;
                            description: "Open an existing project from disk (.p3d)";
                            clicked => { root.open-project-requested(); }
                        }
                        TopAction {
                            icon: IconSet.Save;
                            semantic-label: "Save project";
                            shortcut: root.shortcuts.save;
                            description: "Save the current project and scene to disk";
                            clicked => { root.save-requested(); }
                        }
                        TopAction {
                            icon: IconSet.Search;
                            semantic-label: "Command search";
                            shortcut: root.shortcuts.search;
                            description: "Quick search and execute any command, tool or setting";
                            clicked => { root.search-requested(); }
                        }
                        TopAction {
                            icon: IconSet.Image;
                            semantic-label: "Reference Images";
                            shortcut: "F4";
                            description: "Open Reference Image Manager to load blueprints and background references";
                            active: root.reference-manager-visible;
                            clicked => { root.reference-manager-toggle(); }
                        }
                        TopAction {
                            icon: IconSet.Settings;
                            icon-svg: PetuniaIcons.settings;
                            semantic-label: "Settings";
                            shortcut: root.shortcuts.settings;
                            description: "Open application preferences, keymaps and theme settings";
                            clicked => { root.settings-requested(); }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                horizontal-stretch: 1;
                vertical-stretch: 1;

                // Contextual Tool Tray. Workspaces live only in the header.
                Rectangle {
                    width: 44px;
                    background: DesignTokens.surface-raised;
                    border-width: 1px;
                    border-color: DesignTokens.border;

                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 5px;
                        alignment: start;

                        if active-workspace == "MODEL": VerticalLayout {
                            spacing: 5px;

                            // Grupo de Seleção (Box & Lasso)
                            Rectangle {
                                border-radius: 6px;
                                background: DesignTokens.canvas;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    ToolButton {
                                        icon: IconSet.MousePointer2;
                                        semantic-label: root.label-model-select;
                                        shortcut: root.shortcuts.model-select;
                                        description: "Box / click selection of scene points, edges and faces";
                                        active: active-tool == "select" || active-tool == "box_select";
                                        clicked => { root.active-tool-changed("select"); }
                                    }
                                    ToolButton {
                                        icon: IconSet.Spline;
                                        semantic-label: root.label-model-lasso;
                                        shortcut: root.shortcuts.model-lasso;
                                        description: "Freehand polygon loop lasso selection";
                                        active: active-tool == "lasso_select";
                                        clicked => { root.command-executed("model.tool_lasso"); }
                                    }
                                }
                            }

                            // 3D Cursor / Ponto Âncora 3D
                            ToolButton {
                                icon: IconSet.Crosshair;
                                semantic-label: "3D Cursor";
                                shortcut: root.shortcuts.model-cursor;
                                description: "Place 3D cursor as origin for new objects and transformations";
                                active: active-tool == "cursor" || active-tool == "cursor_3d";
                                clicked => { root.command-executed("model.tool_cursor"); }
                            }

                            // Quick Measure Tool (Fase 6: Fita Métrica 3D)
                            ToolButton {
                                icon: IconSet.ArrowUpDown;
                                semantic-label: "Measure";
                                shortcut: root.shortcuts.model-measure;
                                description: "Measure distances and angles between geometry elements in 3D";
                                active: active-tool == "measure";
                                clicked => { root.command-executed("model.measure"); }
                            }

                            Rectangle {
                                width: 28px;
                                height: 1px;
                                background: DesignTokens.border;
                            }
                            ViewportSvgButton {
                                glyph: PetuniaIcons.tool-position;
                                label: root.label-model-position;
                                shortcut: root.shortcuts.model-move;
                                description: "Translate active selection along axes or viewport plane";
                                active: active-tool == "move";
                                live-mode: active-tool == "move" && root.transform-instant-active;
                                clicked => { root.active-tool-changed("move"); }
                            }
                            ViewportSvgButton {
                                glyph: PetuniaIcons.tool-rotate;
                                label: root.label-model-rotate;
                                shortcut: root.shortcuts.model-rotate;
                                description: "Rotate active selection around the active pivot point";
                                active: active-tool == "rotate";
                                live-mode: active-tool == "rotate" && root.transform-instant-active;
                                clicked => { root.active-tool-changed("rotate"); }
                            }
                            ViewportSvgButton {
                                glyph: PetuniaIcons.tool-scale;
                                label: root.label-model-scale;
                                shortcut: root.shortcuts.model-scale;
                                description: "Resize active selection proportionally or along specific axes";
                                active: active-tool == "scale";
                                live-mode: active-tool == "scale" && root.transform-instant-active;
                                clicked => { root.active-tool-changed("scale"); }
                            }
                            ViewportSvgButton {
                                glyph: PetuniaIcons.tool-transform;
                                label: root.label-model-transform;
                                shortcut: root.shortcuts.model-transform;
                                description: "Universal 3-in-1 gizmo for translate, rotate and scale";
                                active: active-tool == "transform";
                                live-mode: active-tool == "transform" && root.transform-instant-active;
                                clicked => { root.command-executed("model.tool_transform"); }
                            }

                            Rectangle {
                                width: 28px;
                                height: 1px;
                                background: DesignTokens.border;
                            }

                            ToolButton {
                                icon-svg: PetuniaIcons.tool-profile;
                                semantic-label: "Sketch / Profile";
                                shortcut: root.shortcuts.model-profile;
                                description: "Draw 2D profile curves on ground, face, or viewplane to extrude or revolve";
                                active: active-tool == "draw_profile";
                                clicked => { root.active-tool-changed("draw_profile"); }
                            }
                            ToolButton {
                                icon: IconSet.Square;
                                semantic-label: "2D Rectangle";
                                description: "Create 2D rectangle profile on active workplane, ready to extrude";
                                active: false;
                                clicked => { root.add-profile-rectangle(2.0, 1.5); }
                            }
                            ToolButton {
                                icon: IconSet.Circle;
                                semantic-label: "2D Circle";
                                description: "Create 2D circle profile on active workplane, ready to extrude or revolve";
                                active: false;
                                clicked => { root.add-profile-circle(1.0, 16); }
                            }

                            Rectangle {
                                width: 28px;
                                height: 1px;
                                background: DesignTokens.border;
                            }

                            ToolButton {
                                icon: IconSet.Plus;
                                semantic-label: "Add Primitive";
                                shortcut: root.shortcuts.model-add-primitive;
                                description: "Quick menu to create standard 3D parametric shapes";
                                active: root.add-menu-open;
                                clicked => {
                                    root.add-menu-open = !root.add-menu-open;
                                    root.add-menu-changed(root.add-menu-open);
                                }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.cube;
                                semantic-label: "Add Cube";
                                shortcut: "Shift+A, 1";
                                description: "Add parametric 3D cube mesh with customizable subdivisions";
                                active: false;
                                clicked => { root.add-primitive-requested("cube"); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.sphere;
                                semantic-label: "Add Sphere";
                                shortcut: "Shift+A, 2";
                                description: "Add UV sphere mesh with longitude and latitude rings";
                                active: false;
                                clicked => { root.add-primitive-requested("sphere"); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.cylinder;
                                semantic-label: "Add Cylinder";
                                shortcut: "Shift+A, 3";
                                description: "Add parametric cylinder with radial subdivisions";
                                active: false;
                                clicked => { root.add-primitive-requested("cylinder"); }
                            }
                        }

                        if active-workspace == "PAINT": VerticalLayout {
                            spacing: 6px;
                            ToolButton {
                                icon: IconSet.Paintbrush;
                                semantic-label: "Brush";
                                shortcut: root.shortcuts.paint-brush;
                                description: "Freehand raster texture painting with adjustable size and softness";
                                active: active-tool == "brush";
                                clicked => { root.active-tool-changed("brush"); }
                            }
                            ToolButton {
                                icon: IconSet.Eraser;
                                semantic-label: "Eraser";
                                shortcut: root.shortcuts.paint-eraser;
                                description: "Erase pixel color values and alpha transparency from active texture";
                                active: active-tool == "eraser";
                                clicked => { root.active-tool-changed("eraser"); }
                            }
                            ToolButton {
                                icon: IconSet.Pipette;
                                semantic-label: "Color Picker";
                                shortcut: root.shortcuts.paint-picker;
                                description: "Sample color from viewport pixels under mouse cursor";
                                active: active-tool == "picker";
                                clicked => { root.active-tool-changed("picker"); }
                            }
                            ToolButton {
                                icon: IconSet.PaintBucket;
                                semantic-label: "Fill Bucket";
                                shortcut: root.shortcuts.paint-fill;
                                description: "Flood fill contiguous color areas on active UV map";
                                active: active-tool == "fill";
                                clicked => { root.active-tool-changed("fill"); }
                            }
                            ToolButton {
                                icon: IconSet.SquareDashed;
                                semantic-label: "Line";
                                shortcut: root.shortcuts.paint-line;
                                description: "Draw straight brush strokes between clicked endpoints";
                                active: active-tool == "line";
                                clicked => { root.active-tool-changed("line"); }
                            }
                            ToolButton {
                                icon: IconSet.Square;
                                semantic-label: "Rectangle";
                                shortcut: root.shortcuts.paint-rectangle;
                                description: "Fill or stroke rectangular 2D shapes on texture canvas";
                                active: active-tool == "rectangle";
                                clicked => { root.active-tool-changed("rectangle"); }
                            }
                        }

                        if active-workspace == "UV": VerticalLayout {
                            spacing: 6px;
                            ToolButton {
                                icon: IconSet.MousePointer2;
                                semantic-label: "UV Select";
                                shortcut: root.shortcuts.uv-select;
                                description: "Select UV vertices, edges and polygon islands";
                                active: active-tool == "uv_select";
                                clicked => { root.active-tool-changed("uv_select"); }
                            }
                            ToolButton {
                                icon: IconSet.Maximize2;
                                semantic-label: "Unwrap";
                                shortcut: root.shortcuts.uv-unwrap;
                                description: "Unfold 3D mesh surface into flat 2D UV layout";
                                active: false;
                                clicked => { root.command-executed("uv.unwrap"); }
                            }
                            ToolButton {
                                icon: IconSet.Grid2x2;
                                semantic-label: "Pack Islands";
                                shortcut: root.shortcuts.uv-pack;
                                description: "Pack and arrange UV islands efficiently without overlap";
                                active: false;
                                clicked => { root.command-executed("uv.pack_islands"); }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        // Navigation pills (Decision D4: Parts & Asset Library)
                        Rectangle {
                            width: 28px;
                            height: 1px;
                            background: DesignTokens.border;
                        }
                        ToolButton {
                            icon: IconSet.Layers3;
                            semantic-label: root.label-parts;
                            shortcut: "F4";
                            description: "Open or collapse the scene parts hierarchy outliner";
                            active: scene-drawer-visible;
                            clicked => { root.scene-requested(); }
                        }
                        ToolButton {
                            icon: IconSet.FolderArchive;
                            semantic-label: root.label-asset-library;
                            shortcut: "Shift+F5";
                            description: "Open or collapse the bottom project asset library";
                            active: asset-library-visible;
                            clicked => { root.asset-library-requested(); }
                        }
                    }
                }

                viewport-region := Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    background: DesignTokens.canvas;
                    border-width: 1px;
                    border-color: DesignTokens.border;

                    // Em px físicos a medida muda também quando só o fator de escala
                    // muda (UI scale, troca de monitor), o que recria o alvo nítido.
                    property <float> physical-width: self.width / 1phx;
                    property <float> physical-height: self.height / 1phx;
                    changed width => {
                        root.viewport-resized(self.width / 1px, self.height / 1px, self.physical-width, self.physical-height);
                    }
                    changed height => {
                        root.viewport-resized(self.width / 1px, self.height / 1px, self.physical-width, self.physical-height);
                    }
                    changed physical-width => {
                        root.viewport-resized(self.width / 1px, self.height / 1px, self.physical-width, self.physical-height);
                    }
                    changed physical-height => {
                        root.viewport-resized(self.width / 1px, self.height / 1px, self.physical-width, self.physical-height);
                    }

                    if has-gpu-viewport: Image {
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                        source: root.viewport-image;
                    }

                    if !has-gpu-viewport: Text {
                        text: "VIEWPORT\n\nSlint shell bootstrap\nGPU viewport remains behind PetuniaViewport";
                        color: DesignTokens.text-muted;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Coordenadas já projetadas em pixels da viewport. Não
                    // normalizar os paths à caixa do item (fit padrão).
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: transparent;
                        stroke: DesignTokens.text-secondary;
                        stroke-width: 1.25px;
                        commands: root.selection-unselected-outline-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: transparent;
                        // Modo componente usa o mesmo laranja da seleção
                        // (Blender não pinta seleção de edit-mode de azul):
                        // o accent virou vestígio e sai na próxima limpeza.
                        stroke: root.selection-color;
                        stroke-width: max(2px, root.selection-thickness * 1px);
                        commands: root.selection-outline-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: root.selection-thickness * 1.2 * 1px;
                        commands: root.selection-active-outline-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: DesignTokens.text-muted;
                        stroke: transparent;
                        commands: root.selection-unselected-point-commands;
                    }
                    if selection-overlay-visible: Path {
                        fit: ImageFit.preserve;
                        fill: root.selection-color;
                        stroke: transparent;
                        commands: root.selection-point-commands;
                    }

                    Path {
                        fit: ImageFit.preserve;
                        commands: root.operation-preview-commands;
                        fill: transparent;
                        stroke: #FFAF29;
                        stroke-width: 2.5px;
                    }
                    Path {
                        fit: ImageFit.preserve;
                        commands: root.loop-cut-preview-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: 2px;
                    }
                    // Poly Pen: pontos coletados até o cursor.
                    if root.poly-pen-preview-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.poly-pen-preview-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: 2px;
                    }

                    // Região fechada sob o cursor (Draw/Push-Pull): tinta translúcida.
                    if root.region-hover-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.region-hover-commands;
                        fill-rule: evenodd;
                        fill: DesignTokens.selection.transparentize(0.78);
                        stroke: DesignTokens.selection;
                        stroke-width: 1.5px;
                    }
                    Path {
                        fit: ImageFit.preserve;
                        commands: root.profile-preview-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection;
                        stroke-width: 2px;
                    }

                    // Cordão da ferramenta ativa: tracejado amarelo da base da
                    // seleção até o mouse. Cresce/encolhe com a distância.
                    if root.drag-link-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.drag-link-commands;
                        fill: transparent;
                        stroke: DesignTokens.selection-active;
                        stroke-width: 1.5px;
                    }

                    // Círculo pontilhado do raio de influência para Proportional Editing
                    if root.proportional-circle-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.proportional-circle-commands;
                        fill: transparent;
                        stroke: #E0E0E0;
                        stroke-width: 1.5px;
                    }

                    // Infinite Axis Guide Line (Fase 4: Linhas de Guia Infinitas)
                    if root.axis-guide-visible && root.axis-guide-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.axis-guide-commands;
                        fill: transparent;
                        stroke: root.axis-guide-color;
                        stroke-width: 1.5px;
                    }

                    // Rótulo discreto do eixo na linha de guia infinita
                    if root.axis-guide-visible && root.axis-guide-label != "" && active-workspace == "MODEL": Rectangle {
                        x: root.axis-guide-label-x - 9px;
                        y: root.axis-guide-label-y - 9px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: #14141ef0;
                        border-width: 1.5px;
                        border-color: root.axis-guide-color;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000088;
                        Text {
                            text: root.axis-guide-label;
                            color: root.axis-guide-color;
                            font-size: 10px;
                            font-weight: 700;
                            font-family: "monospace";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Dimension Line (Fase 4: Cotas Blueprint)
                    if root.dimension-visible && root.dimension-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.dimension-commands;
                        fill: transparent;
                        stroke: #3e63dd;
                        stroke-width: 1.5px;
                    }

                    // Quick Measure Line (Fase 6: Fita Métrica 3D)
                    if root.measure-visible && root.measure-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.measure-commands;
                        fill: transparent;
                        stroke: #f59e0baa;
                        stroke-width: 1.2px;
                    }

                    // Protractor (Transferidor Visual de Ângulo para Rotação Modal)
                    if root.protractor-visible && root.protractor-wedge-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.protractor-wedge-commands;
                        fill: DesignTokens.accent.transparentize(0.85);
                        stroke: DesignTokens.accent;
                        stroke-width: 1.5px;
                    }
                    if root.protractor-visible && root.protractor-ticks-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.protractor-ticks-commands;
                        fill: transparent;
                        stroke: DesignTokens.accent.transparentize(0.4);
                        stroke-width: 1px;
                    }

                    // 3D Decal Live Projection Manipulator (Sprint C: P3D-133 / P3D-160)
                    if root.active-workspace == "PAINT" && root.active-layer-is-decal && root.decal-preview-commands != "": Path {
                        fit: ImageFit.preserve;
                        commands: root.decal-preview-commands;
                        fill: DesignTokens.accent.transparentize(0.90);
                        stroke: DesignTokens.accent;
                        stroke-width: 1.5px;
                    }

                    viewport-touch := TouchArea {
                        mouse-cursor: self.is-orbit || self.is-pan || self.is-gizmo-drag ? grabbing
                            : (self.is-transform || self.is-keyboard-transform-drag) ? (root.active-tool == "scale" ? nesw-resize : (root.active-tool == "rotate" ? grabbing : move))
                            : (root.active-workspace == "PAINT") ? crosshair
                            : (root.active-tool == "slice" || root.active-tool == "cut" || root.active-tool == "loop_cut" || root.active-tool == "measure" || root.active-tool == "draw_profile" || root.active-tool == "cursor" || root.active-tool == "cursor_3d" || self.is-box-select || self.is-lasso-select || root.active-tool == "lasso_select") ? crosshair
                            : (root.active-tool == "extrude" || root.active-tool == "push_pull") ? ns-resize
                            : root.active-tool == "bevel" ? nesw-resize
                            : root.active-tool == "inset" ? nwse-resize
                            : root.active-tool == "scale" ? nesw-resize
                            : root.active-tool == "rotate" ? grabbing
                            : root.active-tool == "move" ? move
                            : root.gizmo-has-hover ? grab
                            : default;
                        property <length> last-x;
                        property <length> last-y;
                        property <bool> is-box-select: false;
                        property <bool> is-lasso-select: false;
                        property <bool> pending-lasso-select: false;
                        property <string> lasso-points: "";
                        property <string> lasso-base-commands: "";
                        property <string> lasso-commands: "";
                        property <length> lasso-last-x;
                        property <length> lasso-last-y;
                        property <int> lasso-count: 0;
                        property <bool> subtract-selection: false;
                        property <bool> is-orbit: false;
                        property <bool> is-pan: false;
                        property <bool> moved-since-down: false;
                        property <bool> extend-selection: false;
                        property <bool> is-transform: false;
                        property <bool> pending-transform: false;
                        // Tweak do Blender: com a tool Select, o arrasto vira
                        // box select; o clique (sem arrasto) só seleciona.
                        property <bool> pending-box-select: false;
                        property <bool> is-painting: false;
                        property <bool> is-tool-drag: false;
                        property <bool> is-loop-drag: false;
                        property <bool> is-loop-place: false;
                        property <bool> pending-slice: false;
                        property <bool> is-slice-drag: false;
                        property <bool> is-gizmo-drag: false;
                        property <bool> is-keyboard-transform-drag: false;
                        // Gesto da gramática única em andamento (botão pressionado).
                        property <bool> is-tool-gesture: false;
                        property <bool> is-profile-depth-drag: false;
                        property <bool> is-profile-volume-drag: false;
                        property <bool> is-profile-draw-drag: false;
                        property <bool> is-profile-point-drag: false;
                        property <bool> consume-click: false;
                        property <bool> tool-drag-fine: false;
                        property <bool> loop-selection: false;
                        property <string> local-kind: "";

                        function clear-gesture() {
                            self.is-box-select = false;
                            self.is-lasso-select = false;
                            self.pending-lasso-select = false;
                            self.lasso-points = "";
                            self.lasso-base-commands = "";
                            self.lasso-commands = "";
                            self.is-transform = false;
                            self.pending-transform = false;
                            self.pending-box-select = false;
                            self.is-tool-drag = false;
                            self.is-profile-depth-drag = false;
                            self.is-profile-volume-drag = false;
                            self.is-profile-draw-drag = false;
                            self.is-profile-point-drag = false;
                            self.is-loop-drag = false;
                            self.is-loop-place = false;
                            self.pending-slice = false;
                            self.is-slice-drag = false;
                            self.is-gizmo-drag = false;
                            self.is-keyboard-transform-drag = false;
                            self.is-tool-gesture = false;
                            self.consume-click = false;
                            self.loop-selection = false;
                            self.is-painting = false;
                            self.is-orbit = false;
                            self.is-pan = false;
                            self.moved-since-down = true;
                        }

                        function transform-tool() -> string {
                            if root.active-workspace != "MODEL" {
                                return "";
                            }
                            if root.active-tool == "move" || root.active-tool == "transform" {
                                return "pos";
                            }
                            if root.active-tool == "rotate" {
                                return "rot";
                            }
                            if root.active-tool == "scale" {
                                return "scale";
                            }
                            return "";
                        }

                        pointer-event(event) => {
                            root.precision-mode = event.modifiers.shift;
                            root.snap-mode = event.modifiers.control;
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right
                                && (is-tool-gesture || root.tool-gesture-latched || is-transform || is-gizmo-drag
                                    || is-tool-drag || is-keyboard-transform-drag || root.transform-instant-active
                                    || is-loop-drag || is-slice-drag) {
                                // RMB nunca cancela um gesto (constituição 11); cancelar é Esc.
                            } else if event.kind == PointerEventKind.cancel || (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                if event.kind == PointerEventKind.cancel && (is-tool-gesture || root.tool-gesture-latched) {
                                    root.tool-pointer(3, self.mouse-x / 1px, self.mouse-y / 1px, false, false);
                                }
                                self.clear-gesture();
                                if event.kind == PointerEventKind.down && event.modifiers.shift {
                                    consume-click = true;
                                    root.viewport-place-cursor(self.mouse-x / self.width, self.mouse-y / self.height);
                                } else {
                                    // Sem gesto: abre o menu da viewport.
                                    root.viewport-context-requested(self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            } else if event.kind == PointerEventKind.down {
                                root-focus.focus();
                                last-x = self.mouse-x;
                                last-y = self.mouse-y;
                                moved-since-down = false;
                                consume-click = false;
                                extend-selection = event.modifiers.shift;
                                loop-selection = event.modifiers.alt;
                                is-transform = false;
                                pending-transform = false;
                                pending-box-select = false;
                                pending-lasso-select = false;
                                if event.button == PointerEventButton.left && root.active-tool == "draw_profile" {
                                    if root.viewport-profile-pointer-down(self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.alt) {
                                        is-profile-point-drag = true;
                                        consume-click = true;
                                    } else if root.profile-volume-mode != "none" {
                                        is-profile-volume-drag = true;
                                        tool-drag-fine = event.modifiers.shift;
                                    } else if root.profile-closed {
                                        is-profile-depth-drag = true;
                                        tool-drag-fine = event.modifiers.shift;
                                    } else {
                                        consume-click = true;
                                        is-profile-draw-drag = true;
                                        root.viewport-select(self.mouse-x / self.width, self.mouse-y / self.height, false, false);
                                    }
                                } else if event.button == PointerEventButton.middle {
                                    if event.modifiers.shift {
                                        is-pan = true;
                                        is-orbit = false;
                                    } else {
                                        is-orbit = true;
                                        is-pan = false;
                                    }
                                } else if event.button == PointerEventButton.left && event.modifiers.alt && root.active-keymap-id == "maya" {
                                    is-orbit = true;
                                    is-pan = false;
                                } else if event.button == PointerEventButton.left && root.active-tool == "lasso_select" && !event.modifiers.alt {
                                    pending-lasso-select = true;
                                    is-lasso-select = false;
                                    subtract-selection = event.modifiers.control;
                                    lasso-last-x = self.mouse-x;
                                    lasso-last-y = self.mouse-y;
                                    lasso-count = 0;
                                    lasso-points = "";
                                    lasso-base-commands = "";
                                    lasso-commands = "";
                                } else if event.button == PointerEventButton.left && (root.active-tool == "cursor" || root.active-tool == "cursor_3d") {
                                    consume-click = true;
                                    root.viewport-place-cursor(self.mouse-x / self.width, self.mouse-y / self.height);
                                } else if event.button == PointerEventButton.left
                                    && (!event.modifiers.alt || root.active-keymap-id != "maya") {
                                    // Gramática única: ferramentas persistentes (Move/Rotate/Scale,
                                    // Extrude, Inset, Round Edge, Push/Pull) e o gizmo delas decidem
                                    // clique × arrasto no bridge; o clique sem arrasto seleciona lá.
                                    if root.tool-gesture-latched
                                        || (root.tool-grammar-active && !event.modifiers.alt && !root.transform-instant-active) {
                                        is-tool-gesture = true;
                                        consume-click = true;
                                        root.tool-pointer(0, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control);
                                    } else if root.gizmo-has-hover {
                                        is-gizmo-drag = true;
                                        root.gizmo-drag-begin(self.mouse-x / 1px, self.mouse-y / 1px);
                                    } else if root.transform-instant-active {
                                        // O atalho já abriu a operação modal. O mesmo
                                        // clique pode confirmar ou iniciar um arrasto;
                                        // não exigir um primeiro clique descartável.
                                        is-keyboard-transform-drag = true;
                                        consume-click = true;
                                    } else if root.active-workspace == "PAINT" {
                                        is-painting = true;
                                        root.viewport-paint-begin(self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control);
                                    } else if root.active-tool == "slice" {
                                        pending-slice = true;
                                    } else if root.active-tool == "loop_cut" && !root.loop-cut-active {
                                        is-loop-place = true;
                                        consume-click = true;
                                    } else if root.loop-cut-active {
                                        is-loop-drag = true;
                                        tool-drag-fine = event.modifiers.shift;
                                    } else if root.tool-modal-active {
                                        is-tool-drag = true;
                                        tool-drag-fine = event.modifiers.shift;
                                    } else {
                                        local-kind = self.transform-tool();
                                        if local-kind != "" && !event.modifiers.alt {
                                            // A ferramenta só inicia uma operação após um
                                            // arrasto real; um clique continua selecionando.
                                            pending-transform = true;
                                        } else if (root.active-tool == "select" || root.active-tool == "box_select")
                                            && root.active-workspace == "MODEL"
                                            && !root.gizmo-has-hover
                                            && !root.transform-instant-active
                                            && !root.tool-modal-active
                                            && !root.loop-cut-active
                                            && !event.modifiers.alt {
                                            // Tweak / Box Select (Blender): arrastar
                                            // vira box select; o clique (sem
                                            // arrasto) cai no viewport-select.
                                            pending-box-select = true;
                                            subtract-selection = event.modifiers.control;
                                        }
                                    }
                                }
                            } else if event.kind == PointerEventKind.move {
                                if !self.pressed {
                                    // TouchArea.moved só dispara durante um grab. O
                                    // pointer-event Move também cobre hover livre,
                                    // necessário para operações iniciadas por atalho.
                                    root.gizmo-hover(self.mouse-x / 1px, self.mouse-y / 1px);
                                    if !root.gizmo-has-hover {
                                        root.viewport-hover(self.mouse-x / self.width, self.mouse-y / self.height);
                                    } else {
                                        root.viewport-hover-clear();
                                    }
                                }
                                if is-box-select {
                                    if abs(self.mouse-x - last-x) > 4px || abs(self.mouse-y - last-y) > 4px { moved-since-down = true; }
                                } else if pending-lasso-select && self.pressed
                                    && (abs(self.mouse-x - lasso-last-x) > 3px || abs(self.mouse-y - lasso-last-y) > 3px) {
                                    pending-lasso-select = false;
                                    is-lasso-select = true;
                                    moved-since-down = true;
                                    lasso-count = 2;
                                    lasso-points = "\{lasso-last-x / self.width},\{lasso-last-y / self.height};\{self.mouse-x / self.width},\{self.mouse-y / self.height};";
                                    lasso-base-commands = "M \{lasso-last-x / 1px} \{lasso-last-y / 1px} L \{self.mouse-x / 1px} \{self.mouse-y / 1px} ";
                                    lasso-commands = lasso-base-commands + "Z";
                                    lasso-last-x = self.mouse-x;
                                    lasso-last-y = self.mouse-y;
                                } else if is-lasso-select && self.pressed {
                                    if lasso-count < 4096 && (abs(self.mouse-x - lasso-last-x) > 3px || abs(self.mouse-y - lasso-last-y) > 3px) {
                                        lasso-last-x = self.mouse-x;
                                        lasso-last-y = self.mouse-y;
                                        lasso-count += 1;
                                        lasso-points += "\{self.mouse-x / self.width},\{self.mouse-y / self.height};";
                                        lasso-base-commands += "L \{self.mouse-x / 1px} \{self.mouse-y / 1px} ";
                                    }
                                    lasso-commands = lasso-base-commands + "L \{self.mouse-x / 1px} \{self.mouse-y / 1px} Z";
                                } else if pending-box-select && self.pressed
                                    && (self.mouse-x - last-x > 4px || last-x - self.mouse-x > 4px
                                        || self.mouse-y - last-y > 4px || last-y - self.mouse-y > 4px) {
                                    pending-box-select = false;
                                    is-box-select = true;
                                    moved-since-down = true;
                                } else if is-orbit {
                                    moved-since-down = true;
                                    root.viewport-orbit((self.mouse-x - last-x) / 1px, (self.mouse-y - last-y) / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-pan {
                                    moved-since-down = true;
                                    root.viewport-pan((self.mouse-x - last-x) / 1px, (self.mouse-y - last-y) / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if (is-tool-gesture && self.pressed) || root.tool-gesture-latched {
                                    // Gramática única: o bridge decide clique × arrasto e aplica.
                                    moved-since-down = true;
                                    root.tool-pointer(1, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control);
                                } else if event.modifiers.alt && root.active-keymap-id != "maya"
                                    && (abs(self.mouse-x - last-x) > 4px || abs(self.mouse-y - last-y) > 4px) {
                                    moved-since-down = true;
                                } else if root.transform-instant-active && (!self.pressed || is-keyboard-transform-drag) {
                                    if is-keyboard-transform-drag { moved-since-down = true; }
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if is-gizmo-drag {
                                    moved-since-down = true;
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if root.tool-modal-active && (root.tool-activation == "instant" || root.keyboard-tool-modal-active) && !self.pressed {
                                    root.tool-modal-hovered((self.mouse-y - last-y) / 1px, self.mouse-x / 1px, self.mouse-y / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-transform {
                                    moved-since-down = true;
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if pending-transform && self.pressed
                                    && (self.mouse-x - last-x > 4px || last-x - self.mouse-x > 4px
                                        || self.mouse-y - last-y > 4px || last-y - self.mouse-y > 4px) {
                                    pending-transform = false;
                                    is-transform = true;
                                    moved-since-down = true;
                                    root.viewport-transform-begin(local-kind, last-x / 1px, last-y / 1px);
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if is-painting {
                                    moved-since-down = true;
                                    root.viewport-paint-update(self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control);
                                } else if is-tool-drag {
                                    moved-since-down = true;
                                    root.tool-modal-scrubbed((self.mouse-y - last-y) / 1px, tool-drag-fine, self.mouse-x / 1px, self.mouse-y / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-profile-point-drag {
                                    moved-since-down = true;
                                    root.viewport-profile-pointer-move(self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.alt);
                                } else if is-profile-volume-drag {
                                    moved-since-down = true;
                                    if root.profile-volume-mode == "extrude" {
                                        let delta = (last-y - self.mouse-y) / 1px * (tool-drag-fine ? 0.005 : 0.02);
                                        root.profile-depth-set("\{max(0.05, root.profile-depth + delta)}");
                                    } else if root.profile-volume-mode == "revolve" {
                                        let delta = (self.mouse-x - last-x) / 1px * (tool-drag-fine ? 0.2 : 1.0);
                                        root.profile-revolve-angle-set("\{max(1.0, min(360.0, root.profile-revolve-angle + delta))}");
                                    }
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-profile-draw-drag {
                                    if abs(self.mouse-x - last-x) > 3px || abs(self.mouse-y - last-y) > 3px {
                                        moved-since-down = true;
                                        root.viewport-profile-drag-handle(self.mouse-x / self.width, self.mouse-y / self.height, event.modifiers.alt);
                                    }
                                } else if is-profile-depth-drag {
                                    moved-since-down = true;
                                    let delta = (last-y - self.mouse-y) / 1px * (tool-drag-fine ? 0.005 : 0.02);
                                    root.profile-depth-set("\{max(0.05, root.profile-depth + delta)}");
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-loop-drag {
                                    moved-since-down = true;
                                    root.loop-cut-scrubbed((self.mouse-x - last-x) / 1px, (self.mouse-y - last-y) / 1px);
                                    last-x = self.mouse-x;
                                    last-y = self.mouse-y;
                                } else if is-loop-place {
                                    root.viewport-hover(self.mouse-x / self.width, self.mouse-y / self.height);
                                } else if pending-slice && self.pressed
                                    && (self.mouse-x - last-x > 4px || last-x - self.mouse-x > 4px
                                        || self.mouse-y - last-y > 4px || last-y - self.mouse-y > 4px) {
                                    pending-slice = false;
                                    is-slice-drag = true;
                                    moved-since-down = true;
                                    root.viewport-transform-begin("slice", last-x / 1px, last-y / 1px);
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                } else if is-slice-drag {
                                    moved-since-down = true;
                                    root.viewport-transform-update(self.mouse-x / 1px, self.mouse-y / 1px, root.precision-mode, root.snap-mode);
                                }
                            } else if event.kind == PointerEventKind.up {
                                if is-tool-gesture {
                                    root.tool-pointer(2, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control);
                                    is-tool-gesture = false;
                                }
                                if is-box-select {
                                    if moved-since-down {
                                        root.viewport-box-select(last-x / self.width, last-y / self.height, self.mouse-x / self.width, self.mouse-y / self.height, extend-selection, subtract-selection);
                                    }
                                    is-box-select = false;
                                }
                                if is-lasso-select {
                                    if abs(self.mouse-x - lasso-last-x) > 1px || abs(self.mouse-y - lasso-last-y) > 1px {
                                        lasso-points += "\{self.mouse-x / self.width},\{self.mouse-y / self.height};";
                                        lasso-count += 1;
                                    }
                                    if lasso-count >= 3 {
                                        root.viewport-lasso-select(lasso-points, extend-selection, subtract-selection);
                                    }
                                    is-lasso-select = false;
                                    pending-lasso-select = false;
                                    lasso-points = "";
                                    lasso-base-commands = "";
                                    lasso-commands = "";
                                }
                                pending-lasso-select = false;
                                is-orbit = false;
                                is-pan = false;
                                if is-profile-point-drag {
                                    root.viewport-profile-pointer-up();
                                    is-profile-point-drag = false;
                                }
                                if is-profile-draw-drag {
                                    root.viewport-profile-pointer-up();
                                }
                                is-profile-depth-drag = false;
                                is-profile-volume-drag = false;
                                is-profile-draw-drag = false;
                                if is-transform {
                                    root.viewport-transform-end();
                                    is-transform = false;
                                }
                                if is-keyboard-transform-drag {
                                    // No modal por atalho, clique confirma e
                                    // clique-arrasto edita sem clique preparatório.
                                    root.viewport-transform-end();
                                    is-keyboard-transform-drag = false;
                                }
                                pending-transform = false;
                                pending-box-select = false;
                                pending-slice = false;
                                if is-painting {
                                    root.viewport-paint-end(self.mouse-x / 1px, self.mouse-y / 1px);
                                    is-painting = false;
                                }
                                if is-tool-drag {
                                    if moved-since-down {
                                        root.tool-modal-apply();
                                    }
                                    is-tool-drag = false;
                                }
                                if is-loop-drag {
                                    root.loop-cut-apply();
                                    is-loop-drag = false;
                                }
                                if is-loop-place {
                                    root.loop-cut-place();
                                    is-loop-place = false;
                                }
                                if is-slice-drag {
                                    is-slice-drag = false;
                                }
                                if is-gizmo-drag {
                                    root.gizmo-drag-end();
                                    is-gizmo-drag = false;
                                }
                                root.viewport-hover(self.mouse-x / self.width, self.mouse-y / self.height);
                            }
                        }

                        clicked => {
                            if !consume-click && !moved-since-down && !is-transform && !is-painting
                                && root.active-workspace != "PAINT" {
                                if root.active-tool == "slice" {
                                    root.slice-confirm();
                                } else {
                                    root.viewport-select(self.mouse-x / self.width, self.mouse-y / self.height, extend-selection, loop-selection);
                                }
                            }
                            consume-click = false;
                        }

                        scroll-event(event) => {
                            // A roda sempre faz zoom (constituição 11). Ctrl+roda ajusta
                            // contagens (Loop Cut) e o raio da edição proporcional.
                            if event.modifiers.control {
                                root.viewport-ctrl-scroll(event.delta-y / 1px);
                            } else {
                                root.viewport-zoom(event.delta-y / 1px);
                            }
                            accept
                        }
                    }

                    if viewport-touch.is-box-select: Rectangle {
                        x: min(viewport-touch.last-x, viewport-touch.mouse-x);
                        y: min(viewport-touch.last-y, viewport-touch.mouse-y);
                        width: abs(viewport-touch.mouse-x - viewport-touch.last-x);
                        height: abs(viewport-touch.mouse-y - viewport-touch.last-y);
                        background: DesignTokens.selection.transparentize(0.9);
                        border-color: DesignTokens.selection;
                        border-width: 1px;
                    }
                    if viewport-touch.is-lasso-select: Path {
                        width: 100%;
                        height: 100%;
                        fit: ImageFit.preserve;
                        commands: viewport-touch.lasso-commands;
                        fill: DesignTokens.selection.transparentize(0.85);
                        stroke: DesignTokens.selection;
                        stroke-width: 1.5px;
                    }

                    // 3D Cursor overlay (âncora 3D para criação de primitivas e foco de câmera)
                    if root.cursor-visible && active-workspace == "MODEL": Rectangle {
                        x: root.cursor-screen-x - 14px;
                        y: root.cursor-screen-y - 14px;
                        width: 28px;
                        height: 28px;

                        // Outer ring (white)
                        Rectangle {
                            x: 2px; y: 2px;
                            width: 24px; height: 24px;
                            border-radius: 12px;
                            border-width: 1.5px;
                            border-color: #ffffffdd;
                            background: transparent;
                        }
                        // Inner ring (accent / red)
                        Rectangle {
                            x: 4px; y: 4px;
                            width: 20px; height: 20px;
                            border-radius: 10px;
                            border-width: 1.5px;
                            border-color: #e54d42dd;
                            background: transparent;
                        }
                        // Horizontal crosshair
                        Rectangle {
                            x: 0px; y: 13px;
                            width: 28px; height: 2px;
                            background: #ffffffdd;
                        }
                        // Vertical crosshair
                        Rectangle {
                            x: 13px; y: 0px;
                            width: 2px; height: 28px;
                            background: #ffffffdd;
                        }
                        // Center dot
                        Rectangle {
                            x: 12px; y: 12px;
                            width: 4px; height: 4px;
                            border-radius: 2px;
                            background: #e54d42;
                        }
                    }

                    // Edit Pivot Mode visual banner / badge
                    if root.edit-pivot && active-workspace == "MODEL": Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 58px;
                        height: 30px;
                        width: edit-pivot-row.preferred-width + 24px;
                        border-radius: 6px;
                        background: #e54d4222;
                        border-width: 1.5px;
                        border-color: #e54d42;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000066;

                        edit-pivot-row := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            alignment: center;
                            Rectangle {
                                width: 8px; height: 8px;
                                border-radius: 4px;
                                background: #e54d42;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "\{root.label-edit-pivot} (Insert)";
                                color: #ffffff;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "· G to move origin";
                                color: #ffaaaa;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Marcador magnético de snap (Fase 4: Feedback Magnético)
                    if root.snap-marker-visible && active-workspace == "MODEL": Rectangle {
                        x: root.snap-marker-x - 8px;
                        y: root.snap-marker-y - 8px;
                        width: 16px;
                        height: 16px;
                        Rectangle {
                            x: 2px; y: 2px; width: 12px; height: 12px;
                            border-radius: root.snap-marker-round ? 6px : 2px;
                            background: transparent;
                            border-width: 2px;
                            border-color: #f59e0b;
                            drop-shadow-blur: 6px;
                            drop-shadow-color: #f59e0bcc;
                        }
                        Rectangle {
                            x: 6px; y: 6px; width: 4px; height: 4px;
                            border-radius: 2px;
                            background: #f59e0b;
                        }
                    }

                    // Rótulo do alvo de snap (P3D-040: forma + cor + texto)
                    if root.snap-marker-visible && root.snap-marker-label != "" && active-workspace == "MODEL": Rectangle {
                        x: root.snap-marker-x + 12px;
                        y: root.snap-marker-y + 10px;
                        width: snap-label.preferred-width + 10px;
                        height: 18px;
                        border-radius: 4px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        snap-label := Text {
                            text: root.snap-marker-label;
                            color: DesignTokens.text-primary;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Rótulo da cota blueprint (Fase 4: Cotas Blueprint)
                    if root.dimension-visible && root.dimension-text != "" && active-workspace == "MODEL": Rectangle {
                        x: root.dimension-x - self.width / 2;
                        y: root.dimension-y - self.height / 2;
                        width: dim-label.preferred-width + 12px;
                        height: 20px;
                        border-radius: 4px;
                        background: #1e1e24ee;
                        border-width: 1px;
                        border-color: #3e63dd;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #00000088;
                        dim-label := Text {
                            text: root.dimension-text;
                            color: #ffffff;
                            font-size: 10px;
                            font-weight: 700;
                            font-family: "monospace";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Rótulos de Medição nos Edges (Fase 6: Medição Rápida Compacta e Translúcida)
                    if root.measure-visible && active-workspace == "MODEL": Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;

                        for tag in root.measure-tags: Rectangle {
                            x: tag.x * 1px - self.width / 2;
                            y: tag.y * 1px - self.height / 2;
                            width: tag-label.preferred-width + 10px;
                            height: 18px;
                            border-radius: 4px;
                            background: #14141ecc;
                            border-width: 1px;
                            border-color: #f59e0b88;
                            drop-shadow-blur: 6px;
                            drop-shadow-color: #00000066;

                            tag-label := Text {
                                text: tag.text;
                                color: #f59e0b;
                                font-size: 10px;
                                font-weight: 700;
                                font-family: "monospace";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.measure-tags.length == 0 && root.measure-text != "": Rectangle {
                            x: root.measure-x - self.width / 2;
                            y: root.measure-y - self.height / 2;
                            width: fallback-label.preferred-width + 10px;
                            height: 18px;
                            border-radius: 4px;
                            background: #14141ecc;
                            border-width: 1px;
                            border-color: #f59e0b88;
                            drop-shadow-blur: 6px;
                            drop-shadow-color: #00000066;

                            fallback-label := Text {
                                text: root.measure-text;
                                color: #f59e0b;
                                font-size: 10px;
                                font-weight: 700;
                                font-family: "monospace";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Rótulos não-cromáticos dos eixos do mundo no chão 3D (Grid Viewport)
                    if root.colorblind-axes && active-workspace == "MODEL": Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;

                        for tag in root.world-axis-labels: Rectangle {
                            x: tag.x * 1px - 8px;
                            y: tag.y * 1px - 8px;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            background: #14141ecc;
                            border-width: 1px;
                            border-color: tag.tint.transparentize(0.2);
                            drop-shadow-blur: 4px;
                            drop-shadow-color: #00000066;

                            Text {
                                text: tag.text;
                                color: tag.tint;
                                font-size: 9px;
                                font-weight: 700;
                                font-family: "monospace";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // HUD Flutuante no Cursor (Fase 4: HUD Numérico em Tempo Real)
                    if root.hud-pill-visible && active-workspace == "MODEL": Rectangle {
                        x: min(max(8px, root.hud-pill-x), parent.width - self.width - 8px);
                        y: min(max(8px, root.hud-pill-y), parent.height - self.height - 8px);
                        width: hud-pill-layout.preferred-width + 20px;
                        height: hud-pill-layout.preferred-height + 12px;
                        border-radius: 8px;
                        background: #14141ef2;
                        border-width: 1px;
                        border-color: DesignTokens.accent.transparentize(0.3);
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000088;

                        hud-pill-layout := VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: space-between;
                                Text {
                                    text: root.hud-pill-title;
                                    color: DesignTokens.accent;
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    if root.hud-pill-badge != "": Rectangle {
                                        border-radius: 3px;
                                        background: DesignTokens.accent.transparentize(0.8);
                                        border-width: 1px;
                                        border-color: DesignTokens.accent;
                                        HorizontalLayout {
                                            padding-left: 4px; padding-right: 4px;
                                            Text { text: root.hud-pill-badge; color: DesignTokens.accent; font-size: 9px; font-weight: 700; }
                                        }
                                    }
                                    if root.precision-mode: Rectangle {
                                        border-radius: 3px;
                                        background: #3e63dd33;
                                        border-width: 1px;
                                        border-color: #3e63dd;
                                        HorizontalLayout {
                                            padding-left: 4px; padding-right: 4px;
                                            Text { text: "PRECISION 0.1×"; color: #3e63dd; font-size: 8px; font-weight: 700; font-family: "monospace"; }
                                        }
                                    }
                                    if root.snap-mode: Rectangle {
                                        border-radius: 3px;
                                        background: #46a75833;
                                        border-width: 1px;
                                        border-color: #46a758;
                                        HorizontalLayout {
                                            padding-left: 4px; padding-right: 4px;
                                            Text { text: "SNAP"; color: #46a758; font-size: 8px; font-weight: 700; font-family: "monospace"; }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.hud-pill-value;
                                color: DesignTokens.text-primary;
                                font-size: 12px;
                                font-weight: 600;
                                font-family: "monospace";
                            }
                            if root.hud-pill-hint != "": Text {
                                text: root.hud-pill-hint;
                                color: DesignTokens.text-muted;
                                font-size: 9px;
                            }
                        }
                    }

                    // Pílula Flutuante da Viewport: Câmera & Projeção (Esquerda)
                    camera-bar := Rectangle {
                        x: 14px;
                        y: 14px;
                        width: camera-row.preferred-width + 12px;
                        height: 38px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000055;
                        drop-shadow-offset-y: 2px;

                        camera-row := HorizontalLayout {
                            x: 6px;
                            y: 5px;
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: is-orthographic ? "Ortho" : "Persp";
                                color: DesignTokens.text-primary;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }

                            ViewportBarButton {
                                icon: IconSet.Camera;
                                label: "Projection";
                                shortcut: root.shortcuts.view-proj;
                                description: "Toggle between perspective 3D projection and orthographic view";
                                active: is-orthographic;
                                clicked => { root.toggle-projection-requested(); }
                            }
                            ViewportBarButton {
                                icon: IconSet.Maximize2;
                                label: "Frame";
                                shortcut: root.shortcuts.view-frame;
                                description: "Frame and center camera view on currently selected geometry";
                                active: false;
                                clicked => { root.command-executed("view.frame_selection"); }
                            }
                            ViewportBarButton {
                                icon: IconSet.RotateCcw;
                                label: "Reset view";
                                shortcut: root.shortcuts.view-reset;
                                description: "Reset camera zoom, orientation and position to default origin";
                                active: false;
                                clicked => { root.reset-camera-requested(); }
                            }
                        }
                    }

                    // --- Pílulas Flutuantes da Viewport (Centro: Shading & Modelagem) ---
                    viewport-bar := HorizontalLayout {
                        x: (parent.width - self.width) / 2;
                        y: 14px;
                        spacing: 8px;
                        alignment: center;

                        // Pílula 2: Modos de Shading & Overlays
                        Rectangle {
                            height: 38px;
                            border-radius: 8px;
                            background: DesignTokens.surface-raised;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            drop-shadow-blur: 10px;
                            drop-shadow-color: #00000055;
                            drop-shadow-offset-y: 2px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 4px;
                                alignment: center;

                                ViewportSvgButton { glyph: PetuniaIcons.view-wire; label: root.label-view-wireframe; shortcut: root.shortcuts.view-wireframe; description: "Display mesh edges with transparent wireframe surfaces"; active: root.shading-mode == "wireframe"; clicked => { root.shading-mode-set("wireframe"); } }
                                ViewportSvgButton { glyph: PetuniaIcons.view-solid; label: root.label-view-solid; shortcut: root.shortcuts.view-solid; description: "Standard matte shaded surfaces with basic directional lighting"; active: root.shading-mode == "solid"; clicked => { root.shading-mode-set("solid"); } }
                                ViewportSvgButton { glyph: PetuniaIcons.view-material; label: root.label-view-material; shortcut: root.shortcuts.view-material; description: "Preview base color, texture and emission with a simple directional light"; active: root.shading-mode == "material"; clicked => { root.shading-mode-set("material"); } }
                                ViewportSvgButton { glyph: PetuniaIcons.view-lit; label: root.label-view-lit; shortcut: root.shortcuts.view-lit; description: "Lit preview with a single directional light (no shadows or ray tracing)"; active: root.shading-mode == "rendered"; clicked => { root.shading-mode-set("rendered"); } }

                                Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }

                                ViewportBarButton {
                                    icon: IconSet.Eye;
                                    label: "X-Ray";
                                    shortcut: root.shortcuts.view-xray;
                                    description: "Semi-transparent surfaces allowing selection of occluded geometry";
                                    active: root.show-xray;
                                    clicked => { root.toggle-xray-requested(); }
                                }
                                ViewportBarButton {
                                    icon: IconSet.Settings2;
                                    label: "Shading options";
                                    shortcut: "";
                                    description: "Configure studio matcaps, cavity highlights and wireframe opacity";
                                    active: root.shading-popover-open;
                                    clicked => { root.shading-popover-toggled(!root.shading-popover-open); }
                                }
                                ViewportBarButton {
                                    icon: IconSet.Image;
                                    label: "Ref Images";
                                    shortcut: "F4";
                                    description: "Reference Images manager for background blueprints and modeling guides";
                                    active: root.reference-manager-visible;
                                    clicked => { root.reference-manager-toggle(); }
                                }
                            }
                        }

                        // Pílula 3: Auxiliares de Modelagem (Pivot, Snap, Prop)
                        if active-workspace == "MODEL" && root.viewport-region-width >= 600: Rectangle {
                            height: 38px;
                            border-radius: 8px;
                            background: DesignTokens.surface-raised;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            drop-shadow-blur: 10px;
                            drop-shadow-color: #00000055;
                            drop-shadow-offset-y: 2px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 4px;
                                alignment: center;

                                ViewportBarButton {
                                    icon: IconSet.Crosshair;
                                    label: "\{root.label-model-pivot}: \{root.pivot-label}";
                                    shortcut: root.shortcuts.view-pivot;
                                    description: "Change pivot point origin for transformations (Median, Cursor, Bounds)";
                                    active: root.pivot-menu-open;
                                    clicked => { root.pivot-menu-toggled(!root.pivot-menu-open); }
                                }
                                if root.viewport-region-width >= 680: ViewportBarButton {
                                    icon: IconSet.Magnet;
                                    label: root.snap-enabled ? "Snap (\{root.snap-target})" : "Snap";
                                    shortcut: root.shortcuts.view-snap;
                                    description: "Snap transformations to grid intervals, vertices, edges or faces";
                                    active: root.snap-enabled;
                                    clicked => { root.toggle-snap-enabled(); }
                                }
                                if root.viewport-region-width >= 750: ViewportBarButton {
                                    icon: IconSet.CircleDot;
                                    label: root.proportional-editing ? "Prop (\{round(root.proportional-radius * 10) / 10})" : "Prop";
                                    shortcut: root.shortcuts.view-prop;
                                    description: "Smoothly deform neighboring vertices with proportional falloff curve";
                                    active: root.proportional-editing;
                                    clicked => { root.toggle-proportional-editing(); }
                                }
                            }
                        }
                    }

                    // Pílula de Ferramenta Ativa e Modo de Operação (Feedback visual contínuo)
                    if !root.measure-visible && active-workspace == "MODEL" && (root.tool-modal-active || root.active-tool == "extrude" || root.active-tool == "bevel" || root.active-tool == "inset" || root.active-tool == "push_pull" || root.active-tool == "cut" || root.active-tool == "loop_cut" || root.active-tool == "slice" || root.active-tool == "move" || root.active-tool == "rotate" || root.active-tool == "scale"): Rectangle {
                        width: min(parent.width - 40px, active-tool-hud-row.preferred-width + 24px);
                        x: (parent.width - self.width) / 2;
                        y: 58px;
                        height: 28px;
                        border-radius: 14px;
                        background: #14141ee6;
                        border-width: 1px;
                        border-color: root.is-instant-tool-mode ? DesignTokens.accent : DesignTokens.border;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000066;

                        active-tool-hud-row := HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: root.tool-modal-active ? root.tool-modal-title : (root.tool-options-title != "" ? root.tool-options-title : root.active-tool);
                                color: DesignTokens.accent;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle {
                                border-radius: 3px;
                                background: root.is-instant-tool-mode ? DesignTokens.accent : DesignTokens.surface-raised;
                                border-width: 1px;
                                border-color: root.is-instant-tool-mode ? DesignTokens.accent : DesignTokens.border;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    Text {
                                        text: root.is-instant-tool-mode ? "MODO LIVRE" : "CARD / GIZMO";
                                        color: root.is-instant-tool-mode ? DesignTokens.canvas : DesignTokens.text-secondary;
                                        font-size: 9px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: root.active-tool == "slice"
                                    ? "Arraste o corte · T: Trim/Split · Enter/Clique Confirma · Esc Cancela"
                                    : (root.is-instant-tool-mode
                                        ? "Mova o mouse · LMB/Enter Confirma · RMB/Esc Cancela"
                                        : "2 Toques no atalho: Modo Livre · Enter Confirma");
                                color: DesignTokens.text-muted;
                                font-size: 9px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Pílula Flutuante de Medição / Dimensões (Centro: Resumo HUD no Topo)
                    if root.measure-visible && root.measure-hud-text != "" && active-workspace == "MODEL": Rectangle {
                        width: min(parent.width - 40px, measure-hud-row.preferred-width + 24px);
                        x: (parent.width - self.width) / 2;
                        y: 58px;
                        height: 26px;
                        border-radius: 6px;
                        background: #14141ee8;
                        border-width: 1px;
                        border-color: #f59e0b88;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000088;
                        drop-shadow-offset-y: 2px;

                        measure-hud-row := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            IconDisplay {
                                icon: IconSet.ArrowUpDown;
                                size: 12px;
                                stroke: #f59e0b;
                            }

                            Text {
                                text: root.measure-hud-text;
                                color: #f59e0b;
                                font-size: 11px;
                                font-weight: 700;
                                font-family: "monospace";
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Barra de domínio de seleção independente no canto superior direito (Decision D3)
                    if active-workspace == "MODEL": domain-bar := Rectangle {
                        x: (parent.width >= 720px) ? (parent.width - self.width - 118px - root.inspector-clearance) : (parent.width - self.width - 14px - root.inspector-clearance);
                        y: (parent.width >= 720px) ? 14px : 118px;
                        width: domain-row.preferred-width + 12px;
                        height: 38px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000055;
                        drop-shadow-offset-y: 2px;
                        animate x { duration: root.reduced-motion ? 0ms : 180ms; easing: ease-out; }

                        domain-row := HorizontalLayout {
                            x: 6px;
                            y: 5px;
                            spacing: 3px;
                            alignment: center;
                            for domain in [
                                { id: "OBJECT", icon: IconSet.Box, icon-svg: PetuniaIcons.object-mesh, label: "Object", shortcut: root.shortcuts.select-object, description: "Select and manipulate entire objects as discrete units" },
                                { id: "POINT", icon: IconSet.CircleDot, icon-svg: PetuniaIcons.select-vertex, label: "Point", shortcut: root.shortcuts.select-point, description: "Select and transform individual vertices (points)" },
                                { id: "EDGE", icon: IconSet.SquareDashed, icon-svg: PetuniaIcons.select-edge, label: "Edge", shortcut: root.shortcuts.select-edge, description: "Select and transform polygonal boundary edges" },
                                { id: "FACE", icon: IconSet.Square, icon-svg: PetuniaIcons.select-face, label: "Face", shortcut: root.shortcuts.select-face, description: "Select and transform polygonal planar faces" },
                            ]: ViewportBarButton {
                                icon: domain.icon;
                                icon-svg: domain.icon-svg;
                                label: domain.label;
                                shortcut: domain.shortcut;
                                description: domain.description;
                                active: selection-domain == domain.id;
                                emphasized: true;
                                clicked => { root.selection-domain-changed(domain.id); }
                            }
                        }
                    }

                    // Tool Cards dedicados por ferramenta (Decisões D5, D6, D7)
                    if loop-cut-active || loop-cut-armed: ToolCard {
                        x: 14px;
                        y: 58px;
                        title: "Loop Cut";
                        collapsed: root.tool-properties-collapsed;
                        collapse-toggled => { root.tool-properties-collapsed = !root.tool-properties-collapsed; }

                        if loop-cut-active: HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Text { text: "Slide"; color: DesignTokens.text-secondary; font-size: 11px; width: 44px; vertical-alignment: center; }
                            NumericField {
                                label: "";
                                value: root.loop-cut-slide;
                                horizontal-stretch: 1;
                                step: 0.01;
                                scrubbed(delta, fine) => { root.loop-cut-slide-committed("\{root.loop-cut-slide + delta * (fine ? 0.001 : 0.01)}"); }
                                scrub-cancelled(value) => { root.loop-cut-slide-committed("\{value}"); }
                                text-committed(text) => { root.loop-cut-slide-committed(text); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Text { text: "Cuts"; color: DesignTokens.text-secondary; font-size: 11px; width: 44px; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                Text {
                                    text: "\{root.loop-cut-cuts}";
                                    color: DesignTokens.text-primary;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.loop-cut-count-committed("\{max(1, root.loop-cut-cuts - 1)}"); } }
                            }
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.loop-cut-count-committed("\{root.loop-cut-cuts + 1}"); } }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: root.loop-cut-balanced ? DesignTokens.accent : DesignTokens.surface;
                                border-width: 1px;
                                border-color: root.loop-cut-balanced ? DesignTokens.accent : DesignTokens.border;
                                Text {
                                    text: root.loop-cut-balanced ? "Dual Balanced: ON" : "Dual Balanced: OFF";
                                    color: root.loop-cut-balanced ? DesignTokens.canvas : DesignTokens.text-primary;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea { clicked => { root.toggle-loop-cut-balanced(); } }
                            }
                        }

                        Text {
                            text: loop-cut-active ? "Enter confirm · Esc cancel · Drag slide" : "Click edge to cut · Scroll to adjust cuts";
                            color: DesignTokens.text-muted;
                            font-size: 9px;
                        }

                        if loop-cut-active: HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                Text { text: root.label-cancel; color: DesignTokens.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.loop-cut-cancel(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: DesignTokens.accent;
                                Text { text: root.label-apply; color: DesignTokens.canvas; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.loop-cut-apply(); } }
                            }
                        }
                    }

                    if tool-modal-active && !loop-cut-active && !loop-cut-armed: ToolCard {
                        x: 14px;
                        y: 58px;
                        title: root.tool-modal-title;
                        collapsed: root.tool-properties-collapsed;
                        collapse-toggled => { root.tool-properties-collapsed = !root.tool-properties-collapsed; }

                        if root.tool-modal-id == "extrude" || root.tool-modal-id == "extrude_individual": VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 4px;
                                height: 24px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.tool-modal-id == "extrude" ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: root.tool-modal-id == "extrude" ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: "Region";
                                        color: root.tool-modal-id == "extrude" ? DesignTokens.canvas : DesignTokens.text-primary;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            if root.tool-modal-id == "extrude_individual" {
                                                root.tool-modal-toggle-extrude-mode();
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.tool-modal-id == "extrude_individual" ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: root.tool-modal-id == "extrude_individual" ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: "Individual";
                                        color: root.tool-modal-id == "extrude_individual" ? DesignTokens.canvas : DesignTokens.text-primary;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            if root.tool-modal-id == "extrude" {
                                                root.tool-modal-toggle-extrude-mode();
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                height: 22px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+0.2"; color: DesignTokens.text-secondary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.tool-modal-text-committed("0.2"); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+0.5"; color: DesignTokens.text-secondary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.tool-modal-text-committed("0.5"); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+1.0"; color: DesignTokens.text-secondary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.tool-modal-text-committed("1.0"); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "Invert"; color: DesignTokens.text-secondary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.tool-modal-text-committed("\{-root.tool-modal-value}"); } }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Text {
                                text: root.tool-modal-label;
                                color: DesignTokens.text-secondary;
                                font-size: 11px;
                                width: 56px;
                                vertical-alignment: center;
                            }
                            NumericField {
                                label: "";
                                value: root.tool-modal-value;
                                horizontal-stretch: 1;
                                step: root.tool-modal-step;
                                scrubbed(delta, fine) => { root.tool-modal-text-committed("\{root.tool-modal-value + delta * root.tool-modal-step * (fine ? 0.1 : 1)}"); }
                                scrub-cancelled(value) => { root.tool-modal-text-committed("\{value}"); }
                                text-committed(text) => { root.tool-modal-text-committed(text); }
                            }
                        }

                        Text {
                            text: "Enter confirm · Esc cancel";
                            color: DesignTokens.text-muted;
                            font-size: 9px;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 28px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                Text { text: root.label-cancel; color: DesignTokens.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.tool-modal-cancel(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: DesignTokens.accent;
                                Text { text: root.label-apply; color: DesignTokens.canvas; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.tool-modal-apply(); } }
                            }
                        }
                    }

                    if profile-active && !tool-modal-active && !loop-cut-active && !loop-cut-armed: ToolCard {
                        x: 14px;
                        y: 58px;
                        title: root.label-model-profile;
                        collapsed: root.tool-properties-collapsed;
                        collapse-toggled => { root.tool-properties-collapsed = !root.tool-properties-collapsed; }

                        HorizontalLayout {
                            spacing: 4px;
                            height: 24px;
                            Text { text: root.label-profile-plane; color: DesignTokens.text-secondary; font-size: 10px; width: 44px; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px;
                                background: !root.profile-workplane-locked ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
                                border-width: 1px; border-color: !root.profile-workplane-locked ? DesignTokens.accent : DesignTokens.border;
                                Text { text: root.label-profile-plane-auto; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
                                TouchArea { clicked => { root.profile-set-workplane-auto(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px;
                                background: root.profile-workplane-locked && root.profile-workplane == "Ground" ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
                                border-width: 1px; border-color: root.profile-workplane-locked && root.profile-workplane == "Ground" ? DesignTokens.accent : DesignTokens.border;
                                Text { text: root.label-profile-plane-ground; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
                                TouchArea { clicked => { root.profile-set-workplane-ground(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px;
                                background: root.profile-workplane-locked && root.profile-workplane == "Face" ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
                                border-width: 1px; border-color: root.profile-workplane-locked && root.profile-workplane == "Face" ? DesignTokens.accent : DesignTokens.border;
                                Text { text: root.label-profile-plane-face; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
                                TouchArea { clicked => { root.profile-set-workplane-face(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px;
                                background: root.profile-workplane-locked && root.profile-workplane == "View" ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
                                border-width: 1px; border-color: root.profile-workplane-locked && root.profile-workplane == "View" ? DesignTokens.accent : DesignTokens.border;
                                Text { text: root.label-profile-plane-view; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
                                TouchArea { clicked => { root.profile-set-workplane-view(); } }
                            }
                        }

                        Rectangle {
                            height: 24px; border-radius: 4px; background: DesignTokens.surface;
                            border-width: 1px; border-color: DesignTokens.border;
                            Text { text: root.label-profile-look-at-plane; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.profile-look-at-plane(); } }
                        }

                        Text { text: "\{root.label-profile-points}: \{root.profile-point-count}"; color: DesignTokens.text-secondary; font-size: 10px; }
                        if !root.profile-closed: Rectangle {
                            height: 26px; border-radius: 4px; background: DesignTokens.surface;
                            border-width: 1px; border-color: DesignTokens.border;
                            Text { text: root.label-profile-close; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.profile-close(); } }
                        }
                        if root.profile-closed: HorizontalLayout {
                            spacing: 5px; height: 28px;
                            Text { text: root.label-profile-depth; color: DesignTokens.text-secondary; font-size: 10px; width: 56px; vertical-alignment: center; }
                            NumericField {
                                label: ""; value: root.profile-depth; horizontal-stretch: 1; step: 0.1;
                                text-committed(text) => { root.profile-depth-set(text); }
                                scrubbed(delta, fine) => { root.profile-depth-set("\{root.profile-depth + delta * (fine ? 0.01 : 0.1)}"); }
                            }
                        }
                        if root.profile-closed: HorizontalLayout {
                            spacing: 5px; height: 28px;
                            Text { text: root.label-profile-wall-thickness; color: DesignTokens.text-secondary; font-size: 10px; width: 80px; vertical-alignment: center; }
                            NumericField {
                                label: ""; value: root.profile-wall-thickness; horizontal-stretch: 1; step: 0.05;
                                text-committed(text) => { root.profile-wall-thickness-set(text); }
                                scrubbed(delta, fine) => { root.profile-wall-thickness-set("\{root.profile-wall-thickness + delta * (fine ? 0.01 : 0.05)}"); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 5px; height: 26px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px;
                                background: root.profile-has-curves ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface;
                                border-width: 1px; border-color: root.profile-has-curves ? DesignTokens.accent : DesignTokens.border;
                                Text {
                                    text: root.profile-has-curves ? root.label-profile-sharp-corners : root.label-profile-smooth-curves;
                                    color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        if root.profile-has-curves {
                                            root.profile-clear-curves();
                                        } else {
                                            root.profile-smooth-curves();
                                        }
                                    }
                                }
                            }
                        }
                        if root.profile-has-curves: HorizontalLayout {
                            spacing: 5px; height: 28px;
                            Text { text: root.label-profile-smoothness; color: DesignTokens.text-secondary; font-size: 10px; width: 80px; vertical-alignment: center; }
                            NumericField {
                                label: ""; value: root.profile-smoothness; horizontal-stretch: 1; step: 0.01;
                                text-committed(text) => { root.profile-smoothness-set(text); }
                                scrubbed(delta, fine) => { root.profile-smoothness-set("\{root.profile-smoothness + delta * (fine ? 0.002 : 0.01)}"); }
                            }
                        }
                        if root.profile-volume-mode == "none" && root.profile-point-count >= 2: HorizontalLayout {
                            spacing: 5px; height: 28px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                Text { text: root.label-profile-revolve; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.profile-enter-revolve(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                Text { text: root.label-profile-sweep; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.profile-enter-sweep(); } }
                            }
                            if root.profile-closed: Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.accent;
                                Text { text: root.label-profile-generate; color: DesignTokens.canvas; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.profile-generate(); } }
                            }
                        }
                        if root.profile-volume-mode != "none": VerticalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 24px; border-radius: 4px; background: DesignTokens.accent.transparentize(0.85);
                                border-width: 1px; border-color: DesignTokens.accent;
                                Text {
                                    text: root.profile-volume-mode == "extrude" ? "Extrude Preview (Live)" :
                                          (root.profile-volume-mode == "revolve" ? "Revolve Preview (Live)" : "Sweep Preview (Live)");
                                    color: DesignTokens.accent; font-size: 10px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            if root.profile-volume-mode == "revolve": HorizontalLayout {
                                spacing: 5px; height: 28px;
                                Text { text: "Angle"; color: DesignTokens.text-secondary; font-size: 10px; width: 56px; vertical-alignment: center; }
                                NumericField {
                                    label: ""; value: root.profile-revolve-angle; horizontal-stretch: 1; step: 5.0;
                                    text-committed(text) => { root.profile-revolve-angle-set(text); }
                                    scrubbed(delta, fine) => { root.profile-revolve-angle-set("\{root.profile-revolve-angle + delta * (fine ? 1.0 : 5.0)}"); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px; height: 28px;
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.accent;
                                    Text { text: "Confirm (Enter)"; color: DesignTokens.canvas; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.profile-volume-confirm(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                    Text { text: "Cancel (Esc)"; color: DesignTokens.text-muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.profile-volume-cancel(); } }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 5px; height: 26px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                Text { text: root.label-profile-add-rect; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.add-profile-rectangle(2.0, 1.0); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                Text { text: root.label-profile-add-circle; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.add-profile-circle(1.0, 16); } }
                            }
                        }
                        Text { text: root.hint-model-profile; color: DesignTokens.text-muted; font-size: 9px; wrap: word-wrap; }
                    }

                    if operation-hud-active && !tool-modal-active && !loop-cut-active && !loop-cut-armed && !profile-active: ToolCard {
                        x: 14px;
                        y: 58px;
                        title: root.operation-hud-title;
                        collapsed: false;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: root.operation-hud-subject;
                                color: DesignTokens.accent;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        for line in root.operation-hud-lines: Text {
                            text: line;
                            color: DesignTokens.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                            font-family: "monospace";
                        }
                        if root.operation-hud-hint != "": Text {
                            text: root.operation-hud-hint;
                            color: DesignTokens.text-muted;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                    }

                    if primitive-active && !tool-modal-active && !loop-cut-active && !loop-cut-armed && !profile-active: ToolCard {
                        x: 14px;
                        y: 58px;
                        title: root.primitive-title != "" ? root.primitive-title : "Primitive Properties";
                        collapsed: false;

                        if root.primitive-kind == "box" || root.primitive-kind == "wedge": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: "Width"; value: root.primitive-width; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("width", root.primitive-width + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("width", t.to-float()); true } }
                            NumericField { label: "Height"; value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                            NumericField { label: "Depth"; value: root.primitive-depth; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("depth", root.primitive-depth + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("depth", t.to-float()); true } }
                        }

                        if root.primitive-kind == "plane": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: "Width"; value: root.primitive-width; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("width", root.primitive-width + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("width", t.to-float()); true } }
                            NumericField { label: "Height"; value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                        }

                        if root.primitive-kind == "cylinder": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: "Radius"; value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: "Height"; value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                            NumericField { label: "Sides"; value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            HorizontalLayout {
                                spacing: 4px; height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px;
                                    background: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px; border-color: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.border;
                                    Text { text: root.primitive-cap-top ? "Top Cap: on" : "Top Cap: off"; color: root.primitive-cap-top ? DesignTokens.canvas : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.primitive-param-bool("cap_top", !root.primitive-cap-top); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px;
                                    background: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px; border-color: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.border;
                                    Text { text: root.primitive-cap-bottom ? "Bottom Cap: on" : "Bottom Cap: off"; color: root.primitive-cap-bottom ? DesignTokens.canvas : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.primitive-param-bool("cap_bottom", !root.primitive-cap-bottom); } }
                                }
                            }
                        }

                        if root.primitive-kind == "cone": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: "Bottom Radius"; value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: "Top Radius"; value: root.primitive-radius-b; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius_b", root.primitive-radius-b + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius_b", t.to-float()); true } }
                            NumericField { label: "Height"; value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                            NumericField { label: "Sides"; value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            HorizontalLayout {
                                spacing: 4px; height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px;
                                    background: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px; border-color: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.border;
                                    Text { text: root.primitive-cap-bottom ? "Base Cap: on" : "Base Cap: off"; color: root.primitive-cap-bottom ? DesignTokens.canvas : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.primitive-param-bool("cap_bottom", !root.primitive-cap-bottom); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 4px;
                                    background: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px; border-color: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.border;
                                    Text { text: root.primitive-cap-top ? "Top Cap: on" : "Top Cap: off"; color: root.primitive-cap-top ? DesignTokens.canvas : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.primitive-param-bool("cap_top", !root.primitive-cap-top); } }
                                }
                            }
                        }

                        if root.primitive-kind == "sphere": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: "Radius"; value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: "Segments"; value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            NumericField { label: "Rings"; value: root.primitive-rings; step: 1; scrubbed(d, f) => { root.primitive-param-float("rings", root.primitive-rings + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("rings", t.to-float()); true } }
                        }

                        if root.primitive-kind == "icosphere": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: "Radius"; value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: "Subdivisions"; value: root.primitive-subdiv; step: 1; scrubbed(d, f) => { root.primitive-param-float("subdiv", root.primitive-subdiv + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("subdiv", t.to-float()); true } }
                        }

                        if root.primitive-kind == "torus": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: "Ring Radius"; value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: "Pipe Radius"; value: root.primitive-radius-b; step: 0.05; scrubbed(d, f) => { root.primitive-param-float("radius_b", root.primitive-radius-b + d * (f ? 0.005 : 0.05)); } text-committed(t) => { root.primitive-param-float("radius_b", t.to-float()); true } }
                            NumericField { label: "Ring Segments"; value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            NumericField { label: "Pipe Segments"; value: root.primitive-rings; step: 1; scrubbed(d, f) => { root.primitive-param-float("rings", root.primitive-rings + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("rings", t.to-float()); true } }
                        }

                        if root.primitive-kind == "capsule": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: "Radius"; value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: "Height"; value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                            NumericField { label: "Sides"; value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            NumericField { label: "Cap Rings"; value: root.primitive-rings; step: 1; scrubbed(d, f) => { root.primitive-param-float("rings", root.primitive-rings + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("rings", t.to-float()); true } }
                        }

                        if root.primitive-kind == "circle": VerticalLayout {
                            spacing: 6px;
                            NumericField { label: "Radius"; value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                            NumericField { label: "Vertices"; value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                            Rectangle {
                                height: 26px; border-radius: 4px;
                                background: root.primitive-fill-disc ? DesignTokens.accent : DesignTokens.surface-raised;
                                border-width: 1px; border-color: root.primitive-fill-disc ? DesignTokens.accent : DesignTokens.border;
                                Text { text: root.primitive-fill-disc ? "Fill: Disc" : "Fill: Open Loop"; color: root.primitive-fill-disc ? DesignTokens.canvas : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.primitive-param-bool("fill_disc", !root.primitive-fill-disc); } }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 26px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                Text { text: "Cancel"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.primitive-cancel(); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.accent;
                                Text { text: "Confirm"; color: DesignTokens.canvas; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.primitive-confirm(); } }
                            }
                        }
                        Text { text: "Enter confirm · Esc cancel"; color: DesignTokens.text-muted; font-size: 9px; }
                    }

                    if !tool-modal-active && !loop-cut-active && !loop-cut-armed && !profile-active && !operation-hud-active && !primitive-active && (root.active-tool == "move" || root.active-tool == "rotate" || root.active-tool == "scale" || root.active-tool == "extrude" || root.active-tool == "inset" || root.active-tool == "push_pull" || root.active-tool == "cut" || root.active-tool == "slice" || root.active-tool == "bevel" || root.active-tool == "cursor" || root.active-tool == "cursor_3d"): ToolCard {
                        x: 14px;
                        y: 58px;
                        title: root.tool-options-title != "" ? root.tool-options-title : "Tool Options";
                        collapsed: root.tool-properties-collapsed;
                        collapse-toggled => { root.tool-properties-collapsed = !root.tool-properties-collapsed; }

                        // Última operação (constituição 11): o valor do gesto confirmado
                        // continua ajustável aqui, dentro da mesma entrada de Undo.
                        if root.last-operation-active: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.label-last-operation + " · " + root.last-operation-title;
                                color: DesignTokens.text-secondary;
                                font-size: 10px;
                                font-weight: 600;
                            }
                            NumericField {
                                label: root.last-operation-unit != "" ? root.last-operation-unit : "#";
                                full-label: root.label-last-operation + " — " + root.last-operation-title;
                                hint: root.label-last-operation-hint;
                                value: root.last-operation-value;
                                step: root.last-operation-step;
                                label-color: DesignTokens.accent;
                                text-committed(text) => { root.last-operation-committed(text) }
                            }
                        }

                        if root.active-tool == "extrude": VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 4px;
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.accent;
                                    Text { text: "Extrude Region (E)"; color: DesignTokens.canvas; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.command-executed("model.extrude"); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "Individual (Alt+E)"; color: DesignTokens.text-primary; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.command-executed("model.extrude_individual"); } }
                                }
                            }
                            Text { text: "Click and drag or press E / Alt+E to extrude selected faces"; color: DesignTokens.text-muted; font-size: 9px; wrap: word-wrap; }
                        }

                        // Common adjustments row (Snap, Proportional Editing and Pivot) / Linha de ajustes comuns (Snap, Proportional Editing e Pivot)
                        if root.active-tool == "move" || root.active-tool == "rotate" || root.active-tool == "scale": HorizontalLayout {
                            spacing: 4px;
                            height: 24px;

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: root.snap-enabled ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface;
                                border-width: 1px;
                                border-color: root.snap-enabled ? DesignTokens.accent : DesignTokens.border;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    IconDisplay {
                                        icon: IconSet.Magnet;
                                        size: 11px;
                                        stroke: root.snap-enabled ? DesignTokens.accent : DesignTokens.text-secondary;
                                    }
                                    Text {
                                        text: root.snap-enabled ? root.snap-target : "Snap";
                                        color: root.snap-enabled ? DesignTokens.accent : DesignTokens.text-secondary;
                                        font-size: 9px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.toggle-snap-enabled(); } }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: root.proportional-editing ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface;
                                border-width: 1px;
                                border-color: root.proportional-editing ? DesignTokens.accent : DesignTokens.border;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    IconDisplay {
                                        icon: IconSet.CircleDot;
                                        size: 11px;
                                        stroke: root.proportional-editing ? DesignTokens.accent : DesignTokens.text-secondary;
                                    }
                                    Text {
                                        text: root.proportional-editing ? "\{round(root.proportional-radius * 10) / 10}" : "Prop";
                                        color: root.proportional-editing ? DesignTokens.accent : DesignTokens.text-secondary;
                                        font-size: 9px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.toggle-proportional-editing(); } }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: root.pivot-menu-open ? DesignTokens.surface-raised : DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.pivot-label != "" ? root.pivot-label : "Pivot";
                                        color: DesignTokens.text-secondary;
                                        font-size: 9px;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.pivot-menu-toggled(!root.pivot-menu-open); } }
                            }
                        }

                        if root.active-tool == "move": Vector3Field {
                            row-label: "Position";
                            field-hint: root.label-numeric-field-hint;
                            x-value: root.pos-x;
                            y-value: root.pos-y;
                            z-value: root.pos-z;
                            scrubbed(axis, delta, fine) => { root.transform-scrubbed("pos", axis, delta, fine); }
                            scrub-started => { root.transform-scrub-started("pos"); }
                            scrub-finished => { root.transform-scrub-finished(); }
                            text-committed(axis, text) => { root.transform-text-committed("pos", axis, text) }
                            scrub-cancelled => { root.transform-scrub-cancelled(); }
                        }

                        if root.active-tool == "rotate": VerticalLayout {
                            spacing: 6px;
                            Vector3Field {
                                row-label: "Rotation";
                                field-hint: root.label-numeric-field-hint;
                                step: 1;
                                x-value: root.rot-x;
                                y-value: root.rot-y;
                                z-value: root.rot-z;
                                scrubbed(axis, delta, fine) => { root.transform-scrubbed("rot", axis, delta, fine); }
                                scrub-started => { root.transform-scrub-started("rot"); }
                                scrub-finished => { root.transform-scrub-finished(); }
                                text-committed(axis, text) => { root.transform-text-committed("rot", axis, text) }
                                scrub-cancelled => { root.transform-scrub-cancelled(); }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                height: 22px;
                                Text { text: "Step 90°:"; color: DesignTokens.text-muted; font-size: 9px; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+90° X"; color: DesignTokens.text-primary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.transform-scrubbed("rot", 0, 90, false); root.transform-scrub-finished(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+90° Y"; color: DesignTokens.text-primary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.transform-scrubbed("rot", 1, 90, false); root.transform-scrub-finished(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: "+90° Z"; color: DesignTokens.text-primary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.transform-scrubbed("rot", 2, 90, false); root.transform-scrub-finished(); } }
                                }
                            }
                        }

                        if root.active-tool == "scale": Vector3Field {
                            row-label: "Scale";
                            field-hint: root.label-numeric-field-hint;
                            x-value: root.scale-x;
                            y-value: root.scale-y;
                            z-value: root.scale-z;
                            scrubbed(axis, delta, fine) => { root.transform-scrubbed("scale", axis, delta, fine); }
                            scrub-started => { root.transform-scrub-started("scale"); }
                            scrub-finished => { root.transform-scrub-finished(); }
                            text-committed(axis, text) => { root.transform-text-committed("scale", axis, text) }
                            scrub-cancelled => { root.transform-scrub-cancelled(); }
                        }

                        if root.active-tool == "cut": VerticalLayout {
                            spacing: 6px;
                            Text { text: "Click vertices or edges to draw cut path"; color: DesignTokens.text-secondary; font-size: 10px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 6px;
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: root.label-cancel; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.command-executed("model.knife_cancel"); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.accent;
                                    Text { text: "Cut"; color: DesignTokens.canvas; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.command-executed("model.knife_apply"); } }
                                }
                            }
                            Text { text: "Enter confirm · Esc cancel"; color: DesignTokens.text-muted; font-size: 9px; }
                        }

                        if root.active-tool == "slice": VerticalLayout {
                            spacing: 6px;
                            Text { text: "Drag a cut line across the mesh to bisect"; color: DesignTokens.text-secondary; font-size: 10px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 4px;
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: !root.slice-trim ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: !root.slice-trim ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: "Split (T)";
                                        color: !root.slice-trim ? DesignTokens.canvas : DesignTokens.text-primary;
                                        font-size: 10px;
                                        font-weight: !root.slice-trim ? 700 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.slice-trim-set(false); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.slice-trim ? DesignTokens.accent : DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: root.slice-trim ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: "Trim (T)";
                                        color: root.slice-trim ? DesignTokens.canvas : DesignTokens.text-primary;
                                        font-size: 10px;
                                        font-weight: root.slice-trim ? 700 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.slice-trim-set(true); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text { text: root.label-cancel; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.slice-cancel(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.accent;
                                    Text { text: "Confirm Cut"; color: DesignTokens.canvas; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.slice-confirm(); } }
                                }
                            }
                            Text { text: "Enter: Confirm · Esc: Cancel · T: Toggle Trim"; color: DesignTokens.text-muted; font-size: 9px; wrap: word-wrap; }
                        }

                        if root.active-tool == "bevel": VerticalLayout {
                            spacing: 6px;
                            Text { text: "Round Edge (Bevel) Options"; color: DesignTokens.text-secondary; font-size: 10px; wrap: word-wrap; }
                            HorizontalLayout {
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.bevel-clamp-overlap ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: root.bevel-clamp-overlap ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: root.bevel-clamp-overlap ? "✓ Clamp Overlap (Active)" : "Clamp Overlap (Off)";
                                        color: root.bevel-clamp-overlap ? DesignTokens.accent : DesignTokens.text-primary;
                                        font-size: 10px;
                                        font-weight: root.bevel-clamp-overlap ? 700 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.toggle-bevel-clamp-overlap(); } }
                                }
                            }
                            HorizontalLayout {
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: root.bevel-affect-vertices ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface-raised;
                                    border-width: 1px;
                                    border-color: root.bevel-affect-vertices ? DesignTokens.accent : DesignTokens.border;
                                    Text {
                                        text: root.bevel-affect-vertices ? "✓ Point (Vertex) Mode" : "Point Mode (Off)";
                                        color: root.bevel-affect-vertices ? DesignTokens.accent : DesignTokens.text-primary;
                                        font-size: 10px;
                                        font-weight: root.bevel-affect-vertices ? 700 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.toggle-bevel-affect-vertices(); } }
                                }
                            }
                        }

                        if root.active-tool == "cursor" || root.active-tool == "cursor_3d": VerticalLayout {
                            spacing: 6px;
                            Vector3Field {
                                row-label: "Cursor";
                                field-hint: root.label-numeric-field-hint;
                                x-value: root.cursor-x;
                                y-value: root.cursor-y;
                                z-value: root.cursor-z;
                                scrubbed(axis, delta, fine) => {
                                    root.cursor-coord-committed(axis, (axis == 0 ? root.cursor-x : (axis == 1 ? root.cursor-y : root.cursor-z)) + delta * (fine ? 0.01 : 0.1));
                                }
                                text-committed(axis, text) => {
                                    root.cursor-coord-committed(axis, text.to-float());
                                    return true;
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                height: 26px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text {
                                        text: "Focus Camera";
                                        color: DesignTokens.text-primary;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.frame-cursor-requested(); } }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    Text {
                                        text: "Reset (0,0,0)";
                                        color: DesignTokens.text-primary;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.reset-cursor-requested(); } }
                                }
                            }
                        }

                        Text {
                            text: (root.active-tool == "cursor" || root.active-tool == "cursor_3d") ? "LMB Click to place · Shift+RMB in any tool" : ((root.active-tool == "move" || root.active-tool == "rotate" || root.active-tool == "scale") ? "G move · R rotate · S scale · Shift precision" : "");
                            color: DesignTokens.text-muted;
                            font-size: 9px;
                        }
                    }


                    // Gizmo de transformação: hastes curtas de tamanho fixo em
                    // tela, com setas, só com Move/Rotate/Scale. Nunca linhas
                    // infinitas: o padrão é controle de tamanho aparente constante.
                    if gizmo-visible && active-workspace == "MODEL": Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        background: transparent;

                        // Hierarquia do gizmo: o eixo ativo domina, o eixo sob o
                        // cursor clareia, os demais esmaecem durante o arrasto.
                        Path {
                            commands: root.gizmo-x-commands;
                            fit: ImageFit.preserve;
                            stroke: root.gizmo-handle-color(0, DesignTokens.axis-x);
                            stroke-width: root.gizmo-handle-width(0);
                            fill: transparent;
                        }
                        Path {
                            commands: root.gizmo-y-commands;
                            fit: ImageFit.preserve;
                            stroke: root.gizmo-handle-color(1, DesignTokens.axis-y);
                            stroke-width: root.gizmo-handle-width(1);
                            fill: transparent;
                        }
                        Path {
                            commands: root.gizmo-z-commands;
                            fit: ImageFit.preserve;
                            stroke: root.gizmo-handle-color(2, DesignTokens.axis-z);
                            stroke-width: root.gizmo-handle-width(2);
                            fill: transparent;
                        }
                        Path {
                            commands: root.gizmo-x-arrow-commands;
                            fit: ImageFit.preserve;
                            stroke: transparent;
                            fill: root.gizmo-handle-color(0, DesignTokens.axis-x);
                        }
                        Path {
                            commands: root.gizmo-y-arrow-commands;
                            fit: ImageFit.preserve;
                            stroke: transparent;
                            fill: root.gizmo-handle-color(1, DesignTokens.axis-y);
                        }
                        Path {
                            commands: root.gizmo-z-arrow-commands;
                            fit: ImageFit.preserve;
                            stroke: transparent;
                            fill: root.gizmo-handle-color(2, DesignTokens.axis-z);
                        }
                        Path { commands: root.gizmo-x-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(0, DesignTokens.axis-x); }
                        Path { commands: root.gizmo-y-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(1, DesignTokens.axis-y); }
                        Path { commands: root.gizmo-z-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(2, DesignTokens.axis-z); }
                        Path { commands: root.gizmo-x-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(0, DesignTokens.axis-x).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
                        Path { commands: root.gizmo-y-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(1, DesignTokens.axis-y).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
                        Path { commands: root.gizmo-z-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(2, DesignTokens.axis-z).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
                        Path { commands: root.gizmo-plane-yz-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(0, DesignTokens.axis-x); stroke-width: 1px; fill: root.gizmo-handle-color(0, DesignTokens.axis-x).transparentize(0.65); }
                        Path { commands: root.gizmo-plane-xz-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(1, DesignTokens.axis-y); stroke-width: 1px; fill: root.gizmo-handle-color(1, DesignTokens.axis-y).transparentize(0.65); }
                        Path { commands: root.gizmo-plane-xy-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(2, DesignTokens.axis-z); stroke-width: 1px; fill: root.gizmo-handle-color(2, DesignTokens.axis-z).transparentize(0.65); }
                        Path { commands: root.gizmo-view-roll-commands; fit: ImageFit.preserve; stroke: root.gizmo-center-active || root.gizmo-center-hover ? DesignTokens.accent : DesignTokens.text-secondary.transparentize(0.4); stroke-width: 1.5px; fill: transparent; }
                        Rectangle {
                            x: gizmo-origin-x - 6px;
                            y: gizmo-origin-y - 6px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.gizmo-center-active ? DesignTokens.accent : (root.gizmo-center-hover ? DesignTokens.accent.transparentize(0.2) : DesignTokens.text-primary);
                            border-width: 1.5px;
                            border-color: DesignTokens.canvas;
                        }
                        if root.colorblind-axes: Rectangle {
                            for axis-badge in [
                                { label: "X", x: root.gizmo-x-label-x != 0px ? root.gizmo-x-label-x : root.gizmo-x-end-x, y: root.gizmo-x-label-y != 0px ? root.gizmo-x-label-y : root.gizmo-x-end-y, tint: DesignTokens.axis-x },
                                { label: "Y", x: root.gizmo-y-label-x != 0px ? root.gizmo-y-label-x : root.gizmo-y-end-x, y: root.gizmo-y-label-y != 0px ? root.gizmo-y-label-y : root.gizmo-y-end-y, tint: DesignTokens.axis-y },
                                { label: "Z", x: root.gizmo-z-label-x != 0px ? root.gizmo-z-label-x : root.gizmo-z-end-x, y: root.gizmo-z-label-y != 0px ? root.gizmo-z-label-y : root.gizmo-z-end-y, tint: DesignTokens.axis-z },
                            ]: Rectangle {
                                x: axis-badge.x - 8px;
                                y: axis-badge.y - 8px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: #14141ee6;
                                border-width: 1px;
                                border-color: axis-badge.tint.transparentize(0.2);
                                drop-shadow-blur: 4px;
                                drop-shadow-color: #00000088;
                                Text {
                                    text: axis-badge.label;
                                    color: axis-badge.tint;
                                    font-size: 10px;
                                    font-weight: 700;
                                    font-family: "monospace";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Tripé de navegação no alto à direita. Arrastar orbita a
                    // câmera; clicar em um eixo mantém o alinhamento da vista.
                    Rectangle {
                        x: view-gizmo-origin-x - 54px - root.inspector-clearance;
                        y: view-gizmo-origin-y - 54px;
                        width: 108px;
                        height: 108px;
                        clip: true;
                        background: transparent;
                        animate x { duration: root.reduced-motion ? 0ms : 180ms; easing: ease-out; }

                        TouchArea {
                            mouse-cursor: self.pressed ? grabbing : grab;
                            property <length> last-x;
                            property <length> last-y;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.viewport-orbit((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                                    self.last-x = self.mouse-x;
                                    self.last-y = self.mouse-y;
                                }
                            }
                        }

                        Path {
                            commands: root.view-gizmo-x-commands;
                            fit: ImageFit.preserve;
                            stroke: DesignTokens.axis-x;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                        Path {
                            commands: root.view-gizmo-y-commands;
                            fit: ImageFit.preserve;
                            stroke: DesignTokens.axis-y;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                        Path {
                            commands: root.view-gizmo-z-commands;
                            fit: ImageFit.preserve;
                            stroke: DesignTokens.axis-z;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                        for axis in [
                            { id: "x", label: "X", x: root.view-gizmo-x-end-x, y: root.view-gizmo-x-end-y, tint: DesignTokens.axis-x },
                            { id: "y", label: "Y", x: root.view-gizmo-y-end-x, y: root.view-gizmo-y-end-y, tint: DesignTokens.axis-y },
                            { id: "z", label: "Z", x: root.view-gizmo-z-end-x, y: root.view-gizmo-z-end-y, tint: DesignTokens.axis-z },
                        ]: Rectangle {
                            x: axis.x - 10px;
                            y: axis.y - 10px;
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: DesignTokens.surface-raised;
                            border-width: 1px;
                            border-color: axis.tint;
                            accessible-role: button;
                            accessible-label: axis.label;
                            Text { text: axis.label; color: axis.tint; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea {
                                mouse-cursor: self.pressed ? grabbing : pointer;
                                property <length> last-x;
                                property <length> last-y;
                                property <bool> dragged: false;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                        self.last-x = self.mouse-x;
                                        self.last-y = self.mouse-y;
                                        self.dragged = false;
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        if abs(self.mouse-x - self.last-x) > 1px || abs(self.mouse-y - self.last-y) > 1px {
                                            self.dragged = true;
                                            root.viewport-orbit((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                                            self.last-x = self.mouse-x;
                                            self.last-y = self.mouse-y;
                                        }
                                    }
                                }
                                clicked => { if !self.dragged { root.view-axis-clicked(axis.id); } }
                            }
                        }
                    }

                    // Barra contextual flutuante na base da viewport.
                    context-bar := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 14px;
                        width: bar-row.preferred-width + 16px;
                        height: 40px;
                        border-radius: 10px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000066;
                        drop-shadow-offset-y: 3px;

                        bar-row := HorizontalLayout {
                            x: 8px;
                            y: 4px;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            spacing: 4px;
                            alignment: center;

                            // --- MODEL: Ferramentas de modelagem (Shapes / 2D Profiles hero position) ---
                            if active-workspace == "MODEL" && root.modeling-mode == "DRAW": ToolButton {
                                icon-svg: PetuniaIcons.tool-profile;
                                semantic-label: "Sketch";
                                shortcut: root.shortcuts.model-profile;
                                description: "Draw 2D profile curves on ground, face, or viewplane to extrude or revolve";
                                active: active-tool == "draw_profile";
                                clicked => { root.active-tool-changed("draw_profile"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "DRAW" && root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.Square;
                                semantic-label: "Rect 2D";
                                description: "Create 2D rectangle profile on active workplane, ready to extrude";
                                clicked => { root.add-profile-rectangle(2.0, 1.5); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "DRAW" && root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.Circle;
                                semantic-label: "Circle 2D";
                                description: "Create 2D circle profile on active workplane, ready to extrude or revolve";
                                clicked => { root.add-profile-circle(1.0, 16); }
                            }

                            if active-workspace == "MODEL" && root.modeling-mode == "DRAW": Rectangle {
                                width: 1px;
                                height: 20px;
                                background: DesignTokens.border;
                            }

                            // --- MODEL: Ferramentas principais de edição poligonal ---
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY": ToolButton {
                                icon-svg: PetuniaIcons.tool-extrude;
                                semantic-label: "Extrude";
                                shortcut: root.shortcuts.model-extrude;
                                description: "Pull new vertices and faces outward from selected edges or faces";
                                clicked => { root.command-executed("model.extrude"); }
                            }
                            if active-workspace == "MODEL" && (root.modeling-mode == "DRAW" || root.viewport-region-width >= 760): ToolButton {
                                icon-svg: PetuniaIcons.tool-pushpull;
                                active: active-tool == "push_pull";
                                semantic-label: root.label-model-push-pull;
                                shortcut: root.shortcuts.model-push-pull;
                                description: "Push or pull faces along surface normals directly";
                                clicked => { root.command-executed("model.push_pull"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY": ToolButton {
                                icon-svg: PetuniaIcons.tool-inset;
                                semantic-label: "Inset";
                                shortcut: root.shortcuts.model-inset;
                                description: "Inset new polygonal boundary inside selected faces";
                                clicked => { root.command-executed("model.inset"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY": ToolButton {
                                icon-svg: PetuniaIcons.tool-bevel;
                                semantic-label: "Bevel";
                                shortcut: root.shortcuts.model-bevel;
                                description: "Round edges or vertices with smooth chamfer bevel fillets";
                                clicked => { root.command-executed("model.bevel"); }
                            }

                            if active-workspace == "MODEL" && root.modeling-mode == "POLY": Rectangle {
                                width: 1px;
                                height: 20px;
                                background: DesignTokens.border;
                            }

                            if active-workspace == "MODEL" && root.modeling-mode == "POLY": ToolButton {
                                icon-svg: PetuniaIcons.tool-profile;
                                semantic-label: root.label-poly-pen;
                                description: root.label-poly-pen-hint;
                                active: active-tool == "poly_pen";
                                clicked => { root.active-tool-changed("poly_pen"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY": ToolButton {
                                icon-svg: PetuniaIcons.tool-knife;
                                semantic-label: "Knife";
                                shortcut: root.shortcuts.model-knife;
                                description: "Interactively slice through edges and faces with cutting line";
                                active: active-tool == "cut";
                                clicked => { root.command-executed("model.knife"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760: ToolButton {
                                icon-svg: PetuniaIcons.tool-loopcut;
                                semantic-label: root.label-model-loop-cut;
                                shortcut: root.shortcuts.model-loop-cut;
                                description: "Insert a connected edge loop ring across quad mesh geometry";
                                active: active-tool == "loop_cut";
                                clicked => { root.active-tool-changed("loop_cut"); }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width >= 760: ToolButton {
                                icon-svg: PetuniaIcons.tool-duplicate;
                                semantic-label: "Duplicate";
                                shortcut: root.shortcuts.model-duplicate;
                                description: "Create an identical clone of selected geometry or parts";
                                clicked => { root.duplicate-requested(); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760: ToolButton {
                                icon-svg: PetuniaIcons.tool-subdivide;
                                semantic-label: "Subdivide";
                                shortcut: root.shortcuts.model-subdivide;
                                description: "Subdivide faces into quad quarters creating finer geometry";
                                clicked => { root.command-executed("model.subdivide"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760: ToolButton {
                                icon-svg: PetuniaIcons.tool-merge;
                                semantic-label: "Merge Center";
                                shortcut: root.shortcuts.model-merge;
                                description: "Collapse and merge all selected vertices to their median center";
                                clicked => { root.command-executed("model.merge"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760: ToolButton {
                                icon-svg: PetuniaIcons.tool-slice;
                                semantic-label: root.label-model-slice;
                                shortcut: root.shortcuts.model-slice;
                                description: "Cut mesh along an infinite cutting plane through selection";
                                active: active-tool == "slice";
                                clicked => { root.active-tool-changed("slice"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760: ToolButton {
                                icon-svg: PetuniaIcons.tool-connect;
                                semantic-label: "Connect";
                                shortcut: root.shortcuts.model-connect;
                                description: "Bridge edge loops with configurable quad segments and twist";
                                clicked => { root.command-executed("model.connect"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 720: ToolButton {
                                icon: IconSet.Square;
                                semantic-label: "Make Face";
                                shortcut: "F";
                                description: "Create face or edge connecting selected vertices or edges (F)";
                                clicked => { root.command-executed("model.make_face"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760: ToolButton {
                                icon-svg: PetuniaIcons.tool-spin;
                                semantic-label: "Spin";
                                shortcut: root.shortcuts.model-spin;
                                description: "Revolve selection around cursor or axis into lathe surface";
                                clicked => { root.command-executed("model.spin"); }
                            }
                            if active-workspace == "MODEL" && root.modeling-mode == "POLY" && root.viewport-region-width >= 760: ToolButton {
                                icon-svg: PetuniaIcons.tool-dissolve;
                                semantic-label: "Dissolve";
                                shortcut: root.shortcuts.model-dissolve;
                                description: "Dissolve selected vertices, edges or faces without removing surrounding geometry";
                                clicked => { root.command-executed("model.dissolve"); }
                            }

                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Paintbrush;
                                semantic-label: "Brush";
                                shortcut: root.shortcuts.paint-brush;
                                description: "Freehand raster texture painting with adjustable size and softness";
                                active: active-tool == "brush";
                                clicked => { root.active-tool-changed("brush"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Spline;
                                semantic-label: "Airbrush";
                                shortcut: root.shortcuts.paint-airbrush;
                                description: "Smooth gradual airbrush spray effect onto active texture";
                                active: active-tool == "airbrush";
                                clicked => { root.active-tool-changed("airbrush"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Eraser;
                                semantic-label: "Eraser";
                                shortcut: root.shortcuts.paint-eraser;
                                description: "Erase pixel color values and alpha transparency from active texture";
                                active: active-tool == "eraser";
                                clicked => { root.active-tool-changed("eraser"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Pipette;
                                semantic-label: "Color Picker";
                                shortcut: root.shortcuts.paint-picker;
                                description: "Sample color from viewport pixels under mouse cursor";
                                active: active-tool == "picker";
                                clicked => { root.active-tool-changed("picker"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.PaintBucket;
                                semantic-label: "Fill";
                                shortcut: root.shortcuts.paint-fill;
                                description: "Flood fill contiguous color areas on active UV map";
                                active: active-tool == "fill";
                                clicked => { root.active-tool-changed("fill"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.SquareDashed;
                                semantic-label: "Line";
                                shortcut: root.shortcuts.paint-line;
                                description: "Draw straight brush strokes between clicked endpoints";
                                active: active-tool == "line";
                                clicked => { root.active-tool-changed("line"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Square;
                                semantic-label: "Rectangle";
                                shortcut: root.shortcuts.paint-rectangle;
                                description: "Fill or stroke rectangular 2D shapes on texture canvas";
                                active: active-tool == "rectangle";
                                clicked => { root.active-tool-changed("rectangle"); }
                            }
                            if active-workspace == "PAINT": ToolButton {
                                icon: IconSet.Sliders;
                                semantic-label: "Gradient";
                                shortcut: root.shortcuts.paint-gradient;
                                description: "Draw linear color gradients between endpoints across active canvas";
                                active: active-tool == "gradient";
                                clicked => { root.active-tool-changed("gradient"); }
                            }

                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Maximize2;
                                semantic-label: "Unwrap";
                                shortcut: root.shortcuts.uv-unwrap;
                                description: "Unfold 3D mesh surface into flat 2D UV layout";
                                clicked => { root.command-executed("uv.unwrap_auto"); }
                            }
                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Grid2x2;
                                semantic-label: "Pack Islands";
                                shortcut: root.shortcuts.uv-pack;
                                description: "Pack and arrange UV islands efficiently without overlap";
                                clicked => { root.command-executed("uv.pack_islands"); }
                            }
                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Camera;
                                semantic-label: "Project Ref";
                                shortcut: root.shortcuts.uv-project-ref;
                                description: "Project UV coordinates from active camera perspective";
                                clicked => { root.command-executed("uv.project_reference"); }
                            }
                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Link;
                                semantic-label: "Stitch";
                                shortcut: root.shortcuts.uv-stitch;
                                description: "Weld coincident 3D edges that have split UV seams";
                                clicked => { root.command-executed("uv.stitch"); }
                            }
                            if active-workspace == "UV": ToolButton {
                                icon: IconSet.Minimize2;
                                semantic-label: "Relax";
                                shortcut: root.shortcuts.uv-relax;
                                description: "Smooth unpinned UV island corners to minimize distortion";
                                clicked => { root.command-executed("uv.relax"); }
                            }

                            Rectangle {
                                width: 1px;
                                height: 22px;
                                background: DesignTokens.border;
                            }
                            if active-workspace != "MODEL" || root.viewport-region-width >= 760: ToolButton {
                                icon: IconSet.Trash2;
                                semantic-label: "Delete";
                                shortcut: root.shortcuts.model-delete;
                                description: "Remove selected points, edges, faces or entire objects";
                                clicked => { root.delete-requested(); }
                            }
                            if active-workspace == "MODEL" && root.viewport-region-width < 760: ToolButton {
                                icon: IconSet.MoreHorizontal;
                                semantic-label: root.label-more-model-tools;
                                shortcut: "";
                                description: "Open overflow menu with additional modeling operations";
                                active: root.shelf-overflow-open;
                                clicked => { root.shelf-overflow-open = !root.shelf-overflow-open; }
                            }
                        }
                    }

                    if root.pivot-menu-open: Rectangle {
                        x: min(max(8px, (parent.width - self.width) / 2), parent.width - self.width - 8px);
                        y: 54px;
                        width: 240px;
                        height: 356px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000080;
                        VerticalLayout {
                            padding: 10px; spacing: 4px;
                            Text { text: root.label-model-pivot; color: DesignTokens.text-primary; font-size: 11px; font-weight: 700; }
                            for item in [
                                { id: "median", label: root.pivot-median-label },
                                { id: "bounds", label: root.pivot-bounds-label },
                                { id: "cursor", label: root.pivot-cursor-label },
                                { id: "individual", label: root.pivot-individual-label },
                            ]: Rectangle {
                                height: 26px; border-radius: 4px;
                                background: root.pivot-id == item.id ? DesignTokens.surface-hover : transparent;
                                Text { text: item.label; x: 8px; color: root.pivot-id == item.id ? DesignTokens.accent : DesignTokens.text-primary; font-size: 10px; vertical-alignment: center; }
                                TouchArea { clicked => { root.pivot-set(item.id); root.pivot-menu-toggled(false); } }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            Rectangle {
                                height: 26px; border-radius: 4px;
                                background: root.edit-pivot ? DesignTokens.accent.transparentize(0.8) : transparent;
                                border-width: root.edit-pivot ? 1px : 0px;
                                border-color: DesignTokens.accent;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px;
                                    alignment: space-between;
                                    Text { text: root.label-edit-pivot; color: root.edit-pivot ? DesignTokens.accent : DesignTokens.text-primary; font-size: 10px; vertical-alignment: center; }
                                    Text { text: "Insert"; color: DesignTokens.text-muted; font-size: 9px; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.command-executed("object.toggle_edit_pivot"); root.pivot-menu-toggled(false); } }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            Text { text: "Set Origin"; color: DesignTokens.text-secondary; font-size: 10px; font-weight: 700; }
                            for origin-item in [
                                { id: "object.origin_to_geometry", label: root.label-origin-to-geometry },
                                { id: "object.origin_to_bottom", label: root.label-origin-to-bottom },
                                { id: "object.origin_to_cursor", label: root.label-origin-to-cursor },
                                { id: "object.origin_to_selection", label: root.label-origin-to-selection },
                                { id: "object.geometry_to_origin", label: root.label-geometry-to-origin },
                            ]: Rectangle {
                                height: 24px; border-radius: 4px;
                                background: transparent;
                                Text { text: origin-item.label; x: 8px; color: DesignTokens.text-primary; font-size: 10px; vertical-alignment: center; }
                                TouchArea { clicked => { root.command-executed(origin-item.id); root.pivot-menu-toggled(false); } }
                            }
                        }
                    }

                    // Micro-Inspector Flutuante sob o Cursor (Fase 6: Micro-Inspector Flutuante)
                    if root.micro-inspector-open && active-workspace == "MODEL": Rectangle {
                        x: min(max(14px, root.micro-inspector-x), parent.width - self.width - 14px);
                        y: min(max(14px, root.micro-inspector-y), parent.height - self.height - 14px);
                        width: 250px;
                        height: 200px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1.5px;
                        border-color: DesignTokens.accent;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: #000000aa;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            // Cabeçalho com título e botão de fechar
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Micro-Inspector";
                                    color: DesignTokens.accent;
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 4px;
                                    background: close-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                    IconDisplay {
                                        icon: IconSet.X;
                                        size: 12px;
                                        stroke: DesignTokens.text-muted;
                                    }
                                    close-touch := TouchArea {
                                        clicked => { root.micro-inspector-toggle(); }
                                    }
                                }
                            }

                            // Ferramentas de Transformação Rápida
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: stretch;
                                for tool in [
                                    { id: "select", label: "Select", icon: IconSet.MousePointer2 },
                                    { id: "move", label: "Move", icon: IconSet.Move3d },
                                    { id: "rotate", label: "Rotate", icon: IconSet.RotateCcw },
                                    { id: "scale", label: "Scale", icon: IconSet.Maximize2 },
                                    { id: "measure", label: "Measure", icon: IconSet.ArrowUpDown },
                                ]: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 28px;
                                    border-radius: 4px;
                                    background: root.active-tool == tool.id ? DesignTokens.accent.transparentize(0.75) : (tool-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface);
                                    border-width: root.active-tool == tool.id ? 1px : 0px;
                                    border-color: DesignTokens.accent;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        IconDisplay {
                                            icon: tool.icon;
                                            size: 13px;
                                            stroke: root.active-tool == tool.id ? DesignTokens.accent : DesignTokens.text-primary;
                                        }
                                    }
                                    tool-touch := TouchArea {
                                        clicked => {
                                            root.active-tool-changed(tool.id);
                                            root.micro-inspector-toggle();
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            // Resumo de Dados: Se fita métrica visível ou coordenadas de posição
                            if root.measure-visible: VerticalLayout {
                                spacing: 2px;
                                Text { text: "Distance: " + root.measure-distance + "m"; color: #f59e0b; font-size: 11px; font-weight: 700; font-family: "monospace"; }
                                Text { text: "Δ: X " + root.measure-dx + "  Y " + root.measure-dy + "  Z " + root.measure-dz; color: DesignTokens.text-primary; font-size: 10px; font-family: "monospace"; }
                                Text { text: "Angle: " + root.measure-angle-deg + "°"; color: DesignTokens.text-muted; font-size: 10px; }
                            }

                            if !root.measure-visible: VerticalLayout {
                                spacing: 2px;
                                Text { text: "Transform Quick Readout"; color: DesignTokens.text-muted; font-size: 9px; font-weight: 700; }
                                Text { text: "Pos: " + root.pos-x + ", " + root.pos-y + ", " + root.pos-z; color: DesignTokens.text-primary; font-size: 10px; font-family: "monospace"; }
                                Text { text: "Rot: " + root.rot-x + "°, " + root.rot-y + "°, " + root.rot-z + "°"; color: DesignTokens.text-secondary; font-size: 10px; font-family: "monospace"; }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            // Ações de Modelagem Direta
                            HorizontalLayout {
                                spacing: 4px;
                                for act in [
                                    { id: "model.extrude", label: "Extrude" },
                                    { id: "model.inset", label: "Inset" },
                                    { id: "model.bevel", label: "Bevel" },
                                    { id: "model.loop_cut", label: "Loop Cut" },
                                ]: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: act-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface;
                                    Text {
                                        text: act.label;
                                        color: DesignTokens.text-primary;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    act-touch := TouchArea {
                                        clicked => {
                                            root.command-executed(act.id);
                                            root.micro-inspector-toggle();
                                        }
                                    }
                                }
                            }

                            // Rodapé com atalho
                            Text {
                                text: "Space: close · Esc: cancel";
                                color: DesignTokens.text-muted;
                                font-size: 9px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.shelf-overflow-open && active-workspace == "MODEL" && root.viewport-region-width < 760: Rectangle {
                        x: min(parent.width - self.width - 14px, context-bar.x + context-bar.width - self.width);
                        y: context-bar.y - self.height - 8px;
                        width: 190px;
                        height: 380px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;
                            ContextMenuItem { label: "Duplicate"; shortcut: root.shortcuts.model-duplicate; clicked => { root.shelf-overflow-open = false; root.duplicate-requested(); } }
                            ContextMenuItem { label: "Loop Cut"; shortcut: root.shortcuts.model-loop-cut; clicked => { root.shelf-overflow-open = false; root.command-executed("model.loop_cut"); } }
                            ContextMenuItem { label: root.label-model-push-pull; shortcut: root.shortcuts.model-push-pull; clicked => { root.shelf-overflow-open = false; root.command-executed("model.push_pull"); } }
                            ContextMenuItem { label: root.label-model-profile; shortcut: root.shortcuts.model-profile; clicked => { root.shelf-overflow-open = false; root.active-tool-changed("draw_profile"); } }
                            ContextMenuItem { label: root.label-model-slice; shortcut: root.shortcuts.model-slice; clicked => { root.shelf-overflow-open = false; root.active-tool-changed("slice"); } }
                            ContextMenuItem { label: "Connect Loops"; shortcut: root.shortcuts.model-connect; clicked => { root.shelf-overflow-open = false; root.command-executed("model.connect"); } }
                            ContextMenuItem { label: "Make Face / Edge"; shortcut: "F"; clicked => { root.shelf-overflow-open = false; root.command-executed("model.make_face"); } }
                            ContextMenuItem { label: "Spin / Lathe"; shortcut: root.shortcuts.model-spin; clicked => { root.shelf-overflow-open = false; root.command-executed("model.spin"); } }
                            ContextMenuItem { label: "Subdivide"; shortcut: root.shortcuts.model-subdivide; clicked => { root.shelf-overflow-open = false; root.command-executed("model.subdivide"); } }
                            ContextMenuItem { label: "Merge Center"; shortcut: root.shortcuts.model-merge; clicked => { root.shelf-overflow-open = false; root.command-executed("model.merge"); } }
                            ContextMenuItem { label: "Dissolve"; shortcut: root.shortcuts.model-dissolve; clicked => { root.shelf-overflow-open = false; root.command-executed("model.dissolve"); } }
                            ContextMenuItem { label: "Slice"; shortcut: root.shortcuts.model-slice; clicked => { root.shelf-overflow-open = false; root.command-executed("model.slice"); } }
                            ContextMenuItem { label: "Delete"; shortcut: root.shortcuts.model-delete; danger: true; clicked => { root.shelf-overflow-open = false; root.delete-requested(); } }
                        }
                    }

                    // Menu de criação aberto a partir do trilho esquerdo.
                    if add-menu-open && active-workspace == "MODEL": Rectangle {
                        x: 14px;
                        y: 58px;
                        width: 2 * 34px + 216px;
                        height: 88px;
                        border-radius: 10px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000066;
                        drop-shadow-offset-y: 3px;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 6px;
                            alignment: center;

                            ToolButton {
                                icon-svg: PetuniaIcons.cube;
                                semantic-label: "Cube";
                                shortcut: "1";
                                description: "Parametric 6-sided hexahedral box with width, height and depth";
                                clicked => { root.add-primitive-requested("cube"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.sphere;
                                semantic-label: "Sphere";
                                shortcut: "2";
                                description: "UV sphere parameterized by longitude segments and latitude rings";
                                clicked => { root.add-primitive-requested("sphere"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.cylinder;
                                semantic-label: "Cylinder";
                                shortcut: "3";
                                description: "Parametric circular cylinder with top/bottom cap options";
                                clicked => { root.add-primitive-requested("cylinder"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.plane;
                                semantic-label: "Plane";
                                shortcut: "4";
                                description: "Flat 2D quad rectangular plane surface positioned on ground plane";
                                clicked => { root.add-primitive-requested("plane"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.cone;
                                semantic-label: "Cone";
                                shortcut: "5";
                                description: "Conical geometry tapering to a single apex vertex";
                                clicked => { root.add-primitive-requested("cone"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.capsule;
                                semantic-label: "Capsule";
                                shortcut: "6";
                                description: "Cylindrical body capped by two hemispherical domes";
                                clicked => { root.add-primitive-requested("capsule"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.torus;
                                semantic-label: "Torus";
                                shortcut: "7";
                                description: "Donut-shaped revolution ring with major and minor radii";
                                clicked => { root.add-primitive-requested("torus"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.circle;
                                semantic-label: "Circle";
                                shortcut: "8";
                                description: "2D planar boundary circle polygon or n-gon disc";
                                clicked => { root.add-primitive-requested("circle"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.icosphere;
                                semantic-label: "Icosphere";
                                shortcut: "9";
                                description: "Polyhedral geodesic sphere composed of equilateral triangles";
                                clicked => { root.add-primitive-requested("icosphere"); root.add-menu-changed(false); }
                            }
                            ToolButton {
                                icon-svg: PetuniaIcons.wedge;
                                semantic-label: "Wedge";
                                shortcut: "0";
                                description: "Right-angled triangular prism 3D ramp mesh";
                                clicked => { root.add-primitive-requested("wedge"); root.add-menu-changed(false); }
                            }
                        }
                    }
                
                    // Inspector Flyout flutuante sobre a Viewport (Peek-on-Hover e Pin/Unpin)
                    if inspector-visible && !compact-shell: inspector-flyout := Rectangle {
                        visible: root.inspector-flyout-open || self.opacity > 0.01;
                        x: parent.width - (root.inspector-flyout-open ? (self.width + 6px) : 0px);
                        y: 8px;
                        width: min(320px, parent.width - 60px);
                        height: parent.height - 16px;
                        background: transparent;
                        opacity: root.inspector-flyout-open ? 1.0 : 0.0;

                        animate opacity { duration: root.reduced-motion ? 0ms : 150ms; easing: ease-out; }
                        animate x { duration: root.reduced-motion ? 0ms : 180ms; easing: ease-out; }

                        flyout-touch := TouchArea {
                            changed has-hover => {
                                root.flyout-hovered = self.has-hover;
                                if !self.has-hover && !root.rail-hovered {
                                    root.hovered-inspector-section = "";
                                }
                            }
                            pointer-event(_e) => { }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            horizontal-scrollbar-policy: always-off;
                            vertical-scrollbar-policy: as-needed;
                            VerticalLayout {
                                spacing: 10px;
                                width: parent.width;
                                vertical-stretch: 0;

                        if active-workspace == "MODEL": VerticalLayout {
                            spacing: 10px;
                            vertical-stretch: 0;

                            if (root.model-parts-open || root.hovered-inspector-section == "parts"): InspectorSection {
                                title: root.label-parts;
                                section-id: "parts";
                                open: root.model-parts-open || root.hovered-inspector-section == "parts";
                                pin-open: root.section-states.length > 0 ? root.section-states[0].pin-open : false;
                                toggled => { root.section-open-toggled("parts"); }
                                toggle-all => { root.toggle-all-sections(); }
                                pin-toggled(id) => { root.section-pin-open-toggled(id); }

                                PartsBody {
                                    search-label: root.label-search-parts;
                                    selected-only-label: root.label-selected-parts-only;
                                    sort-label: root.label-sort-parts;
                                    query <=> root.parts-query;
                                    selected-only <=> root.parts-selected-only;
                                    sort-by-name <=> root.parts-sort-by-name;
                                    items: root.parts-items;
                                    total-count: root.scene-items.length;
                                    row-size-label: root.label-parts-row-size;
                                    row-height <=> root.parts-row-height;
                                    list-label: root.label-parts;
                                    hide-label: root.label-hide-part;
                                    show-label: root.label-show-part;
                                    lock-label: root.label-lock-part;
                                    unlock-label: root.label-unlock-part;
                                    rename-active: root.rename-active;
                                    rename-value: root.rename-value;
                                    query-changed(query) => { root.parts-query-changed(query); }
                                    selected-only-changed(enabled) => { root.parts-selected-only-changed(enabled); }
                                    sort-changed(enabled) => { root.parts-sort-changed(enabled); }
                                    row-height-changed(value) => { root.parts-row-height-changed(value); }
                                    scene-select(id, extend) => { root.scene-select(id, extend); }
                                    scene-toggle-visibility(id) => { root.scene-toggle-visibility(id); }
                                    scene-toggle-lock(id) => { root.scene-toggle-lock(id); }
                                    scene-context-requested(id, x, y) => { root.scene-context-requested(id, x, y); }
                                    rename-edited(text) => { root.rename-edited(text); }
                                    rename-committed(text) => { root.rename-committed(text); }
                                }
                            }

                            if (selection-domain == "OBJECT" && (root.model-transform-open || root.hovered-inspector-section == "transform")): InspectorSection {
                                title: root.label-tab-transform;
                                section-id: "transform";
                                open: root.model-transform-open || root.hovered-inspector-section == "transform";
                                pin-open: root.section-states.length > 1 ? root.section-states[1].pin-open : false;
                                toggled => { root.section-open-toggled("transform"); }
                                toggle-all => { root.toggle-all-sections(); }
                                pin-toggled(id) => { root.section-pin-open-toggled(id); }

                                    TransformBody {
                                        field-hint: root.label-numeric-field-hint;
                                        pos-x: root.pos-x;
                                        pos-y: root.pos-y;
                                        pos-z: root.pos-z;
                                        rot-x: root.rot-x;
                                        rot-y: root.rot-y;
                                        rot-z: root.rot-z;
                                        scale-x: root.scale-x;
                                        scale-y: root.scale-y;
                                        scale-z: root.scale-z;
                                        scrubbed(kind, axis, delta, fine) => { root.transform-scrubbed(kind, axis, delta, fine); }
                                        scrub-started(kind) => { root.transform-scrub-started(kind); }
                                        scrub-finished => { root.transform-scrub-finished(); }
                                        text-committed(kind, axis, text) => { root.transform-text-committed(kind, axis, text) }
                                        scrub-cancelled => { root.transform-scrub-cancelled(); }
                                    }
                            }
                            if (root.model-material-open || root.hovered-inspector-section == "material"): InspectorSection {
                                title: root.label-tab-material;
                                section-id: "material";
                                open: root.model-material-open || root.hovered-inspector-section == "material";
                                pin-open: root.section-states.length > 2 ? root.section-states[2].pin-open : false;
                                toggled => { root.section-open-toggled("material"); }
                                toggle-all => { root.toggle-all-sections(); }
                                pin-toggled(id) => { root.section-pin-open-toggled(id); }

                                MaterialBody {
                                    active-name: root.active-material-name;
                                    active-slot <=> root.active-material-slot;
                                    slots: root.material-slots;
                                    profile: root.material-profile;
                                    base-color: root.material-base-color;
                                    palette: root.material-palette;
                                    roughness: root.material-roughness;
                                    metallic: root.material-metallic;
                                    emission-strength: root.material-emission-strength;
                                    advanced-open <=> root.material-advanced-open;
                                    normal-scale: root.material-normal-scale;
                                    alpha-mode: root.material-alpha-mode;
                                    alpha-cutoff: root.material-alpha-cutoff;
                                    has-albedo: root.material-has-albedo;
                                    albedo-text-label: root.material-albedo-label;
                                    assign-label: root.label-material-assign;
                                    new-label: root.label-material-new;
                                    duplicate-label: root.label-material-duplicate;
                                    remove-label: root.label-material-remove;
                                    profile-label: root.label-material-profile;
                                    profile-pbr-label: root.label-material-profile-pbr;
                                    profile-unlit-label: root.label-material-profile-unlit;
                                    profile-toon-label: root.label-material-profile-toon;
                                    profile-glass-label: root.label-material-profile-glass;
                                    profile-emissive-label: root.label-material-profile-emissive;
                                    base-color-label: root.label-material-base-color;
                                    roughness-label: root.label-material-roughness;
                                    metallic-label: root.label-material-metallic;
                                    emission-label: root.label-material-emission-strength;
                                    advanced-label: root.label-material-advanced;
                                    normal-scale-label: root.label-material-normal-scale;
                                    alpha-mode-label: root.label-material-alpha-mode;
                                    alpha-opaque-label: root.label-material-alpha-opaque;
                                    alpha-mask-label: root.label-material-alpha-mask;
                                    alpha-blend-label: root.label-material-alpha-blend;
                                    alpha-cutoff-label: root.label-material-alpha-cutoff;
                                    albedo-label: root.label-material-texture-albedo;
                                    create-texture-label: root.label-material-create-texture;
                                    clear-texture-label: root.label-material-clear-texture;
                                    no-texture-label: root.label-material-no-texture;
                                    assign-material-slot(slot) => { root.assign-material-slot(slot); }
                                    create-material => { root.create-material(); }
                                    duplicate-material(slot) => { root.duplicate-material(slot); }
                                    remove-material(slot) => { root.remove-material(slot); }
                                    material-slot-selected(index) => { root.material-slot-selected(index); }
                                    material-base-color-changed(r, g, b) => { root.material-base-color-changed(r, g, b); }
                                    material-scalar-committed(field, slot, text) => { root.material-scalar-committed(field, slot, text) }
                                    material-profile-changed(index) => { root.material-profile-changed(index); }
                                    material-alpha-mode-changed(index) => { root.material-alpha-mode-changed(index); }
                                    material-albedo-create => { root.material-albedo-create(); }
                                    material-albedo-clear => { root.material-albedo-clear(); }
                                }
                            }
                            if (root.model-object-open || root.hovered-inspector-section == "object"): InspectorSection {
                                title: root.label-tab-object;
                                section-id: "object";
                                open: root.model-object-open || root.hovered-inspector-section == "object";
                                pin-open: root.section-states.length > 3 ? root.section-states[3].pin-open : false;
                                toggled => { root.section-open-toggled("object"); }
                                toggle-all => { root.toggle-all-sections(); }
                                pin-toggled(id) => { root.section-pin-open-toggled(id); }
                                ObjectBody {
                                    has-selection: root.object-has-selection;
                                    object-name: root.object-name;
                                    object-id: root.object-id;
                                    object-visible: root.object-visible;
                                    object-locked: root.object-locked;
                                    object-verts: root.object-verts;
                                    object-faces: root.object-faces;
                                    object-tris: root.object-tris;
                                    no-selection-label: root.label-object-no-selection;
                                    verts-label: root.label-stats-verts;
                                    faces-label: root.label-stats-faces;
                                    tris-label: root.label-stats-tris;
                                    duplicate-label: root.label-duplicate;
                                    delete-label: root.label-delete;
                                    is-parametric: root.active-asset-is-parametric;
                                    primitive-kind: root.primitive-kind;
                                    primitive-radius: root.primitive-radius;
                                    primitive-radius-b: root.primitive-radius-b;
                                    primitive-height: root.primitive-height;
                                    primitive-depth: root.primitive-depth;
                                    primitive-width: root.primitive-width;
                                    primitive-sides: root.primitive-sides;
                                    primitive-rings: root.primitive-rings;
                                    primitive-subdiv: root.primitive-subdiv;
                                    primitive-cap-top: root.primitive-cap-top;
                                    primitive-cap-bottom: root.primitive-cap-bottom;
                                    primitive-fill-disc: root.primitive-fill-disc;
                                    label-parametric-primitive: root.label-parametric-primitive;
                                    label-freeze-primitive: root.label-freeze-primitive;
                                    label-freeze-primitive-hint: root.label-freeze-primitive-hint;
                                    scene-toggle-visibility(id) => { root.scene-toggle-visibility(id); }
                                    scene-toggle-lock(id) => { root.scene-toggle-lock(id); }
                                    duplicate-requested => { root.duplicate-requested(); }
                                    delete-requested => { root.delete-requested(); }
                                    primitive-param-float(param, val) => { root.primitive-param-float(param, val); }
                                    primitive-param-bool(param, val) => { root.primitive-param-bool(param, val); }
                                    freeze-primitive-requested => { root.freeze-primitive-requested(); }
                                }
                            }
                             if (root.model-modifiers-open || root.hovered-inspector-section == "modifiers"): InspectorSection {
                                title: root.label-tab-modifiers;
                                section-id: "modifiers";
                                open: root.model-modifiers-open || root.hovered-inspector-section == "modifiers";
                                pin-open: root.section-states.length > 4 ? root.section-states[4].pin-open : false;
                                toggled => { root.section-open-toggled("modifiers"); }
                                toggle-all => { root.toggle-all-sections(); }
                                pin-toggled(id) => { root.section-pin-open-toggled(id); }
                                 ModifiersBody {
                                     rows: root.modifier-rows;
                                     add-mirror-label: root.label-modifier-add-mirror;
                                     add-symmetry-label: root.label-modifier-add-symmetry;
                                     apply-label: root.label-modifier-apply;
                                     direction-label: root.label-modifier-direction;
                                     neg-to-pos-label: root.label-modifier-negative-to-positive;
                                     pos-to-neg-label: root.label-modifier-positive-to-negative;
                                     empty-label: root.label-modifiers-empty;
                                     modifier-add(kind) => { root.modifier-add(kind); }
                                     modifier-toggle(id, enabled) => { root.modifier-toggle(id, enabled); }
                                     modifier-remove(id) => { root.modifier-remove(id); }
                                     modifier-move(id, direction) => { root.modifier-move(id, direction); }
                                     modifier-apply(id) => { root.modifier-apply(id); }
                                     modifier-axis-changed(id, axis) => { root.modifier-axis-changed(id, axis); }
                                     modifier-direction-changed(id, direction) => { root.modifier-direction-changed(id, direction); }
                                 }
                             }
                             if (root.quick-actions-section-open || root.hovered-inspector-section == "quick_actions"): InspectorSection {
                                title: root.label-quick-actions;
                                section-id: "quick_actions";
                                open: root.quick-actions-section-open || root.hovered-inspector-section == "quick_actions";
                                pin-open: root.section-states.length > 5 ? root.section-states[5].pin-open : false;
                                toggled => { root.section-open-toggled("quick_actions"); }
                                toggle-all => { root.toggle-all-sections(); }
                                pin-toggled(id) => { root.section-pin-open-toggled(id); }
                                 QuickActionsBody {
                                     title-label: root.label-quick-actions;
                                     customize-open <=> root.quick-actions-open;
                                     actions: root.quick-actions;
                                     candidates: root.quick-action-candidates;
                                     customize-label: root.label-quick-action-customize;
                                     remove-label: root.label-quick-action-remove;
                                     add-label: root.label-quick-action-add;
                                     reset-label: root.label-quick-action-reset;
                                     done-label: root.label-quick-action-done;
                                     action-executed(id) => { root.quick-action-executed(id); }
                                     action-toggled(id) => { root.quick-action-toggled(id); }
                                     actions-reset => { root.quick-actions-reset(); }
                                 }
                             }

                             if root.scene-items.length > 1 || root.boolean-operand-name != "": InspectorSection {
                                title: "Combine";
                                open: true;
                                toggled => { self.open = !self.open; }
                                VerticalLayout {
                                    spacing: 6px;
                                    if root.boolean-operand-name != "": VerticalLayout {
                                        spacing: 6px;
                                        Text { text: "Operand: \{root.boolean-operand-name}"; color: DesignTokens.accent; font-size: 10px; font-weight: 700; }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            ToolButton { icon-svg: PetuniaIcons.boolean-fuse; semantic-label: "Fuse"; description: "Combine the active part with the operand"; clicked => { root.command-executed("model.fuse"); } }
                                            ToolButton { icon-svg: PetuniaIcons.boolean-cut; semantic-label: "Cut"; description: "Subtract the operand from the active part"; clicked => { root.command-executed("model.cut"); } }
                                            ToolButton { icon-svg: PetuniaIcons.boolean-intersect; semantic-label: "Intersect"; description: "Keep the overlapping volume"; clicked => { root.command-executed("model.intersect"); } }
                                            ToolButton { icon-svg: PetuniaIcons.boolean-join; semantic-label: "Join"; description: "Join the operand into the active part"; clicked => { root.join-requested(); } }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Rectangle {
                                                horizontal-stretch: 1; height: 26px;
                                                background: root.boolean-keep-parts ? DesignTokens.accent : DesignTokens.surface-raised;
                                                border-radius: 4px;
                                                accessible-role: checkbox;
                                                accessible-label: "Keep Parts";
                                                accessible-checked: root.boolean-keep-parts;
                                                Text { text: root.boolean-keep-parts ? "Keep Parts: on" : "Keep Parts: off"; color: root.boolean-keep-parts ? DesignTokens.canvas : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.boolean-keep-parts-set(!root.boolean-keep-parts); } }
                                            }
                                            Rectangle {
                                                width: 92px; height: 26px;
                                                background: DesignTokens.surface-raised;
                                                border-radius: 4px;
                                                accessible-role: button;
                                                accessible-label: "Clear operand";
                                                Text { text: "Clear"; color: DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.boolean-operand-cleared(); } }
                                            }
                                        }
                                    }
                                    if root.boolean-operand-name == "": VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "Select second part to Combine:"; color: DesignTokens.text-muted; font-size: 10px; }
                                        for item in root.scene-items: Rectangle {
                                            visible: !item.active;
                                            height: !item.active ? 24px : 0px;
                                            background: DesignTokens.surface-raised;
                                            border-radius: 4px;
                                            if !item.active: HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 4px;
                                                Text { text: item.name; color: DesignTokens.text-primary; font-size: 10px; vertical-alignment: center; horizontal-stretch: 1; }
                                                Text { text: "Choose"; color: DesignTokens.accent; font-size: 9px; vertical-alignment: center; }
                                            }
                                            if !item.active: TouchArea { clicked => { root.boolean-operand-set(item.id); } }
                                        }
                                    }
                                }
                            }
                        }

                        if active-workspace == "PAINT": VerticalLayout {
                            spacing: 10px;

                            InspectorSection {
                                title: "Effects";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    Text {
                                        text: "Add an effect layer";
                                        color: DesignTokens.text-secondary;
                                        font-size: 10px;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for effect in ["Pixelate", "Posterize", "Invert"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: effect;
                                            Text { text: effect; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            TouchArea { clicked => { root.paint-effect-layer-added(effect); } }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for effect in ["Grain", "BrightnessContrast", "HueSaturation"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: button;
                                            accessible-label: effect;
                                            Text { text: effect; color: DesignTokens.text-primary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            TouchArea { clicked => { root.paint-effect-layer-added(effect); } }
                                        }
                                    }

                                    if paint-effect-kind != "": Text {
                                        text: "Active effect: \{root.paint-effect-kind}";
                                        color: DesignTokens.accent;
                                        font-size: 10px;
                                        font-weight: 600;
                                    }
                                    if paint-effect-kind != "" && paint-effect-params.length == 0: Text {
                                        text: "This effect has no parameters.";
                                        color: DesignTokens.text-muted;
                                        font-size: 10px;
                                    }

                                    for param in root.paint-effect-params: HorizontalLayout {
                                        spacing: 6px;
                                        height: 24px;

                                        Text {
                                            text: param.label;
                                            color: DesignTokens.text-secondary;
                                            font-size: 10px;
                                            width: 78px;
                                            vertical-alignment: center;
                                        }
                                        Slider {
                                            horizontal-stretch: 1;
                                            minimum: param.minimum;
                                            maximum: param.maximum;
                                            value: param.value;
                                            changed(value) => { root.paint-effect-param-set(param.key, value); }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Canvas";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: root.paint-canvas-size;
                                            color: DesignTokens.text-muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            // Pixel Grid toggle button
                                            Rectangle {
                                                width: 42px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: root.paint-pixel-grid ? DesignTokens.accent : DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text {
                                                    text: "Grid";
                                                    color: root.paint-pixel-grid ? DesignTokens.canvas : DesignTokens.text-secondary;
                                                    font-size: 9px;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => { root.toggle-paint-pixel-grid(); }
                                                }
                                            }
                                            // Zoom In / Out
                                            Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text {
                                                    text: "-";
                                                    color: DesignTokens.text-primary;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => {
                                                        if root.paint-canvas-zoom > 1 {
                                                            root.set-paint-canvas-zoom(root.paint-canvas-zoom / 2);
                                                        }
                                                    }
                                                }
                                            }
                                            Text {
                                                text: root.paint-canvas-zoom + "x";
                                                color: DesignTokens.text-primary;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                border-radius: 3px;
                                                background: DesignTokens.surface-raised;
                                                border-width: 1px;
                                                border-color: DesignTokens.border;
                                                Text {
                                                    text: "+";
                                                    color: DesignTokens.text-primary;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => {
                                                        if root.paint-canvas-zoom < 16 {
                                                            root.set-paint-canvas-zoom(root.paint-canvas-zoom * 2);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Xadrez de transparência atrás do raster + pintura 2D interativa
                                    Rectangle {
                                        width: 256px;
                                        height: 256px;
                                        horizontal-stretch: 0;
                                        background: DesignTokens.canvas;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        clip: true;

                                        paint-canvas-raster := Image {
                                            width: parent.width * root.paint-canvas-zoom;
                                            height: parent.height * root.paint-canvas-zoom;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            image-fit: fill;
                                            image-rendering: pixelated;
                                            source: root.paint-canvas-image;
                                        }

                                        if root.paint-show-uv: Path {
                                            width: paint-canvas-raster.width;
                                            height: paint-canvas-raster.height;
                                            x: paint-canvas-raster.x;
                                            y: paint-canvas-raster.y;
                                            fill: transparent;
                                            stroke: #00ffff99;
                                            stroke-width: 1px;
                                            commands: root.uv-layout-commands;
                                        }

                                        if root.paint-pixel-grid && root.paint-canvas-grid-commands != "": Path {
                                            width: 100%;
                                            height: 100%;
                                            fill: transparent;
                                            stroke: DesignTokens.border.transparentize(0.35);
                                            stroke-width: 1px;
                                            commands: root.paint-canvas-grid-commands;
                                        }

                                        TouchArea {
                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.down) {
                                                    root.paint-2d-stroke((self.mouse-x - paint-canvas-raster.x) / paint-canvas-raster.width, (self.mouse-y - paint-canvas-raster.y) / paint-canvas-raster.height, 0);
                                                } else if (event.kind == PointerEventKind.up) {
                                                    root.paint-2d-stroke((self.mouse-x - paint-canvas-raster.x) / paint-canvas-raster.width, (self.mouse-y - paint-canvas-raster.y) / paint-canvas-raster.height, 2);
                                                }
                                            }
                                            moved => {
                                                if (self.pressed) {
                                                    root.paint-2d-stroke((self.mouse-x - paint-canvas-raster.x) / paint-canvas-raster.width, (self.mouse-y - paint-canvas-raster.y) / paint-canvas-raster.height, 1);
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 26px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-show-uv ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: root.paint-show-uv ? DesignTokens.accent : DesignTokens.border;
                                            Text {
                                                text: root.paint-show-uv ? "✓ UV Wireframe Overlay" : "UV Wireframe Overlay";
                                                color: root.paint-show-uv ? DesignTokens.accent : DesignTokens.text-primary;
                                                font-size: 10px;
                                                font-weight: root.paint-show-uv ? 700 : 400;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.toggle-paint-show-uv(); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Fill & Projection";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    Text {
                                        text: "Fill scope";
                                        color: DesignTokens.text-secondary;
                                        font-size: 10px;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for scope in ["ConnectedPixels", "Face", "SelectedFaces", "UvIsland", "Object"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-fill-scope == scope ? DesignTokens.accent : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: radio-button;
                                            accessible-label: scope;
                                            accessible-checked: root.paint-fill-scope == scope;
                                            Text {
                                                text: scope;
                                                color: root.paint-fill-scope == scope ? DesignTokens.canvas : DesignTokens.text-secondary;
                                                font-size: 9px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            TouchArea { clicked => { root.paint-fill-scope-set(scope); } }
                                        }
                                    }

                                    Text {
                                        text: "Projection";
                                        color: DesignTokens.text-secondary;
                                        font-size: 10px;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for projection in ["Surface", "ScreenSpace"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-projection == projection ? DesignTokens.accent : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: radio-button;
                                            accessible-label: projection;
                                            accessible-checked: root.paint-projection == projection;
                                            Text {
                                                text: projection;
                                                color: root.paint-projection == projection ? DesignTokens.canvas : DesignTokens.text-secondary;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.paint-projection-set(projection); } }
                                        }
                                    }

                                    // Ação: Bake Reference to Texture
                                    Rectangle {
                                        height: 26px;
                                        border-radius: 4px;
                                        background: DesignTokens.surface-raised;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            IconDisplay {
                                                icon: IconSet.Camera;
                                                size: 13px;
                                                stroke: DesignTokens.accent;
                                            }
                                            Text {
                                                text: "Bake Reference to Texture";
                                                color: DesignTokens.text-primary;
                                                font-size: 10px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.command-executed("paint.bake_reference"); }
                                        }
                                    }

                                    Text {
                                        text: "Brush lock";
                                        color: DesignTokens.text-secondary;
                                        font-size: 10px;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        for lock in ["None", "FirstObject", "FirstFace"]: Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.paint-lock == lock ? DesignTokens.accent : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            accessible-role: radio-button;
                                            accessible-label: lock;
                                            accessible-checked: root.paint-lock == lock;
                                            Text {
                                                text: lock;
                                                color: root.paint-lock == lock ? DesignTokens.canvas : DesignTokens.text-secondary;
                                                font-size: 9px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            TouchArea { clicked => { root.paint-lock-set(lock); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Layers";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 4px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 24px;

                                        Text {
                                            text: root.paint-layer-count;
                                            color: DesignTokens.text-muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 3px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            IconDisplay { icon: IconSet.Plus; size: 12px; stroke: DesignTokens.text-secondary; }
                                            accessible-role: button;
                                            accessible-label: "Add layer";
                                            TouchArea { clicked => { root.paint-layer-added(); } }
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 3px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            IconDisplay { icon: IconSet.FolderOpen; size: 12px; stroke: DesignTokens.text-secondary; }
                                            accessible-role: button;
                                            accessible-label: "Add group";
                                            TouchArea { clicked => { root.paint-layer-group-added(); } }
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 3px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            IconDisplay { icon: IconSet.Square; size: 12px; stroke: DesignTokens.text-secondary; }
                                            accessible-role: button;
                                            accessible-label: "Add decal layer";
                                            TouchArea { clicked => { root.paint-decal-layer-added(); } }
                                        }
                                    }

                                    for layer in root.paint-layers: Rectangle {
                                        height: 30px;
                                        border-radius: 4px;
                                        background: layer.active ? DesignTokens.surface-hover : transparent;
                                        border-width: layer.active ? 1px : 0px;
                                        border-color: DesignTokens.accent;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;

                                            TouchArea {
                                                horizontal-stretch: 1;
                                                clicked => { root.paint-layer-activated(layer.id); }

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: center;

                                                    IconDisplay {
                                                        icon: layer.is-group ? IconSet.FolderOpen : IconSet.Square;
                                                        size: 12px;
                                                        stroke: layer.active ? DesignTokens.accent : DesignTokens.text-muted;
                                                    }
                                                    Text {
                                                        text: layer.name;
                                                        color: layer.active ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                                        font-size: 11px;
                                                        font-weight: layer.active ? 600 : 400;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: layer.kind-label;
                                                        color: DesignTokens.text-muted;
                                                        font-size: 9px;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.ChevronUp; size: 11px; stroke: DesignTokens.text-muted; }
                                                accessible-role: button;
                                                accessible-label: "Move layer up";
                                                TouchArea { clicked => { root.paint-layer-moved(layer.id, 1); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.ChevronDown; size: 11px; stroke: DesignTokens.text-muted; }
                                                accessible-role: button;
                                                accessible-label: "Move layer down";
                                                TouchArea { clicked => { root.paint-layer-moved(layer.id, -1); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay {
                                                    icon: layer.visible ? IconSet.Eye : IconSet.EyeOff;
                                                    size: 12px;
                                                    stroke: layer.visible ? DesignTokens.text-secondary : DesignTokens.text-muted;
                                                }
                                                accessible-role: checkbox;
                                                accessible-label: "Layer visible";
                                                accessible-checked: layer.visible;
                                                TouchArea { clicked => { root.paint-layer-visibility-toggled(layer.id); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay {
                                                    icon: layer.locked ? IconSet.Lock : IconSet.LockOpen;
                                                    size: 12px;
                                                    stroke: layer.locked ? DesignTokens.accent : DesignTokens.text-muted;
                                                }
                                                accessible-role: checkbox;
                                                accessible-label: "Layer locked";
                                                accessible-checked: layer.locked;
                                                TouchArea { clicked => { root.paint-layer-lock-toggled(layer.id); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.Merge; size: 11px; stroke: DesignTokens.text-muted; }
                                                accessible-role: button;
                                                accessible-label: "Merge layer down";
                                                TouchArea { clicked => { root.paint-layer-merged-down(layer.id); } }
                                            }
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                IconDisplay { icon: IconSet.Trash2; size: 11px; stroke: DesignTokens.danger; }
                                                accessible-role: button;
                                                accessible-label: "Remove layer";
                                                TouchArea { clicked => { root.paint-layer-removed(layer.id); } }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 22px;

                                        Text {
                                            text: "Opacity";
                                            color: DesignTokens.text-secondary;
                                            font-size: 10px;
                                            width: 52px;
                                            vertical-alignment: center;
                                        }
                                        for layer in root.paint-layers: Rectangle {
                                            visible: layer.active;
                                            horizontal-stretch: 1;
                                            height: 22px;

                                            Slider {
                                                minimum: 0.0;
                                                maximum: 1.0;
                                                value: layer.opacity;
                                                changed(value) => { root.paint-layer-opacity-set(layer.id, value); }
                                            }
                                        }
                                    }

                                    if root.active-layer-is-decal: VerticalLayout {
                                        spacing: 6px;
                                        padding-top: 4px;

                                        Text {
                                            text: root.label-decal-transform;
                                            color: DesignTokens.text-primary;
                                            font-size: 11px;
                                            font-weight: 600;
                                        }

                                        if root.label-decal-hint != "": Text {
                                            text: root.label-decal-hint;
                                            color: DesignTokens.text-muted;
                                            font-size: 9px;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: root.label-decal-position;
                                                color: DesignTokens.text-secondary;
                                                font-size: 10px;
                                                width: 52px;
                                                vertical-alignment: center;
                                            }
                                            NumericField {
                                                label: "U";
                                                value: root.decal-center-u;
                                                step: 0.05;
                                                scrubbed(delta, _) => {
                                                    root.decal-center-u = Math.clamp(root.decal-center-u + delta * 0.01, 0.0, 1.0);
                                                    root.decal-transform-changed("", root.decal-center-u, root.decal-center-v, root.decal-scale-u, root.decal-scale-v, root.decal-rotation-deg);
                                                }
                                            }
                                            NumericField {
                                                label: "V";
                                                value: root.decal-center-v;
                                                step: 0.05;
                                                scrubbed(delta, _) => {
                                                    root.decal-center-v = Math.clamp(root.decal-center-v + delta * 0.01, 0.0, 1.0);
                                                    root.decal-transform-changed("", root.decal-center-u, root.decal-center-v, root.decal-scale-u, root.decal-scale-v, root.decal-rotation-deg);
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: root.label-decal-scale;
                                                color: DesignTokens.text-secondary;
                                                font-size: 10px;
                                                width: 52px;
                                                vertical-alignment: center;
                                            }
                                            NumericField {
                                                label: "U";
                                                value: root.decal-scale-u;
                                                step: 0.05;
                                                scrubbed(delta, _) => {
                                                    root.decal-scale-u = Math.max(0.01, root.decal-scale-u + delta * 0.01);
                                                    root.decal-transform-changed("", root.decal-center-u, root.decal-center-v, root.decal-scale-u, root.decal-scale-v, root.decal-rotation-deg);
                                                }
                                            }
                                            NumericField {
                                                label: "V";
                                                value: root.decal-scale-v;
                                                step: 0.05;
                                                scrubbed(delta, _) => {
                                                    root.decal-scale-v = Math.max(0.01, root.decal-scale-v + delta * 0.01);
                                                    root.decal-transform-changed("", root.decal-center-u, root.decal-center-v, root.decal-scale-u, root.decal-scale-v, root.decal-rotation-deg);
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: root.label-decal-rotation;
                                                color: DesignTokens.text-secondary;
                                                font-size: 10px;
                                                width: 52px;
                                                vertical-alignment: center;
                                            }
                                            NumericField {
                                                label: "Deg";
                                                value: root.decal-rotation-deg;
                                                step: 5.0;
                                                scrubbed(delta, _) => {
                                                    root.decal-rotation-deg = root.decal-rotation-deg + delta * 1.0;
                                                    root.decal-transform-changed("", root.decal-center-u, root.decal-center-v, root.decal-scale-u, root.decal-scale-v, root.decal-rotation-deg);
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 26px;
                                            border-radius: 4px;
                                            background: bake-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                IconDisplay { icon: IconSet.Check; size: 12px; stroke: DesignTokens.accent; }
                                                Text {
                                                    text: root.label-decal-bake;
                                                    color: DesignTokens.text-primary;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            bake-touch := TouchArea {
                                                clicked => { root.bake-active-decal(); }
                                            }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Color Palette";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 6px;
                                            background: root.paint-color;
                                            border-width: 2px;
                                            border-color: DesignTokens.accent;
                                        }

                                        Text {
                                            text: root.label-active-brush-color;
                                            color: DesignTokens.text-primary;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        ColorSwatch {
                                            swatch-color: #b58cff;
                                            selected: root.paint-color == #b58cff;
                                            clicked => { root.paint-color-changed(0.71, 0.55, 1.0); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #ef4444;
                                            selected: root.paint-color == #ef4444;
                                            clicked => { root.paint-color-changed(0.93, 0.27, 0.27); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #22c55e;
                                            selected: root.paint-color == #22c55e;
                                            clicked => { root.paint-color-changed(0.13, 0.77, 0.37); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #3b82f6;
                                            selected: root.paint-color == #3b82f6;
                                            clicked => { root.paint-color-changed(0.23, 0.51, 0.96); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #eab308;
                                            selected: root.paint-color == #eab308;
                                            clicked => { root.paint-color-changed(0.92, 0.70, 0.03); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #ffffff;
                                            selected: root.paint-color == #ffffff;
                                            clicked => { root.paint-color-changed(1.0, 1.0, 1.0); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #6b7280;
                                            selected: root.paint-color == #6b7280;
                                            clicked => { root.paint-color-changed(0.42, 0.45, 0.50); }
                                        }
                                        ColorSwatch {
                                            swatch-color: #111111;
                                            selected: root.paint-color == #111111;
                                            clicked => { root.paint-color-changed(0.07, 0.07, 0.07); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        padding-top: 4px;
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                IconDisplay { icon: IconSet.Download; size: 12px; stroke: DesignTokens.text-primary; }
                                                Text { text: "Import"; color: DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.command-file-action("palette.import"); } }
                                        }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                IconDisplay { icon: IconSet.Upload; size: 12px; stroke: DesignTokens.text-primary; }
                                                Text { text: "Export"; color: DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.command-file-action("palette.export"); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Brush Settings";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Size: \{Math.round(root.brush-size * 10) / 10}";
                                            color: DesignTokens.text-secondary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-size-changed(Math.max(0.1, root.brush-size - 0.2)); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-size-changed(Math.min(10.0, root.brush-size + 0.2)); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Opacity: \{Math.round(root.brush-opacity * 100)}%";
                                            color: DesignTokens.text-secondary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-opacity-changed(Math.max(0.05, root.brush-opacity - 0.1)); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-opacity-changed(Math.min(1.0, root.brush-opacity + 0.1)); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Hardness: \{Math.round(root.brush-hardness * 100)}%";
                                            color: DesignTokens.text-secondary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "-"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-hardness-changed(Math.max(0.0, root.brush-hardness - 0.1)); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            Text { text: "+"; color: DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.brush-hardness-changed(Math.min(1.0, root.brush-hardness + 0.1)); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Symmetry:";
                                            color: DesignTokens.text-secondary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.paint-symmetry-x ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: "X"; color: root.paint-symmetry-x ? #ffffff : DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-symmetry-x-toggled(); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.paint-symmetry-y ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: "Y"; color: root.paint-symmetry-y ? #ffffff : DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-symmetry-y-toggled(); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.paint-symmetry-z ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: "Z"; color: root.paint-symmetry-z ? #ffffff : DesignTokens.text-primary; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-symmetry-z-toggled(); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Target:";
                                            color: DesignTokens.text-secondary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 64px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: !root.paint-target-vertex ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: "Texture"; color: !root.paint-target-vertex ? #ffffff : DesignTokens.text-primary; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-target-vertex-changed(false); } }
                                        }
                                        Rectangle { width: 4px; }
                                        Rectangle {
                                            width: 58px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.paint-target-vertex ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: "Vertex"; color: root.paint-target-vertex ? #ffffff : DesignTokens.text-primary; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-target-vertex-changed(true); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Mask Selection:";
                                            color: DesignTokens.text-secondary;
                                            font-size: 11px;
                                            horizontal-stretch: 1;
                                        }
                                        Rectangle {
                                            width: 44px;
                                            height: 24px;
                                            border-radius: 4px;
                                            background: root.paint-mask-selection ? DesignTokens.accent : DesignTokens.surface-raised;
                                            Text { text: root.paint-mask-selection ? "ON" : "OFF"; color: root.paint-mask-selection ? #ffffff : DesignTokens.text-secondary; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.paint-mask-selection-toggled(); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "Texture Layers";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        height: 28px;
                                        background: DesignTokens.surface-raised;
                                        border-radius: 4px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            alignment: center;
                                            IconDisplay { icon: IconSet.Layers3; size: 14px; stroke: DesignTokens.accent; }
                                            Text { text: root.label-albedo-base-color; color: DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: "Active"; color: DesignTokens.success; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        if active-workspace == "UV": VerticalLayout {
                            spacing: 10px;

                            InspectorSection {
                                title: "UV Operations";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 4px;

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 5px;
                                        background: DesignTokens.accent;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            IconDisplay { icon: IconSet.Maximize2; size: 14px; stroke: DesignTokens.canvas; }
                                            Text { text: root.label-unwrap-mesh; color: DesignTokens.canvas; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.command-executed("uv.unwrap"); } }
                                    }

                                    Rectangle {
                                        height: 32px;
                                        border-radius: 5px;
                                        background: DesignTokens.surface-raised;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            IconDisplay { icon: IconSet.Grid2x2; size: 14px; stroke: DesignTokens.text-primary; }
                                            Text { text: root.label-pack-islands; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.command-executed("uv.pack_islands"); } }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "UV Editor";
                                open: true;
                                toggled => { self.open = !self.open; }

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 4px;

                                    // Caixa 0..1 com o layout real das UVs.
                                    uv-box := Rectangle {
                                        width: 256px;
                                        height: 256px;
                                        horizontal-stretch: 0;
                                        background: DesignTokens.canvas;
                                        border-width: 1px;
                                        border-color: DesignTokens.border;
                                        clip: true;

                                        // Textura ativa sob a malha UV
                                        if root.uv-show-texture: Image {
                                            width: 100%;
                                            height: 100%;
                                            image-fit: fill;
                                            source: root.paint-canvas-image;
                                            opacity: 0.65;
                                        }

                                        // Selected UV faces / Faces UV selecionadas
                                        Path {
                                            fill: #ffaa0033;
                                            stroke: #ffaa00;
                                            stroke-width: 1.5px;
                                            commands: root.uv-selected-commands;
                                        }

                                        // Base UV mesh wireframe / Malha de arame UV base
                                        Path {
                                            fill: transparent;
                                            stroke: DesignTokens.accent.with-alpha(0.65);
                                            stroke-width: 1px;
                                            commands: root.uv-layout-commands;
                                        }

                                        // Seam edges / Arestas de costura
                                        Path {
                                            fill: transparent;
                                            stroke: #ff4433;
                                            stroke-width: 2px;
                                            commands: root.uv-seam-commands;
                                        }

                                        // Pinned UV vertices / Vértices UV fixados
                                        Path {
                                            fill: #ff3344;
                                            stroke: #ffffff;
                                            stroke-width: 1px;
                                            commands: root.uv-pinned-commands;
                                        }

                                        TouchArea {
                                            property <bool> extend: false;
                                            property <bool> dragging: false;
                                            property <float> last-u: 0.0;
                                            property <float> last-v: 0.0;
                                            pointer-event(event) => {
                                                extend = event.modifiers.shift;
                                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                    dragging = true;
                                                    last-u = self.mouse-x / self.width;
                                                    last-v = 1.0 - self.mouse-y / self.height;
                                                    // O domínio usa UV com origem embaixo; a caixa desenha
                                                    // com origem em cima, então o V é invertido aqui.
                                                    root.uv-editor-clicked(
                                                        last-u,
                                                        last-v,
                                                        extend,
                                                    );
                                                } else if event.kind == PointerEventKind.up {
                                                    dragging = false;
                                                }
                                            }
                                            moved => {
                                                if self.pressed && dragging {
                                                    let cur-u = self.mouse-x / self.width;
                                                    let cur-v = 1.0 - self.mouse-y / self.height;
                                                    let du = cur-u - last-u;
                                                    let dv = cur-v - last-v;
                                                    if Math.abs(du) > 0.002 || Math.abs(dv) > 0.002 {
                                                        root.uv-moved(du, dv);
                                                        last-u = cur-u;
                                                        last-v = cur-v;
                                                    }
                                                }
                                            }
                                        }

                                        // Contorno do espaço 0..1.
                                        Rectangle { x: 0; y: 0; width: 100%; height: 1px; background: DesignTokens.border; }
                                        Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: DesignTokens.border; }
                                        Rectangle { x: 0; y: 0; width: 1px; height: 100%; background: DesignTokens.border; }
                                        Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: 100%; background: DesignTokens.border; }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 26px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: root.uv-show-texture ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: root.uv-show-texture ? DesignTokens.accent : DesignTokens.border;
                                            Text {
                                                text: root.uv-show-texture ? "✓ Show Texture" : "Show Texture";
                                                color: root.uv-show-texture ? DesignTokens.accent : DesignTokens.text-primary;
                                                font-size: 10px;
                                                font-weight: root.uv-show-texture ? 700 : 400;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.toggle-uv-show-texture(); } }
                                        }
                                    }

                                    Text {
                                        text: "\{root.uv-island-count} island(s)  ·  \{root.uv-face-count} face(s)  ·  selected: \{root.uv-selected-face}  ·  UV set: \{root.uv-selected-count}";
                                        color: DesignTokens.text-secondary;
                                        font-size: 10px;
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "← U"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Move UV left";
                                            TouchArea { clicked => { root.uv-moved(-0.05, 0.0); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "U →"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Move UV right";
                                            TouchArea { clicked => { root.uv-moved(0.05, 0.0); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "↓ V"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Move UV down";
                                            TouchArea { clicked => { root.uv-moved(0.0, -0.05); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "V ↑"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Move UV up";
                                            TouchArea { clicked => { root.uv-moved(0.0, 0.05); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 26px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Scale −"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Scale UV down";
                                            TouchArea { clicked => { root.uv-scaled(0.9); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Scale +"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Scale UV up";
                                            TouchArea { clicked => { root.uv-scaled(1.1); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Rotate −"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Rotate UV counter-clockwise";
                                            TouchArea { clicked => { root.uv-rotated(-15.0); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Rotate +"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Rotate UV clockwise";
                                            TouchArea { clicked => { root.uv-rotated(15.0); } }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 28px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "↺ 90° CCW"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Rotate UV 90 degrees counter-clockwise";
                                            TouchArea { clicked => { root.uv-rotated(-90.0); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "↻ 90° CW"; color: DesignTokens.text-primary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Rotate UV 90 degrees clockwise";
                                            TouchArea { clicked => { root.uv-rotated(90.0); } }
                                        }
                                    }
                                    if root.uv-layout-truncated: Text {
                                        text: "Layout truncated: only the first 2000 faces are drawn.";
                                        color: DesignTokens.text-muted;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 28px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Mark/Unmark Seams"; color: DesignTokens.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Toggle seams on the selected face";
                                            TouchArea { clicked => { root.uv-seam-toggled(); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Clear Seams"; color: DesignTokens.danger; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Clear all seams";
                                            TouchArea { clicked => { root.uv-seams-cleared(); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        height: 28px;
                                        spacing: 6px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Pin/Unpin (P)"; color: DesignTokens.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Pin or unpin UV vertices of the selected faces";
                                            TouchArea { clicked => { root.toggle-uv-pins(); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Clear Pins"; color: DesignTokens.danger; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Clear all UV pins";
                                            TouchArea { clicked => { root.clear-all-uv-pins(); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        height: 28px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Equalize Texel Density"; color: DesignTokens.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Equalize texel density across UV islands";
                                            TouchArea { clicked => { root.uv-equalize-texel-density(); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        height: 28px;
                                        spacing: 6px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Stitch Seams"; color: DesignTokens.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Weld coincident 3D edges that have split UV seams";
                                            TouchArea { clicked => { root.command-executed("uv.stitch"); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: DesignTokens.surface-raised;
                                            border-width: 1px;
                                            border-color: DesignTokens.border;
                                            Text { text: "Relax UV"; color: DesignTokens.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                            accessible-role: button;
                                            accessible-label: "Smooth unpinned UV island corners to minimize distortion";
                                            TouchArea { clicked => { root.command-executed("uv.relax"); } }
                                        }
                                    }
                                }
                            }

                            InspectorSection {
                                title: "UV Statistics";
                                open: true;
                                toggled => { self.open = !self.open; }

                                Text {
                                    text: root.uv-stats;
                                    color: DesignTokens.text-secondary;
                                    font-size: 11px;
                                }
                            }
                        }

                        }
                    }
                    }
}

                if inspector-visible && !compact-shell: Rectangle {
                    width: 56px;
                    height: 100%;
                    background: DesignTokens.surface-raised.with-alpha(0.9);
                    border-width: 1px;
                    border-color: DesignTokens.border;
                    border-radius: 8px;

                    rail-touch := TouchArea {
                        changed has-hover => {
                            root.rail-hovered = self.has-hover;
                            if !self.has-hover && !root.flyout-hovered {
                                root.hovered-inspector-section = "";
                            }
                        }
                    }

                    VerticalLayout {
                        padding: 10px;
                        spacing: 10px;
                        alignment: start;

                        InspectorPill {
                            focus-token: root.f6-rail-token;
                            section-id: "parts";
                            icon: IconSet.Layers3;
                            icon-svg: PetuniaIcons.parts;
                            semantic-label: root.label-tab-parts;
                            description: "Manage scene parts, groups and hierarchy";
                            active: root.model-parts-open;
                            clicked => { root.section-pill-clicked("parts"); }
                            hovered(id) => { root.hovered-inspector-section = id; }
                        }
                        InspectorPill {
                            section-id: "transform";
                            icon: IconSet.Move3d;
                            icon-svg: PetuniaIcons.transform;
                            semantic-label: root.label-tab-transform;
                            description: "Position, rotation and scale coordinates";
                            active: root.model-transform-open;
                            clicked => { root.section-pill-clicked("transform"); }
                            hovered(id) => { root.hovered-inspector-section = id; }
                        }
                        InspectorPill {
                            section-id: "material";
                            icon: IconSet.Paintbrush;
                            icon-svg: PetuniaIcons.material;
                            semantic-label: root.label-tab-material;
                            description: "Surface shaders, colors and textures";
                            active: root.model-material-open;
                            clicked => { root.section-pill-clicked("material"); }
                            hovered(id) => { root.hovered-inspector-section = id; }
                        }
                        InspectorPill {
                            section-id: "object";
                            icon: IconSet.Box;
                            icon-svg: PetuniaIcons.object-mesh;
                            semantic-label: root.label-tab-object;
                            description: "Object metadata, visibility and display options";
                            active: root.model-object-open;
                            clicked => { root.section-pill-clicked("object"); }
                            hovered(id) => { root.hovered-inspector-section = id; }
                        }
                        InspectorPill {
                            section-id: "modifiers";
                            icon: IconSet.Settings;
                            icon-svg: PetuniaIcons.modifier;
                            semantic-label: root.label-tab-modifiers;
                            description: "Generative and deformer modifier stack";
                            active: root.model-modifiers-open;
                            clicked => { root.section-pill-clicked("modifiers"); }
                            hovered(id) => { root.hovered-inspector-section = id; }
                        }
                        InspectorPill {
                            section-id: "quick_actions";
                            icon: IconSet.Zap;
                            icon-svg: PetuniaIcons.tool-profile;
                            semantic-label: root.label-quick-actions;
                            description: "Quick actions and modeling tools";
                            active: root.quick-actions-section-open;
                            clicked => { root.section-pill-clicked("quick_actions"); }
                            hovered(id) => { root.hovered-inspector-section = id; }
                        }
                    }
                }
            }

            Rectangle {
                height: 30px;
                background: DesignTokens.surface;
                border-width: 1px;
                border-color: DesignTokens.border;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: center;

                    // Status indicator dot
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: DesignTokens.success;
                    }

                    Text { text: root.status-message; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; max-width: 340px; }
                    Text { text: root.context-hint != "" ? root.context-hint : root.label-status-hint; color: DesignTokens.text-muted; font-size: 11px; vertical-alignment: center; overflow: elide; max-width: 320px; }

                    if root.precision-mode: Rectangle {
                        border-radius: 3px;
                        background: #3e63dd33;
                        border-width: 1px;
                        border-color: #3e63dd;
                        HorizontalLayout {
                            padding-left: 5px; padding-right: 5px;
                            Text { text: "Shift: Precision 0.1×"; color: #3e63dd; font-size: 10px; font-weight: 700; font-family: "monospace"; }
                        }
                    }
                    if root.snap-mode: Rectangle {
                        border-radius: 3px;
                        background: #46a75833;
                        border-width: 1px;
                        border-color: #46a758;
                        HorizontalLayout {
                            padding-left: 5px; padding-right: 5px;
                            Text { text: "Ctrl: Snap"; color: #46a758; font-size: 10px; font-weight: 700; font-family: "monospace"; }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if (root.hover-label != "" || root.selection-summary != ""): Text {
                        text: root.hover-label != "" ? root.hover-label : root.selection-summary;
                        color: root.hover-label != "" ? DesignTokens.hover : DesignTokens.text-primary;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    if (root.hover-label != "" || root.selection-summary != ""): Rectangle {
                        width: 1px;
                        height: 14px;
                        background: DesignTokens.border;
                    }

                    Text { text: root.scene-stats; color: DesignTokens.text-secondary; font-size: 11px; font-weight: 500; vertical-alignment: center; }

                    Rectangle { width: 1px; height: 14px; background: DesignTokens.border; }

                    Text {
                        text: saved ? "Saved" : "Unsaved";
                        color: saved ? DesignTokens.success : DesignTokens.warning;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Overlay: Scene Drawer
        if scene-drawer-visible && compact-shell: Rectangle {
            x: parent.width - self.width - 8px;
            y: 42px;
            width: 250px;
            height: parent.height - 72px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            border-radius: 6px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: root.label-parts;
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TopAction {
                        icon: IconSet.Pin;
                        semantic-label: scene-drawer-pinned ? "Unpin Parts" : "Pin Parts";
                        clicked => {
                            root.scene-drawer-pinned = !root.scene-drawer-pinned;
                            root.scene-pin-requested(root.scene-drawer-pinned);
                        }
                    }
                    TopAction {
                        icon: IconSet.X;
                        semantic-label: "Close scene drawer";
                        clicked => { root.scene-requested(); }
                    }
                }

                Rectangle { height: 1px; background: DesignTokens.border; }

                PartsFilterRow {
                    horizontal-stretch: 1;
                    search-label: root.label-search-parts;
                    search-id: "compact-parts-search";
                    selected-only-label: root.label-selected-parts-only;
                    sort-label: root.label-sort-parts;
                    query <=> root.parts-query;
                    selected-only <=> root.parts-selected-only;
                    sort-by-name <=> root.parts-sort-by-name;
                    visible-count: root.parts-items.length;
                    total-count: root.scene-items.length;
                    query-changed(query) => { root.parts-query-changed(query); }
                    selected-only-changed(enabled) => { root.parts-selected-only-changed(enabled); }
                    sort-changed(enabled) => { root.parts-sort-changed(enabled); }
                }
                PartsRowSizeControl {
                    horizontal-stretch: 1;
                    semantic-label: root.label-parts-row-size;
                    accessibility-id: "compact-parts-row-height";
                    value <=> root.parts-row-height;
                    value-changed(value) => { root.parts-row-height-changed(value); }
                }

                ScrollView {
                    accessible-role: list;
                    accessible-label: root.label-parts;
                    accessible-item-count: root.parts-items.length;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        for item in root.parts-items: Rectangle {
                            height: root.parts-row-height * 1px;
                            accessible-role: list-item;
                            accessible-label: item.name;
                            accessible-item-selectable: true;
                            accessible-item-selected: item.selected;
                            border-radius: 4px;
                            background: item.selected ? DesignTokens.surface-hover : transparent;
                            border-width: item.selected ? 1px : 0px;
                            // Ativo (amarelo) ≠ selecionado (laranja): a
                            // referência das operações sempre identificável.
                            border-color: item.active ? DesignTokens.selection-active : DesignTokens.selection;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: center;

                                TouchArea {
                                    property <bool> extend: false;
                                    pointer-event(event) => {
                                        self.extend = event.modifiers.shift;
                                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                            root.scene-context-requested(
                                                item.id,
                                                (self.absolute-position.x + self.mouse-x) / 1px,
                                                (self.absolute-position.y + self.mouse-y) / 1px,
                                            );
                                        }
                                    }
                                    clicked => { root.scene-select(item.id, self.extend); }
                                    horizontal-stretch: 1;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;

                                        IconDisplay {
                                            icon: IconSet.Box;
                                            size: 12px;
                                            stroke: item.selected ? DesignTokens.accent : DesignTokens.text-muted;
                                        }

                                        if root.rename-active && item.selected: TextInput {
                                            text: root.rename-value;
                                            horizontal-stretch: 1;
                                            font-size: 12px;
                                            color: DesignTokens.text-primary;
                                            single-line: true;
                                            init => { self.focus(); }
                                            edited => { root.rename-edited(self.text); }
                                            accepted => { root.rename-committed(self.text); }
                                        }

                                        if !(root.rename-active && item.selected): Text {
                                            text: item.name;
                                            color: item.selected ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                            font-size: 12px;
                                            font-weight: item.selected ? 600 : 400;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: "\{item.verts}v · \{item.tris}t";
                                            color: DesignTokens.text-muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    IconDisplay {
                                        icon: item.visible ? IconSet.Eye : IconSet.EyeOff;
                                        size: 13px;
                                        stroke: item.visible ? DesignTokens.text-secondary : DesignTokens.text-muted;
                                    }
                                    TouchArea {
                                        clicked => { root.scene-toggle-visibility(item.id); }
                                    }
                                }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    IconDisplay {
                                        icon: item.locked ? IconSet.Lock : IconSet.LockOpen;
                                        size: 13px;
                                        stroke: item.locked ? DesignTokens.accent : DesignTokens.text-muted;
                                    }
                                    TouchArea {
                                        clicked => { root.scene-toggle-lock(item.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }


        // Overlay: recuperação de autosave (P3D-002 §Recuperação segura).
        if recovery-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            Rectangle {
                width: 460px;
                height: recovery-layout.preferred-height;
                x: (parent.width - self.width) / 2;
                y: 96px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;

                recovery-layout := VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    Text {
                        text: root.recovery-title;
                        color: DesignTokens.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.recovery-body;
                        color: DesignTokens.text-secondary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.recovery-detail;
                        color: DesignTokens.text-muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        height: 30px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            Text { text: root.recovery-discard; color: DesignTokens.danger; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.recovery-discard-requested(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: DesignTokens.surface;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            Text { text: root.recovery-keep; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.recovery-keep-requested(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: DesignTokens.accent;
                            Text { text: root.recovery-recover; color: DesignTokens.canvas; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.recovery-recover-requested(); } }
                        }
                    }
                }
            }
        }

        // Overlay: dropdown de um menu da barra superior.
        if root.menu-open != "": Rectangle {
            x: 0;
            y: 42px;
            width: parent.width;
            height: parent.height - 42px;

            TouchArea {
                clicked => { root.click-away-requested(); }
            }

            MenuDropdown {
                x: min(max(8px, root.menu-anchor-x), max(8px, parent.width - self.width - 8px));
                y: 2px;
                entries: root.menu-open == "file"
                    ? root.menu-file-items
                    : (root.menu-open == "edit"
                        ? root.menu-edit-items
                        : (root.menu-open == "view" ? root.menu-view-items : root.menu-window-items));
                invoked(id) => { root.menu-item-invoked(id); }
            }
        }


        // Popover de shading: só opções com backend real.
        if shading-popover-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            TouchArea {
                clicked => { root.shading-popover-toggled(false); }
            }

            Rectangle {
                x: min(max(8px, (parent.width - self.width) / 2), parent.width - self.width - 8px);
                y: 54px;
                width: 280px;
                height: shading-options.preferred-height + 24px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                drop-shadow-blur: 14px;
                drop-shadow-color: #00000090;
                drop-shadow-offset-y: 4px;

                // O scrim só fecha ao clicar fora. Capturar o fundo do painel
                // evita que o clique no slider atravesse para a viewport.
                TouchArea { clicked => {} }

                shading-options := VerticalLayout {
                    width: parent.width;
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Shading";
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Mode: \{root.shading-mode}";
                        color: DesignTokens.text-muted;
                        font-size: 10px;
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Text {
                        text: "X-Ray";
                        color: DesignTokens.text-primary;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 24px;
                        alignment: center;
                        Text {
                            text: "Opacity";
                            color: DesignTokens.text-secondary;
                            font-size: 10px;
                            width: 56px;
                            vertical-alignment: center;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            min-width: 110px;
                            minimum: 0.1;
                            maximum: 0.9;
                            value <=> root.xray-opacity;
                            accessible-label: root.label-xray-opacity;
                            changed(value) => { root.xray-opacity-set(value); }
                        }
                        Text {
                            text: "\{round(root.xray-opacity * 100)}%";
                            color: DesignTokens.text-muted;
                            font-size: 10px;
                            width: 36px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.show-xray ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: "X-Ray enabled";
                        accessible-checked: root.show-xray;
                        Text {
                            text: root.show-xray ? "X-Ray on" : "X-Ray off";
                            color: root.show-xray ? DesignTokens.canvas : DesignTokens.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.toggle-xray-requested(); } }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.is-wireframe ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: root.label-wire-overlay;
                        accessible-checked: root.is-wireframe;
                        Text {
                            text: root.label-wire-overlay;
                            color: root.is-wireframe ? DesignTokens.canvas : DesignTokens.text-primary;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.toggle-wireframe-requested(); }
                            Tooltip {
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 2px;
                                    Text { text: root.label-wire-overlay; color: DesignTokens.text-primary; font-size: 11px; font-weight: 700; }
                                    Text { text: root.label-wire-overlay-hint; color: DesignTokens.text-secondary; font-size: 10px; }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.show-face-orientation ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: "Face Orientation";
                        accessible-checked: root.show-face-orientation;
                        Text {
                            text: root.show-face-orientation ? "Face Orientation: Front (Blue) / Back (Red)" : "Face Orientation: Off";
                            color: root.show-face-orientation ? DesignTokens.canvas : DesignTokens.text-primary;
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.toggle-face-orientation(); } }
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.show-uv-checker ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: checkbox;
                        accessible-label: "UV Checkerboard";
                        accessible-checked: root.show-uv-checker;
                        Text {
                            text: root.show-uv-checker ? "UV Checkerboard: On" : "UV Checkerboard: Off";
                            color: root.show-uv-checker ? DesignTokens.canvas : DesignTokens.text-primary;
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.toggle-uv-checker(); } }
                    }
                }
            }
        }

        // Overlay: menu de contexto do Outliner (botão direito numa linha).
        if context-menu-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.context-menu-open = false;
                        root.click-away-requested();
                    }
                }
                clicked => {
                    root.context-menu-open = false;
                    root.click-away-requested();
                }
            }

            context-menu-panel := Rectangle {
                x: min(root.context-menu-x, max(0px, parent.width - self.width - 8px));
                y: min(root.context-menu-y, max(0px, parent.height - self.height - 8px));
                width: 220px;
                height: context-menu-layout.preferred-height;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                border-radius: 6px;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000080;
                drop-shadow-offset-y: 4px;

                context-menu-layout := VerticalLayout {
                    padding: 4px;
                    spacing: 1px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            text: root.context-menu-title;
                            color: DesignTokens.text-muted;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: "Rename";
                        shortcut: "F2";
                        clicked => { root.context-menu-open = false; root.context-menu-action("rename"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: "Duplicate";
                        shortcut: "Shift+D";
                        clicked => { root.context-menu-open = false; root.context-menu-action("duplicate"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: root.context-menu-visible ? "Hide" : "Show";
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("visibility"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: root.context-menu-locked ? "Unlock" : "Lock";
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("lock"); }
                    }
                    if root.context-menu-mode != "viewport": ContextMenuItem {
                        label: root.context-menu-isolated ? "Un-isolate" : "Isolate";
                        shortcut: "Numpad /";
                        clicked => { root.context-menu-open = false; root.context-menu-action("isolate"); }
                    }
                    if root.context-menu-mode != "viewport" && root.context-menu-can-move-up: ContextMenuItem {
                        label: "Move Up";
                        shortcut: "Alt+Up";
                        clicked => { root.context-menu-open = false; root.context-menu-action("move_up"); }
                    }
                    if root.context-menu-mode != "viewport" && root.context-menu-can-move-down: ContextMenuItem {
                        label: "Move Down";
                        shortcut: "Alt+Down";
                        clicked => { root.context-menu-open = false; root.context-menu-action("move_down"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: "Select All";
                        shortcut: "A";
                        clicked => { root.context-menu-open = false; root.context-menu-action("select_all"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: "Clear Selection";
                        shortcut: "Alt+A";
                        clicked => { root.context-menu-open = false; root.context-menu-action("clear_selection"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: "Invert Selection";
                        shortcut: "Ctrl+I";
                        clicked => { root.context-menu-open = false; root.context-menu-action("invert_selection"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                        label: "Extrude";
                        shortcut: "E";
                        clicked => { root.context-menu-open = false; root.context-menu-action("extrude"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain == "FACE": ContextMenuItem {
                        label: "Inset";
                        shortcut: "I";
                        clicked => { root.context-menu-open = false; root.context-menu-action("inset"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                        label: "Bevel";
                        shortcut: "Ctrl+B";
                        clicked => { root.context-menu-open = false; root.context-menu-action("bevel"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: "Subdivide";
                        shortcut: "Alt+W";
                        clicked => { root.context-menu-open = false; root.context-menu-action("subdivide"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain == "EDGE": ContextMenuItem {
                        label: "Loop Cut";
                        shortcut: "Ctrl+R";
                        clicked => { root.context-menu-open = false; root.context-menu-action("loop_cut"); }
                    }
                    if root.context-menu-mode == "viewport" && (root.selection-domain == "VERTEX" || root.selection-domain == "EDGE"): ContextMenuItem {
                        label: "Connect";
                        shortcut: "J";
                        clicked => { root.context-menu-open = false; root.context-menu-action("connect"); }
                    }
                    if root.context-menu-mode == "viewport" && (root.selection-domain == "VERTEX" || root.selection-domain == "EDGE"): ContextMenuItem {
                        label: "Make Face / Edge";
                        shortcut: "F";
                        clicked => { root.context-menu-open = false; root.context-menu-action("make_face"); }
                    }
                    if root.context-menu-mode == "viewport" && (root.selection-domain == "VERTEX" || root.selection-domain == "EDGE"): ContextMenuItem {
                        label: "Merge";
                        shortcut: "M";
                        clicked => { root.context-menu-open = false; root.context-menu-action("merge"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                        label: "Dissolve";
                        shortcut: "Ctrl+X";
                        clicked => { root.context-menu-open = false; root.context-menu-action("dissolve"); }
                    }
                    if root.context-menu-mode == "viewport": ContextMenuItem {
                        label: "Slice";
                        shortcut: "Shift+K";
                        clicked => { root.context-menu-open = false; root.context-menu-action("slice"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain == "EDGE": ContextMenuItem {
                        label: "Mark / Clear Seam";
                        shortcut: "U";
                        clicked => { root.context-menu-open = false; root.context-menu-action("mark_seam"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain == "FACE": ContextMenuItem {
                        label: "Flip Normals";
                        shortcut: "Alt+N";
                        clicked => { root.context-menu-open = false; root.context-menu-action("flip_normals"); }
                    }
                    if root.context-menu-mode == "viewport" && (root.selection-domain == "OBJECT" || root.selection-domain == "FACE"): ContextMenuItem {
                        label: "Shade Smooth";
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("shade_smooth"); }
                    }
                    if root.context-menu-mode == "viewport" && (root.selection-domain == "OBJECT" || root.selection-domain == "FACE"): ContextMenuItem {
                        label: "Shade Flat";
                        shortcut: "";
                        clicked => { root.context-menu-open = false; root.context-menu-action("shade_flat"); }
                    }
                    if root.context-menu-mode == "viewport" && root.selection-domain == "OBJECT": ContextMenuItem {
                        label: "Duplicate";
                        shortcut: "Shift+D";
                        clicked => { root.context-menu-open = false; root.context-menu-action("duplicate"); }
                    }
                    ContextMenuItem {
                        label: "Frame Selection";
                        shortcut: "F";
                        clicked => { root.context-menu-action("frame"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: "Set as Boolean Operand";
                        shortcut: "";
                        clicked => { root.context-menu-action("boolean_operand"); }
                    }

                    if root.selection-domain == "OBJECT": Rectangle { height: 1px; background: DesignTokens.border; }

                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-edit-pivot;
                        shortcut: "Insert";
                        clicked => { root.context-menu-action("toggle_edit_pivot"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-origin-to-geometry;
                        shortcut: "";
                        clicked => { root.context-menu-action("origin_to_geometry"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-origin-to-bottom;
                        shortcut: "";
                        clicked => { root.context-menu-action("origin_to_bottom"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-origin-to-cursor;
                        shortcut: "";
                        clicked => { root.context-menu-action("origin_to_cursor"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-origin-to-selection;
                        shortcut: "";
                        clicked => { root.context-menu-action("origin_to_selection"); }
                    }
                    if root.selection-domain == "OBJECT": ContextMenuItem {
                        label: root.label-geometry-to-origin;
                        shortcut: "";
                        clicked => { root.context-menu-action("geometry_to_origin"); }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    ContextMenuItem {
                        label: "Delete";
                        shortcut: "Del";
                        danger: true;
                        clicked => { root.context-menu-action("delete"); }
                    }
                }
            }
        }

        // Divisor da Asset Library: arrasta na vertical e devolve a altura.
        if asset-library-visible: SplitterHorizontal {
            x: 8px;
            y: parent.height - 36px - asset-library-height;
            width: parent.width - 16px - (inspector-visible && !compact-shell ? inspector-width + 8px : 0px);
            value: root.asset-library-height;
            direction: -1.0;
            moved(height) => { root.asset-library-height-changed(height / 1px); }
        }

        // Overlay / Bottom Drawer: Asset Library (AGENTS.md §3: Asset Library-abaixo)
        if asset-library-visible: Rectangle {
            x: 8px;
            y: parent.height - 30px - asset-library-height;
            width: parent.width - 16px - (inspector-visible && !compact-shell ? inspector-width + 8px : 0px);
            height: asset-library-height;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            border-radius: 6px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    IconDisplay {
                        icon: IconSet.FolderArchive;
                        size: 16px;
                        stroke: DesignTokens.accent;
                    }

                    Text {
                        text: root.label-project-asset-library;
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "(\{root.asset-items.length}/\{root.scene-items.length})";
                        color: DesignTokens.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            IconDisplay { icon: IconSet.BookmarkPlus; size: 12px; stroke: DesignTokens.text-primary; }
                            Text { text: root.label-save-active-as-asset; color: DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.save-active-as-asset-requested(); } }
                    }

                    TopAction {
                        icon: IconSet.X;
                        semantic-label: "Close asset library";
                        clicked => { root.asset-library-requested(); }
                    }
                }

                Rectangle { height: 1px; background: DesignTokens.border; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: search;
                        accessible-label: root.label-search-assets;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            spacing: 5px;
                            alignment: center;
                            IconDisplay { icon: IconSet.Search; size: 13px; stroke: DesignTokens.text-muted; }
                            TextInput {
                                text: root.asset-query;
                                color: DesignTokens.text-primary;
                                font-size: 11px;
                                single-line: true;
                                horizontal-stretch: 1;
                                accessible-label: root.label-search-assets;
                                edited => { root.asset-query-changed(self.text); }
                            }
                        }
                    }
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: root.asset-sort-by-name ? DesignTokens.accent : DesignTokens.surface;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        accessible-role: button;
                        accessible-label: root.label-sort-assets;
                        accessible-checked: root.asset-sort-by-name;
                        IconDisplay { icon: IconSet.ArrowDownAz; size: 14px; stroke: root.asset-sort-by-name ? DesignTokens.canvas : DesignTokens.text-primary; }
                        TouchArea { clicked => { root.asset-sort-changed(!root.asset-sort-by-name); } }
                    }
                    Text { text: root.label-thumbnail-size; color: DesignTokens.text-secondary; font-size: 10px; vertical-alignment: center; }
                    Slider {
                        width: 100px;
                        minimum: 48;
                        maximum: 128;
                        value <=> root.asset-thumbnail-size;
                        changed(value) => { root.asset-thumbnail-size-changed(value); }
                    }
                    Text { text: "\{round(root.asset-thumbnail-size)}"; color: DesignTokens.text-muted; font-size: 10px; width: 24px; horizontal-alignment: right; vertical-alignment: center; }
                }

                ScrollView {
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        for item in root.asset-items: Rectangle {
                            width: root.asset-thumbnail-size * 1px + 96px;
                            height: root.asset-thumbnail-size * 1px + 56px;
                            border-radius: 6px;
                            background: item.selected ? DesignTokens.surface-hover : DesignTokens.surface;
                            border-width: item.selected ? 2px : 1px;
                            border-color: item.selected ? DesignTokens.accent : DesignTokens.border;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                HorizontalLayout {
                                    alignment: center;
                                    IconDisplay { icon: IconSet.Box; size: 14px; stroke: item.selected ? DesignTokens.accent : DesignTokens.text-secondary; }
                                    Rectangle { width: 4px; }
                                    Text {
                                        text: item.name;
                                        color: DesignTokens.text-primary;
                                        font-size: 12px;
                                        font-weight: item.selected ? 700 : 500;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: "\{item.tris} tris  ·  \{item.verts} verts";
                                    color: DesignTokens.text-muted;
                                    font-size: 10px;
                                }

                                Rectangle { vertical-stretch: 1; }

                                HorizontalLayout {
                                    spacing: 4px;

                                    Rectangle {
                                        height: 22px;
                                        horizontal-stretch: 1;
                                        border-radius: 3px;
                                        background: item.selected ? DesignTokens.accent : DesignTokens.surface-raised;
                                        Text {
                                            text: item.selected ? "Active" : "Select";
                                            color: item.selected ? DesignTokens.canvas : DesignTokens.text-primary;
                                            font-size: 10px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { clicked => { root.scene-select(item.id, false); } }
                                    }

                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 3px;
                                        background: DesignTokens.surface-raised;
                                        IconDisplay { icon: IconSet.Copy; size: 12px; stroke: DesignTokens.text-secondary; }
                                        TouchArea {
                                            clicked => {
                                                root.scene-select(item.id, false);
                                                root.duplicate-requested();
                                            }
                                        }
                                    }

                                    // Coloca uma cópia do asset no cursor 3D (P3D-093).
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 3px;
                                        background: DesignTokens.surface-raised;
                                        accessible-role: button;
                                        accessible-label: root.label-place-in-scene;
                                        IconDisplay { icon: IconSet.Plus; size: 12px; stroke: DesignTokens.text-secondary; }
                                        TouchArea {
                                            clicked => { root.place-asset-requested(item.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Overlay: Command Search Modal
        if command-search-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            TouchArea {
                clicked => { root.click-away-requested(); }
            }

            Rectangle {
                width: 480px;
                height: 320px;
                x: (parent.width - self.width) / 2;
                y: 80px;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        alignment: center;

                        IconDisplay {
                            icon: IconSet.Search;
                            size: 16px;
                            stroke: DesignTokens.text-secondary;
                        }

                        search-input := TextInput {
                            accessible-role: text-input;
                            accessible-label: "Search commands";
                            font-size: 14px;
                            color: DesignTokens.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            text <=> root.command-query;
                            edited => { root.command-query-changed(self.text); }
                            key-pressed(event) => {
                                if event.text == Key.DownArrow && root.command-results.length > 0 {
                                    root.command-selection = Math.min(root.command-selection + 1, root.command-results.length - 1);
                                    return accept;
                                }
                                if event.text == Key.UpArrow && root.command-results.length > 0 {
                                    root.command-selection = Math.max(root.command-selection - 1, 0);
                                    return accept;
                                }
                                reject
                            }
                            accepted => {
                                if root.command-results.length > 0 {
                                    if !root.command-results[root.command-selection].available {
                                    } else if root.command-results[root.command-selection].id == "file.save" || root.command-results[root.command-selection].id == "file.save_as" || root.command-results[root.command-selection].id == "file.open" {
                                        root.command-file-action(root.command-results[root.command-selection].id);
                                    } else {
                                        root.command-executed(root.command-results[root.command-selection].id);
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: DesignTokens.border;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for cmd[index] in root.command-results: Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                background: index == root.command-selection || item-touch.has-hover ? DesignTokens.surface-hover : transparent;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;

                                    Text {
                                        text: cmd.label;
                                        color: DesignTokens.text-primary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    if cmd.shortcut != "": Text {
                                        text: cmd.shortcut;
                                        color: DesignTokens.text-muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }

                                item-touch := TouchArea {
                                    clicked => {
                                        root.command-selection = index;
                                        if !cmd.available {
                                        } else if cmd.id == "file.save" || cmd.id == "file.save_as" || cmd.id == "file.open" {
                                            root.command-file-action(cmd.id);
                                        } else {
                                            root.command-executed(cmd.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Overlay: Reference Image Manager Modal (P3D-013)
        if reference-manager-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            TouchArea {
                clicked => {
                    root.reference-manager-visible = false;
                    root.reference-manager-closed();
                }
            }

            Rectangle {
                width: min(780px, parent.width - 40px);
                height: min(600px, parent.height - 40px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                drop-shadow-blur: 16px;
                drop-shadow-color: DesignTokens.shadow;
                drop-shadow-offset-y: 6px;

                TouchArea { clicked => {} }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // Header
                    Rectangle {
                        height: 48px;
                        background: DesignTokens.surface;
                        border-top-left-radius: 8px;
                        border-top-right-radius: 8px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                IconDisplay {
                                    icon: IconSet.Image;
                                    size: 16px;
                                    stroke: DesignTokens.accent;
                                }
                                Text {
                                    text: "Reference Images · P3D-013";
                                    color: DesignTokens.text-primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "(\{root.reference-total-count} active)";
                                    color: DesignTokens.text-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                Rectangle {
                                    height: 26px;
                                    background: DesignTokens.surface-raised;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    TouchArea {
                                        clicked => { root.reference-clear-all(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;
                                        IconDisplay { icon: IconSet.Trash2; size: 12px; stroke: DesignTokens.text-secondary; }
                                        Text { text: "Clear All"; color: DesignTokens.text-secondary; font-size: 11px; vertical-alignment: center; }
                                    }
                                }

                                TopAction {
                                    icon: IconSet.X;
                                    semantic-label: "Close reference manager";
                                    clicked => {
                                        root.reference-manager-visible = false;
                                        root.reference-manager-closed();
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            for slot[index] in root.reference-slots: ReferenceSlotCard {
                                slot: slot;
                                pick-image => { root.reference-slot-pick(slot.axis); }
                                remove-image => { root.reference-slot-remove(slot.axis); }
                                align-view => { root.reference-slot-align(slot.axis); }
                                toggle-visible => { root.reference-slot-toggle-visible(slot.axis); }
                                toggle-lock => { root.reference-slot-toggle-lock(slot.axis); }
                                set-param(param, val) => { root.reference-slot-set-param(slot.axis, param, val); }
                            }
                        }
                    }
                }
            }
        }

        // Overlay: Settings Modal
        if settings-visible: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: DesignTokens.scrim;

            TouchArea {
                clicked => {
                    root.settings-visible = false;
                    root.settings-closed();
                }
            }

            Rectangle {
                width: 660px;
                height: 520px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                drop-shadow-blur: 16px;
                drop-shadow-color: DesignTokens.shadow;
                drop-shadow-offset-y: 6px;

                // Captura cliques no card para que não atravessem para o scrim de fundo
                TouchArea { clicked => {} }

                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // Cabeçalho da modal
                    Rectangle {
                        height: 48px;
                        background: DesignTokens.surface;
                        border-top-left-radius: 8px;
                        border-top-right-radius: 8px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                IconDisplay {
                                    icon: IconSet.Settings2;
                                    size: 16px;
                                    stroke: DesignTokens.accent;
                                }
                                Text {
                                    text: root.label-preferences != "" ? root.label-preferences : "Configurações";
                                    color: DesignTokens.text-primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            TopAction {
                                icon: IconSet.X;
                                semantic-label: "Close settings";
                                clicked => {
                                    root.settings-visible = false;
                                    root.settings-closed();
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: DesignTokens.border; }

                    // Corpo: Barra lateral de categorias + Painel de conteúdo
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        // Sidebar de seções
                        Rectangle {
                            width: 175px;
                            background: DesignTokens.surface;
                            border-bottom-left-radius: 8px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 3px;

                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 0 ? DesignTokens.accent : (tab0-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: "Aparência";
                                    accessible-checked: root.settings-tab == 0;
                                    accessible-action-default => { root.settings-tab = 0; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        IconDisplay { icon: IconSet.Palette; size: 14px; stroke: root.settings-tab == 0 ? DesignTokens.canvas : DesignTokens.text-secondary; }
                                        Text { text: "Aparência"; color: root.settings-tab == 0 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab0-touch := TouchArea { clicked => { root.settings-tab = 0; } }
                                }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 1 ? DesignTokens.accent : (tab1-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: "Idioma & Região";
                                    accessible-checked: root.settings-tab == 1;
                                    accessible-action-default => { root.settings-tab = 1; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        IconDisplay { icon: IconSet.Globe; size: 14px; stroke: root.settings-tab == 1 ? DesignTokens.canvas : DesignTokens.text-secondary; }
                                        Text { text: "Idioma & Região"; color: root.settings-tab == 1 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab1-touch := TouchArea { clicked => { root.settings-tab = 1; } }
                                }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 2 ? DesignTokens.accent : (tab2-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: "Teclado & Atalhos";
                                    accessible-checked: root.settings-tab == 2;
                                    accessible-action-default => { root.settings-tab = 2; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        IconDisplay { icon: IconSet.Keyboard; size: 14px; stroke: root.settings-tab == 2 ? DesignTokens.canvas : DesignTokens.text-secondary; }
                                        Text { text: "Teclado & Atalhos"; color: root.settings-tab == 2 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab2-touch := TouchArea { clicked => { root.settings-tab = 2; } }
                                }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 3 ? DesignTokens.accent : (tab3-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: "Acessibilidade";
                                    accessible-checked: root.settings-tab == 3;
                                    accessible-action-default => { root.settings-tab = 3; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        IconDisplay { icon: IconSet.Eye; size: 14px; stroke: root.settings-tab == 3 ? DesignTokens.canvas : DesignTokens.text-secondary; }
                                        Text { text: "Acessibilidade"; color: root.settings-tab == 3 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab3-touch := TouchArea { clicked => { root.settings-tab = 3; } }
                                }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 4 ? DesignTokens.accent : (tab4-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: "Ferramentas";
                                    accessible-checked: root.settings-tab == 4;
                                    accessible-action-default => { root.settings-tab = 4; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        IconDisplay { icon: IconSet.Box; size: 14px; stroke: root.settings-tab == 4 ? DesignTokens.canvas : DesignTokens.text-secondary; }
                                        Text { text: "Ferramentas"; color: root.settings-tab == 4 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab4-touch := TouchArea { clicked => { root.settings-tab = 4; } }
                                }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 5 ? DesignTokens.accent : (tab5-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: "Viewport 3D";
                                    accessible-checked: root.settings-tab == 5;
                                    accessible-action-default => { root.settings-tab = 5; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        IconDisplay { icon: IconSet.Monitor; size: 14px; stroke: root.settings-tab == 5 ? DesignTokens.canvas : DesignTokens.text-secondary; }
                                        Text { text: "Viewport 3D"; color: root.settings-tab == 5 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab5-touch := TouchArea { clicked => { root.settings-tab = 5; } }
                                }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 6 ? DesignTokens.accent : (tab6-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: "Plugins";
                                    accessible-checked: root.settings-tab == 6;
                                    accessible-action-default => { root.settings-tab = 6; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        IconDisplay { icon: IconSet.Cpu; size: 14px; stroke: root.settings-tab == 6 ? DesignTokens.canvas : DesignTokens.text-secondary; }
                                        Text { text: "Plugins"; color: root.settings-tab == 6 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab6-touch := TouchArea { clicked => { root.settings-tab = 6; } }
                                }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: root.settings-tab == 7 ? DesignTokens.accent : (tab7-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    accessible-role: tab;
                                    accessible-label: "MCP & Automação";
                                    accessible-checked: root.settings-tab == 7;
                                    accessible-action-default => { root.settings-tab = 7; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        spacing: 8px;
                                        alignment: start;
                                        IconDisplay { icon: IconSet.Terminal; size: 14px; stroke: root.settings-tab == 7 ? DesignTokens.canvas : DesignTokens.text-secondary; }
                                        Text { text: "MCP & Automação"; color: root.settings-tab == 7 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                    }
                                    tab7-touch := TouchArea { clicked => { root.settings-tab = 7; } }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }

                        Rectangle { width: 1px; background: DesignTokens.border; }

                        // Painel de Conteúdo com rolagem
                        ScrollView {
                            horizontal-stretch: 1;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;

                                // --- TAB 0: APARÊNCIA ---
                                if root.settings-tab == 0: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: "Tema da Interface"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        for theme in root.themes: Rectangle {
                                            width: 140px; height: 30px; border-radius: 4px;
                                            background: theme.active ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text {
                                                text: theme.name;
                                                color: theme.active ? DesignTokens.canvas : DesignTokens.text-primary;
                                                font-size: 11px; font-weight: 600;
                                                vertical-alignment: center; horizontal-alignment: center;
                                            }
                                            TouchArea { clicked => { root.theme-changed(theme.id); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: "Escala da UI (Zoom)"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 60px; height: 28px; border-radius: 4px;
                                            background: (root.ui-scale <= 1.05) ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "100%"; color: (root.ui-scale <= 1.05) ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.ui-scale-set(1.0); } }
                                        }
                                        Rectangle {
                                            width: 60px; height: 28px; border-radius: 4px;
                                            background: (root.ui-scale > 1.05 && root.ui-scale <= 1.35) ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "125%"; color: (root.ui-scale > 1.05 && root.ui-scale <= 1.35) ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.ui-scale-set(1.25); } }
                                        }
                                        Rectangle {
                                            width: 60px; height: 28px; border-radius: 4px;
                                            background: (root.ui-scale > 1.35 && root.ui-scale <= 1.65) ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "150%"; color: (root.ui-scale > 1.35 && root.ui-scale <= 1.65) ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.ui-scale-set(1.5); } }
                                        }
                                        Rectangle {
                                            width: 60px; height: 28px; border-radius: 4px;
                                            background: (root.ui-scale > 1.65) ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "200%"; color: (root.ui-scale > 1.65) ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.ui-scale-set(2.0); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: "Estilo dos Ícones"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 100px; height: 30px; border-radius: 4px;
                                            background: root.icon-theme == "outline" ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                padding-left: 10px;
                                                alignment: start;
                                                Image { source: PetuniaIcons.cube; width: 16px; height: 16px; y: (parent.height - self.height) / 2; image-fit: contain; }
                                                Text { text: "Outline"; color: root.icon-theme == "outline" ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.icon-theme-set("outline"); } }
                                        }
                                        Rectangle {
                                            width: 100px; height: 30px; border-radius: 4px;
                                            background: root.icon-theme == "filled" ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                padding-left: 10px;
                                                alignment: start;
                                                Image { source: PetuniaIcons.cube; width: 16px; height: 16px; y: (parent.height - self.height) / 2; image-fit: contain; }
                                                Text { text: "Filled"; color: root.icon-theme == "filled" ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                            }
                                            TouchArea { clicked => { root.icon-theme-set("filled"); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: "Cor de Destaque / Seleção"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        // Preset 1: Blender Orange
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: #e96a00;
                                            border-width: root.selection-color-hex == "#E96A00" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#E96A00" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#E96A00"); } }
                                        }
                                        // Preset 2: Electric Cyan
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: #00d2ff;
                                            border-width: root.selection-color-hex == "#00D2FF" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#00D2FF" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#00D2FF"); } }
                                        }
                                        // Preset 3: Purple Accent
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: #b58cff;
                                            border-width: root.selection-color-hex == "#B58CFF" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#B58CFF" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#B58CFF"); } }
                                        }
                                        // Preset 4: Emerald Green
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: #10b981;
                                            border-width: root.selection-color-hex == "#10B981" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#10B981" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#10B981"); } }
                                        }
                                        // Preset 5: Amber Gold
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: #f59e0b;
                                            border-width: root.selection-color-hex == "#F59E0B" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#F59E0B" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#F59E0B"); } }
                                        }
                                        // Preset 6: Coral Red
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 4px; background: #ef4444;
                                            border-width: root.selection-color-hex == "#EF4444" ? 2px : 1px;
                                            border-color: root.selection-color-hex == "#EF4444" ? DesignTokens.focus-ring : DesignTokens.border;
                                            TouchArea { clicked => { root.selection-color-set("#EF4444"); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        Rectangle {
                                            width: 30px; height: 30px; border-radius: 4px;
                                            background: root.selection-color;
                                            border-width: 1px; border-color: DesignTokens.border;
                                        }
                                        Rectangle {
                                            width: 110px; height: 30px; border-radius: 4px;
                                            background: DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            TextInput {
                                                x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px;
                                                text: root.selection-color-hex;
                                                color: DesignTokens.text-primary;
                                                font-size: 11px;
                                                single-line: true;
                                                accessible-label: root.label-selection-color;
                                                accepted => { root.selection-color-set(self.text); }
                                            }
                                        }
                                        Rectangle {
                                            width: 90px; height: 30px; border-radius: 4px;
                                            background: DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text {
                                                text: "Reset (#E96A00)";
                                                color: DesignTokens.text-secondary;
                                                font-size: 10px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                            TouchArea { clicked => { root.selection-color-set("#E96A00"); } }
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: root.label-highlight-thickness; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        Slider {
                                            horizontal-stretch: 1;
                                            minimum: 1; maximum: 6;
                                            value <=> root.selection-thickness;
                                            accessible-label: root.label-highlight-thickness;
                                            changed(value) => { root.selection-thickness-set(value); }
                                            released(value) => { root.selection-thickness-released(value); }
                                        }
                                        Text { text: "\{round(root.selection-thickness * 10) / 10} px"; color: DesignTokens.text-secondary; font-size: 10px; width: 44px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }

                                // --- TAB 1: IDIOMA & REGIÃO ---
                                if root.settings-tab == 1: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: "Idioma da Interface"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            width: 160px; height: 32px; border-radius: 4px;
                                            background: root.active-language == "pt-BR" ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text {
                                                text: "Português (Brasil)";
                                                color: root.active-language == "pt-BR" ? DesignTokens.canvas : DesignTokens.text-primary;
                                                font-size: 11px; font-weight: 600;
                                                vertical-alignment: center; horizontal-alignment: center;
                                            }
                                            TouchArea { clicked => { root.language-changed("pt-BR"); } }
                                        }
                                        Rectangle {
                                            width: 160px; height: 32px; border-radius: 4px;
                                            background: root.active-language == "en" ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text {
                                                text: "English (US)";
                                                color: root.active-language == "en" ? DesignTokens.canvas : DesignTokens.text-primary;
                                                font-size: 11px; font-weight: 600;
                                                vertical-alignment: center; horizontal-alignment: center;
                                            }
                                            TouchArea { clicked => { root.language-changed("en"); } }
                                        }
