                                            Text { text: "Desativado"; color: root.double-tap-interval-ms == 0 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.double-tap-interval-set(0); } }
                                        }
