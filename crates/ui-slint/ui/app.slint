/// Tooltip rico moderno (Blender / VS Code / Figma style):
/// Cabeçalho com título em destaque e badge kbd estilizado para o atalho,
/// corpo com micro-explicação em texto secundário e rodapé de dicas/gestos.
component RichTooltip inherits Rectangle {
    in property <string> title;
    in property <string> shortcut: "";
    in property <string> description: "";
    in property <string> hint: "";

    background: DesignTokens.surface-raised;
    border-radius: 6px;
    border-width: 1px;
    border-color: DesignTokens.border;
    drop-shadow-color: #00000088;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;
        min-width: 130px;
        max-width: 280px;

        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            Text {
                text: root.title;
                color: DesignTokens.text-primary;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }

            if root.shortcut != "": Rectangle {
                background: DesignTokens.surface-hover;
                border-width: 1px;
                border-color: DesignTokens.border;
                border-radius: 3px;
                height: 16px;

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    alignment: center;

                    Text {
                        text: root.shortcut;
                        color: DesignTokens.accent;
                        font-size: 9px;
                        font-weight: 600;
                        font-family: "monospace";
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        if root.description != "": Text {
            text: root.description;
            color: DesignTokens.text-secondary;
            font-size: 10px;
            wrap: word-wrap;
        }

        if root.hint != "": Text {
            text: root.hint;
            color: DesignTokens.text-muted;
            font-size: 9px;
            wrap: word-wrap;
        }
    }
}

/// Divisor horizontal: arrasta na vertical e devolve a altura desejada.
component SplitterHorizontal inherits Rectangle {
    in property <length> value;
    in property <float> direction: 1.0;
    callback moved(length);

    width: 100%;
    height: 6px;
    background: touch-area.has-hover || touch-area.pressed ? DesignTokens.accent : DesignTokens.border;
    accessible-role: slider;
    accessible-label: Tr.t("sl.resize_panel_height");
    accessible-value: 50;

    touch-area := TouchArea {
        property <length> start-value;
        property <length> start-y;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.start-value = root.value;
                self.start-y = self.mouse-y;
            }
        }
        moved => {
            if self.pressed {
                root.moved(self.start-value + root.direction * (self.mouse-y - self.start-y));
            }
        }
    }
}

/// Botão compacto da barra da viewport (visão e domínio de seleção).
component ViewportBarButton inherits Rectangle {
    in property <Icon> icon;
    in property <image> icon-svg;
    in property <string> label;
    in property <string> shortcut: "";
    in property <string> description: "";
    in property <string> hint: "";
    in property <bool> active;
    in property <bool> emphasized: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.active;
    forward-focus: bar-focus;
    width: root.emphasized ? 32px : max(26px, 12px + 14px + 12px);
    height: root.emphasized ? 28px : 26px;
    border-radius: 5px;
    background: root.active
        ? DesignTokens.accent
        : (bar-touch.pressed ? DesignTokens.surface-pressed : (bar-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-hover.with-alpha(0)));
    border-width: bar-focus.has-focus || (root.emphasized && root.active) ? 2px : 0px;
    border-color: DesignTokens.focus-ring;
    animate background { duration: Motion.fast; easing: ease-out; }
    animate border-color { duration: Motion.fast; easing: ease-out; }
    transform-scale: bar-touch.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: Motion.fast; easing: ease-out; }

    if root.icon-svg.width > 0: Image {
        source: root.icon-svg;
        colorize: root.active ? DesignTokens.on-accent : DesignTokens.text-primary;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    if root.icon-svg.width == 0: bar-icon := IconDisplay {
        icon: root.icon;
        size: 14px;
        stroke: root.active ? DesignTokens.on-accent : DesignTokens.text-secondary;
    }
    bar-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
        bar-touch := TouchArea {
            clicked => { root.clicked(); }
            Tooltip {
                RichTooltip {
                    title: root.label;
                    shortcut: root.shortcut;
                    description: root.description;
                    hint: root.hint;
                }
            }
        }
    }
}

/// Ícone vetorial específico do modo de shading (16–18 px legíveis).
component ViewportSvgButton inherits Rectangle {
    in property <image> glyph;
    in property <string> label;
    in property <string> shortcut: "";
    in property <string> description: "";
    in property <string> hint: "";
    in property <bool> active;
    in property <bool> live-mode: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.active;
    forward-focus: svg-focus;
    width: 32px;
    height: 28px;
    border-radius: 5px;
    background: root.live-mode ? DesignTokens.live-mode : (root.active ? DesignTokens.accent : (touch.pressed ? DesignTokens.surface-pressed : (touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-hover.with-alpha(0))));
    border-width: svg-focus.has-focus ? 2px : ((root.active || root.live-mode) ? 1px : 0px);
    border-color: root.live-mode ? DesignTokens.live-mode-ring : DesignTokens.focus-ring;
    animate background { duration: Motion.fast; easing: ease-out; }
    animate border-color { duration: Motion.fast; easing: ease-out; }
    transform-scale: touch.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: Motion.fast; easing: ease-out; }
    Image {
        source: root.glyph;
        colorize: (root.active || root.live-mode) ? DesignTokens.on-accent : DesignTokens.text-primary;
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    svg-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            clicked => { root.clicked(); }
            Tooltip {
                RichTooltip {
                    title: root.label;
                    shortcut: root.shortcut;
                    description: root.description;
                    hint: root.hint;
                }
            }
        }
    }
}

/// Botão da barra de menus do topo.
component MenuButton inherits Rectangle {
    in property <string> label;
    in property <string> shortcut: "";
    in property <string> description: "";
    in property <bool> open;
    callback clicked;
    callback hovered;

    accessible-role: button;
    accessible-label: root.label;
    accessible-expanded: root.open;
    height: 26px;
    width: max(46px, menu-label.preferred-width + 20px);
    border-radius: 4px;
    background: root.open
        ? DesignTokens.accent
        : (touch-area.pressed ? DesignTokens.surface-pressed : (touch-area.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-hover.with-alpha(0)));
    animate background { duration: Motion.fast; easing: ease-out; }
    animate border-color { duration: Motion.fast; easing: ease-out; }

    menu-label := Text {
        text: root.label;
        color: root.open ? DesignTokens.on-accent : DesignTokens.text-secondary;
        font-size: 11px;
        font-weight: root.open ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch-area := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover {
                root.hovered();
            }
        }
        if !root.open: Tooltip {
            RichTooltip {
                title: root.label;
                shortcut: root.shortcut;
                description: root.description;
            }
        }
    }
}

/// Slider Petunia: trilho fino, preenchimento no accent, alça com feedback e teclado.
component PetuniaSlider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0.0;
    in property <float> maximum: 100.0;
    in property <float> step: 0.0;
    in property <bool> enabled: true;
    callback changed(float);
    callback released(float);

    property <float> span: max(root.maximum - root.minimum, 0.0001);
    property <float> ratio: clamp((root.value - root.minimum) / root.span, 0.0, 1.0);

    accessible-role: slider;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step > 0.0 ? root.step : root.span / 20.0;
    accessible-enabled: root.enabled;
    forward-focus: slider-focus;
    min-width: 60px;
    height: 18px;

    function apply(v: float) {
        let snapped = root.step > 0.0 ? root.minimum + round((v - root.minimum) / root.step) * root.step : v;
        let next = clamp(snapped, root.minimum, root.maximum);
        if next != root.value {
            root.value = next;
            root.changed(next);
        }
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: DesignTokens.border-strong.with-alpha(0.55);
        Rectangle {
            x: 0px;
            width: max(parent.width * root.ratio, 0px);
            border-radius: 2px;
            background: root.enabled ? DesignTokens.accent : DesignTokens.disabled;
        }
    }

    handle := Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        x: (root.width - self.width) * root.ratio;
        y: (root.height - self.height) / 2;
        background: DesignTokens.text-primary;
        border-width: (slider-focus.has-focus || slider-touch.pressed) ? 3px : 2px;
        border-color: root.enabled ? DesignTokens.accent : DesignTokens.disabled;
        animate border-width { duration: Motion.fast; easing: ease-out; }
        transform-scale: slider-touch.pressed ? 1.15 : (slider-touch.has-hover ? 1.08 : 1.0);
        animate transform-scale { duration: Motion.fast; easing: ease-out; }
        drop-shadow-blur: 3px;
        drop-shadow-color: DesignTokens.shadow-subtle;
        drop-shadow-offset-y: 1px;
    }

    slider-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            let delta = root.step > 0.0 ? root.step : root.span / 20.0;
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.apply(root.value - delta); return accept; }
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.apply(root.value + delta); return accept; }
            if event.text == Key.Home { root.apply(root.minimum); return accept; }
            if event.text == Key.End { root.apply(root.maximum); return accept; }
            reject
        }
        slider-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.apply(root.minimum + root.span * clamp((self.mouse-x - 7px) / max(root.width - 14px, 1px), 0.0, 1.0));
                }
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                    root.released(root.value);
                }
            }
            moved => {
                if self.pressed {
                    root.apply(root.minimum + root.span * clamp((self.mouse-x - 7px) / max(root.width - 14px, 1px), 0.0, 1.0));
                }
            }
        }
    }
}

/// Superfície do canvas de pintura 2D: raster, wireframe UV, grade de pixels, pan (botão do meio)
/// e zoom (roda). Mesma superfície no Inspector (pequena) e na janela flutuante (grande).
component PaintCanvasSurface inherits Rectangle {
    in property <image> canvas-image;
    in property <int> zoom: 1;
    in property <bool> show-uv: false;
    in property <string> uv-commands: "";
    in property <bool> show-grid: false;
    in property <string> grid-commands: "";
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    callback stroke(float, float, int);
    callback zoom-step(int);

    background: DesignTokens.canvas;
    border-width: 1px;
    border-color: DesignTokens.border;
    clip: true;

    raster := Image {
        width: root.width * root.zoom;
        height: root.height * root.zoom;
        x: (root.width - self.width) / 2 + root.pan-x;
        y: (root.height - self.height) / 2 + root.pan-y;
        image-fit: fill;
        image-rendering: pixelated;
        source: root.canvas-image;
    }

    if root.show-uv: Path {
        width: raster.width;
        height: raster.height;
        x: raster.x;
        y: raster.y;
        fill: transparent;
        stroke: #00ffff99;
        stroke-width: 1px;
        commands: root.uv-commands;
    }

    if root.show-grid && root.grid-commands != "": Path {
        width: 100%;
        height: 100%;
        fill: transparent;
        stroke: DesignTokens.border.transparentize(0.35);
        stroke-width: 1px;
        commands: root.grid-commands;
    }

    surface-touch := TouchArea {
        property <bool> panning: false;
        property <length> last-x;
        property <length> last-y;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.middle || event.button == PointerEventButton.right {
                    self.panning = true;
                    self.last-x = self.mouse-x;
                    self.last-y = self.mouse-y;
                } else if event.button == PointerEventButton.left {
                    root.stroke((self.mouse-x - raster.x) / raster.width, (self.mouse-y - raster.y) / raster.height, 0);
                }
            } else if event.kind == PointerEventKind.up {
                if self.panning {
                    self.panning = false;
                } else if event.button == PointerEventButton.left {
                    root.stroke((self.mouse-x - raster.x) / raster.width, (self.mouse-y - raster.y) / raster.height, 2);
                }
            }
        }
        moved => {
            if self.panning {
                root.pan-x += self.mouse-x - self.last-x;
                root.pan-y += self.mouse-y - self.last-y;
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
            } else if self.pressed {
                root.stroke((self.mouse-x - raster.x) / raster.width, (self.mouse-y - raster.y) / raster.height, 1);
            }
        }
        scroll-event(event) => {
            if event.delta-y != 0px {
                root.zoom-step(event.delta-y > 0px ? 1 : -1);
                return accept;
            }
            reject
        }
    }
}

/// Alça de arraste de painéis flutuantes não modais (cap. 36, revisão 2026-09-30).
/// O pai guarda a posição; duplo clique recentraliza (posição negativa = centro).
component PanelDragHandle inherits TouchArea {
    in property <length> panel-x;
    in property <length> panel-y;
    in property <length> max-x;
    in property <length> max-y;
    callback moved-to(length, length);
    property <length> start-x;
    property <length> start-y;
    mouse-cursor: MouseCursor.move;
    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            root.start-x = root.panel-x;
            root.start-y = root.panel-y;
        }
    }
    moved => {
        root.moved-to(
            clamp(root.start-x + (self.mouse-x - self.pressed-x), 0px, max(root.max-x, 0px)),
            clamp(root.start-y + (self.mouse-y - self.pressed-y), 0px, max(root.max-y, 0px)));
    }
    double-clicked => { root.moved-to(-1px, -1px); }
}

/// Item de menu: rótulo, atalho, check opcional, estado desativado e realce de teclado.
component ContextMenuItem inherits Rectangle {
    in property <string> label;
    in property <string> shortcut;
    in property <bool> danger: false;
    in property <bool> disabled: false;
    in property <bool> checked: false;
    in property <bool> highlighted: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: !root.disabled;
    accessible-checkable: root.checked;
    accessible-checked: root.checked;
    height: 26px;
    border-radius: 4px;
    background: root.disabled ? DesignTokens.surface-hover.with-alpha(0)
        : (touch-area.pressed ? DesignTokens.surface-pressed
        : ((touch-area.has-hover || root.highlighted) ? DesignTokens.surface-hover : DesignTokens.surface-hover.with-alpha(0)));
    animate background { duration: Motion.fast; easing: ease-out; }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 6px;
        alignment: stretch;

        Rectangle {
            width: 14px;
            if root.checked: IconDisplay {
                icon: IconSet.Check;
                size: 12px;
                stroke: DesignTokens.accent;
            }
        }
        Text {
            text: root.label;
            color: root.disabled ? DesignTokens.disabled : (root.danger ? DesignTokens.danger : DesignTokens.text-primary);
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.shortcut;
            color: root.disabled ? DesignTokens.disabled : DesignTokens.text-muted;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    touch-area := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

/// Dropdown de um menu da barra superior.
component MenuDropdown inherits Rectangle {
    in property <[MenuEntry]> entries;
    in property <int> highlight: -1;
    callback invoked(string);

    width: 216px;
    height: menu-items.preferred-height;
    background: DesignTokens.surface-raised;
    border-width: 1px;
    border-color: DesignTokens.border;
    border-radius: 6px;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000080;
    drop-shadow-offset-y: 4px;

    menu-items := VerticalLayout {
        padding: 4px;
        spacing: 1px;

        for entry[index] in root.entries: VerticalLayout {
            if entry.separator: Rectangle {
                height: 9px;
                Rectangle {
                    y: 4px;
                    height: 1px;
                    background: DesignTokens.border;
                }
            }
            if !entry.separator: ContextMenuItem {
                label: entry.label;
                shortcut: entry.shortcut;
                disabled: entry.disabled;
                checked: entry.checked;
                highlighted: index == root.highlight;
                clicked => { root.invoked(entry.id); }
            }
        }
    }
}

component TopAction inherits Rectangle {
    in property <Icon> icon;
    in property <image> icon-svg;
    in property <string> semantic-label;
    in property <string> shortcut: "";
    in property <string> description: "";
    in property <string> hint: "";
    in property <bool> active: false;
    in property <bool> toggle-button: false;
    in property <bool> enabled: true;
    callback clicked;

    accessible-role: button;
    accessible-label: root.semantic-label;
    accessible-checkable: root.toggle-button;
    accessible-checked: root.active;
    forward-focus: top-focus;
    width: 32px;
    height: 28px;
    border-radius: 5px;
    background: root.active ? DesignTokens.accent : (touch-area.pressed ? DesignTokens.surface-pressed : (touch-area.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-hover.with-alpha(0)));
    border-width: top-focus.has-focus ? 2px : (touch-area.has-hover ? 1px : 0px);
    border-color: top-focus.has-focus ? DesignTokens.focus-ring : DesignTokens.border;
    animate background { duration: Motion.fast; easing: ease-out; }
    animate border-color { duration: Motion.fast; easing: ease-out; }
    transform-scale: touch-area.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: Motion.fast; easing: ease-out; }

    if root.icon-svg.width > 0: Image {
        source: root.icon-svg;
        colorize: root.active ? DesignTokens.on-accent : DesignTokens.text-primary;
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    if root.icon-svg.width == 0: IconDisplay {
        icon: root.icon;
        size: 16px;
        stroke: root.active ? DesignTokens.on-accent : DesignTokens.text-secondary;
    }
    top-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") && root.enabled {
                root.clicked();
                return accept;
            }
            reject
        }
        touch-area := TouchArea {
            enabled: root.enabled;
            clicked => {
                if root.enabled {
                    root.clicked();
                }
            }
            Tooltip {
                RichTooltip {
                    title: root.semantic-label;
                    shortcut: root.shortcut;
                    description: root.description;
                    hint: root.hint;
                }
            }
        }
    }
}

/// Segmented control para a seleção de workspaces com pill deslizante.
component WorkspaceSegment inherits Rectangle {
    /// "DRAW", "POLY", "PAINT" ou "UV".
    in property <string> active: "POLY";
    in property <bool> reduced-motion: false;
    in property <string> draw-title: "Draw";
    in property <string> draw-description: "";
    in property <string> poly-title: "Poly";
    in property <string> poly-description: "";
    callback changed(string);

    accessible-role: tab-list;
    accessible-label: Tr.t("sl.workspaces");
    width: 246px;
    height: 28px;
    border-radius: 6px;
    background: DesignTokens.surface-raised;
    border-width: 1px;
    border-color: DesignTokens.border;

    // Sliding pill
    Rectangle {
        x: root.active == "DRAW" ? 2px : (root.active == "POLY" ? 83px : (root.active == "PAINT" ? 164px : 245px));
        y: 2px;
        width: 80px;
        height: 22px;
        border-radius: 4px;
        background: DesignTokens.accent;
        animate x { duration: root.reduced-motion ? 0ms : 160ms; easing: ease-out-quad; }
    }

    HorizontalLayout {
        padding: 2px;
        spacing: 1px;
        Rectangle {
            width: 80px;
            height: 22px;
            background: transparent;
            accessible-role: tab;
            accessible-label: root.draw-title;
            accessible-description: root.draw-description;
            accessible-checked: root.active == "DRAW";
            Text {
                text: Tr.t("sl.draw");
                color: root.active == "DRAW" ? DesignTokens.on-accent : DesignTokens.text-secondary;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.changed("DRAW"); }
                Tooltip {
                    RichTooltip {
                        title: root.draw-title;
                        shortcut: "F1";
                        description: root.draw-description;
                    }
                }
            }
        }
        Rectangle {
            width: 80px;
            height: 22px;
            background: transparent;
            accessible-role: tab;
            accessible-label: root.poly-title;
            accessible-description: root.poly-description;
            accessible-checked: root.active == "POLY";
            Text {
                text: Tr.t("sl.poly");
                color: root.active == "POLY" ? DesignTokens.canvas : DesignTokens.text-secondary;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.changed("POLY"); }
                Tooltip {
                    RichTooltip {
                        title: root.poly-title;
                        shortcut: "F1";
                        description: root.poly-description;
                    }
                }
            }
        }
        Rectangle {
            width: 80px;
            height: 22px;
            background: transparent;
            accessible-role: tab;
            accessible-label: Tr.t("sl.paint_workspace");
            accessible-checked: root.active == "PAINT";
            Text {
                text: Tr.t("sl.paint");
                color: root.active == "PAINT" ? DesignTokens.on-accent : DesignTokens.text-secondary;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.changed("PAINT"); }
                Tooltip {
                    RichTooltip {
                        title: Tr.t("sl.paint_workspace");
                        shortcut: "F2";
                        description: Tr.t("sl.texture_painting_layer_management_and_brush_");
                    }
                }
            }
        }
    }
}

/// Card flutuante de propriedades de ferramenta com animação de colapso.
component ToolCard inherits Rectangle {
    in property <string> title;
    in-out property <bool> collapsed: false;
    callback collapse-toggled;

    width: 264px;
    height: card-layout.preferred-height;
    border-radius: 8px;
    background: DesignTokens.surface-raised;
    border-width: 1px;
    border-color: DesignTokens.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000080;
    drop-shadow-offset-y: 4px;

    card-layout := VerticalLayout {
        padding: 10px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            height: 20px;
            Text {
                text: root.title;
                color: DesignTokens.text-primary;
                font-size: 12px;
                font-weight: 700;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: 20px;
                height: 20px;
                accessible-role: button;
                accessible-label: root.collapsed ? Tr.t("sl.expand") : Tr.t("sl.collapse");
                IconDisplay {
                    icon: root.collapsed ? IconSet.ChevronDown : IconSet.ChevronUp;
                    size: 13px;
                    stroke: DesignTokens.text-secondary;
                }
                TouchArea { clicked => { root.collapse-toggled(); } }
            }
        }

        VerticalLayout {
            visible: !root.collapsed;
            spacing: 8px;
            alignment: start;
            @children
        }
    }
}


/// Linha compacta de busca, filtro e ordenação da lista Parts.
component PartsFilterRow inherits Rectangle {
    in property <string> search-label;
    in property <string> search-id: "";
    in property <string> selected-only-label;
    in property <string> sort-label;
    in-out property <string> query: "";
    in-out property <bool> selected-only: false;
    in-out property <bool> sort-by-name: false;
    in-out property <int> visible-count: 0;
    in-out property <int> total-count: 0;
    callback query-changed(string);
    callback selected-only-changed(bool);
    callback sort-changed(bool);

    width: 100%;
    height: 28px;
    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 6px;
        alignment: center;

        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            border-radius: 4px;
            background: DesignTokens.surface;
            border-width: 1px;
            border-color: DesignTokens.border;
            accessible-role: search;
            accessible-label: root.search-label;
            accessible-id: root.search-id;
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                spacing: 5px;
                alignment: center;
                IconDisplay { icon: IconSet.Search; size: 13px; stroke: DesignTokens.text-muted; }
                TextInput {
                    text <=> root.query;
                    color: DesignTokens.text-primary;
                    font-size: 11px;
                    single-line: true;
                    horizontal-stretch: 1;
                    accessible-label: root.search-label;
                    edited => { root.query-changed(self.text); }
                }
            }
        }
        TopAction {
            icon: IconSet.MousePointer2;
            semantic-label: root.selected-only-label;
            active: root.selected-only;
            toggle-button: true;
            clicked => { root.selected-only-changed(!root.selected-only); }
        }
        TopAction {
            icon: IconSet.ArrowDownAz;
            semantic-label: root.sort-label;
            active: root.sort-by-name;
            toggle-button: true;
            clicked => { root.sort-changed(!root.sort-by-name); }
        }
        Text {
            text: "\{root.visible-count}/\{root.total-count}";
            color: DesignTokens.text-muted;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
}

/// Controle compartilhado de densidade das linhas de Parts.
component PartsRowSizeControl inherits Rectangle {
    in property <string> semantic-label;
    in property <string> accessibility-id;
    in-out property <float> value: 28.0;
    callback value-changed(float);

    width: 100%;
    height: 24px;
    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.semantic-label;
            color: DesignTokens.text-secondary;
            font-size: 10px;
            vertical-alignment: center;
        }
        PetuniaSlider {
            horizontal-stretch: 1;
            min-width: 100px;
            minimum: 28;
            maximum: 44;
            step: 1;
            accessible-role: slider;
            value <=> root.value;
            accessible-label: root.semantic-label;
            accessible-id: root.accessibility-id;
            accessible-value-minimum: 28;
            accessible-value-maximum: 44;
            accessible-value-step: 1;
            accessible-value: "\{round(root.value)}";
            changed(value) => { root.value-changed(round(value)); }
        }
        Text {
            text: "\{round(root.value)}";
            width: 24px;
            color: DesignTokens.text-secondary;
            font-size: 10px;
            horizontal-alignment: right;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component ToolButton inherits Rectangle {
    in property <Icon> icon;
    in property <image> icon-svg;
    in property <string> semantic-label;
    in property <string> shortcut: "";
    in property <string> description: "";
    in property <string> hint: "";
    in property <bool> active;
    in property <bool> double-tap-armed: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.semantic-label;
    forward-focus: tool-focus;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: active ? DesignTokens.accent : (touch-area.pressed ? DesignTokens.surface-pressed : (touch-area.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-hover.with-alpha(0)));
    animate background { duration: Motion.fast; easing: ease-out; }
    animate border-color { duration: Motion.fast; easing: ease-out; }
    transform-scale: touch-area.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: Motion.fast; easing: ease-out; }
    border-width: tool-focus.has-focus ? 2px : (root.double-tap-armed ? 2px : ((!active && touch-area.has-hover) ? 1px : 0px));
    border-color: root.double-tap-armed ? #ffd54f : DesignTokens.focus-ring;

    if root.icon-svg.width > 0: Image {
        source: root.icon-svg;
        colorize: root.active ? DesignTokens.on-accent : DesignTokens.text-primary;
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    if root.icon-svg.width == 0: IconDisplay {
        icon: root.icon;
        size: 16px;
        stroke: active ? DesignTokens.on-accent : DesignTokens.text-primary;
    }
    tool-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
        touch-area := TouchArea {
            clicked => { root.clicked(); }
            Tooltip {
                RichTooltip {
                    title: root.semantic-label;
                    shortcut: root.shortcut;
                    description: root.description;
                    hint: root.hint;
                }
            }
        }
    }
}

component ColorSwatch inherits Rectangle {
    in property <color> swatch-color;
    in property <bool> selected;
    callback clicked;

    accessible-role: button;
    accessible-label: Tr.t("sl.color_swatch");
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: root.swatch-color;
    border-width: selected ? 2px : 1px;
    border-color: selected ? DesignTokens.accent : DesignTokens.border;

    TouchArea {
        clicked => { root.clicked(); }
        Tooltip {
            RichTooltip {
                title: Tr.t("sl.color_swatch");
                description: Tr.t("sl.click_to_select_or_modify_active_color");
            }
        }
    }
}

component NumericField inherits Rectangle {
    in property <string> label: "X";
    in property <string> full-label: root.label;
    in property <string> shortcut: "";
    in property <string> description: "";
    in property <string> hint: Tr.t("sl.click_to_enter_value_drag_to_adjust_shift_fo");
    in property <float> value: 0.0;
    in property <float> step: 0.1;
    in property <color> label-color: DesignTokens.axis-x;
    callback scrubbed(float, bool);
    callback scrub-started;
    callback scrub-finished;
    callback scrub-cancelled(float);
    callback text-committed(string) -> bool;
    property <bool> editing: false;
    property <bool> invalid: false;
    property <string> draft;

    min-height: 28px;
    max-height: 28px;

    accessible-role: spinbox;
    accessible-label: root.full-label;
    accessible-value: Math.round(root.value * 100) / 100;
    forward-focus: field-focus;
    border-radius: 4px;
    background: touch.pressed ? DesignTokens.surface-hover : DesignTokens.surface-raised;
    border-width: field-focus.has-focus ? 2px : 1px;
    border-color: root.invalid ? DesignTokens.danger : (field-focus.has-focus ? DesignTokens.focus-ring : (root.editing || touch.is-scrubbing ? DesignTokens.accent : DesignTokens.border));

    field-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape && touch.is-scrubbing {
                touch.cancel-gesture();
                return accept;
            }
            if !root.editing && (event.text == Key.Return || event.text == Key.UpArrow || event.text == Key.DownArrow) {
                root.draft = root.value;
                root.invalid = false;
                root.editing = true;
                return accept;
            }
            reject
        }
        // Preenchimento do virtual slider durante o scrubbing (estilo Cinema 4D / Blender)
        if touch.is-scrubbing: Rectangle {
            x: 0;
            y: 0;
            width: Math.clamp(touch.mouse-x, 4px, parent.width);
            height: 100%;
            border-radius: 3px;
            background: (root.label-color != transparent && root.label-color != DesignTokens.text-primary ? root.label-color : DesignTokens.accent).transparentize(0.78);
        }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 4px;
            alignment: center;
            Text {
                text: root.label;
                color: root.label-color;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
                width: root.label == "" ? 0px : 10px;
            }
            if !root.editing: Text {
                text: Math.round(root.value * 100) / 100;
                color: DesignTokens.text-primary;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
                horizontal-stretch: 1;
            }
            if root.editing: TextInput {
                text <=> root.draft;
                color: DesignTokens.text-primary;
                font-size: 11px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                init => { self.focus(); self.select-all(); }
                edited => { root.invalid = false; }
                changed has-focus => {
                    if !self.has-focus && root.editing {
                        root.editing = false;
                        root.invalid = !root.text-committed(self.text);
                    }
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.editing = false;
                        root.invalid = false;
                        field-focus.focus();
                        return accept;
                    }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow {
                        // Arrow edits stay in the draft until Enter or focus loss.
                        self.text = self.text.to-float() + (event.text == Key.UpArrow ? 1 : -1) * root.step * (event.modifiers.shift ? 0.1 : 1);
                        return accept;
                    }
                    reject
                }
                accepted => {
                    root.invalid = !root.text-committed(self.text);
                    if !root.invalid { root.editing = false; field-focus.focus(); }
                }
            }
        }
        touch := TouchArea {
            enabled: !root.editing;
            mouse-cursor: ew-resize;
            Tooltip {
                RichTooltip {
                    title: root.full-label != "" ? root.full-label : root.label;
                    shortcut: root.shortcut;
                    description: root.description != "" ? root.description : Tr.t("sl.numeric_property_field");
                    hint: root.hint;
                }
            }
            property <length> start-x;
            property <length> last-x;
            property <float> original-value;
            property <bool> is-fine: false;
            property <bool> is-scrubbing: false;
            property <bool> was-drag: false;
            property <bool> cancelled: false;
            function cancel-gesture() {
                if is-scrubbing { root.scrub-cancelled(original-value); }
                is-scrubbing = false;
                cancelled = true;
                was-drag = true;
            }
            pointer-event(event) => {
                is-fine = event.modifiers.shift;
                if event.kind == PointerEventKind.cancel || (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                    self.cancel-gesture();
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    field-focus.focus();
                    start-x = self.mouse-x;
                    last-x = self.mouse-x;
                    original-value = root.value;
                    was-drag = false;
                    cancelled = false;
                    root.invalid = false;
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    if is-scrubbing { root.scrub-finished(); }
                    is-scrubbing = false;
                }
            }
            moved => {
                if self.pressed && !cancelled {
                    if !is-scrubbing && Math.abs(self.mouse-x - start-x) > 3px {
                        is-scrubbing = true;
                        was-drag = true;
                        root.scrub-started();
                    }
                    if is-scrubbing {
                        root.scrubbed((self.mouse-x - last-x) / 1px, is-fine);
                        last-x = self.mouse-x;
                    }
                }
            }
            clicked => {
                if !was-drag {
                    root.draft = root.value;
                    root.editing = true;
                }
            }
        }
    }
}

component Vector3Field inherits HorizontalLayout {
    in property <string> row-label: Tr.t("sl.position");
    in property <string> field-hint: "";
    in property <float> x-value: 0.0;
    in property <float> y-value: 0.0;
    in property <float> z-value: 0.0;
    callback scrubbed(int, float, bool);
    callback scrub-started;
    callback scrub-finished;
    callback text-committed(int, string) -> bool;
    callback scrub-cancelled;
    in property <float> step: 0.1;

    spacing: 6px;
    alignment: center;
    height: 28px;

    Text {
        text: root.row-label;
        color: DesignTokens.text-secondary;
        font-size: 11px;
        min-width: 52px;
        max-width: 52px;
        vertical-alignment: center;
    }

    NumericField {
        label: "X";
        full-label: "\{root.row-label} X";
        description: root.field-hint;
        value: root.x-value;
        label-color: DesignTokens.axis-x;
        horizontal-stretch: 1;
        scrubbed(delta, fine) => { root.scrubbed(0, delta, fine); }
        scrub-started => { root.scrub-started(); }
        scrub-finished => { root.scrub-finished(); }
        text-committed(text) => { root.text-committed(0, text) }
        scrub-cancelled(_value) => { root.scrub-cancelled(); }
        step: root.step;
    }
    NumericField {
        label: "Y";
        full-label: "\{root.row-label} Y";
        description: root.field-hint;
        value: root.y-value;
        label-color: DesignTokens.axis-y;
        horizontal-stretch: 1;
        scrubbed(delta, fine) => { root.scrubbed(1, delta, fine); }
        scrub-started => { root.scrub-started(); }
        scrub-finished => { root.scrub-finished(); }
        text-committed(text) => { root.text-committed(1, text) }
        scrub-cancelled(_value) => { root.scrub-cancelled(); }
        step: root.step;
    }
    NumericField {
        label: "Z";
        full-label: "\{root.row-label} Z";
        description: root.field-hint;
        value: root.z-value;
        label-color: DesignTokens.axis-z;
        horizontal-stretch: 1;
        scrubbed(delta, fine) => { root.scrubbed(2, delta, fine); }
        scrub-started => { root.scrub-started(); }
        scrub-finished => { root.scrub-finished(); }
        text-committed(text) => { root.text-committed(2, text) }
        scrub-cancelled(_value) => { root.scrub-cancelled(); }
        step: root.step;
    }
}

component InspectorSection inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    in property <bool> open: true;
    in property <string> section-id: "";
    in property <bool> pin-open: false;
    callback toggled;
    callback toggle-all;
    callback pin-toggled(string);
    toggle-all => { root.toggled(); }

    width: 100%;
    height: root.open ? section-layout.preferred-height : 36px;
    animate height { duration: Motion.medium; easing: ease-in-out; }
    clip: true;
    vertical-stretch: 0;
    border-radius: 8px;
    background: DesignTokens.surface-raised.with-alpha(0.96);
    border-width: 1px;
    border-color: DesignTokens.border-strong;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000077;
    drop-shadow-offset-y: 3px;

    section-layout := VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;

        HorizontalLayout {
            height: 28px;
            spacing: 4px;
            alignment: center;

            header-toggle := Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-width: section-focus.has-focus ? 1px : 0px;
                border-color: DesignTokens.focus-ring;
                border-radius: 4px;
                accessible-role: button;
                accessible-label: root.title;
                accessible-expanded: root.open;
                forward-focus: section-focus;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 6px;
                    alignment: start;
                    IconDisplay {
                        icon: root.open ? IconSet.ChevronDown : IconSet.ChevronRight;
                        size: 12px;
                        stroke: DesignTokens.text-muted;
                    }
                    Text {
                        text: root.title;
                        color: DesignTokens.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                }

                section-focus := FocusScope {
                    width: 100%;
                    height: 100%;
                    key-pressed(event) => {
                        if event.text == Key.Return || event.text == " " { root.toggled(); return accept; }
                        reject
                    }
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        property <bool> alt-down: false;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                self.alt-down = event.modifiers.alt;
                            }
                        }
                        clicked => {
                            if self.alt-down { root.toggle-all(); } else { root.toggled(); }
                            self.alt-down = false;
                        }
                        Tooltip {
                            RichTooltip {
                                title: root.title;
                                description: root.description != "" ? root.description : (root.open ? Tr.t("sl.click_to_collapse_section") : Tr.t("sl.click_to_expand_section"));
                                hint: Tr.t("sl.hold_alt_and_click_to_toggle_all_sections");
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: root.pin-open ? DesignTokens.accent : (pin-touch.has-hover ? DesignTokens.surface-hover : transparent);
                border-width: pin-focus.has-focus ? 2px : 0px;
                border-color: DesignTokens.focus-ring;
                accessible-role: button;
                accessible-label: root.pin-open ? Tr.t("sl.unpin_section") : Tr.t("sl.pin_section");
                accessible-checked: root.pin-open;
                accessible-action-default => { root.pin-toggled(root.section-id); }
                pin-focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.Return || event.text == " " { root.pin-toggled(root.section-id); return accept; }
                        reject
                    }
                }
                IconDisplay {
                    icon: IconSet.Pin;
                    size: 11px;
                    stroke: root.pin-open ? DesignTokens.on-accent : DesignTokens.text-secondary;
                }
                pin-touch := TouchArea {
                    clicked => { root.pin-toggled(root.section-id); }
                    Tooltip {
                        VerticalLayout {
                            padding: 6px;
                            Text { text: root.pin-open ? Tr.t("sl.pinned_open") : Tr.t("sl.pin_section_open"); color: DesignTokens.text-primary; font-size: 10px; font-weight: 600; }
                        }
                    }
                }
            }
        }

        if root.open: Rectangle {
            height: 1px;
            background: DesignTokens.border;
        }

        VerticalLayout {
            visible: root.open;
            @children
        }
    }
}


/// Pílula de ícone do rail colapsado do Inspector: 36px, separada das
/// vizinhas, com hover visível e Tooltip com o nome da seção.
component InspectorPill inherits Rectangle {
    in property <Icon> icon;
    in property <image> icon-svg;
    in property <string> semantic-label;
    in property <string> description: "";
    in property <bool> active: false;
    in property <string> section-id: "";
    out property <bool> has-hover: pill-touch.has-hover;
    /// Incrementar move o foco de teclado para esta pílula (usado por F6).
    in property <int> focus-token: 0;
    callback clicked;
    callback hovered(string);
    changed focus-token => { pill-focus.focus(); }

    accessible-role: button;
    accessible-label: root.semantic-label;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: root.active ? DesignTokens.accent : (pill-touch.has-hover ? DesignTokens.surface-hover : transparent);
    border-width: pill-touch.has-hover || root.active || pill-focus.has-focus ? (pill-focus.has-focus ? 2px : 1px) : 0px;
    border-color: DesignTokens.focus-ring;

    // Teclado: Tab foca a pílula (e abre o peek), Enter/Espaço fixa ou solta a seção.
    pill-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.clicked(); return accept; }
            reject
        }
        changed has-focus => {
            if self.has-focus { root.hovered(root.section-id); }
        }
    }

    if root.icon-svg.width > 0: Image {
        source: root.icon-svg;
        colorize: root.active ? DesignTokens.on-accent : DesignTokens.text-primary;
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    if root.icon-svg.width == 0: IconDisplay {
        icon: root.icon;
        size: 17px;
        stroke: root.active ? DesignTokens.on-accent : DesignTokens.text-primary;
    }

    pill-touch := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover {
                root.hovered(root.section-id);
            }
        }
        Tooltip {
            RichTooltip {
                title: root.semantic-label;
                description: root.description;
                hint: root.active ? Tr.t("sl.click_to_unpin_section") : Tr.t("sl.click_to_pin_section_open");
            }
        }
    }
}


/// Floating Inspector section card: drag header to move, pin to keep open or
/// to an asset, dock button returns it to the column. Body via @children so
/// each section is defined once and instantiated docked + floating.
/// Corpo da seção Transform: definido uma vez, instanciado ancorado + flutuante.
/// Transform section body: defined once, instantiated docked + floating.
component TransformBody inherits VerticalLayout {
    in property <string> field-hint;
    in property <float> pos-x;
    in property <float> pos-y;
    in property <float> pos-z;
    in property <float> rot-x;
    in property <float> rot-y;
    in property <float> rot-z;
    in property <float> scale-x;
    in property <float> scale-y;
    in property <float> scale-z;
    callback scrubbed(string, int, float, bool);
    callback scrub-started(string);
    callback scrub-finished;
    callback text-committed(string, int, string) -> bool;
    callback scrub-cancelled;

    spacing: 6px;
    padding-top: 4px;
    Vector3Field {
        row-label: Tr.t("sl.position");
        field-hint: root.field-hint;
        x-value: root.pos-x;
        y-value: root.pos-y;
        z-value: root.pos-z;
        scrubbed(axis, delta, fine) => { root.scrubbed("pos", axis, delta, fine); }
        scrub-started => { root.scrub-started("pos"); }
        scrub-finished => { root.scrub-finished(); }
        text-committed(axis, text) => { root.text-committed("pos", axis, text) }
        scrub-cancelled => { root.scrub-cancelled(); }
    }
    Vector3Field {
        row-label: Tr.t("sl.rotation");
        field-hint: root.field-hint;
        step: 1;
        x-value: root.rot-x;
        y-value: root.rot-y;
        z-value: root.rot-z;
        scrubbed(axis, delta, fine) => { root.scrubbed("rot", axis, delta, fine); }
        scrub-started => { root.scrub-started("rot"); }
        scrub-finished => { root.scrub-finished(); }
        text-committed(axis, text) => { root.text-committed("rot", axis, text) }
        scrub-cancelled => { root.scrub-cancelled(); }
    }
    Vector3Field {
        row-label: Tr.t("sl.scale");
        field-hint: root.field-hint;
        x-value: root.scale-x;
        y-value: root.scale-y;
        z-value: root.scale-z;
        scrubbed(axis, delta, fine) => { root.scrubbed("scale", axis, delta, fine); }
        scrub-started => { root.scrub-started("scale"); }
        scrub-finished => { root.scrub-finished(); }
        text-committed(axis, text) => { root.text-committed("scale", axis, text) }
        scrub-cancelled => { root.scrub-cancelled(); }
    }
}

/// Corpo da seção Quick Actions: definido uma vez, instanciado ancorado + flutuante.
/// Quick Actions section body: defined once, instantiated docked + floating.
component QuickActionsBody inherits VerticalLayout {
    in property <string> title-label;
    in-out property <bool> customize-open: false;
    in property <[QuickActionEntry]> actions;
    in property <[QuickActionEntry]> candidates;
    in property <string> customize-label;
    in property <string> remove-label;
    in property <string> add-label;
    in property <string> reset-label;
    in property <string> done-label;
    callback action-executed(string);
    callback action-toggled(string);
    callback actions-reset;

    spacing: 6px;
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: 6px;
        height: 28px;
        Text {
            text: root.title-label;
            color: DesignTokens.text-secondary;
            font-size: 10px;
            font-weight: 700;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Rectangle {
            width: 28px;
            height: 24px;
            border-radius: 4px;
            background: root.customize-open ? DesignTokens.accent : DesignTokens.surface-raised;
            IconDisplay {
                icon: IconSet.Settings2;
                size: 12px;
                stroke: root.customize-open ? DesignTokens.on-accent : DesignTokens.text-primary;
            }
            TouchArea { clicked => { root.customize-open = !root.customize-open; } }
        }
    }
    for action in root.actions: Rectangle {
        width: 100%;
        height: 28px;
        border-radius: 4px;
        background: action.enabled ? DesignTokens.surface-raised : DesignTokens.surface;
        border-width: 1px;
        border-color: DesignTokens.border;
        Text {
            text: action.label;
            color: action.enabled ? DesignTokens.text-primary : DesignTokens.text-muted;
            font-size: 10px;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea { clicked => { root.action-executed(action.id); } }
    }
    if root.customize-open: Rectangle {
        background: DesignTokens.surface;
        border-radius: 5px;
        border-width: 1px;
        border-color: DesignTokens.border;
        VerticalLayout {
            spacing: 4px;
            padding: 6px;
            Text {
                text: root.customize-label;
                color: DesignTokens.text-secondary;
                font-size: 10px;
                font-weight: 700;
            }
            for candidate in root.candidates: Rectangle {
                height: 26px;
                border-radius: 4px;
                background: candidate.pinned ? DesignTokens.surface-hover : transparent;
                Text {
                    text: candidate.label;
                    color: DesignTokens.text-primary;
                    font-size: 10px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: candidate.pinned ? root.remove-label : root.add-label;
                    color: DesignTokens.accent;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.action-toggled(candidate.id); } }
            }
            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 24px;
                    border-radius: 4px;
                    background: DesignTokens.surface-raised;
                    Text { text: root.reset-label; color: DesignTokens.text-secondary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.actions-reset(); } }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 24px;
                    border-radius: 4px;
                    background: DesignTokens.accent;
                    Text { text: root.done-label; color: DesignTokens.on-accent; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.customize-open = false; } }
                }
            }
        }
    }
}

/// Corpo da seção Parts: definido uma vez, instanciado ancorado + flutuante.
/// Parts section body: defined once, instantiated docked + floating.
component PartsBody inherits VerticalLayout {
    in property <string> search-label;
    in property <string> selected-only-label;
    in property <string> sort-label;
    in-out property <string> query;
    in-out property <bool> selected-only: false;
    in-out property <bool> sort-by-name: false;
    in property <[SceneItem]> items;
    in property <int> total-count;
    in property <string> row-size-label;
    in-out property <float> row-height: 28.0;
    in property <string> list-label;
    in property <string> hide-label;
    in property <string> show-label;
    in property <string> lock-label;
    in property <string> unlock-label;
    in property <bool> rename-active: false;
    in property <string> rename-value;
    callback query-changed(string);
    callback selected-only-changed(bool);
    callback sort-changed(bool);
    callback row-height-changed(float);
    callback scene-select(string, bool);
    callback scene-toggle-visibility(string);
    callback scene-toggle-lock(string);
    callback scene-context-requested(string, float, float);
    callback rename-edited(string);
    callback rename-committed(string);
    spacing: 6px;
    PartsFilterRow {
        horizontal-stretch: 1;
        search-label: root.search-label;
        selected-only-label: root.selected-only-label;
        sort-label: root.sort-label;
        query <=> root.query;
        selected-only <=> root.selected-only;
        sort-by-name <=> root.sort-by-name;
        visible-count: root.items.length;
        total-count: root.total-count;
        query-changed(query) => { root.query-changed(query); }
        selected-only-changed(enabled) => { root.selected-only-changed(enabled); }
        sort-changed(enabled) => { root.sort-changed(enabled); }
    }
    PartsRowSizeControl {
        horizontal-stretch: 1;
        semantic-label: root.row-size-label;
        accessibility-id: "model-inspector-parts-row-height";
        value <=> root.row-height;
        value-changed(value) => { root.row-height-changed(value); }
    }
    ListView {
        height: min(184px, max(32px, root.items.length * root.row-height * 1px));
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: as-needed;
        accessible-role: list;
        accessible-label: root.list-label;
        accessible-id: "model-inspector-parts-list";
        accessible-item-count: root.items.length;
        for item in root.items: Rectangle {
            height: root.row-height * 1px;
            accessible-role: list-item;
            accessible-label: item.name;
            accessible-item-selectable: true;
            accessible-item-selected: item.selected;
            background: item.selected ? DesignTokens.surface-hover : transparent;
            border-width: item.active ? 1px : 0px;
            border-color: item.active ? DesignTokens.selection-active : DesignTokens.selection;
            border-radius: 4px;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 4px;
                spacing: 4px;
                alignment: center;
                TouchArea {
                    property <bool> extend: false;
                    horizontal-stretch: 1;
                    pointer-event(event) => {
                        self.extend = event.modifiers.shift;
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            root.scene-context-requested(item.id, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
                        }
                    }
                    clicked => { root.scene-select(item.id, self.extend); }
                    HorizontalLayout {
                        spacing: 5px;
                        alignment: center;
                        IconDisplay { icon: IconSet.Box; size: 12px; stroke: item.selected ? DesignTokens.accent : DesignTokens.text-muted; }
                        if root.rename-active && item.selected: TextInput {
                            text: root.rename-value;
                            horizontal-stretch: 1;
                            font-size: 11px;
                            color: DesignTokens.text-primary;
                            single-line: true;
                            init => { self.focus(); }
                            edited => { root.rename-edited(self.text); }
                            accepted => { root.rename-committed(self.text); }
                        }
                        if !(root.rename-active && item.selected): Text {
                            text: item.name;
                            color: item.selected ? DesignTokens.text-primary : DesignTokens.text-secondary;
                            font-size: 11px;
                            font-weight: item.selected ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
                Rectangle {
                    width: 22px; height: 22px;
                    accessible-role: button;
                    accessible-label: item.visible ? root.hide-label : root.show-label;
                    IconDisplay { icon: item.visible ? IconSet.Eye : IconSet.EyeOff; size: 13px; stroke: item.visible ? DesignTokens.text-secondary : DesignTokens.text-muted; }
                    TouchArea { clicked => { root.scene-toggle-visibility(item.id); } }
                }
                Rectangle {
                    width: 22px; height: 22px;
                    accessible-role: button;
                    accessible-label: item.locked ? root.unlock-label : root.lock-label;
                    IconDisplay { icon: item.locked ? IconSet.Lock : IconSet.LockOpen; size: 13px; stroke: item.locked ? DesignTokens.accent : DesignTokens.text-muted; }
                    TouchArea { clicked => { root.scene-toggle-lock(item.id); } }
                }
            }
        }
    }
}

/// Corpo da seção Material: definido uma vez, instanciado ancorado + flutuante.
/// Material section body: defined once, instantiated docked + floating.
component MaterialBody inherits VerticalLayout {
    in property <string> active-name;
    in-out property <int> active-slot: 0;
    in property <[string]> slots;
    in property <string> profile;
    in property <color> base-color;
    in property <[color]> palette;
    in property <float> roughness;
    in property <float> metallic;
    in property <float> emission-strength;
    in-out property <bool> advanced-open: false;
    in property <float> normal-scale;
    in property <string> alpha-mode;
    in property <float> alpha-cutoff;
    in property <bool> has-albedo;
    in property <string> albedo-text-label;
    in property <string> assign-label;
    in property <string> new-label;
    in property <string> duplicate-label;
    in property <string> remove-label;
    in property <string> profile-label;
    in property <string> profile-pbr-label;
    in property <string> profile-unlit-label;
    in property <string> profile-toon-label;
    in property <string> profile-glass-label;
    in property <string> profile-emissive-label;
    in property <string> base-color-label;
    in property <string> roughness-label;
    in property <string> metallic-label;
    in property <string> emission-label;
    in property <string> advanced-label;
    in property <string> normal-scale-label;
    in property <string> alpha-mode-label;
    in property <string> alpha-opaque-label;
    in property <string> alpha-mask-label;
    in property <string> alpha-blend-label;
    in property <string> alpha-cutoff-label;
    in property <string> albedo-label;
    in property <string> create-texture-label;
    in property <string> clear-texture-label;
    in property <string> no-texture-label;
    callback assign-material-slot(int);
    callback create-material;
    callback duplicate-material(int);
    callback remove-material(int);
    callback material-slot-selected(int);
    callback material-base-color-changed(float, float, float);
    callback material-scalar-committed(string, int, string) -> bool;
    callback material-profile-changed(int);
    callback material-alpha-mode-changed(int);
    callback material-albedo-create;
    callback material-albedo-clear;

    spacing: 8px;
    padding-top: 4px;

    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 4px;
            background: root.base-color;
            border-width: 1px;
            border-color: DesignTokens.border-strong;
        }

        Text {
            text: root.slots.length > 0 && root.active-slot < root.slots.length
            ? root.slots[root.active-slot]
            : root.active-name;
            color: DesignTokens.text-primary;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 4px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            accessible-role: button;
            accessible-label: root.new-label;
            IconDisplay { icon: IconSet.Plus; size: 13px; stroke: DesignTokens.text-primary; }
            TouchArea {
                clicked => { root.create-material(); }
                Tooltip {
                    VerticalLayout {
                        padding: 8px; spacing: 2px;
                        Text { text: root.new-label; color: DesignTokens.text-primary; font-size: 11px; font-weight: 700; }
                    }
                }
            }
        }

        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 4px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            accessible-role: button;
            accessible-label: root.duplicate-label;
            IconDisplay { icon: IconSet.Copy; size: 13px; stroke: DesignTokens.text-primary; }
            TouchArea {
                clicked => { root.duplicate-material(root.active-slot); }
                Tooltip {
                    VerticalLayout {
                        padding: 8px; spacing: 2px;
                        Text { text: root.duplicate-label; color: DesignTokens.text-primary; font-size: 11px; font-weight: 700; }
                    }
                }
            }
        }

        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 4px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            accessible-role: button;
            accessible-label: root.remove-label;
            IconDisplay { icon: IconSet.Trash2; size: 13px; stroke: DesignTokens.danger; }
            TouchArea {
                clicked => { root.remove-material(root.active-slot); }
                Tooltip {
                    VerticalLayout {
                        padding: 8px; spacing: 2px;
                        Text { text: root.remove-label; color: DesignTokens.text-primary; font-size: 11px; font-weight: 700; }
                    }
                }
            }
        }
    }

    // Material slot selector list
    if root.slots.length > 1: VerticalLayout {
        spacing: 4px;
        for slot[index] in root.slots: Rectangle {
            height: 24px;
            border-radius: 4px;
            background: index == root.active-slot ? DesignTokens.surface-hover : DesignTokens.surface-raised;
            border-width: 1px;
            border-color: index == root.active-slot ? DesignTokens.accent : DesignTokens.border;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                spacing: 6px;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 2px;
                    background: index == root.active-slot ? DesignTokens.accent : DesignTokens.text-muted;
                }
                Text {
                    text: slot;
                    color: index == root.active-slot ? DesignTokens.text-primary : DesignTokens.text-secondary;
                    font-size: 10px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                clicked => {
                    root.active-slot = index;
                    root.material-slot-selected(index);
                }
            }
        }
    }

    // Assign primeiro: fluxo slot → atribuir → editar.
    Rectangle {
        height: 28px;
        border-radius: 5px;
        background: DesignTokens.accent;
        accessible-role: button;
        accessible-label: root.assign-label;
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            IconDisplay {
                icon: IconSet.Check;
                size: 12px;
                stroke: DesignTokens.on-accent;
            }
            Text {
                text: root.assign-label;
                color: DesignTokens.on-accent;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        TouchArea {
            clicked => { root.assign-material-slot(root.active-slot); }
        }
    }

    HorizontalLayout {
        spacing: 6px;
        height: 28px;
        Text {
            text: root.profile-label;
            color: DesignTokens.text-secondary;
            font-size: 10px;
            width: 64px;
            vertical-alignment: center;
        }
        for profile[index] in [
        { id: "pbr", label: root.profile-pbr-label },
        { id: "unlit", label: root.profile-unlit-label },
        { id: "toon", label: root.profile-toon-label },
        { id: "glass", label: root.profile-glass-label },
        { id: "emissive", label: root.profile-emissive-label },
        ]: Rectangle {
            horizontal-stretch: 1;
            height: 26px;
            border-radius: 4px;
            background: root.profile == profile.id ? DesignTokens.accent : DesignTokens.surface-raised;
            border-width: 1px;
            border-color: root.profile == profile.id ? DesignTokens.accent : DesignTokens.border;
            Text {
                text: profile.label;
                color: root.profile == profile.id ? DesignTokens.on-accent : DesignTokens.text-secondary;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea { clicked => { root.material-profile-changed(index); } }
        }
    }

    HorizontalLayout {
        spacing: 6px;
        height: 28px;
        Text {
            text: root.base-color-label;
            color: DesignTokens.text-secondary;
            font-size: 10px;
            width: 64px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 4px;
            background: root.base-color;
            border-width: 1px;
            border-color: DesignTokens.border-strong;
        }
        for swatch[index] in root.palette: ColorSwatch {
            swatch-color: swatch;
            selected: swatch == root.base-color;
            clicked => {
                root.material-base-color-changed(swatch.red, swatch.green, swatch.blue);
            }
        }
    }

    HorizontalLayout {
        spacing: 6px;
        height: 28px;
        Text {
            text: root.roughness-label;
            color: DesignTokens.text-secondary;
            font-size: 10px;
            width: 64px;
            vertical-alignment: center;
        }
        NumericField {
            label: "";
            value: root.roughness;
            step: 0.01;
            horizontal-stretch: 1;
            text-committed(text) => { root.material-scalar-committed("roughness", root.active-slot, text); }
        }
        Text {
            text: root.metallic-label;
            color: DesignTokens.text-secondary;
            font-size: 10px;
            width: 64px;
            vertical-alignment: center;
        }
        NumericField {
            label: "";
            value: root.metallic;
            step: 0.01;
            horizontal-stretch: 1;
            text-committed(text) => { root.material-scalar-committed("metallic", root.active-slot, text); }
        }
    }

    if root.profile == "emissive" || root.profile == "pbr": HorizontalLayout {
        spacing: 6px;
        height: 28px;
        Text {
            text: root.emission-label;
            color: DesignTokens.text-secondary;
            font-size: 10px;
            width: 64px;
            vertical-alignment: center;
        }
        NumericField {
            label: "";
            value: root.emission-strength;
            step: 0.05;
            horizontal-stretch: 1;
            text-committed(text) => { root.material-scalar-committed("emission-strength", root.active-slot, text); }
        }
    }


    // Avançado: Normal, Alfa e Cutoff.
    Rectangle {
        height: 24px;
        border-radius: 4px;
        background: DesignTokens.surface;
        Text {
            text: root.advanced-label;
            color: DesignTokens.text-secondary;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea { clicked => { root.advanced-open = !root.advanced-open; } }
    }
    if root.advanced-open: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            height: 28px;
            Text {
                text: root.normal-scale-label;
                color: DesignTokens.text-secondary;
                font-size: 10px;
                width: 64px;
                vertical-alignment: center;
            }
            NumericField {
                label: "";
                value: root.normal-scale;
                step: 0.01;
                horizontal-stretch: 1;
                text-committed(text) => { root.material-scalar-committed("normal-scale", root.active-slot, text); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            height: 28px;
            Text {
                text: root.alpha-mode-label;
                color: DesignTokens.text-secondary;
                font-size: 10px;
                width: 64px;
                vertical-alignment: center;
            }
            for alpha[index] in [
            { id: "opaque", label: root.alpha-opaque-label },
            { id: "mask", label: root.alpha-mask-label },
            { id: "blend", label: root.alpha-blend-label },
            ]: Rectangle {
                horizontal-stretch: 1;
                height: 26px;
                border-radius: 4px;
                background: root.alpha-mode == alpha.id ? DesignTokens.accent : DesignTokens.surface-raised;
                border-width: 1px;
                border-color: root.alpha-mode == alpha.id ? DesignTokens.accent : DesignTokens.border;
                Text {
                    text: alpha.label;
                    color: root.alpha-mode == alpha.id ? DesignTokens.on-accent : DesignTokens.text-secondary;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea { clicked => { root.material-alpha-mode-changed(index); } }
            }
        }
        if root.alpha-mode == "mask": HorizontalLayout {
            spacing: 6px;
            height: 28px;
            Text {
                text: root.alpha-cutoff-label;
                color: DesignTokens.text-secondary;
                font-size: 10px;
                width: 64px;
                vertical-alignment: center;
            }
            NumericField {
                label: "";
                value: root.alpha-cutoff;
                step: 0.01;
                horizontal-stretch: 1;
                text-committed(text) => { root.material-scalar-committed("alpha-cutoff", root.active-slot, text); }
            }
        }
    }

    Rectangle {
        height: 26px;
        border-radius: 4px;
        background: DesignTokens.surface;
        border-width: 1px;
        border-color: DesignTokens.border;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: center;
            Text {
                text: root.albedo-label;
                color: DesignTokens.text-secondary;
                font-size: 10px;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Text {
                text: root.has-albedo ? root.albedo-text-label : root.no-texture-label;
                color: root.has-albedo ? DesignTokens.text-primary : DesignTokens.text-muted;
                font-size: 10px;
                vertical-alignment: center;
            }
            Rectangle {
                width: 74px;
                height: 22px;
                border-radius: 4px;
                background: root.has-albedo ? DesignTokens.surface-raised : DesignTokens.accent;
                Text {
                    text: root.has-albedo ? root.clear-texture-label : root.create-texture-label;
                    color: root.has-albedo ? DesignTokens.text-primary : DesignTokens.on-accent;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        if root.has-albedo { root.material-albedo-clear(); } else { root.material-albedo-create(); }
                    }
                }
            }
        }
    }


}

/// Corpo da seção Object: definido uma vez, instanciado ancorado + flutuante.
/// Object section body: defined once, instantiated docked + floating.
component ObjectBody inherits VerticalLayout {
    in property <bool> has-selection: false;
    in property <string> object-name;
    in property <string> object-id;
    in property <bool> object-visible: true;
    in property <bool> object-locked: false;
    in property <int> object-verts: 0;
    in property <int> object-faces: 0;
    in property <int> object-tris: 0;
    in property <string> no-selection-label;
    in property <string> verts-label;
    in property <string> faces-label;
    in property <string> tris-label;
    in property <string> duplicate-label;
    in property <string> delete-label;
    in property <bool> is-parametric: false;
    in property <string> primitive-kind: "";
    in property <float> primitive-radius: 1.0;
    in property <float> primitive-radius-b: 1.0;
    in property <float> primitive-height: 2.0;
    in property <float> primitive-depth: 1.0;
    in property <float> primitive-width: 1.0;
    in property <int> primitive-sides: 8;
    in property <int> primitive-rings: 6;
    in property <int> primitive-subdiv: 1;
    in property <bool> primitive-cap-top: true;
    in property <bool> primitive-cap-bottom: true;
    in property <bool> primitive-fill-disc: true;
    in property <string> label-parametric-primitive: "Parametric Primitive";
    in property <string> label-freeze-primitive: "Convert to Editable Mesh";
    in property <string> label-freeze-primitive-hint: "Destructive edits auto-convert to mesh";
    callback scene-toggle-visibility(string);
    callback scene-toggle-lock(string);
    callback duplicate-requested;
    callback delete-requested;
    callback primitive-param-float(string, float);
    callback primitive-param-bool(string, bool);
    callback freeze-primitive-requested;

    spacing: 6px;
    vertical-stretch: 0;
    if !root.has-selection: Text {
        text: root.no-selection-label;
        color: DesignTokens.text-muted;
        font-size: 10px;
        wrap: word-wrap;
    }
    if root.has-selection: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            height: 28px;
            Text {
                text: root.object-name;
                color: DesignTokens.text-primary;
                font-size: 12px;
                font-weight: 700;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 4px;
                background: root.object-visible ? DesignTokens.surface-raised : DesignTokens.surface;
                border-width: 1px;
                border-color: root.object-visible ? DesignTokens.border : DesignTokens.disabled;
                accessible-role: button;
                IconDisplay {
                    icon: root.object-visible ? IconSet.Eye : IconSet.EyeOff;
                    size: 13px;
                    stroke: root.object-visible ? DesignTokens.text-primary : DesignTokens.text-muted;
                }
                TouchArea { clicked => { root.scene-toggle-visibility(root.object-id); } }
            }
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 4px;
                background: root.object-locked ? DesignTokens.accent : DesignTokens.surface-raised;
                border-width: 1px;
                border-color: root.object-locked ? DesignTokens.accent : DesignTokens.border;
                accessible-role: button;
                IconDisplay {
                    icon: root.object-locked ? IconSet.Lock : IconSet.LockOpen;
                    size: 13px;
                    stroke: root.object-locked ? DesignTokens.on-accent : DesignTokens.text-primary;
                }
                TouchArea { clicked => { root.scene-toggle-lock(root.object-id); } }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "\{root.verts-label}: \{root.object-verts}   \{root.faces-label}: \{root.object-faces}   \{root.tris-label}: \{root.object-tris}";
                color: DesignTokens.text-muted;
                font-size: 10px;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }
        if root.is-parametric: VerticalLayout {
            spacing: 6px;
            Rectangle {
                height: 1px;
                background: DesignTokens.border;
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.label-parametric-primitive;
                    color: DesignTokens.accent;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    border-radius: 3px;
                    background: DesignTokens.surface-raised;
                    border-width: 1px;
                    border-color: DesignTokens.accent;
                    height: 18px;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.primitive-kind;
                            color: DesignTokens.accent;
                            font-size: 9px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
            if root.primitive-kind == "box" || root.primitive-kind == "wedge": VerticalLayout {
                spacing: 6px;
                NumericField { label: Tr.t("sl.width"); value: root.primitive-width; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("width", root.primitive-width + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("width", t.to-float()); true } }
                NumericField { label: Tr.t("sl.height"); value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                NumericField { label: Tr.t("sl.depth"); value: root.primitive-depth; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("depth", root.primitive-depth + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("depth", t.to-float()); true } }
            }
            if root.primitive-kind == "plane": VerticalLayout {
                spacing: 6px;
                NumericField { label: Tr.t("sl.width"); value: root.primitive-width; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("width", root.primitive-width + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("width", t.to-float()); true } }
                NumericField { label: Tr.t("sl.height"); value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
            }
            if root.primitive-kind == "cylinder": VerticalLayout {
                spacing: 6px;
                NumericField { label: Tr.t("sl.radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                NumericField { label: Tr.t("sl.height"); value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                NumericField { label: Tr.t("sl.sides"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                HorizontalLayout {
                    spacing: 4px; height: 26px;
                    Rectangle {
                        horizontal-stretch: 1; border-radius: 4px;
                        background: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.surface-raised;
                        border-width: 1px; border-color: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.border;
                        Text { text: root.primitive-cap-top ? Tr.t("sl.top_cap_on") : Tr.t("sl.top_cap_off"); color: root.primitive-cap-top ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.primitive-param-bool("cap_top", !root.primitive-cap-top); } }
                    }
                    Rectangle {
                        horizontal-stretch: 1; border-radius: 4px;
                        background: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.surface-raised;
                        border-width: 1px; border-color: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.border;
                        Text { text: root.primitive-cap-bottom ? Tr.t("sl.bottom_cap_on") : Tr.t("sl.bottom_cap_off"); color: root.primitive-cap-bottom ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.primitive-param-bool("cap_bottom", !root.primitive-cap-bottom); } }
                    }
                }
            }
            if root.primitive-kind == "cone": VerticalLayout {
                spacing: 6px;
                NumericField { label: Tr.t("sl.bottom_radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                NumericField { label: Tr.t("sl.top_radius"); value: root.primitive-radius-b; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius_b", root.primitive-radius-b + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius_b", t.to-float()); true } }
                NumericField { label: Tr.t("sl.height"); value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                NumericField { label: Tr.t("sl.sides"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                HorizontalLayout {
                    spacing: 4px; height: 26px;
                    Rectangle {
                        horizontal-stretch: 1; border-radius: 4px;
                        background: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.surface-raised;
                        border-width: 1px; border-color: root.primitive-cap-bottom ? DesignTokens.accent : DesignTokens.border;
                        Text { text: root.primitive-cap-bottom ? Tr.t("sl.base_cap_on") : Tr.t("sl.base_cap_off"); color: root.primitive-cap-bottom ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.primitive-param-bool("cap_bottom", !root.primitive-cap-bottom); } }
                    }
                    Rectangle {
                        horizontal-stretch: 1; border-radius: 4px;
                        background: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.surface-raised;
                        border-width: 1px; border-color: root.primitive-cap-top ? DesignTokens.accent : DesignTokens.border;
                        Text { text: root.primitive-cap-top ? Tr.t("sl.top_cap_on") : Tr.t("sl.top_cap_off"); color: root.primitive-cap-top ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.primitive-param-bool("cap_top", !root.primitive-cap-top); } }
                    }
                }
            }
            if root.primitive-kind == "sphere": VerticalLayout {
                spacing: 6px;
                NumericField { label: Tr.t("sl.radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                NumericField { label: Tr.t("sl.segments"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                NumericField { label: Tr.t("sl.rings"); value: root.primitive-rings; step: 1; scrubbed(d, f) => { root.primitive-param-float("rings", root.primitive-rings + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("rings", t.to-float()); true } }
            }
            if root.primitive-kind == "icosphere": VerticalLayout {
                spacing: 6px;
                NumericField { label: Tr.t("sl.radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                NumericField { label: Tr.t("sl.subdivisions"); value: root.primitive-subdiv; step: 1; scrubbed(d, f) => { root.primitive-param-float("subdiv", root.primitive-subdiv + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("subdiv", t.to-float()); true } }
            }
            if root.primitive-kind == "torus": VerticalLayout {
                spacing: 6px;
                NumericField { label: Tr.t("sl.ring_radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                NumericField { label: Tr.t("sl.pipe_radius"); value: root.primitive-radius-b; step: 0.05; scrubbed(d, f) => { root.primitive-param-float("radius_b", root.primitive-radius-b + d * (f ? 0.005 : 0.05)); } text-committed(t) => { root.primitive-param-float("radius_b", t.to-float()); true } }
                NumericField { label: Tr.t("sl.ring_segments"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                NumericField { label: Tr.t("sl.pipe_segments"); value: root.primitive-rings; step: 1; scrubbed(d, f) => { root.primitive-param-float("rings", root.primitive-rings + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("rings", t.to-float()); true } }
            }
            if root.primitive-kind == "capsule": VerticalLayout {
                spacing: 6px;
                NumericField { label: Tr.t("sl.radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                NumericField { label: Tr.t("sl.height"); value: root.primitive-height; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("height", root.primitive-height + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("height", t.to-float()); true } }
                NumericField { label: Tr.t("sl.sides"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                NumericField { label: Tr.t("sl.cap_rings"); value: root.primitive-rings; step: 1; scrubbed(d, f) => { root.primitive-param-float("rings", root.primitive-rings + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("rings", t.to-float()); true } }
            }
            if root.primitive-kind == "circle": VerticalLayout {
                spacing: 6px;
                NumericField { label: Tr.t("sl.radius"); value: root.primitive-radius; step: 0.1; scrubbed(d, f) => { root.primitive-param-float("radius", root.primitive-radius + d * (f ? 0.01 : 0.1)); } text-committed(t) => { root.primitive-param-float("radius", t.to-float()); true } }
                NumericField { label: Tr.t("sl.vertices"); value: root.primitive-sides; step: 1; scrubbed(d, f) => { root.primitive-param-float("sides", root.primitive-sides + (d > 0 ? 1 : -1)); } text-committed(t) => { root.primitive-param-float("sides", t.to-float()); true } }
                Rectangle {
                    height: 26px; border-radius: 4px;
                    background: root.primitive-fill-disc ? DesignTokens.accent : DesignTokens.surface-raised;
                    border-width: 1px; border-color: root.primitive-fill-disc ? DesignTokens.accent : DesignTokens.border;
                    Text { text: root.primitive-fill-disc ? Tr.t("sl.fill_disc") : Tr.t("sl.fill_open_loop"); color: root.primitive-fill-disc ? DesignTokens.on-accent : DesignTokens.text-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.primitive-param-bool("fill_disc", !root.primitive-fill-disc); } }
                }
            }
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: DesignTokens.border;
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    IconDisplay {
                        icon: IconSet.Box;
                        size: 13px;
                        stroke: DesignTokens.accent;
                    }
                    Text {
                        text: root.label-freeze-primitive;
                        color: DesignTokens.text-primary;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.freeze-primitive-requested(); }
                }
            }
            Text {
                text: root.label-freeze-primitive-hint;
                color: DesignTokens.text-muted;
                font-size: 9px;
                wrap: word-wrap;
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        height: 28px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 5px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                IconDisplay {
                    icon: IconSet.Copy;
                    size: 13px;
                    stroke: DesignTokens.text-primary;
                }
                Text {
                    text: root.duplicate-label;
                    color: DesignTokens.text-primary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                clicked => { root.duplicate-requested(); }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 5px;
            background: DesignTokens.surface-raised;
            border-width: 1px;
            border-color: DesignTokens.border;
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                IconDisplay {
                    icon: IconSet.Trash2;
                    size: 13px;
                    stroke: DesignTokens.danger;
                }
                Text {
                    text: root.delete-label;
                    color: DesignTokens.danger;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                clicked => { root.delete-requested(); }
            }
        }
    }
}

/// Corpo da seção Modifiers: definido uma vez, instanciado ancorado + flutuante.
/// Modifiers section body: defined once, instantiated docked + floating.
component ModifiersBody inherits VerticalLayout {
    in property <[ModifierEntry]> rows;
    in property <string> add-mirror-label;
    in property <string> add-symmetry-label;
    in property <string> apply-label;
    in property <string> direction-label;
    in property <string> neg-to-pos-label;
    in property <string> pos-to-neg-label;
    in property <string> empty-label;
    callback modifier-add(string);
    callback modifier-toggle(string, bool);
    callback modifier-remove(string);
    callback modifier-move(string, int);
    callback modifier-apply(string);
    callback modifier-axis-changed(string, int);
    callback modifier-direction-changed(string, bool);

    spacing: 6px;
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: 4px;
        Rectangle {
            horizontal-stretch: 1;
            height: 26px;
            border-radius: 4px;
            background: DesignTokens.surface-raised;
            Text { text: root.add-mirror-label; color: DesignTokens.text-primary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.modifier-add("mirror"); } }
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 26px;
            border-radius: 4px;
            background: DesignTokens.surface-raised;
            Text { text: root.add-symmetry-label; color: DesignTokens.text-primary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.modifier-add("symmetry"); } }
        }
    }

    if root.rows.length == 0: Text {
        text: root.empty-label;
        color: DesignTokens.text-muted;
        font-size: 10px;
    }
    for modifier in root.rows: Rectangle {
        width: 100%;
        height: modifier.kind == "symmetry" ? 74px : 58px;
        border-radius: 5px;
        background: DesignTokens.surface;
        border-width: 1px;
        border-color: DesignTokens.border;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 4px;
                height: 22px;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    background: modifier.enabled ? DesignTokens.accent : DesignTokens.surface-raised;
                    IconDisplay {
                        icon: IconSet.Monitor;
                        size: 12px;
                        stroke: modifier.enabled ? DesignTokens.on-accent : DesignTokens.text-muted;
                    }
                    TouchArea { clicked => { root.modifier-toggle(modifier.id, !modifier.enabled); } }
                }
                Text {
                    text: modifier.title;
                    color: DesignTokens.text-primary;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 20px;
                    height: 20px;
                    IconDisplay {
                        icon: IconSet.ChevronUp;
                        size: 13px;
                        stroke: modifier.can-move-up ? DesignTokens.text-secondary : DesignTokens.disabled;
                    }
                    TouchArea { clicked => { if modifier.can-move-up { root.modifier-move(modifier.id, -1); } } }
                }
                Rectangle {
                    width: 20px;
                    height: 20px;
                    IconDisplay {
                        icon: IconSet.ChevronDown;
                        size: 13px;
                        stroke: modifier.can-move-down ? DesignTokens.text-secondary : DesignTokens.disabled;
                    }
                    TouchArea { clicked => { if modifier.can-move-down { root.modifier-move(modifier.id, 1); } } }
                }
                Rectangle {
                    width: 20px;
                    height: 20px;
                    IconDisplay {
                        icon: IconSet.X;
                        size: 13px;
                        stroke: DesignTokens.danger;
                    }
                    TouchArea { clicked => { root.modifier-remove(modifier.id); } }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                height: 22px;
                Text {
                    text: modifier.subtitle;
                    color: DesignTokens.text-muted;
                    font-size: 9px;
                    width: 42px;
                    vertical-alignment: center;
                }
                for axis[index] in ["X", "Y", "Z"]: Rectangle {
                    width: 24px;
                    height: 22px;
                    border-radius: 3px;
                    background: modifier.axis == index ? DesignTokens.surface-hover : DesignTokens.surface-raised;
                    Text {
                        text: axis;
                        color: modifier.axis == index ? DesignTokens.accent : DesignTokens.text-secondary;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.modifier-axis-changed(modifier.id, index); } }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 22px;
                    border-radius: 3px;
                    background: DesignTokens.surface-raised;
                    Text { text: root.apply-label; color: DesignTokens.text-primary; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.modifier-apply(modifier.id); } }
                }
            }
            if modifier.kind == "symmetry": HorizontalLayout {
                spacing: 4px;
                height: 22px;
                Text {
                    text: root.direction-label;
                    color: DesignTokens.text-muted;
                    font-size: 9px;
                    width: 42px;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 22px;
                    border-radius: 3px;
                    background: modifier.positive-to-negative ? DesignTokens.surface-hover : DesignTokens.surface-raised;
                    Text { text: root.pos-to-neg-label; color: DesignTokens.text-secondary; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    TouchArea { clicked => { if !modifier.positive-to-negative { root.modifier-direction-changed(modifier.id, true); } } }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 22px;
                    border-radius: 3px;
                    background: !modifier.positive-to-negative ? DesignTokens.surface-hover : DesignTokens.surface-raised;
                    Text { text: root.neg-to-pos-label; color: DesignTokens.text-secondary; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                    TouchArea { clicked => { if modifier.positive-to-negative { root.modifier-direction-changed(modifier.id, false); } } }
                }
            }
        }
    }
}

component ReferenceSlotCard inherits Rectangle {
    in property <ReferenceSlotData> slot;
    callback pick-image();
    callback remove-image();
    callback align-view();
    callback toggle-visible();
    callback toggle-lock();
    callback set-param(string, float);

    in-out property <float> local-opacity: slot.opacity;
    in-out property <float> local-size: slot.size;
    in-out property <float> local-offset: slot.offset;
    changed slot => {
        root.local-opacity = slot.opacity;
        root.local-size = slot.size;
        root.local-offset = slot.offset;
    }

    border-radius: 6px;
    background: DesignTokens.surface;
    border-width: 1px;
    border-color: slot.has-image ? DesignTokens.border-strong : DesignTokens.border;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // Header: Badge + Title + Align + Quick Tools
        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Rectangle {
                    width: 28px;
                    height: 20px;
                    border-radius: 4px;
                    background: DesignTokens.accent.transparentize(0.8);
                    Text {
                        text: slot.axis-tag;
                        color: DesignTokens.accent;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: slot.title;
                    color: DesignTokens.text-primary;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                // Align View button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: align-touch.has-hover ? DesignTokens.surface-hover : transparent;
                    align-touch := TouchArea {
                        clicked => { root.align-view(); }
                    }
                    IconDisplay {
                        icon: IconSet.Camera;
                        size: 13px;
                        stroke: DesignTokens.text-secondary;
                    }
                }

                // Visibility
                if slot.has-image: Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: vis-touch.has-hover ? DesignTokens.surface-hover : transparent;
                    vis-touch := TouchArea {
                        clicked => { root.toggle-visible(); }
                    }
                    IconDisplay {
                        icon: slot.visible ? IconSet.Eye : IconSet.EyeOff;
                        size: 13px;
                        stroke: slot.visible ? DesignTokens.accent : DesignTokens.text-muted;
                    }
                }

                // Lock
                if slot.has-image: Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: lock-touch.has-hover ? DesignTokens.surface-hover : transparent;
                    lock-touch := TouchArea {
                        clicked => { root.toggle-lock(); }
                    }
                    IconDisplay {
                        icon: slot.locked ? IconSet.Lock : IconSet.LockOpen;
                        size: 13px;
                        stroke: slot.locked ? DesignTokens.accent : DesignTokens.text-muted;
                    }
                }

                // Remove
                if slot.has-image: Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: remove-touch.has-hover ? DesignTokens.surface-hover : transparent;
                    remove-touch := TouchArea {
                        clicked => { root.remove-image(); }
                    }
                    IconDisplay {
                        icon: IconSet.Trash2;
                        size: 13px;
                        stroke: DesignTokens.danger;
                    }
                }
            }
        }

        // Body: Thumbnail box (left) and Parameters (right)
        HorizontalLayout {
            spacing: 12px;

            // Thumbnail / Load Box
            Rectangle {
                width: 120px;
                height: 100px;
                border-radius: 4px;
                background: DesignTokens.surface-raised;
                border-width: 1px;
                border-color: thumb-touch.has-hover ? DesignTokens.accent : DesignTokens.border;
                clip: true;

                thumb-touch := TouchArea {
                    clicked => { root.pick-image(); }
                }

                if slot.has-image: Image {
                    width: 100%;
                    height: 100%;
                    source: slot.thumbnail;
                    image-fit: contain;
                }

                if !slot.has-image: VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    IconDisplay {
                        icon: IconSet.Plus;
                        size: 16px;
                        stroke: DesignTokens.text-muted;
                    }
                    Text {
                        text: Tr.t("sl.load_image");
                        color: DesignTokens.text-secondary;
                        font-size: 10px;
                        horizontal-alignment: center;
                    }
                }
            }

            // Sliders & Info
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                alignment: center;

                if slot.has-image: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: slot.image-name != "" ? slot.image-name : "reference";
                        color: DesignTokens.text-primary;
                        font-size: 11px;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: slot.dimensions;
                        color: DesignTokens.text-muted;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }

                if slot.has-image: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Tr.t("sl.opacity") + ": \{round(root.local-opacity * 100)}%";
                        color: DesignTokens.text-secondary;
                        font-size: 10px;
                        width: 72px;
                        vertical-alignment: center;
                    }
                    PetuniaSlider {
                        horizontal-stretch: 1;
                        minimum: 0.05;
                        maximum: 1.0;
                        value <=> root.local-opacity;
                        changed(v) => { root.set-param("opacity", v); }
                    }
                }

                if slot.has-image: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Tr.t("sl.size") + ": \{round(root.local-size * 10) / 10}";
                        color: DesignTokens.text-secondary;
                        font-size: 10px;
                        width: 72px;
                        vertical-alignment: center;
                    }
                    PetuniaSlider {
                        horizontal-stretch: 1;
                        minimum: 0.5;
                        maximum: 20.0;
                        value <=> root.local-size;
                        changed(v) => { root.set-param("size", v); }
                    }
                }

                if slot.has-image: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Tr.t("sl.offset") + ": \{round(root.local-offset * 10) / 10}";
                        color: DesignTokens.text-secondary;
                        font-size: 10px;
                        width: 72px;
                        vertical-alignment: center;
                    }
                    PetuniaSlider {
                        horizontal-stretch: 1;
                        minimum: -10.0;
                        maximum: 10.0;
                        value <=> root.local-offset;
                        changed(v) => { root.set-param("offset", v); }
                    }
                }

                if !slot.has-image: Text {
                    text: Tr.t("sl.no_reference_image_loaded_click_the_box_to_l");
                    color: DesignTokens.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

export component PetuniaSlintShell inherits Window {
    out property <float> viewport-region-width: viewport-region.width / 1px;
    out property <float> viewport-region-height: viewport-region.height / 1px;
    out property <float> window-width: root.width / 1px;
    out property <float> window-height: root.height / 1px;
    title: Tr.t("sl.petunia3d");
    preferred-width: 1280px;
    preferred-height: 800px;
    background: DesignTokens.canvas;
    forward-focus: root-focus;

    in-out property <string> active-workspace: "MODEL";
    /// "DRAW" ou "POLY" dentro do workspace de modelagem (ADR 007).
    in-out property <string> modeling-mode: "POLY";
    in-out property <string> label-workspace-draw-title: "";
    in-out property <string> label-workspace-draw-description: "";
    in-out property <string> label-workspace-poly-title: "";
    in-out property <string> label-workspace-poly-description: "";
    in-out property <bool> inspector-visible: true;
    in-out property <bool> model-parts-open: false;
    in-out property <bool> model-transform-open: false;
    in-out property <bool> model-material-open: false;
    in-out property <bool> model-object-open: false;
    in-out property <bool> model-modifiers-open: false;
    in-out property <bool> parts-docked: true;
    in-out property <bool> transform-docked: true;
    in-out property <bool> material-docked: true;
    in-out property <bool> object-docked: true;
    in-out property <bool> modifiers-docked: true;
    in-out property <bool> quick-actions-docked: true;
    in-out property <bool> inspector-collapsed: true;
    in-out property <string> hovered-inspector-section: "";
    in-out property <bool> flyout-hovered: false;
    in-out property <bool> rail-hovered: false;
    in-out property <bool> inspector-flyout-open: (
        root.hovered-inspector-section != "" ||
        root.flyout-hovered ||
        root.rail-hovered ||
        root.model-parts-open ||
        root.model-transform-open ||
        root.model-material-open ||
        root.model-object-open ||
        root.model-modifiers-open ||
        root.quick-actions-section-open
    );
    out property <length> inspector-clearance: (root.inspector-flyout-open && inspector-visible && !compact-shell)
        ? (min(320px, viewport-region.width - 60px) + 12px)
        : 0px;
    in-out property <bool> compact-shell: false;
    in-out property <bool> command-search-visible: false;
    in-out property <bool> scene-drawer-visible: false;
    in-out property <bool> scene-drawer-pinned: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> reference-manager-visible: false;
    // Posição dos painéis flutuantes; negativo = centralizado.
    in-out property <length> ref-panel-x: -1px;
    in-out property <length> ref-panel-y: -1px;
    in-out property <bool> paint-canvas-panel-visible: false;
    in-out property <bool> paint-pip: false;
    in-out property <length> canvas-panel-x: -1px;
    in-out property <length> canvas-panel-y: -1px;
    in-out property <length> settings-panel-x: -1px;
    in-out property <length> settings-panel-y: -1px;
    in-out property <[ReferenceSlotData]> reference-slots: [];
    in-out property <int> reference-total-count: 0;
    in-out property <string> active-keymap-id: "petunia-default";
    in-out property <bool> saved: true;
    in-out property <image> viewport-image;
    in-out property <bool> split-enabled: false;
    in-out property <string> split-preset: "";
    in-out property <image> split-view-image;
    in-out property <bool> has-gpu-viewport: false;

    in-out property <[CommandItem]> command-results: [];
    in-out property <string> command-query: "";
    property <int> command-selection: 0;
    in-out property <float> pos-x: 0.0;
    in-out property <float> pos-y: 0.0;
    in-out property <float> pos-z: 0.0;
    in-out property <float> rot-x: 0.0;
    in-out property <float> rot-y: 0.0;
    in-out property <float> rot-z: 0.0;
    in-out property <float> scale-x: 1.0;
    in-out property <float> scale-y: 1.0;
    in-out property <float> scale-z: 1.0;
    in-out property <[string]> material-slots: [];
    in-out property <int> active-material-slot: 0;
    in-out property <bool> material-has-selection: false;
    in-out property <string> material-id: "";
    in-out property <string> material-name: "";
    in-out property <string> material-profile: "PBR Standard";
    in-out property <string> material-profile-label: "PBR Standard";
    in-out property <color> material-base-color: #bebec7;
    in-out property <float> material-roughness: 0.5;
    in-out property <float> material-metallic: 0.0;
    in-out property <float> material-normal-scale: 1.0;
    in-out property <color> material-emission: #000000;
    in-out property <float> material-emission-strength: 0.0;
    in-out property <string> material-alpha-mode: "Opaque";
    in-out property <float> material-alpha-cutoff: 0.5;
    in-out property <bool> material-has-albedo: false;
    in-out property <string> material-albedo-label: "";
    in-out property <bool> material-palette-open: false;
    in-out property <bool> material-advanced-open: false;
    in-out property <[QuickActionEntry]> quick-actions: [];
    in-out property <[QuickActionEntry]> quick-action-candidates: [];
    in-out property <bool> quick-actions-open: false;
    in-out property <[ModifierEntry]> modifier-rows: [];
    in-out property <[SectionState]> section-states: [];

    in-out property <[SceneItem]> scene-items: [];
    in-out property <[SceneItem]> parts-items: [];
    in-out property <string> parts-query: "";
    in-out property <bool> parts-selected-only: false;
    in-out property <bool> parts-sort-by-name: false;
    in-out property <float> parts-row-height: 28.0;
    in-out property <[PrefabItem]> prefab-items: [];
    in-out property <bool> asset-only-favorites: false;
    in-out property <string> asset-query: "";
    in-out property <bool> asset-sort-by-name: false;
    in-out property <bool> shelf-overflow-open: false;
    in-out property <float> asset-thumbnail-size: 64.0;
    in-out property <color> selection-color: DesignTokens.selection;
    in-out property <string> selection-color-hex: "#E96A00";
    in-out property <float> selection-thickness: 2.0;
    in-out property <string> active-object-title: "Default Cube";
    in-out property <string> active-object-details: "Vertices: 8  ·  Faces: 6";
    in-out property <string> active-material-name: "Default Material";
    in-out property <bool> object-has-selection: false;
    in-out property <string> object-id: "";
    in-out property <string> object-name: "";
    in-out property <bool> object-visible: true;
    in-out property <bool> object-locked: false;
    in-out property <int> object-verts: 0;
    in-out property <int> object-faces: 0;
    in-out property <int> object-tris: 0;
    in-out property <string> object-selection: "";
    in-out property <string> object-material: "";
    in-out property <int> object-modifier-count: 0;
    in-out property <[color]> material-palette: [];
    in-out property <length> inspector-width: 336px;
    in-out property <length> asset-library-height: 200px;
    in-out property <string> scene-stats: "";
    in-out property <string> uv-stats: "";
    in-out property <string> current-theme: "petunia-dark";
    in-out property <int> settings-tab: 0;
    // F6 alterna o foco de teclado entre a viewport e a régua do Inspector.
    in-out property <int> f6-rail-token: 0;
    in-out property <bool> f6-in-rail: false;
    in-out property <float> ui-scale: 1.0;
    in-out property <string> icon-theme: "outline";
    in-out property <string> active-language: "pt-BR";

    in-out property <string> selection-domain: "OBJECT";
    in-out property <string> active-tool: "select";
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <string> status-message: "Ready";
    /// 0 info, 1 sucesso, 2 aviso, 3 erro.
    in-out property <int> status-severity: 0;
    property <bool> toast-visible: false;
    property <color> status-color: root.status-severity == 3 ? DesignTokens.danger
        : (root.status-severity == 2 ? DesignTokens.warning
        : (root.status-severity == 1 ? DesignTokens.success : DesignTokens.info));
    changed status-message => {
        if root.status-severity > 0 {
            root.toast-visible = true;
            toast-timer.running = false;
            toast-timer.running = true;
        } else {
            root.toast-visible = false;
        }
    }
    toast-timer := Timer {
        interval: 3200ms;
        running: false;
        triggered => {
            root.toast-visible = false;
            self.running = false;
        }
    }
    in-out property <color> paint-color: #b58cff;
    in-out property <float> brush-size: 0.8;
    in-out property <float> brush-opacity: 1.0;
    in-out property <float> brush-hardness: 0.0;
    in-out property <bool> paint-symmetry-x: false;
    in-out property <bool> paint-symmetry-y: false;
    in-out property <bool> paint-symmetry-z: false;
    in-out property <bool> paint-target-vertex: false;
    in-out property <bool> paint-mask-selection: false;
    in-out property <bool> asset-library-visible: false;
    in-out property <bool> is-orthographic: false;
    in-out property <bool> is-wireframe: true;
    in-out property <string> shading-mode: "solid";
    in-out property <float> xray-opacity: 0.42;
    in-out property <bool> shading-popover-open: false;
    property <bool> tool-properties-collapsed: false;
    in-out property <bool> quick-actions-section-open: false;
    in-out property <string> operation-preview-commands: "";
    // Cordão pontilhado pivô→mouse da ferramenta de manipulação ativa.
    // Só existe durante a sessão (arrasto/modal); fora dela é "" e some.
    in-out property <string> drag-link-commands: "";
    // Círculo pontilhado de raio de influência para Proportional Editing (Soft Selection).
    in-out property <string> proportional-circle-commands: "";
