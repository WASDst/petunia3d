                    if root.split-enabled: Rectangle {
                        x: (parent.width - 4px) / 2;
                        y: 0px;
                        width: 4px;
                        height: parent.height;
                        background: DesignTokens.border-strong;
                    }

                    if root.split-enabled: split-region := SplitViewRegion {
                        x: (parent.width + 4px) / 2;
                        width: (parent.width - 4px) / 2;
                        height: parent.height;
