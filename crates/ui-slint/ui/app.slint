            settings-query <=> root.settings-query;
            settings-tab <=> root.settings-tab;
            themes: root.themes;
            ui-scale: root.ui-scale;
            icon-theme: root.icon-theme;
            color-wheel-image: root.color-wheel-image;
            label-accent-color: root.label-accent-color;
