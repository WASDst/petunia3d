                                            Text { text: "Cobertura parcial: menus e tooltips traduzidos; várias mensagens de status ainda misturam português e inglês."; color: DesignTokens.warning; font-size: 11px; font-weight: 600; wrap: word-wrap; }
                                            Text { text: "Migração de textos literais para TextId em andamento."; color: DesignTokens.text-secondary; font-size: 10px; wrap: word-wrap; }
                                            Text { text: "✓ Fallback automático para inglês quando chave não encontrada"; color: DesignTokens.text-secondary; font-size: 10px; }
                                            Text { text: "Vocabulário canônico alvo: Point, Round Edge, Fuse, Cut, Connect."; color: DesignTokens.text-muted; font-size: 10px; wrap: word-wrap; }
                                        }
