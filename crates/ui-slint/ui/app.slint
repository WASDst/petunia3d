    in-out property <string> menu-open: "";
    in-out property <int> menu-highlight: -1;
    property <[MenuEntry]> current-menu-entries: root.menu-open == "file"
        ? root.menu-file-items
        : (root.menu-open == "edit"
            ? root.menu-edit-items
            : (root.menu-open == "view" ? root.menu-view-items : root.menu-window-items));
    pure function menu-selectable(i: int) -> bool {
        return i >= 0 && i < root.current-menu-entries.length
            && !root.current-menu-entries[i].separator
            && !root.current-menu-entries[i].disabled;
    }
    function menu-step(delta: int) {
        let n = max(root.current-menu-entries.length, 1);
        let start = root.menu-highlight < 0 ? (delta > 0 ? -1 : n) : root.menu-highlight;
        let c1 = Math.mod(start + delta + n, n);
        let c2 = Math.mod(c1 + delta + n, n);
        root.menu-highlight = root.menu-selectable(c1) ? c1 : (root.menu-selectable(c2) ? c2 : root.menu-highlight);
    }
    changed menu-open => { root.menu-highlight = -1; }
    property <length> menu-anchor-x: 0px;
