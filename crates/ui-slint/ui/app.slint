                                            HorizontalLayout { Text { text: Tr.t("sl.g_move_translate"); color: DesignTokens.text-secondary; font-size: 10px; } Rectangle { horizontal-stretch: 1; } Text { text: Tr.t("sl.tab_selection_mode_v_e_f_obj"); color: DesignTokens.text-secondary; font-size: 10px; } }
