import { InspectorSection, PartsBody, PartsFilterRow, PartsRowSizeControl, QuickActionsBody } from "inspector/sections.slint";
import { CommandItem, KeymapActionEntry, KeymapProfileEntry, MeasureTag, MenuEntry, ModifierEntry, PaintEffectParamEntry, PaintLayerEntry, PrefabItem, QuickActionEntry, ReferenceSlotData, SceneItem, SectionState, ShortcutsEntry, ThemeEntry, WorldAxisTag, RecentProject, HomeTexts } from "types.slint";
import { ComponentGallery } from "gallery.slint";
import { RecoveryDialog } from "dialogs/recovery.slint";
import { HomeDialog } from "dialogs/home.slint";
import { SettingsDialog } from "dialogs/settings.slint";
import { CommandPalette } from "dialogs/command_palette.slint";
import { ReferenceManagerPanel } from "dialogs/reference_manager.slint";
import { MenuDropdownOverlay } from "shell/menu_dropdown.slint";
import { ShadingPopover } from "popovers/shading.slint";
import { PartColorPopover } from "popovers/part_color.slint";
import { ContextMenuOverlay } from "popovers/context_menu.slint";
import { SceneDrawerOverlay } from "shell/scene_drawer.slint";
import { PaintCanvasPanel } from "workspaces/paint/canvas_panel.slint";
import { LoopCutCard } from "viewport/loop_cut_card.slint";
import { ToolModalCard } from "viewport/tool_modal_card.slint";
import { ProfileCard } from "viewport/profile_card.slint";
import { OperationCard } from "viewport/operation_card.slint";
import { PrimitiveCard } from "viewport/primitive_card.slint";
import { ToolOptionsCard } from "viewport/tool_options_card.slint";
