// Fonte embarcada (D4 do plano de UI; OFL em fonts/Inter-OFL.txt).
import "fonts/InterVariable.ttf";
import { Icon, IconDisplay, IconSet } from "@lucide";
import { ListView, ScrollView } from "std-widgets.slint";
import { ColorPresets, DesignTokens, Motion, Tr } from "tokens.slint";
import { PetuniaIcons } from "petunia_icons.slint";
import {
    AnimateCreatureBody,
    AnimateMotionBody,
    AnimateParamEntry,
    AnimateRowEntry,
    AnimateTexts,
    AnimateTransport,
    AnimateTweakBody,
} from "animate.slint";
import { BrushChip, BrushStepper, ColorSwatch, ContextMenuItem, MenuDropdown, NumericField, PanelDragHandle, PanelResizeGrip, PetuniaSlider, SplitterHorizontal, RailTool, ToolButton, ToolCard, ToolGroup, TopAction, Vector3Field, ViewportBarButton, ViewportSvgButton } from "components/controls.slint";
import { EmptyState, IconButton, KeyHint } from "components/base.slint";\nimport { StatusToast } from "components/feedback.slint";\nimport { ShellHeader } from "shell/header.slint";
import { ToolRail } from "shell/tool_rail.slint";
import { BrushCursor, PaintCanvasSurface } from "components/paint_canvas.slint";
import { ReferenceDetails, ReferenceTile } from "dialogs/references.slint";
import { InspectorPill, InspectorSection, MaterialBody, ModifiersBody, ObjectBody, PartsBody, PartsFilterRow, PartsRowSizeControl, QuickActionsBody, TransformBody } from "inspector/sections.slint";
import { CommandItem, KeymapActionEntry, KeymapProfileEntry, MeasureTag, MenuEntry, ModifierEntry, PaintEffectParamEntry, PaintLayerEntry, PrefabItem, QuickActionEntry, ReferenceSlotData, SceneItem, SectionState, ShortcutsEntry, ThemeEntry, WorldAxisTag, RecentProject, HomeTexts } from "types.slint";
import { ComponentGallery } from "gallery.slint";
export { DesignTokens, Motion, PetuniaIcons, Tr }
// Janela da galeria (exemplo `gallery`): gerada junto do shell.
export { ComponentGallery }
export { AnimateParamEntry, AnimateRowEntry, AnimateTexts }
export { CommandItem, KeymapActionEntry, KeymapProfileEntry, MeasureTag, MenuEntry, ModifierEntry, PaintEffectParamEntry, PaintLayerEntry, PrefabItem, QuickActionEntry, ReferenceSlotData, SceneItem, SectionState, ShortcutsEntry, ThemeEntry, WorldAxisTag, RecentProject, HomeTexts }


export component PetuniaSlintShell inherits Window {
    default-font-family: "Inter Variable";
    out property <float> viewport-region-width: viewport-region.width / 1px;
    out property <float> viewport-region-height: viewport-region.height / 1px;
    out property <float> window-width: root.width / 1px;
    out property <float> window-height: root.height / 1px;
    title: Tr.t("sl.petunia3d");
    preferred-width: 1280px;
    preferred-height: 800px;
    background: DesignTokens.canvas;
    forward-focus: root-focus;

    in-out property <string> active-workspace: "MODEL";
    /// "DRAW" ou "POLY" dentro do workspace de modelagem (ADR 007).
    in-out property <string> modeling-mode: "POLY";
    in-out property <string> label-workspace-draw-title: "";
    in-out property <string> label-workspace-draw-description: "";
    in-out property <string> label-workspace-poly-title: "";
    in-out property <string> label-workspace-poly-description: "";
    in-out property <bool> inspector-visible: true;
    in-out property <bool> model-parts-open: false;
    in-out property <bool> model-transform-open: false;
    in-out property <bool> model-material-open: false;
    in-out property <bool> model-object-open: false;
    in-out property <bool> model-modifiers-open: false;
    in-out property <bool> parts-docked: true;
    in-out property <bool> transform-docked: true;
    in-out property <bool> material-docked: true;
    in-out property <bool> object-docked: true;
    in-out property <bool> modifiers-docked: true;
    in-out property <bool> quick-actions-docked: true;
    in-out property <bool> inspector-collapsed: true;
    in-out property <string> hovered-inspector-section: "";
    in-out property <bool> flyout-hovered: false;
    in-out property <bool> rail-hovered: false;
    /// Abertura persistente por clique é diferente da prévia por hover.
    out property <bool> inspector-expanded: root.active-workspace == "ANIMATE"
        || root.model-parts-open || root.model-transform-open
        || root.model-material-open || root.model-object-open;
    in-out property <bool> inspector-flyout-open: (
        // Animate: o painel É a superfície principal do workspace (Creature →
        // Motions → Motion → Style); fica aberto em vez de depender de hover.
        root.inspector-expanded ||
        root.hovered-inspector-section != "" ||
        root.flyout-hovered ||
        root.rail-hovered
    );
    out property <length> inspector-clearance: (root.inspector-flyout-open && inspector-visible && !compact-shell)
        ? (min(320px, viewport-region.width - 60px) + 12px)
        : 0px;
    /// Folga do trilho de pílulas, que só aparece com o Inspector recolhido
    /// (plano de UI F4, D1; ADR 004 §3).
    out property <length> rail-clearance: (inspector-visible && !compact-shell && !root.inspector-expanded) ? 56px : 0px;
    out property <length> right-clearance: root.inspector-clearance + root.rail-clearance;
    callback inspector-collapse-requested;
    /// Ferramentas de POLY que aparecem na barra contextual para o domínio de
    /// seleção atual (`selection-domain`: "OBJECT", "FACE", "EDGE" ou
    /// "POINT"). Plano de UI F5: contextualidade antes de volume de botões.
    /// Trilho por dados (plano de UI F5b): grupos de ferramentas com flyout.
    out property <[RailTool]> rail-select-tools: [
        { id: "select", label: root.label-model-select, shortcut: root.shortcuts.model-select, description: Tr.t("sl.box_click_selection_of_scene_points_edges_an"), icon: IconSet.MousePointer2, active: root.active-tool == "select" || root.active-tool == "box_select" },
        { id: "lasso", label: root.label-model-lasso, shortcut: root.shortcuts.model-lasso, description: Tr.t("sl.freehand_polygon_loop_lasso_selection"), icon: IconSet.Spline, active: root.active-tool == "lasso_select" },
    ];
    out property <[RailTool]> rail-helper-tools: [
        { id: "cursor", label: Tr.t("sl.3d_cursor"), shortcut: root.shortcuts.model-cursor, description: Tr.t("sl.place_3d_cursor_as_origin_for_new_objects_an"), icon: IconSet.Crosshair, active: root.active-tool == "cursor" || root.active-tool == "cursor_3d" },
        { id: "measure", label: Tr.t("sl.measure"), shortcut: root.shortcuts.model-measure, description: Tr.t("sl.measure_distances_and_angles_between_geometr"), icon: IconSet.ArrowUpDown, active: root.active-tool == "measure" },
    ];
    out property <[RailTool]> rail-cut-tools: [
        { id: "knife", label: Tr.t("sl.knife"), shortcut: root.shortcuts.model-knife, description: Tr.t("sl.knife"), icon: IconSet.Slice, active: root.active-tool == "knife" },
        { id: "slice", label: root.label-model-slice, shortcut: root.shortcuts.model-slice, description: root.label-model-slice, icon: IconSet.SquareSplitHorizontal, active: root.active-tool == "slice" },
    ];
    out property <[RailTool]> rail-paint-brush-tools: [
        { id: "brush", label: Tr.t("sl.brush"), shortcut: root.shortcuts.paint-brush, description: Tr.t("sl.brush"), icon: IconSet.Paintbrush, active: root.active-tool == "brush" },
        { id: "airbrush", label: Tr.t("sl.airbrush"), shortcut: "", description: Tr.t("sl.airbrush"), icon: IconSet.SprayCan, active: root.active-tool == "airbrush" },
    ];
    out property <[RailTool]> rail-paint-shape-tools: [
        { id: "line", label: Tr.t("sl.line"), shortcut: root.shortcuts.paint-line, description: Tr.t("sl.draw_straight_brush_strokes_between_clicked_"), icon: IconSet.Slash, active: root.active-tool == "line" },
        { id: "rectangle", label: Tr.t("sl.rectangle"), shortcut: root.shortcuts.paint-rectangle, description: Tr.t("sl.rectangle"), icon: IconSet.Square, active: root.active-tool == "rectangle" },
        { id: "ellipse", label: Tr.t("sl.ellipse"), shortcut: "", description: Tr.t("sl.ellipse"), icon: IconSet.Circle, active: root.active-tool == "ellipse" },
    ];
    out property <[RailTool]> rail-paint-gradient-tools: [
        { id: "gradient", label: Tr.t("sl.gradient"), shortcut: "", description: Tr.t("sl.gradient"), icon: IconSet.Blend, active: root.active-tool == "gradient" },
        { id: "gradient_radial", label: Tr.t("sl.gradient_radial"), shortcut: "", description: Tr.t("sl.gradient_radial"), icon: IconSet.Sun, active: root.active-tool == "gradient_radial" },
    ];
    /// Rótulo humano de um id de opção do PAINT (plano de UI F6): os ids
    /// continuam iguais no bridge; só o texto visível é traduzido.
    pure function paint-label(id: string) -> string {
        if id == "ConnectedPixels" { return Tr.t("sl.paint_opt_connected_pixels"); }
        if id == "Face" { return Tr.t("sl.paint_opt_face"); }
        if id == "SelectedFaces" { return Tr.t("sl.paint_opt_selected_faces"); }
        if id == "UvIsland" { return Tr.t("sl.paint_opt_uv_island"); }
        if id == "Object" { return Tr.t("sl.paint_opt_object"); }
        if id == "Surface" { return Tr.t("sl.paint_opt_surface"); }
        if id == "ScreenSpace" { return Tr.t("sl.paint_opt_screen"); }
        if id == "None" { return Tr.t("sl.paint_opt_none"); }
        if id == "FirstObject" { return Tr.t("sl.paint_opt_first_object"); }
        if id == "FirstFace" { return Tr.t("sl.paint_opt_first_face"); }
        if id == "Pixelate" { return Tr.t("sl.paint_opt_pixelate"); }
        if id == "Posterize" { return Tr.t("sl.paint_opt_posterize"); }
        if id == "Invert" { return Tr.t("sl.paint_opt_invert"); }
        if id == "Grain" { return Tr.t("sl.paint_opt_grain"); }
        if id == "Levels" { return Tr.t("sl.paint_opt_levels"); }
        if id == "BrightnessContrast" { return Tr.t("sl.paint_opt_brightness_contrast"); }
        if id == "HueSaturation" { return Tr.t("sl.paint_opt_hue_saturation"); }
        return id;
    }
    /// Flyout aberto ("" = nenhum), suas variações e a altura do botão de origem.
    in-out property <string> rail-flyout: "";
    in-out property <[RailTool]> rail-flyout-tools: [];
    in-out property <length> rail-flyout-x: 0px;
    in-out property <length> rail-flyout-y: 0px;

    /// Despacha uma ferramenta do trilho pelo id.
    function rail-activate(id: string) {
        root.rail-flyout = "";
        if id == "select" { root.active-tool-changed("select"); }
        else if id == "lasso" { root.command-executed("model.tool_lasso"); }
        else if id == "cursor" { root.command-executed("model.tool_cursor"); }
        else if id == "measure" { root.command-executed("model.measure"); }
        else if id == "knife" { root.command-executed("model.knife"); }
        else { root.active-tool-changed(id); }
    }

    pure function poly-tool-visible(tool: string) -> bool {
        // Desenho e corte agem pelo gesto, não pela seleção: sempre visíveis.
        if tool == "poly_pen" || tool == "knife" || tool == "loop_cut" || tool == "slice" {
            return true;
        }
        if root.selection-domain == "OBJECT" {
            // Subdivide já está nas ações rápidas padrão ao lado.
            return tool == "push_pull";
        }
        if root.selection-domain == "FACE" {
            return tool == "extrude" || tool == "push_pull" || tool == "inset" || tool == "subdivide" || tool == "spin" || tool == "dissolve";
        }
        if root.selection-domain == "EDGE" {
            return tool == "bevel" || tool == "connect" || tool == "make_face" || tool == "subdivide" || tool == "spin" || tool == "dissolve";
        }
        if root.selection-domain == "POINT" {
            return tool == "merge" || tool == "make_face" || tool == "dissolve";
        }
        // Domínio desconhecido: nada some por engano.
        return true;
    }
    in-out property <bool> compact-shell: false;
    in-out property <bool> command-search-visible: false;
    in-out property <bool> scene-drawer-visible: false;
    in-out property <bool> scene-drawer-pinned: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> reference-manager-visible: false;
    // Posição dos painéis flutuantes; negativo = centralizado.
    in-out property <length> ref-panel-x: -1px;
    in-out property <length> ref-panel-y: -1px;
    in-out property <bool> paint-canvas-panel-visible: false;
    in-out property <bool> paint-pip: false;
    in-out property <length> canvas-panel-x: -1px;
    in-out property <length> canvas-panel-y: -1px;
    in-out property <length> settings-panel-x: -1px;
    in-out property <length> settings-panel-w: 0px;
    in-out property <length> settings-panel-h: 0px;
    in-out property <length> ref-panel-w: 0px;
    in-out property <length> ref-panel-h: 0px;
    in-out property <length> canvas-panel-w: 0px;
    in-out property <length> canvas-panel-h: 0px;
    in-out property <length> settings-panel-y: -1px;
    in-out property <[ReferenceSlotData]> reference-slots: [];
    in-out property <int> reference-total-count: 0;
    in-out property <string> active-keymap-id: "petunia-default";
    in-out property <[KeymapProfileEntry]> keymap-profiles;
    in-out property <[KeymapActionEntry]> keymap-rows;
    in-out property <int> keymap-revision: -1;
    in-out property <string> keymap-capture-action: "";
    in-out property <float> brush-flow: 1.0;
    in-out property <float> brush-spacing: 0.15;
    in-out property <float> brush-smoothing: 0.0;
    in-out property <float> brush-size-jitter: 0.0;
    in-out property <float> brush-opacity-jitter: 0.0;
    in-out property <float> brush-scatter: 0.0;
    in-out property <float> brush-spray-density: 0.35;
    in-out property <float> brush-angle: 0.0;
    in-out property <float> brush-roundness: 1.0;
    in-out property <string> brush-tip: "round";
    in-out property <string> brush-blend: "normal";
    in-out property <[string]> brush-presets;
    in-out property <int> brush-preset-index: -1;
    in-out property <bool> clone-source-set: false;
    in-out property <bool> saved: true;
    in-out property <image> viewport-image;
    in-out property <bool> split-enabled: false;
    in-out property <string> split-preset: "";
    in-out property <image> split-view-image;
    in-out property <bool> has-gpu-viewport: false;

    in-out property <bool> part-color-popover-open: false;
    in-out property <string> part-color-popover-id: "";
    in-out property <string> part-color-popover-name: "";
    in-out property <color> part-color-preview: DesignTokens.selection;
    in-out property <string> part-color-hex: "#E96A00";
    in-out property <bool> part-color-has-custom: false;
    in-out property <image> color-wheel-image;
    in-out property <color> active-selection-color: DesignTokens.selection-active;

    in-out property <[CommandItem]> command-results: [];
    in-out property <string> command-query: "";
    property <int> command-selection: 0;
    in-out property <float> pos-x: 0.0;
    in-out property <float> pos-y: 0.0;
    in-out property <float> pos-z: 0.0;
    in-out property <float> rot-x: 0.0;
    in-out property <float> rot-y: 0.0;
    in-out property <float> rot-z: 0.0;
    in-out property <float> scale-x: 1.0;
    in-out property <float> scale-y: 1.0;
    in-out property <float> scale-z: 1.0;
    in-out property <[string]> material-slots: [];
    in-out property <int> active-material-slot: 0;
    in-out property <bool> material-has-selection: false;
    in-out property <string> material-id: "";
    in-out property <string> material-name: "";
    in-out property <string> material-profile: "PBR Standard";
    in-out property <string> material-profile-label: "PBR Standard";
    in-out property <color> material-base-color: ColorPresets.material-default;
    in-out property <float> material-roughness: 0.5;
    in-out property <float> material-metallic: 0.0;
    in-out property <float> material-normal-scale: 1.0;
    in-out property <color> material-emission: ColorPresets.emission-off;
    in-out property <float> material-emission-strength: 0.0;
    in-out property <string> material-alpha-mode: "Opaque";
    in-out property <float> material-alpha-cutoff: 0.5;
    in-out property <bool> material-has-albedo: false;
    in-out property <string> material-albedo-label: "";
    in-out property <bool> material-palette-open: false;
    in-out property <bool> material-advanced-open: false;
    in-out property <[QuickActionEntry]> quick-actions: [];
    in-out property <[QuickActionEntry]> quick-action-candidates: [];
    in-out property <bool> quick-actions-open: false;
    in-out property <[ModifierEntry]> modifier-rows: [];
    in-out property <[SectionState]> section-states: [];

    in-out property <[SceneItem]> scene-items: [];
    in-out property <[SceneItem]> parts-items: [];
    in-out property <string> parts-query: "";
    in-out property <bool> parts-selected-only: false;
    in-out property <bool> parts-sort-by-name: false;
    in-out property <float> parts-row-height: 28.0;
    in-out property <[PrefabItem]> prefab-items: [];
    in-out property <bool> asset-only-favorites: false;
    in-out property <string> asset-query: "";
    in-out property <bool> asset-sort-by-name: false;
    in-out property <bool> shelf-overflow-open: false;
    in-out property <float> asset-thumbnail-size: 64.0;
    in-out property <color> selection-color: DesignTokens.selection;
    in-out property <string> selection-color-hex: "#E96A00";
    in-out property <float> selection-thickness: 2.0;
    in-out property <string> active-object-title: "Default Cube";
    in-out property <string> active-object-details: "Vertices: 8  ·  Faces: 6";
    in-out property <string> active-material-name: "Default Material";
    in-out property <bool> object-has-selection: false;
    in-out property <string> object-id: "";
    in-out property <string> object-name: "";
    in-out property <bool> object-visible: true;
    in-out property <bool> object-locked: false;
    in-out property <int> object-verts: 0;
    in-out property <int> object-faces: 0;
    in-out property <int> object-tris: 0;
    in-out property <string> object-selection: "";
    in-out property <string> object-material: "";
    in-out property <int> object-modifier-count: 0;
    in-out property <[color]> material-palette: [];
    in-out property <length> inspector-width: 336px;
    in-out property <length> asset-library-height: 200px;
    in-out property <string> scene-stats: "";
    in-out property <string> uv-stats: "";
    in-out property <string> current-theme: "petunia-dark";
    in-out property <int> settings-tab: 0;
    /// Busca na barra lateral das Preferências.
    in-out property <string> settings-query: "";
    /// Comparação sem diferenciar maiúsculas (Slint não tem `contains`).
    pure callback text-matches(string, string) -> bool;
    // F6 alterna o foco de teclado entre a viewport e a régua do Inspector.
    in-out property <int> f6-rail-token: 0;
    in-out property <bool> f6-in-rail: false;
    in-out property <float> ui-scale: 1.0;
    in-out property <string> icon-theme: "outline";
    in-out property <string> active-language: "pt-BR";

    in-out property <string> selection-domain: "OBJECT";
    in-out property <string> active-tool: "select";
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <string> status-message: "Ready";
    /// 0 info, 1 sucesso, 2 aviso, 3 erro.
    in-out property <int> status-severity: 0;
    property <bool> toast-visible: false;
    property <color> status-color: root.status-severity == 3 ? DesignTokens.danger
        : (root.status-severity == 2 ? DesignTokens.warning
        : (root.status-severity == 1 ? DesignTokens.success : DesignTokens.info));
    changed status-message => {
        if root.status-severity > 0 {
            root.toast-visible = true;
            toast-timer.running = false;
            toast-timer.running = true;
        } else {
            root.toast-visible = false;
        }
    }
    decal-playback-timer := Timer {
        interval: 33ms;
        running: root.decal-playing;
        triggered => { root.decal-playback-tick(0.033); }
    }

    toast-timer := Timer {
        interval: 3200ms;
        running: false;
        triggered => {
            root.toast-visible = false;
            self.running = false;
        }
    }
    in-out property <color> paint-color: ColorPresets.paint-violet;
    in-out property <float> brush-size: 0.8;
    in-out property <float> brush-opacity: 1.0;
    in-out property <float> brush-hardness: 0.0;
    in-out property <bool> paint-symmetry-x: false;
    in-out property <bool> paint-symmetry-y: false;
    in-out property <bool> paint-symmetry-z: false;
    in-out property <bool> paint-target-vertex: false;
    in-out property <bool> paint-mask-selection: false;
    in-out property <bool> isolate-active: false;
    in-out property <bool> asset-library-visible: false;
    in-out property <bool> is-orthographic: false;
    in-out property <bool> is-wireframe: true;
    in-out property <string> shading-mode: "solid";
    in-out property <float> xray-opacity: 0.42;
    in-out property <bool> shading-popover-open: false;
    property <bool> tool-properties-collapsed: false;
    in-out property <bool> quick-actions-section-open: false;
    in-out property <string> operation-preview-commands: "";
    // Cordão pontilhado pivô→mouse da ferramenta de manipulação ativa.
    // Só existe durante a sessão (arrasto/modal); fora dela é "" e some.
    in-out property <string> drag-link-commands: "";
    // Círculo pontilhado de raio de influência para Proportional Editing (Soft Selection).
    in-out property <string> proportional-circle-commands: "";
    // Phase 4: Feedback Visual em Tempo Real
    in-out property <bool> hud-pill-visible: false;
    in-out property <length> hud-pill-x: 0px;
    in-out property <length> hud-pill-y: 0px;
    in-out property <string> hud-pill-title: "";
    in-out property <string> hud-pill-value: "";
    in-out property <string> hud-pill-badge: "";
    in-out property <string> hud-pill-hint: "";
    in-out property <bool> axis-guide-visible: false;
    in-out property <string> axis-guide-commands: "";
    in-out property <color> axis-guide-color: DesignTokens.marker-pivot;
    in-out property <string> axis-guide-label: "";
    in-out property <length> axis-guide-label-x: 0px;
    in-out property <length> axis-guide-label-y: 0px;
    in-out property <bool> dimension-visible: false;
    in-out property <string> dimension-commands: "";
    in-out property <string> dimension-text: "";
    in-out property <length> dimension-x: 0px;
    in-out property <length> dimension-y: 0px;
    in-out property <bool> protractor-visible: false;
    in-out property <string> protractor-wedge-commands: "";
    in-out property <string> protractor-ticks-commands: "";
    in-out property <bool> snap-marker-visible: false;
    in-out property <length> snap-marker-x: 0px;
    in-out property <length> snap-marker-y: 0px;
    in-out property <string> snap-marker-label: "";
    in-out property <bool> snap-marker-round: false;
    // Phase 6: Campos Inteligentes & Ferramentas de Consulta
    in-out property <bool> measure-visible: false;
    in-out property <string> measure-commands: "";
    in-out property <string> measure-text: "";
    in-out property <length> measure-x: 0px;
    in-out property <length> measure-y: 0px;
    in-out property <float> measure-distance: 0.0;
    in-out property <float> measure-dx: 0.0;
    in-out property <float> measure-dy: 0.0;
    in-out property <float> measure-dz: 0.0;
    in-out property <float> measure-angle-deg: 0.0;
    in-out property <[MeasureTag]> measure-tags: [];
