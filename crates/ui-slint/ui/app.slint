    callback inspector-width-changed(float);
    callback asset-library-height-changed(float);
    callback part-color-picker-open(string);
    callback part-color-wheel-interacted(float, float, bool);
    callback part-color-hex-entered(string) -> bool;
    callback part-color-hsv-entered(int, string) -> bool;
    callback part-color-hsv-adjusted(int, float);
    callback part-color-preset-clicked(color);
    callback part-color-reset-requested();
    callback separate-selection-requested;
    callback rename-committed(string);
    callback rename-edited(string);
    callback rename-cancelled;
    callback scene-context-requested(string, float, float);
    callback viewport-context-requested(float, float);
    callback context-menu-action(string);
    callback menu-toggled(string);
    callback menu-opened(string);
    callback menu-item-invoked(string);
    callback open-project-requested;
    callback scene-select(string, bool);
    callback scene-toggle-visibility(string);
    callback scene-toggle-lock(string);
    callback scene-move(string, int);
    callback theme-changed(string);

    callback undo-requested;
    callback redo-requested;
    callback selection-domain-changed(string);
    callback active-tool-changed(string);
    callback add-primitive-requested(string);
    callback delete-requested;
    callback duplicate-requested;
    callback asset-library-requested;
    callback toggle-projection-requested;
    callback toggle-wireframe-requested;
    callback shading-mode-set(string);
    callback xray-opacity-set(float);
    callback shading-popover-toggled(bool);
    callback gizmo-hover(float, float);
    callback viewport-hover(float, float);
    callback viewport-hover-clear;
    callback gizmo-drag-begin(float, float);
    callback gizmo-drag-end;
    callback toggle-xray-requested;
    callback reset-camera-requested;
    callback save-active-as-asset-requested;
    callback prefab-place-requested(string);
    callback prefab-delete-requested(string);
    callback prefab-update-requested(string);
    callback prefab-favorite-requested(string, bool);
    callback asset-only-favorites-changed(bool);
    callback recovery-recover-requested;
    callback recovery-keep-requested;
    callback recovery-discard-requested;
    callback paint-color-changed(float, float, float);
    callback brush-size-changed(float);
    callback brush-opacity-changed(float);
    callback brush-hardness-changed(float);
    callback paint-symmetry-x-toggled;
    callback paint-symmetry-y-toggled;
    callback paint-symmetry-z-toggled;
    callback paint-target-vertex-changed(bool);
    callback paint-mask-selection-toggled;
    callback poly-pen-mode-selected(string);
    callback shortcut-requested(string, bool, bool, bool);
    callback toggle-face-orientation;
    callback toggle-uv-checker;
    callback toggle-proportional-editing;
    callback set-proportional-radius(float);
    callback set-proportional-falloff(string);
    callback adjust-proportional-radius(float);
    callback toggle-snap-enabled;
    callback set-snap-target(string);
    callback add-profile-rectangle(float, float);
    callback add-profile-circle(float, int);
    callback paint-decal-layer-added;
    callback settings-closed;
    callback keymap-changed(string);
    callback brush-param-changed(string, float);
    callback brush-tip-changed(string);
    callback brush-blend-changed(string);
    callback brush-preset-applied(int);
    callback brush-preset-saved();
    callback brush-preset-deleted(int);
    callback keymap-profile-create();
    callback keymap-profile-delete(string);
    callback keymap-capture-requested(string);
    callback keymap-capture-cancelled();
    callback keymap-capture-key(string, bool, bool, bool);
    callback keymap-binding-reset(string);
    callback keymap-binding-clear(string);

    /// Nome estável da tecla (mesmo vocabulário de `petunia_config::keybinds`).
    pure function shortcut-key-name(text: string) -> string {
        return text == Key.Tab ? "Tab" :
            text == Key.Return ? "Enter" :
            text == Key.Backspace ? "Backspace" :
            text == Key.Delete ? "Delete" :
            text == Key.Home ? "Home" :
            text == Key.End ? "End" :
            text == Key.PageUp ? "PageUp" :
            text == Key.PageDown ? "PageDown" :
            text == Key.Insert ? "Insert" :
            text == Key.UpArrow ? "Up" :
            text == Key.DownArrow ? "Down" :
            text == Key.LeftArrow ? "Left" :
            text == Key.RightArrow ? "Right" :
            text == Key.F1 ? "F1" :
            text == Key.F2 ? "F2" :
            text == Key.F3 ? "F3" :
            text == Key.F4 ? "F4" :
            text == Key.F5 ? "F5" :
            text == Key.F6 ? "F6" :
            text == Key.F7 ? "F7" :
            text == Key.F8 ? "F8" :
            text == Key.F9 ? "F9" :
            text == Key.F10 ? "F10" :
            text == Key.F11 ? "F11" :
            text == Key.F12 ? "F12" :
            text;
    }

    /// Ferramentas de traço com pincel (têm cursor de tamanho/dureza/força).
    pure function brush-stroke-tool(tool: string) -> bool {
        return tool == "brush" || tool == "eraser" || tool == "airbrush" || tool == "pixel"
            || tool == "smudge" || tool == "blur" || tool == "dodge" || tool == "burn"
            || tool == "spray" || tool == "clone";
    }

    // Cor e espessura de um handle do gizmo conforme o estado da interação.
    function gizmo-handle-color(axis: int, base: color) -> color {
        if root.gizmo-constraint-axis-a == axis || root.gizmo-constraint-axis-b == axis {
            return base;
        }
        if root.gizmo-constraint-axis-a >= 0 {
            return base.transparentize(0.72);
        }
        if root.gizmo-active-axis == axis {
            return base;
        }
        if root.gizmo-active-axis >= 0 {
            // Durante o arrasto os outros eixos perdem presença.
            return base.transparentize(0.72);
        }
        if root.gizmo-hover-axis == axis {
            // Pré-seleção: o eixo sob o cursor ganha presença (clareia).
            return base.brighter(0.35);
        }
        return base;
    }

    function gizmo-handle-width(axis: int) -> length {
        if root.gizmo-constraint-axis-a == axis || root.gizmo-constraint-axis-b == axis {
            return 4px;
        }
        if root.gizmo-constraint-axis-a >= 0 {
            return 2px;
        }
        if root.gizmo-active-axis == axis {
            return 4px;
        }
        if root.gizmo-hover-axis == axis {
            return 3.5px;
        }
        return 2.5px;
    }

    changed command-search-visible => { root.command-selection = 0; }
    changed tool-modal-active => { if (root.tool-modal-active) { root.tool-properties-collapsed = false; } }
    changed loop-cut-active => { if (root.loop-cut-active) { root.tool-properties-collapsed = false; } }
    changed width => {
        root.compact-shell = self.width < 900px;
        if !root.compact-shell && root.scene-drawer-visible {
            root.scene-requested();
            root.model-parts-open = true;
        }
    }

    function region-available(region: int) -> bool {
        if region == 3 { return root.inspector-visible && !root.compact-shell; }
        if region == 4 { return root.inspector-visible && !root.compact-shell && root.inspector-expanded; }
        if region == 5 { return root.asset-library-visible; }
        if region == 6 { return root.active-workspace != "ANIMATE"; }
        return region >= 0 && region <= 6;
    }
    function next-focus-region(reverse: bool) -> int {
        let step = reverse ? -1 : 1;
        // Seven fixed regions, no speculative registry or traversal of authoring data.
        let candidate1 = mod(root.focus-region + 1 * step + 7, 7);
        if root.region-available(candidate1) { return candidate1; }
        let candidate2 = mod(root.focus-region + 2 * step + 7, 7);
        if root.region-available(candidate2) { return candidate2; }
        let candidate3 = mod(root.focus-region + 3 * step + 7, 7);
        if root.region-available(candidate3) { return candidate3; }
        let candidate4 = mod(root.focus-region + 4 * step + 7, 7);
        if root.region-available(candidate4) { return candidate4; }
        let candidate5 = mod(root.focus-region + 5 * step + 7, 7);
        if root.region-available(candidate5) { return candidate5; }
        let candidate6 = mod(root.focus-region + 6 * step + 7, 7);
        if root.region-available(candidate6) { return candidate6; }
        let candidate7 = mod(root.focus-region + 7 * step + 7, 7);
        if root.region-available(candidate7) { return candidate7; }
        return 2;
    }
    function enter-focus-region(region: int) {
        if root.focus-region == 3 && region != 3 && !root.inspector-expanded && !root.rail-hovered && !root.flyout-hovered {
            root.hovered-inspector-section = "";
        }
        root.focus-region = root.region-available(region) ? region : 2;
        root.region-focus-epoch += 1;
        if root.focus-region == 3 && !root.inspector-expanded { root.f6-rail-token += 1; }
    }
    function reconcile-focus-region() {
        if root.region-focus-epoch > 0 && !root.regional-focus-blocked && !root.region-available(root.focus-region) {
            root.enter-focus-region(2);
        }
    }
    changed regional-focus-blocked => {
        if !root.regional-focus-blocked {
            if root.overlay-header-invoker == 1 || root.overlay-header-invoker == 2 {
                root.focus-region = 0;
                root.region-focus-epoch = 0;
                shell-header.restore-overlay-invoker(root.overlay-header-invoker);
                root.overlay-header-invoker = 0;
            } else { root.enter-focus-region(root.focus-region); }
        }
    }
    changed inspector-visible => { root.reconcile-focus-region(); }
    changed inspector-expanded => { root.reconcile-focus-region(); }
    changed compact-shell => { root.reconcile-focus-region(); }
    changed asset-library-visible => { root.reconcile-focus-region(); }
    changed active-workspace => { root.reconcile-focus-region(); }
    // Fechamento do popover de criação devolve o foco ao controle que o abriu.
    // Sem invocador de controle, o foco permanece onde estava (popover não modal).
    changed add-menu-open => {
        root.add-menu-highlight = -1;
        if !root.add-menu-open && root.add-menu-invoker == 1 {
            root.add-menu-invoker = 0;
            root.rail-add-focus-token += 1;
        }
    }

    root-focus := FocusScope {
        init => { self.focus(); }
        // Captura precede TextInput/Enter/F6 e o confinamento de cada modal.
        capture-key-pressed(event) => {
            if root.keymap-capture-action != "" {
                if event.text == Key.Escape { root.keymap-capture-cancelled(); }
                else { root.keymap-capture-key(root.shortcut-key-name(event.text), event.modifiers.control, event.modifiers.shift, event.modifiers.alt); }
                return accept;
            }
            reject
        }
        key-released(event) => {
            root.precision-mode = event.modifiers.shift;
            root.snap-mode = event.modifiers.control;
            reject
        }
        key-pressed(event) => {
            root.precision-mode = event.modifiers.shift;
            root.snap-mode = event.modifiers.control;
            // Controles usam Tab nativo. Na superfície de edição preserva-se
            // o atalho de ferramenta configurado; combinações seguem no keymap.
            if (event.text == Key.Tab || event.text == "\u{0019}") && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                && !(root-focus.has-focus || viewport-region.has-region-focus) { return reject; }
            if root.settings-visible && (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                root.settings-tab = event.text == Key.DownArrow ? min(root.settings-tab + 1, 8) : max(root.settings-tab - 1, 0);
                return accept;
            }
            if event.text == Key.F6 {
                if !root.regional-focus-blocked { root.enter-focus-region(root.next-focus-region(event.modifiers.shift)); }
                return accept;
            }
            if root.menu-open != "" {
                if event.text == Key.DownArrow { root.menu-step(1); return accept; }
                if event.text == Key.UpArrow { root.menu-step(-1); return accept; }
                if event.text == Key.RightArrow {
                    root.menu-opened(root.menu-open == "file" ? "edit" : (root.menu-open == "edit" ? "view" : (root.menu-open == "view" ? "window" : "file")));
                    return accept;
                }
                if event.text == Key.LeftArrow {
                    root.menu-opened(root.menu-open == "file" ? "window" : (root.menu-open == "edit" ? "file" : (root.menu-open == "view" ? "edit" : "view")));
                    return accept;
                }
                if event.text == Key.Return {
                    if root.menu-selectable(root.menu-highlight) {
                        root.menu-item-invoked(root.current-menu-entries[root.menu-highlight].id);
                    }
                    return accept;
                }
                if event.text == Key.Escape {
                    root.click-away-requested();
                    return accept;
                }
            }
            if event.text == Key.Escape {
                if root.home-open {
                    root.home-closed();
                    return accept;
                }
                if root.rail-flyout != "" {
                    root.rail-flyout = "";
                    return accept;
                }
                if root.quick-actions-open {
                    root.quick-actions-open = false;
                    return accept;
                }
                if root.context-menu-open {
                    root.context-menu-open = false;
                    root.click-away-requested();
                    return accept;
                }
                if root.paint-canvas-panel-visible {
                    root.paint-canvas-panel-visible = false;
                    return accept;
                }
                if root.settings-visible {
                    root.settings-visible = false;
                    root.settings-closed();
                    return accept;
                }
                if root.reference-manager-visible {
                    root.reference-manager-visible = false;
                    root.reference-manager-closed();
                    return accept;
                }
                viewport-input.clear-gesture();
                root.escape-requested();
                return accept;
            }
            if !root.regional-focus-blocked {
                root.shortcut-requested(
                    root.shortcut-key-name(event.text),
                    event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

            shell-header := ShellHeader {
                region-focus-token: root.focus-region == 0 && !root.regional-focus-blocked ? root.region-focus-epoch : 0;
                region-focus-enabled: !root.regional-focus-blocked;
                menu-open: root.menu-open;
                menu-file-label: root.menu-file-label;
                menu-edit-label: root.menu-edit-label;
                menu-view-label: root.menu-view-label;
                menu-window-label: root.menu-window-label;
                active-workspace: root.active-workspace;
                modeling-mode: root.modeling-mode;
                draw-title: root.label-workspace-draw-title;
                draw-description: root.label-workspace-draw-description;
                poly-title: root.label-workspace-poly-title;
                poly-description: root.label-workspace-poly-description;
                reduced-motion: root.reduced-motion;
                animate-available: root.animate-available;
                animate-label: root.animate-texts.workspace-label;
                animate-tip: root.animate-texts.workspace-tip;
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                shortcut-undo: root.shortcuts.undo;
                shortcut-redo: root.shortcuts.redo;
                shortcut-search: root.shortcuts.search;
                shortcut-settings: root.shortcuts.settings;

                menu-toggled(name, x) => {
                    root.menu-anchor-x = x;
                    root.menu-toggled(name);
                }
                menu-opened(name, x) => {
                    root.menu-anchor-x = x;
                    root.menu-opened(name);
                }
                workspace-changed(ws) => {
                    // The selector owns focus during this interaction. Clear the
                    // F6 transfer token before changing regions so the Header
                    // anchor does not replace its keyboard focus.
                    root.region-focus-epoch = 0;
                    root.focus-region = 0;
                    root.workspace-changed(ws);
                }
                undo-requested => { root.undo-requested(); }
                redo-requested => { root.redo-requested(); }
                search-requested => { root.search-requested(); }
                settings-requested => { root.settings-requested(); }
                overlay-invoked(invoker) => { root.overlay-header-invoker = invoker; }
            }

            HorizontalLayout {
                spacing: 0px;
                horizontal-stretch: 1;
                vertical-stretch: 1;

                // Contextual Tool Rail: estado permanece no shell; o componente só projeta e emite intents.
                ToolRail {
                    region-focus-token: root.focus-region == 1 && !root.regional-focus-blocked ? root.region-focus-epoch : 0;
                    region-focus-enabled: !root.regional-focus-blocked;
                    active-workspace: root.active-workspace;
                    modeling-mode: root.modeling-mode;
                    active-tool: root.active-tool;
                    transform-instant-active: root.transform-instant-active;
                    show-tool-labels: root.show-tool-labels;
                    add-menu-open: root.add-menu-open;
                    add-focus-token: root.rail-add-focus-token;
                    flyout: root.rail-flyout;
                    asset-library-visible: root.asset-library-visible;

                    select-tools: root.rail-select-tools;
                    helper-tools: root.rail-helper-tools;
                    paint-brush-tools: root.rail-paint-brush-tools;
                    paint-shape-tools: root.rail-paint-shape-tools;
                    paint-gradient-tools: root.rail-paint-gradient-tools;
                    animate-catalog: root.animate-catalog;
                    shortcuts: root.shortcuts;

                    label-model-position: root.label-model-position;
                    label-model-rotate: root.label-model-rotate;
                    label-model-scale: root.label-model-scale;
                    label-model-transform: root.label-model-transform;
                    label-model-push-pull: root.label-model-push-pull;
                    label-asset-library: root.label-asset-library;

                    activate-tool(id) => { root.active-tool-changed(id); }
                    execute-command(id) => { root.command-executed(id); }
                    rail-activate(id) => { root.rail-activate(id); }
                    flyout-requested(group, x, y) => {
                        root.rail-flyout-x = x;
                        root.rail-flyout-y = y;
                        root.rail-flyout = group;
                        if group == "select" {
                            root.rail-flyout-tools = root.rail-select-tools;
                        } else if group == "helpers" {
                            root.rail-flyout-tools = root.rail-helper-tools;
                        } else if group == "paint-brush" {
                            root.rail-flyout-tools = root.rail-paint-brush-tools;
                        } else if group == "paint-shapes" {
                            root.rail-flyout-tools = root.rail-paint-shape-tools;
                        } else if group == "paint-gradients" {
                            root.rail-flyout-tools = root.rail-paint-gradient-tools;
                        }
                    }
                    add-profile-rectangle(w, h) => { root.add-profile-rectangle(w, h); }
                    add-profile-circle(radius, segments) => { root.add-profile-circle(radius, segments); }
                    add-menu-toggled(open) => {
                        if open { root.add-menu-invoker = 1; }
                        root.add-menu-open = open;
                        root.add-menu-changed(open);
                    }
                    add-menu-step(delta) => { root.add-menu-step(delta); }
                    add-menu-invoke => { root.add-menu-invoke(); }
                    flyout-step(delta) => { root.rail-flyout-step(delta); }
                    flyout-invoke => { root.rail-flyout-invoke(); }
                    animate-action(action, arg, value) => { root.animate-action(action, arg, value); }
                    asset-library-requested => { root.asset-library-requested(); }
                }

                // Contêiner da viewport: principal + (opcional) vista dividida, lado a lado.
                Rectangle {
                    horizontal-stretch: 1;
                viewport-region := PetuniaViewportHost {
                    region-focus-token: root.focus-region == 2 && !root.regional-focus-blocked ? root.region-focus-epoch : 0;
                    region-focus-enabled: !root.regional-focus-blocked;
                    width: root.split-enabled ? (parent.width - 4px) / 2 : parent.width;
                    height: parent.height;
                    split-enabled: root.split-enabled;
                    has-gpu-viewport: root.has-gpu-viewport;
                    viewport-image: root.viewport-image;
                    resized(w, h, physical-w, physical-h) => {
                        root.viewport-resized(w, h, physical-w, physical-h);
                    }

                    // Overlays passivos: seleção, animação e previews calculados fora da camada declarativa.
                    ViewportPassiveOverlays {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        selection-visible: root.selection-overlay-visible;
                        selection-unselected-outline: root.selection-unselected-outline-commands;
                        selection-outline: root.selection-outline-commands;
                        selection-active-outline: root.selection-active-outline-commands;
                        selection-unselected-points: root.selection-unselected-point-commands;
                        selection-points: root.selection-point-commands;
                        selection-color: root.selection-color;
                        active-selection-color: root.active-selection-color;
                        selection-thickness: root.selection-thickness;

                        animate-bones-visible: root.active-workspace == "ANIMATE" && root.animate-show-bones;
                        animate-bone-commands: root.animate-bone-commands;
                        animate-joint-commands: root.animate-joint-commands;

                        operation-preview: root.operation-preview-commands;
                        loop-cut-preview: root.loop-cut-preview-commands;
                        poly-pen-preview: root.poly-pen-preview-commands;
                        region-shapes: root.region-shapes-commands;
                        profile-outline: root.profile-outline-commands;
                        profile-selection: root.profile-selection-commands;
                        region-hover: root.region-hover-commands;
                    }

                    ViewportGuideOverlays {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        active-layer-is-decal: root.active-layer-is-decal;
                        active-workspace: root.active-workspace;
                        axis-guide-color: root.axis-guide-color;
                        axis-guide-commands: root.axis-guide-commands;
                        axis-guide-label: root.axis-guide-label;
                        axis-guide-label-x: root.axis-guide-label-x;
                        axis-guide-label-y: root.axis-guide-label-y;
                        axis-guide-visible: root.axis-guide-visible;
                        decal-preview-commands: root.decal-preview-commands;
                        depth-handle-commands: root.depth-handle-commands;
                        depth-handle-label: root.depth-handle-label;
                        depth-handle-visible: root.depth-handle-visible;
                        depth-handle-x: root.depth-handle-x;
                        depth-handle-y: root.depth-handle-y;
                        dimension-commands: root.dimension-commands;
                        dimension-visible: root.dimension-visible;
                        drag-link-commands: root.drag-link-commands;
                        measure-commands: root.measure-commands;
                        measure-visible: root.measure-visible;
                        parametric-handle-commands: root.parametric-handle-commands;
                        parametric-handle-hover: root.parametric-handle-hover;
                        parametric-handle-visible: root.parametric-handle-visible;
                        parametric-handle-x: root.parametric-handle-x;
                        parametric-handle-y: root.parametric-handle-y;
                        profile-preview-commands: root.profile-preview-commands;
                        proportional-circle-commands: root.proportional-circle-commands;
                        protractor-ticks-commands: root.protractor-ticks-commands;
                        protractor-visible: root.protractor-visible;
                        protractor-wedge-commands: root.protractor-wedge-commands;
                        stencil-image: root.stencil-image;
                        stencil-visible: root.stencil-visible;
                    }

                    viewport-input := ViewportInputRouter {
                        width: parent.width;
                        height: parent.height;

                        active-tool: root.active-tool;
                        active-workspace: root.active-workspace;
                        modeling-mode: root.modeling-mode;

                        brush-cursor-squash: root.brush-cursor-squash;
                        brush-cursor-tilt: root.brush-cursor-tilt;
                        brush-flow: root.brush-flow;
                        brush-hardness: root.brush-hardness;
                        brush-opacity: root.brush-opacity;
                        brush-size: root.brush-size;
                        paint-color: root.paint-color;

                        drag-threshold-px: root.drag-threshold-px;
                        precision-mask: root.pointer-precision-mask;
                        snap-mask: root.pointer-snap-mask;
                        extend-mask: root.pointer-extend-mask;
                        subtract-mask: root.pointer-subtract-mask;
                        pan-mask: root.pointer-pan-mask;
                        cursor-place-mask: root.pointer-cursor-place-mask;
                        adjust-mask: root.pointer-adjust-mask;
                        loop-mask: root.pointer-loop-mask;
                        orbit-left-mask: root.pointer-orbit-left-mask;
                        paint-straight-mask: root.pointer-paint-straight-mask;
                        clone-source-mask: root.pointer-clone-source-mask;
                        decal-scale-mask: root.pointer-decal-scale-mask;
                        decal-rotate-mask: root.pointer-decal-rotate-mask;
                        depth-handle-visible: root.depth-handle-visible;
                        depth-handle-x: root.depth-handle-x;
                        depth-handle-y: root.depth-handle-y;
                        gizmo-has-hover: root.gizmo-has-hover;
                        keyboard-tool-modal-active: root.keyboard-tool-modal-active;
                        loop-cut-active: root.loop-cut-active;
                        profile-depth: root.profile-depth;
                        tool-activation: root.tool-activation;
                        tool-gesture-latched: root.tool-gesture-latched;
                        tool-grammar-active: root.tool-grammar-active;
                        tool-modal-active: root.tool-modal-active;
                        transform-instant-active: root.transform-instant-active;

                        precision-mode <=> root.precision-mode;
                        snap-mode <=> root.snap-mode;

                        focus-requested => { root-focus.focus(); }
                        gizmo-drag-begin(x, y) => { root.gizmo-drag-begin(x, y); }
                        gizmo-drag-end => { root.gizmo-drag-end(); }
                        gizmo-hover(x, y) => { root.gizmo-hover(x, y); }
                        loop-cut-apply => { root.loop-cut-apply(); }
                        loop-cut-scrubbed(dx, dy) => { root.loop-cut-scrubbed(dx, dy); }
                        profile-depth-set(text) => { return root.profile-depth-set(text); }
                        tool-modal-apply => { root.tool-modal-apply(); }
                        tool-modal-hovered(delta, x, y) => { root.tool-modal-hovered(delta, x, y); }
                        tool-modal-scrubbed(delta, fine, x, y) => { root.tool-modal-scrubbed(delta, fine, x, y); }
                        tool-pointer(phase, x, y, shift, ctrl, alt) => { root.tool-pointer(phase, x, y, shift, ctrl, alt); }
                        viewport-box-select(x0, y0, x1, y1, extend, subtract) => { root.viewport-box-select(x0, y0, x1, y1, extend, subtract); }
                        viewport-context-requested(x, y) => { root.viewport-context-requested(x, y); }
                        viewport-ctrl-scroll(delta) => { root.viewport-ctrl-scroll(delta); }
                        viewport-hover(x, y) => { root.viewport-hover(x, y); }
                        viewport-hover-clear => { root.viewport-hover-clear(); }
                        viewport-lasso-select(points, extend, subtract) => { root.viewport-lasso-select(points, extend, subtract); }
                        viewport-orbit(dx, dy) => { root.viewport-orbit(dx, dy); }
                        viewport-paint-begin(x, y, straight, clone, scale, rotate) => { root.viewport-paint-begin(x, y, straight, clone, scale, rotate); }
                        viewport-paint-end(x, y) => { root.viewport-paint-end(x, y); }
                        viewport-paint-update(x, y) => { root.viewport-paint-update(x, y); }
                        viewport-paint-cancel => { root.viewport-paint-cancel(); }
                        viewport-pan(dx, dy) => { root.viewport-pan(dx, dy); }
                        viewport-place-cursor(x, y) => { root.viewport-place-cursor(x, y); }
                        viewport-select(x, y, extend, loop) => { root.viewport-select(x, y, extend, loop); }
                        viewport-transform-begin(kind, x, y) => { root.viewport-transform-begin(kind, x, y); }
                        viewport-transform-end => { root.viewport-transform-end(); }
                        viewport-transform-update(x, y, fine, snap) => { root.viewport-transform-update(x, y, fine, snap); }
                        viewport-zoom(delta) => { root.viewport-zoom(delta); }
                    }

                    ViewportCursorHud {
                        active-workspace: root.active-workspace;
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        colorblind-axes: root.colorblind-axes;
                        cursor-screen-x: root.cursor-screen-x;
                        cursor-screen-y: root.cursor-screen-y;
                        cursor-visible: root.cursor-visible;
                        dimension-text: root.dimension-text;
                        dimension-visible: root.dimension-visible;
                        dimension-x: root.dimension-x;
                        dimension-y: root.dimension-y;
                        edit-pivot: root.edit-pivot;
                        hud-pill-badge: root.hud-pill-badge;
                        hud-pill-hint: root.hud-pill-hint;
                        hud-pill-title: root.hud-pill-title;
                        hud-pill-value: root.hud-pill-value;
                        hud-pill-visible: root.hud-pill-visible;
                        hud-pill-x: root.hud-pill-x;
                        hud-pill-y: root.hud-pill-y;
                        label-edit-pivot: root.label-edit-pivot;
                        measure-tags: root.measure-tags;
                        measure-text: root.measure-text;
                        measure-visible: root.measure-visible;
                        measure-x: root.measure-x;
                        measure-y: root.measure-y;
                        precision-mode: root.precision-mode;
                        snap-marker-label: root.snap-marker-label;
                        snap-marker-round: root.snap-marker-round;
                        snap-marker-visible: root.snap-marker-visible;
                        snap-marker-x: root.snap-marker-x;
                        snap-marker-y: root.snap-marker-y;
                        snap-mode: root.snap-mode;
                        world-axis-labels: root.world-axis-labels;
                    }

                    // View bar única (plano de UI 2026-10-04, F3; cap. 23 "Viewport control bar"):
                    // LEFT = o que estou editando, CENTER = auxiliares da ferramenta,
                    // RIGHT = como estou vendo. Substitui as três ilhas soltas anteriores.
                    view-bar := ViewBar {
                        right-clearance: root.right-clearance;
                        x: max(14px, (parent.width - root.right-clearance - self.width) / 2);
                            // LEFT — domínio de seleção do workspace.
                            if active-workspace == "MODEL" || active-workspace == "PAINT": HorizontalLayout {
                                spacing: 3px;
                                for domain in (active-workspace == "MODEL" && root.modeling-mode == "DRAW") ? [
                                    { id: "OBJECT", icon-svg: PetuniaIcons.object-mesh, label: Tr.t("sl.shape"), shortcut: root.shortcuts.select-object, description: Tr.t("sl.select_entire_shape") },
                                    { id: "EDGE", icon-svg: PetuniaIcons.tool-profile, label: Tr.t("sl.curve"), shortcut: root.shortcuts.select-edge, description: Tr.t("sl.select_curve_segment") },
                                    { id: "POINT", icon-svg: PetuniaIcons.select-vertex, label: Tr.t("sl.point"), shortcut: root.shortcuts.select-point, description: Tr.t("sl.select_and_transform_individual_vertices_poi") },
                                    { id: "FACE", icon-svg: PetuniaIcons.select-face, label: Tr.t("sl.region"), shortcut: root.shortcuts.select-face, description: Tr.t("sl.select_region_face") },
                                ] : active-workspace == "PAINT" ? [
                                    { id: "OBJECT", icon-svg: PetuniaIcons.object-mesh, label: Tr.t("sl.object"), shortcut: root.shortcuts.select-object, description: Tr.t("sl.select_and_manipulate_entire_objects_as_disc") },
                                    { id: "FACE", icon-svg: PetuniaIcons.select-face, label: Tr.t("sl.face"), shortcut: root.shortcuts.select-face, description: Tr.t("sl.select_and_transform_polygonal_planar_faces") },
                                ] : [
                                    { id: "OBJECT", icon-svg: PetuniaIcons.object-mesh, label: Tr.t("sl.object"), shortcut: root.shortcuts.select-object, description: Tr.t("sl.select_and_manipulate_entire_objects_as_disc") },
                                    { id: "POINT", icon-svg: PetuniaIcons.select-vertex, label: Tr.t("sl.point"), shortcut: root.shortcuts.select-point, description: Tr.t("sl.select_and_transform_individual_vertices_poi") },
                                    { id: "EDGE", icon-svg: PetuniaIcons.select-edge, label: Tr.t("sl.edge"), shortcut: root.shortcuts.select-edge, description: Tr.t("sl.select_and_transform_polygonal_boundary_edge") },
                                    { id: "FACE", icon-svg: PetuniaIcons.select-face, label: Tr.t("sl.face"), shortcut: root.shortcuts.select-face, description: Tr.t("sl.select_and_transform_polygonal_planar_faces") },
                                ]: ViewportBarButton {
                                    icon-svg: domain.icon-svg;
                                    label: domain.label;
                                    shortcut: domain.shortcut;
                                    description: domain.description;
                                    active: selection-domain == domain.id;
                                    emphasized: true;
                                    clicked => { root.selection-domain-changed(domain.id); }
                                }
                            }
                            if active-workspace == "MODEL" || active-workspace == "PAINT": Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }

                            // CENTER — pivô, snap e edição proporcional (modelagem).
                            if active-workspace == "MODEL" && root.viewport-region-width >= 600: HorizontalLayout {
                                spacing: 3px;
                                IconButton {
                                    icon-svg: PetuniaIcons.cursor-3d;
                                    variant: "toggle";
                                    semantic-label: "\{root.label-model-pivot}: \{root.pivot-label}";
                                    shortcut: root.shortcuts.view-pivot;
                                    description: Tr.t("sl.change_pivot_point_origin_for_transformation");
                                    active: root.pivot-menu-open;
                                    clicked => { root.pivot-menu-toggled(!root.pivot-menu-open); }
                                }
                                if root.viewport-region-width >= 680: IconButton {
                                    icon-svg: PetuniaIcons.snap-magnet;
                                    variant: "toggle";
                                    semantic-label: root.snap-enabled ? Tr.t("sl.snap_2") + " (\{root.snap-target})" : Tr.t("sl.snap_2");
                                    shortcut: root.shortcuts.view-snap;
                                    description: Tr.t("sl.snap_transformations_to_grid_intervals_verti");
                                    active: root.snap-enabled;
                                    clicked => { root.toggle-snap-enabled(); }
                                }
                                if root.viewport-region-width >= 750: IconButton {
                                    icon-svg: PetuniaIcons.circle-dot;
                                    variant: "toggle";
                                    semantic-label: root.proportional-editing ? Tr.t("sl.prop") + " (\{round(root.proportional-radius * 10) / 10})" : Tr.t("sl.prop");
                                    shortcut: root.shortcuts.view-prop;
                                    description: Tr.t("sl.smoothly_deform_neighboring_vertices_with_pr");
                                    active: root.proportional-editing;
                                    clicked => { root.toggle-proportional-editing(); }
                                }
                                Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }
                            }

                            // RIGHT — câmera e sombreamento. No DRAW a vista é planar
                            // (sempre ortográfica), então o mesmo lugar alterna
                            // Planar ↔ Livre em vez de Persp ↔ Ortho.
                            if active-workspace == "MODEL" && root.modeling-mode == "DRAW": IconButton {
                                icon-svg: root.planar-navigation ? PetuniaIcons.shape-square-dashed : PetuniaIcons.tool-rotate;
                                label: root.planar-navigation ? Tr.t("sl.planar_view") : Tr.t("sl.free_view");
                                variant: "toggle";
                                active: root.planar-navigation;
                                semantic-label: Tr.t("sl.planar_navigation");
                                description: Tr.t("sl.planar_navigation_hint");
                                clicked => { root.command-executed("view.planar_navigation"); }
                            }
                            if !(active-workspace == "MODEL" && root.modeling-mode == "DRAW"): IconButton {
                                icon-svg: PetuniaIcons.camera;
                                label: is-orthographic ? Tr.t("sl.ortho") : Tr.t("sl.persp");
                                semantic-label: Tr.t("sl.projection");
                                shortcut: root.shortcuts.view-proj;
                                description: Tr.t("sl.toggle_between_perspective_3d_projection_and");
                                clicked => { root.toggle-projection-requested(); }
                            }
                            if !(active-workspace == "MODEL" && root.modeling-mode == "DRAW"): IconButton {
                                icon-svg: PetuniaIcons.cube;
                                label: "2:1";
                                semantic-label: Tr.t("sl.pseudo_isometric_2to1");
                                shortcut: "Numpad 2";
                                description: Tr.t("sl.pseudo_isometric_2to1_hint");
                                clicked => { root.command-executed("view.pseudo_isometric_2to1"); }
                            }
                            IconButton {
                                icon-svg: PetuniaIcons.maximize;
                                semantic-label: Tr.t("sl.frame");
                                shortcut: root.shortcuts.view-frame;
                                description: Tr.t("sl.frame_and_center_camera_view_on_currently_se");
                                clicked => { root.command-executed("view.frame_selection"); }
                            }
                            Rectangle { width: 1px; height: 18px; background: DesignTokens.border; }
                            // Sombreamento num só botão (mostra o modo atual); modos e X-Ray ficam
                            // no popover (plano de UI F0/§11: menos controles em repouso).
                            ViewportSvgButton {
                                glyph: root.shading-mode == "wireframe" ? PetuniaIcons.view-wire : (root.shading-mode == "material" ? PetuniaIcons.view-material : (root.shading-mode == "rendered" ? PetuniaIcons.view-lit : PetuniaIcons.view-solid));
                                label: Tr.t("sl.shading_options");
                                description: Tr.t("sl.configure_studio_matcaps_cavity_highlights_a");
                                active: root.shading-popover-open || root.show-xray;
                                clicked => { root.shading-popover-toggled(!root.shading-popover-open); }
                            }

                    }

                    ViewportStatusHud {
                        right-clearance: root.right-clearance;
                        active-workspace: root.active-workspace;
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        active-tool: root.active-tool;
                        is-instant-tool-mode: root.is-instant-tool-mode;
                        measure-hud-text: root.measure-hud-text;
                        measure-visible: root.measure-visible;
                        tool-modal-active: root.tool-modal-active;
                        tool-modal-title: root.tool-modal-title;
                        tool-options-title: root.tool-options-title;
                    }

                    // Barra de transporte: interativa, então fica DEPOIS do
                    // o input router (irmãos posteriores recebem o clique antes).
                    if root.active-workspace == "ANIMATE" && root.animate-has-creature && !(root.asset-library-visible && root.drawer-tab == 1): AnimateTransport {
                        // Centrada na parte livre da viewport (fora do painel aberto)
                        // e ACIMA da barra contextual (40px + 14px de margem + respiro).
                        x: (parent.width - root.right-clearance - self.width) / 2;
                        y: parent.height - self.height - 64px;
                        width: min(640px, parent.width - root.right-clearance - 32px);
                        texts: root.animate-texts;
                        playing: root.animate-playing;
                        has-motion: root.animate-has-motion;
                        progress: root.animate-progress;
                        time-label: root.animate-time-label;
                        action(a, b, v) => { root.animate-action(a, b, v); }
                    }

                    // Card de opções do Loop Cut.
                    if loop-cut-active || loop-cut-armed: LoopCutCard {
                        tool-properties-collapsed <=> root.tool-properties-collapsed;
                        loop-cut-active: root.loop-cut-active;
                        loop-cut-slide: root.loop-cut-slide;
                        loop-cut-cuts: root.loop-cut-cuts;
                        loop-cut-balanced: root.loop-cut-balanced;
                        label-cancel: root.label-cancel;
                        label-apply: root.label-apply;
                        loop-cut-slide-committed(a0) => { return root.loop-cut-slide-committed(a0); }
                        loop-cut-count-committed(a0) => { root.loop-cut-count-committed(a0); }
                        toggle-loop-cut-balanced() => { root.toggle-loop-cut-balanced(); }
                        loop-cut-cancel() => { root.loop-cut-cancel(); }
                        loop-cut-apply() => { root.loop-cut-apply(); }
                    }

                    // Card modal numérico de ferramenta.
                    if tool-modal-active && !loop-cut-active && !loop-cut-armed: ToolModalCard {
                        tool-modal-title: root.tool-modal-title;
                        tool-properties-collapsed <=> root.tool-properties-collapsed;
                        tool-modal-id: root.tool-modal-id;
                        tool-modal-value: root.tool-modal-value;
                        tool-modal-label: root.tool-modal-label;
                        tool-modal-step: root.tool-modal-step;
                        label-cancel: root.label-cancel;
                        label-apply: root.label-apply;
                        tool-modal-toggle-extrude-mode() => { root.tool-modal-toggle-extrude-mode(); }
                        tool-modal-text-committed(a0) => { return root.tool-modal-text-committed(a0); }
                        tool-modal-cancel() => { root.tool-modal-cancel(); }
                        tool-modal-apply() => { root.tool-modal-apply(); }
                    }

                    // Card do perfil DRAW.
                    if profile-active && !tool-modal-active && !loop-cut-active && !loop-cut-armed: ProfileCard {
                        label-model-profile: root.label-model-profile;
                        tool-properties-collapsed <=> root.tool-properties-collapsed;
                        label-profile-plane: root.label-profile-plane;
                        profile-workplane-locked: root.profile-workplane-locked;
                        label-profile-plane-auto: root.label-profile-plane-auto;
                        profile-workplane: root.profile-workplane;
                        label-profile-plane-ground: root.label-profile-plane-ground;
                        label-profile-plane-face: root.label-profile-plane-face;
                        label-profile-plane-view: root.label-profile-plane-view;
                        label-profile-look-at-plane: root.label-profile-look-at-plane;
                        trace-threshold: root.trace-threshold;
                        extension-radius: root.extension-radius;
                        extension-length: root.extension-length;
                        extension-angle: root.extension-angle;
                        extension-sides: root.extension-sides;
                        extension-tolerance: root.extension-tolerance;
                        label-profile-points: root.label-profile-points;
                        profile-point-count: root.profile-point-count;
                        profile-closed: root.profile-closed;
                        label-profile-close: root.label-profile-close;
                        profile-parametric: root.profile-parametric;
                        profile-width: root.profile-width;
                        profile-height: root.profile-height;
                        profile-ellipse: root.profile-ellipse;
                        profile-segments: root.profile-segments;
                        label-profile-depth: root.label-profile-depth;
                        profile-depth: root.profile-depth;
                        label-profile-wall-thickness: root.label-profile-wall-thickness;
                        profile-wall-thickness: root.profile-wall-thickness;
                        profile-has-curves: root.profile-has-curves;
                        label-profile-sharp-corners: root.label-profile-sharp-corners;
                        label-profile-smooth-curves: root.label-profile-smooth-curves;
                        label-profile-smoothness: root.label-profile-smoothness;
                        profile-smoothness: root.profile-smoothness;
                        profile-volume-mode: root.profile-volume-mode;
                        label-profile-revolve: root.label-profile-revolve;
                        label-profile-sweep: root.label-profile-sweep;
                        label-profile-generate: root.label-profile-generate;
                        profile-revolve-angle: root.profile-revolve-angle;
                        label-profile-add-rect: root.label-profile-add-rect;
                        label-profile-add-circle: root.label-profile-add-circle;
                        hint-model-profile: root.hint-model-profile;
                        profile-set-workplane-auto() => { root.profile-set-workplane-auto(); }
                        profile-set-workplane-ground() => { root.profile-set-workplane-ground(); }
                        profile-set-workplane-face() => { root.profile-set-workplane-face(); }
                        profile-set-workplane-view() => { root.profile-set-workplane-view(); }
                        profile-look-at-plane() => { root.profile-look-at-plane(); }
                        extension-parameter-set(a0, a1) => { return root.extension-parameter-set(a0, a1); }
                        profile-close() => { root.profile-close(); }
                        profile-dimension-gesture(a0) => { root.profile-dimension-gesture(a0); }
                        profile-dimension-set(a0, a1) => { return root.profile-dimension-set(a0, a1); }
                        profile-depth-set(a0) => { return root.profile-depth-set(a0); }
                        profile-wall-thickness-set(a0) => { return root.profile-wall-thickness-set(a0); }
                        profile-clear-curves() => { root.profile-clear-curves(); }
                        profile-smooth-curves() => { root.profile-smooth-curves(); }
                        profile-smoothness-set(a0) => { return root.profile-smoothness-set(a0); }
                        profile-enter-revolve() => { root.profile-enter-revolve(); }
                        profile-enter-sweep() => { root.profile-enter-sweep(); }
                        profile-generate() => { root.profile-generate(); }
                        profile-revolve-angle-set(a0) => { return root.profile-revolve-angle-set(a0); }
                        profile-volume-confirm() => { root.profile-volume-confirm(); }
                        profile-volume-cancel() => { root.profile-volume-cancel(); }
                        add-profile-rectangle(a0, a1) => { root.add-profile-rectangle(a0, a1); }
                        add-profile-circle(a0, a1) => { root.add-profile-circle(a0, a1); }
                    }

                    // Card de operação em andamento.
                    if operation-hud-active && !tool-modal-active && !loop-cut-active && !loop-cut-armed && !profile-active: OperationCard {
                        operation-hud-title: root.operation-hud-title;
                        operation-hud-hint: root.operation-hud-hint;
                        operation-hud-lines: root.operation-hud-lines;
                        operation-hud-subject: root.operation-hud-subject;
                    }

                    // Card de primitiva paramétrica.
                    if primitive-active && !tool-modal-active && !loop-cut-active && !loop-cut-armed && !profile-active: PrimitiveCard {
                        primitive-title: root.primitive-title;
                        primitive-kind: root.primitive-kind;
                        primitive-width: root.primitive-width;
                        primitive-height: root.primitive-height;
                        primitive-depth: root.primitive-depth;
                        primitive-radius: root.primitive-radius;
                        primitive-sides: root.primitive-sides;
                        primitive-cap-top: root.primitive-cap-top;
                        primitive-cap-bottom: root.primitive-cap-bottom;
                        primitive-radius-b: root.primitive-radius-b;
                        primitive-rings: root.primitive-rings;
                        primitive-subdiv: root.primitive-subdiv;
                        primitive-fill-disc: root.primitive-fill-disc;
                        primitive-param-float(a0, a1) => { root.primitive-param-float(a0, a1); }
                        primitive-param-bool(a0, a1) => { root.primitive-param-bool(a0, a1); }
                        primitive-cancel() => { root.primitive-cancel(); }
                        primitive-confirm() => { root.primitive-confirm(); }
                    }

                    // Card de opções da ferramenta ativa.
                    if !tool-modal-active && !loop-cut-active && !loop-cut-armed && !profile-active && !operation-hud-active && !primitive-active && ((root.active-workspace == "PAINT" && root.last-operation-active) || root.active-tool == "move" || root.active-tool == "rotate" || root.active-tool == "scale" || root.active-tool == "transform" || root.active-tool == "extrude" || root.active-tool == "inset" || root.active-tool == "push_pull" || root.active-tool == "cut" || root.active-tool == "slice" || root.active-tool == "bevel" || root.active-tool == "cursor" || root.active-tool == "cursor_3d" || root.active-tool == "poly_pen"): ToolOptionsCard {
                        tool-options-title: root.tool-options-title;
                        tool-properties-collapsed <=> root.tool-properties-collapsed;
                        last-operation-active: root.last-operation-active;
                        label-last-operation: root.label-last-operation;
                        last-operation-title: root.last-operation-title;
                        last-operation-unit: root.last-operation-unit;
                        label-last-operation-hint: root.label-last-operation-hint;
                        last-operation-value: root.last-operation-value;
                        last-operation-step: root.last-operation-step;
                        active-tool: root.active-tool;
                        label-poly-pen-mode: root.label-poly-pen-mode;
                        label-poly-pen-mode-auto: root.label-poly-pen-mode-auto;
                        poly-pen-mode: root.poly-pen-mode;
                        label-poly-pen-mode-points: root.label-poly-pen-mode-points;
                        label-poly-pen-mode-edges: root.label-poly-pen-mode-edges;
                        label-poly-pen-mode-polygons: root.label-poly-pen-mode-polygons;
                        label-poly-pen-mode-hint: root.label-poly-pen-mode-hint;
                        snap-enabled: root.snap-enabled;
                        snap-target: root.snap-target;
                        proportional-editing: root.proportional-editing;
                        proportional-radius: root.proportional-radius;
                        pivot-menu-open: root.pivot-menu-open;
                        pivot-label: root.pivot-label;
                        label-numeric-field-hint: root.label-numeric-field-hint;
                        pos-x: root.pos-x;
                        pos-y: root.pos-y;
                        pos-z: root.pos-z;
                        rot-x: root.rot-x;
                        rot-y: root.rot-y;
                        rot-z: root.rot-z;
                        scale-x: root.scale-x;
                        scale-y: root.scale-y;
                        scale-z: root.scale-z;
                        label-cancel: root.label-cancel;
                        slice-trim: root.slice-trim;
                        bevel-clamp-overlap: root.bevel-clamp-overlap;
                        bevel-affect-vertices: root.bevel-affect-vertices;
                        cursor-x: root.cursor-x;
                        cursor-y: root.cursor-y;
                        cursor-z: root.cursor-z;
                        last-operation-committed(a0) => { return root.last-operation-committed(a0); }
                        poly-pen-mode-selected(a0) => { root.poly-pen-mode-selected(a0); }
                        command-executed(a0) => { root.command-executed(a0); }
                        toggle-snap-enabled() => { root.toggle-snap-enabled(); }
                        toggle-proportional-editing() => { root.toggle-proportional-editing(); }
                        pivot-menu-toggled(a0) => { root.pivot-menu-toggled(a0); }
                        transform-scrubbed(a0, a1, a2, a3) => { root.transform-scrubbed(a0, a1, a2, a3); }
                        transform-scrub-started(a0) => { root.transform-scrub-started(a0); }
                        transform-scrub-finished() => { root.transform-scrub-finished(); }
                        transform-text-committed(a0, a1, a2) => { return root.transform-text-committed(a0, a1, a2); }
                        transform-scrub-cancelled() => { root.transform-scrub-cancelled(); }
                        slice-trim-set(a0) => { root.slice-trim-set(a0); }
                        slice-cancel() => { root.slice-cancel(); }
                        slice-confirm() => { root.slice-confirm(); }
                        toggle-bevel-clamp-overlap() => { root.toggle-bevel-clamp-overlap(); }
                        toggle-bevel-affect-vertices() => { root.toggle-bevel-affect-vertices(); }
                        cursor-coord-committed(a0, a1) => { root.cursor-coord-committed(a0, a1); }
                        frame-cursor-requested() => { root.frame-cursor-requested(); }
                        reset-cursor-requested() => { root.reset-cursor-requested(); }
                    }


                    // Gizmo de vista (eixos) do MODEL.
                    if gizmo-visible && active-workspace == "MODEL": GizmoOverlay {
                        width: parent.width;
                        height: parent.height;
                        gizmo-x-commands: root.gizmo-x-commands;
                        gizmo-y-commands: root.gizmo-y-commands;
                        gizmo-z-commands: root.gizmo-z-commands;
                        gizmo-x-arrow-commands: root.gizmo-x-arrow-commands;
                        gizmo-y-arrow-commands: root.gizmo-y-arrow-commands;
                        gizmo-z-arrow-commands: root.gizmo-z-arrow-commands;
                        gizmo-x-scale-commands: root.gizmo-x-scale-commands;
                        gizmo-y-scale-commands: root.gizmo-y-scale-commands;
                        gizmo-z-scale-commands: root.gizmo-z-scale-commands;
                        gizmo-x-rotate-commands: root.gizmo-x-rotate-commands;
                        gizmo-y-rotate-commands: root.gizmo-y-rotate-commands;
                        gizmo-z-rotate-commands: root.gizmo-z-rotate-commands;
                        gizmo-plane-yz-commands: root.gizmo-plane-yz-commands;
                        gizmo-plane-xz-commands: root.gizmo-plane-xz-commands;
                        gizmo-plane-xy-commands: root.gizmo-plane-xy-commands;
                        gizmo-view-roll-commands: root.gizmo-view-roll-commands;
                        gizmo-center-active: root.gizmo-center-active;
                        gizmo-center-hover: root.gizmo-center-hover;
                        gizmo-gpu: root.gizmo-gpu;
                        gizmo-origin-x: root.gizmo-origin-x;
                        gizmo-origin-y: root.gizmo-origin-y;
                        colorblind-axes: root.colorblind-axes;
                        gizmo-x-label-x: root.gizmo-x-label-x;
                        gizmo-x-end-x: root.gizmo-x-end-x;
                        gizmo-x-label-y: root.gizmo-x-label-y;
                        gizmo-x-end-y: root.gizmo-x-end-y;
                        gizmo-y-label-x: root.gizmo-y-label-x;
                        gizmo-y-end-x: root.gizmo-y-end-x;
                        gizmo-y-label-y: root.gizmo-y-label-y;
                        gizmo-y-end-y: root.gizmo-y-end-y;
                        gizmo-z-label-x: root.gizmo-z-label-x;
                        gizmo-z-end-x: root.gizmo-z-end-x;
                        gizmo-z-label-y: root.gizmo-z-label-y;
                        gizmo-z-end-y: root.gizmo-z-end-y;
                        gizmo-handle-color(axis, base) => { return root.gizmo-handle-color(axis, base); }
                        gizmo-handle-width(axis) => { return root.gizmo-handle-width(axis); }
                    }

                    // Tripé de navegação no alto à direita. Arrastar orbita a
                    // câmera; clicar em um eixo mantém o alinhamento da vista.
                    NavigationGizmo {
                        label-view-gizmo: root.label-view-gizmo;
                        label-view-gizmo-hint: root.label-view-gizmo-hint;
                        right-clearance: root.right-clearance;
                        view-gizmo-origin-x: root.view-gizmo-origin-x;
                        view-gizmo-origin-y: root.view-gizmo-origin-y;
                        view-gizmo-x-commands: root.view-gizmo-x-commands;
                        view-gizmo-x-end-x: root.view-gizmo-x-end-x;
                        view-gizmo-x-end-y: root.view-gizmo-x-end-y;
                        view-gizmo-y-commands: root.view-gizmo-y-commands;
                        view-gizmo-y-end-x: root.view-gizmo-y-end-x;
                        view-gizmo-y-end-y: root.view-gizmo-y-end-y;
                        view-gizmo-z-commands: root.view-gizmo-z-commands;
                        view-gizmo-z-end-x: root.view-gizmo-z-end-x;
                        view-gizmo-z-end-y: root.view-gizmo-z-end-y;
                        view-axis-clicked(a0) => { root.view-axis-clicked(a0); }
                        viewport-orbit(a0, a1) => { root.viewport-orbit(a0, a1); }
                    }

                    // Barra contextual flutuante na base da viewport.
                    context-bar := ViewportContextBar {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 14px;
                        visible: root.region-available(6);
                        region-focus-token: root.focus-region == 6 && root.region-available(6) && !root.regional-focus-blocked ? root.region-focus-epoch : 0;
                        region-focus-enabled: !root.regional-focus-blocked;
                        active-tool: root.active-tool;
                        active-workspace: root.active-workspace;
                        brush-opacity: root.brush-opacity;
                        brush-size: root.brush-size;
                        isolate-active: root.isolate-active;
                        label-model-loop-cut: root.label-model-loop-cut;
                        label-model-push-pull: root.label-model-push-pull;
                        label-more-model-tools: root.label-more-model-tools;
                        label-poly-pen: root.label-poly-pen;
                        label-poly-pen-hint: root.label-poly-pen-hint;
                        label-quick-action-customize: root.label-quick-action-customize;
                        modeling-mode: root.modeling-mode;
                        paint-color: root.paint-color;
                        paint-symmetry-x: root.paint-symmetry-x;
                        paint-symmetry-y: root.paint-symmetry-y;
                        paint-symmetry-z: root.paint-symmetry-z;
                        quick-actions: root.quick-actions;
                        quick-actions-open <=> root.quick-actions-open;
                        rail-cut-tools: root.rail-cut-tools;
                        rail-flyout <=> root.rail-flyout;
                        rail-flyout-tools <=> root.rail-flyout-tools;
                        rail-flyout-x <=> root.rail-flyout-x;
                        rail-flyout-y <=> root.rail-flyout-y;
                        shelf-overflow-open <=> root.shelf-overflow-open;
                        shortcuts: root.shortcuts;
                        viewport-region-width: root.viewport-region-width;
                        active-tool-changed(a0) => { root.active-tool-changed(a0); }
                        brush-opacity-changed(a0) => { root.brush-opacity-changed(a0); }
                        brush-size-changed(a0) => { root.brush-size-changed(a0); }
                        command-executed(a0) => { root.command-executed(a0); }
                        paint-symmetry-x-toggled() => { root.paint-symmetry-x-toggled(); }
                        paint-symmetry-y-toggled() => { root.paint-symmetry-y-toggled(); }
                        paint-symmetry-z-toggled() => { root.paint-symmetry-z-toggled(); }
                        poly-tool-visible(a0) => { return root.poly-tool-visible(a0); }
                        quick-action-executed(a0) => { root.quick-action-executed(a0); }
                        rail-activate(a0) => { root.rail-activate(a0); }
                        rail-flyout-invoke() => { root.rail-flyout-invoke(); }
                        rail-flyout-step(a0) => { root.rail-flyout-step(a0); }
                    }

                    // Popovers não modais deste contêiner (formas, flyout do trilho,
                    // overflow, ações rápidas, pivô): um único apanhador atrás de
                    // todos fecha no press fora deles. Antes cada um tinha (ou não)
                    // o seu, e o menu de formas ficava aberto ao clicar fora.
                    if root.add-menu-open || root.rail-flyout != "" || root.shelf-overflow-open
                        || root.quick-actions-open || root.pivot-menu-open: TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                if root.add-menu-open { root.add-menu-changed(false); }
                                if root.pivot-menu-open { root.pivot-menu-toggled(false); }
                                root.rail-flyout = "";
                                root.shelf-overflow-open = false;
                                root.quick-actions-open = false;
                            }
                        }
                    }

                    // Personalizar ações rápidas: cartão não modal acima da barra.
                    if active-workspace == "MODEL" && root.quick-actions-open: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: context-bar.y - self.height - 8px;
                        width: 300px;
                        height: qa-body.preferred-height + 24px;
                        border-radius: DesignTokens.radius-panel;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        drop-shadow-blur: DesignTokens.elevation-2-blur;
                        drop-shadow-color: DesignTokens.elevation-2-color;
                        drop-shadow-offset-y: DesignTokens.elevation-2-offset;
                        TouchArea { }
                        qa-body := QuickActionsBody {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            title-label: root.label-quick-actions;
                            customize-open <=> root.quick-actions-open;
                            actions: root.quick-actions;
                            candidates: root.quick-action-candidates;
                            customize-label: root.label-quick-action-customize;
                            remove-label: root.label-quick-action-remove;
                            add-label: root.label-quick-action-add;
                            reset-label: root.label-quick-action-reset;
                            done-label: root.label-quick-action-done;
                            action-executed(id) => { root.quick-action-executed(id); }
                            action-toggled(id) => { root.quick-action-toggled(id); }
                            actions-reset => { root.quick-actions-reset(); }
                        }
                    }

                    // Menu de pivô.
                    if root.pivot-menu-open: PivotMenu {
                        x: min(max(8px, (parent.width - self.width) / 2), parent.width - self.width - 8px);
                        label-model-pivot: root.label-model-pivot;
                        pivot-median-label: root.pivot-median-label;
                        pivot-bounds-label: root.pivot-bounds-label;
                        pivot-cursor-label: root.pivot-cursor-label;
                        pivot-individual-label: root.pivot-individual-label;
                        pivot-id: root.pivot-id;
                        edit-pivot: root.edit-pivot;
                        label-edit-pivot: root.label-edit-pivot;
                        label-origin-to-geometry: root.label-origin-to-geometry;
                        label-origin-to-bottom: root.label-origin-to-bottom;
                        label-origin-to-cursor: root.label-origin-to-cursor;
                        label-origin-to-selection: root.label-origin-to-selection;
                        label-geometry-to-origin: root.label-geometry-to-origin;
                        pivot-set(a0) => { root.pivot-set(a0); }
                        pivot-menu-toggled(a0) => { root.pivot-menu-toggled(a0); }
                        command-executed(a0) => { root.command-executed(a0); }
                    }

                    // Micro Inspector flutuante.
                    if root.micro-inspector-open && active-workspace == "MODEL": MicroInspector {
                        x: min(max(14px, root.micro-inspector-x), parent.width - self.width - 14px);
                        y: min(max(14px, root.micro-inspector-y), parent.height - self.height - 14px);
                        micro-inspector-x: root.micro-inspector-x;
                        micro-inspector-y: root.micro-inspector-y;
                        active-tool: root.active-tool;
                        measure-visible: root.measure-visible;
                        measure-distance: root.measure-distance;
                        measure-dx: root.measure-dx;
                        measure-dy: root.measure-dy;
                        measure-dz: root.measure-dz;
                        measure-angle-deg: root.measure-angle-deg;
                        pos-x: root.pos-x;
                        pos-y: root.pos-y;
                        pos-z: root.pos-z;
                        rot-x: root.rot-x;
                        rot-y: root.rot-y;
                        rot-z: root.rot-z;
                        micro-inspector-toggle() => { root.micro-inspector-toggle(); }
                        active-tool-changed(a0) => { root.active-tool-changed(a0); }
                        command-executed(a0) => { root.command-executed(a0); }
                    }

                    if root.shelf-overflow-open && active-workspace == "MODEL" && root.viewport-region-width < 760: Rectangle {
                        x: min(parent.width - self.width - 14px, context-bar.x + context-bar.width - self.width);
                        y: context-bar.y - self.height - 8px;
                        width: 190px;
                        height: 380px;
                        border-radius: 8px;
                        background: DesignTokens.surface-raised;
                        border-width: 1px;
                        border-color: DesignTokens.border;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;
                            ContextMenuItem { label: Tr.t("sl.duplicate"); shortcut: root.shortcuts.model-duplicate; clicked => { root.shelf-overflow-open = false; root.duplicate-requested(); } }
                            ContextMenuItem { label: Tr.t("sl.loop_cut"); shortcut: root.shortcuts.model-loop-cut; clicked => { root.shelf-overflow-open = false; root.command-executed("model.loop_cut"); } }
                            ContextMenuItem { label: root.label-model-push-pull; shortcut: root.shortcuts.model-push-pull; clicked => { root.shelf-overflow-open = false; root.command-executed("model.push_pull"); } }
                            ContextMenuItem { label: root.label-model-profile; shortcut: root.shortcuts.model-profile; clicked => { root.shelf-overflow-open = false; root.active-tool-changed("draw_profile"); } }
                            ContextMenuItem { label: root.label-model-slice; shortcut: root.shortcuts.model-slice; clicked => { root.shelf-overflow-open = false; root.active-tool-changed("slice"); } }
                            ContextMenuItem { label: Tr.t("sl.connect_loops"); shortcut: root.shortcuts.model-connect; clicked => { root.shelf-overflow-open = false; root.command-executed("model.connect"); } }
                            ContextMenuItem { label: Tr.t("sl.make_face_edge"); shortcut: "F"; clicked => { root.shelf-overflow-open = false; root.command-executed("model.make_face"); } }
                            ContextMenuItem { label: Tr.t("sl.spin_lathe"); shortcut: root.shortcuts.model-spin; clicked => { root.shelf-overflow-open = false; root.command-executed("model.spin"); } }
                            ContextMenuItem { label: Tr.t("sl.subdivide"); shortcut: root.shortcuts.model-subdivide; clicked => { root.shelf-overflow-open = false; root.command-executed("model.subdivide"); } }
                            ContextMenuItem { label: Tr.t("sl.merge_center"); shortcut: root.shortcuts.model-merge; clicked => { root.shelf-overflow-open = false; root.command-executed("model.merge"); } }
                            ContextMenuItem { label: Tr.t("sl.dissolve"); shortcut: root.shortcuts.model-dissolve; clicked => { root.shelf-overflow-open = false; root.command-executed("model.dissolve"); } }
                            ContextMenuItem { label: Tr.t("sl.slice"); shortcut: root.shortcuts.model-slice; clicked => { root.shelf-overflow-open = false; root.command-executed("model.slice"); } }
                            ContextMenuItem { label: Tr.t("sl.delete"); shortcut: root.shortcuts.model-delete; danger: true; clicked => { root.shelf-overflow-open = false; root.delete-requested(); } }
                        }
                    }

                    // Flyout de grupo do Tool Rail.
                    if root.rail-flyout != "": RailFlyout {
                        // Ao lado do botão de origem, sempre dentro da viewport.
                        x: clamp(root.rail-flyout-x - parent.absolute-position.x, 6px, max(6px, parent.width - self.width - 6px));
                        y: clamp(root.rail-flyout-y - parent.absolute-position.y, 6px, max(6px, parent.height - self.height - 6px));
                        rail-flyout-x: root.rail-flyout-x;
                        rail-flyout-y: root.rail-flyout-y;
                        rail-flyout-tools: root.rail-flyout-tools;
                        rail-flyout-highlight: root.rail-flyout-highlight;
                        rail-activate(id) => { root.rail-activate(id); }
                    }

                    // Popover de criação de primitivas.
                    if add-menu-open && active-workspace == "MODEL": AddMenuPopover {
                        add-menu-highlight: root.add-menu-highlight;
                        add-primitive-requested(a0) => { root.add-primitive-requested(a0); }
                        add-menu-changed(a0) => { root.add-menu-changed(a0); }
                    }

                    // Coluna direita escondida: um botão na borda a traz de volta
                    // (o mesmo comando do atalho N e do palette).
                    if !root.inspector-visible && !root.compact-shell: IconButton {
                        x: parent.width - self.width - 8px;
                        y: 8px;
                        icon-svg: PetuniaIcons.panel-left;
                        variant: "ghost";
                        semantic-label: Tr.t("sl.show_inspector");
                        description: Tr.t("sl.show_inspector_hint");
                        clicked => { root.command-executed("window.inspector"); }
                    }

                    RightColumnShell {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;

                        inspector-visible: root.inspector-visible;
                        compact-shell: root.compact-shell;
                        inspector-expanded: root.inspector-expanded;
                        inspector-flyout-open: root.inspector-flyout-open;
                        rail-clearance: root.rail-clearance;

                        hovered-section <=> root.hovered-inspector-section;
                        flyout-hovered <=> root.flyout-hovered;
                        rail-hovered <=> root.rail-hovered;
                        regional-focus-enabled: !root.regional-focus-blocked;
                        f6-rail-token: root.focus-region == 3 && !root.regional-focus-blocked ? root.f6-rail-token : 0;

                        parts-open: root.model-parts-open;
                        transform-open: root.model-transform-open;
                        material-open: root.model-material-open;
                        object-open: root.model-object-open;

                        label-parts: root.label-tab-parts;
                        label-transform: root.label-tab-transform;
                        label-material: root.label-tab-material;
                        label-object: root.label-tab-object;

                        active-workspace: root.active-workspace;
                        object-has-selection: root.object-has-selection;
                        object-name: root.object-name;
                        label-duplicate: root.label-duplicate;
                        label-delete: root.label-delete;

                        section-pill-clicked(id) => { root.section-pill-clicked(id); }
                        collapse-requested => { root.inspector-collapse-requested(); }
                        duplicate-requested => { root.duplicate-requested(); }
                        delete-requested => { root.delete-requested(); }
                        panel-width <=> root.inspector-width;
                        panel-width-changed(w) => { root.inspector-width-changed(w / 1px); }

                            if active-workspace == "MODEL": ModelInspector {
                                // Sem `parent.width`: o pai léxico é o RightColumnShell (largura
                                // da viewport); o conteúdo de @children preenche o slot do flyout.
                                structure-ratio: root.inspector-structure-ratio;
                                structure-collapsed: root.inspector-structure-collapsed;
                                properties-collapsed: root.inspector-properties-collapsed;
                                // F6 must target a visible header when the rail is hidden by an open panel.
                                regional-focus-enabled: !root.regional-focus-blocked;
                                structure-focus-token: root.focus-region == 3 && root.region-available(3) && root.inspector-expanded && !root.regional-focus-blocked ? root.region-focus-epoch : 0;
                                properties-focus-token: root.focus-region == 4 && root.region-available(4) && !root.regional-focus-blocked ? root.region-focus-epoch : 0;
                                split-ratio-changed(value) => { root.inspector-split-ratio-set(value); }
                                pane-collapsed-set(pane, collapsed) => { root.inspector-pane-collapsed-set(pane, collapsed); }
                                model-parts-open : root.model-parts-open;
                                hovered-inspector-section : root.hovered-inspector-section;
                                label-parts : root.label-parts;
                                section-states : root.section-states;
                                section-open-toggled(arg1) => { root.section-open-toggled(arg1); }
                                toggle-all-sections() => { root.toggle-all-sections(); }
                                section-pin-open-toggled(arg1) => { root.section-pin-open-toggled(arg1); }
                                label-search-parts : root.label-search-parts;
                                label-selected-parts-only : root.label-selected-parts-only;
                                label-sort-parts : root.label-sort-parts;
                                parts-query <=> root.parts-query;
                                parts-selected-only <=> root.parts-selected-only;
                                parts-sort-by-name <=> root.parts-sort-by-name;
                                parts-items : root.parts-items;
                                scene-items : root.scene-items;
                                label-parts-row-size : root.label-parts-row-size;
                                parts-row-height <=> root.parts-row-height;
                                label-hide-part : root.label-hide-part;
                                label-show-part : root.label-show-part;
                                label-lock-part : root.label-lock-part;
                                label-unlock-part : root.label-unlock-part;
                                rename-active : root.rename-active;
                                rename-value : root.rename-value;
                                parts-query-changed(arg1) => { root.parts-query-changed(arg1); }
                                parts-selected-only-changed(arg1) => { root.parts-selected-only-changed(arg1); }
                                parts-sort-changed(arg1) => { root.parts-sort-changed(arg1); }
                                parts-row-height-changed(arg1) => { root.parts-row-height-changed(arg1); }
                                scene-select(arg1, arg2) => { root.scene-select(arg1, arg2); }
                                scene-toggle-visibility(arg1) => { root.scene-toggle-visibility(arg1); }
                                scene-toggle-lock(arg1) => { root.scene-toggle-lock(arg1); }
                                scene-context-requested(arg1, arg2, arg3) => { root.scene-context-requested(arg1, arg2, arg3); }
                                part-color-picker-open(arg1) => { root.part-color-picker-open(arg1); }
                                separate-selection-requested() => { root.separate-selection-requested(); }
                                rename-edited(arg1) => { root.rename-edited(arg1); }
                                rename-committed(arg1) => { root.rename-committed(arg1); }
                                object-has-selection : root.object-has-selection;
                                selection-domain : root.selection-domain;
                                model-transform-open : root.model-transform-open;
                                label-tab-transform : root.label-tab-transform;
                                label-numeric-field-hint : root.label-numeric-field-hint;
                                pos-x : root.pos-x;
                                pos-y : root.pos-y;
                                pos-z : root.pos-z;
                                rot-x : root.rot-x;
                                rot-y : root.rot-y;
                                rot-z : root.rot-z;
                                scale-x : root.scale-x;
                                scale-y : root.scale-y;
                                scale-z : root.scale-z;
                                transform-scrubbed(arg1, arg2, arg3, arg4) => { root.transform-scrubbed(arg1, arg2, arg3, arg4); }
                                transform-scrub-started(arg1) => { root.transform-scrub-started(arg1); }
                                transform-scrub-finished() => { root.transform-scrub-finished(); }
                                transform-text-committed(arg1, arg2, arg3) => { root.transform-text-committed(arg1, arg2, arg3) }
                                transform-scrub-cancelled() => { root.transform-scrub-cancelled(); }
                                model-material-open : root.model-material-open;
                                label-tab-material : root.label-tab-material;
                                active-material-name : root.active-material-name;
                                active-material-slot <=> root.active-material-slot;
                                material-slots : root.material-slots;
                                material-profile : root.material-profile;
                                material-base-color : root.material-base-color;
                                material-palette : root.material-palette;
                                material-roughness : root.material-roughness;
                                material-metallic : root.material-metallic;
