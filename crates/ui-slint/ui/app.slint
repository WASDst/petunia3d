// Fonte embarcada (D4 do plano de UI; OFL em fonts/Inter-OFL.txt).
import "fonts/InterVariable.ttf";
import { ListView, ScrollView } from "std-widgets.slint";
import { ColorPresets, DesignTokens, Motion, Tr } from "tokens.slint";
