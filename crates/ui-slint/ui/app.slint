import { WorkspaceDrawerContent } from "shell/drawer_content.slint";
import { PaintPresetsContent, PaintPaletteContent } from "workspaces/paint/drawer.slint";
import { UvDiagnosticsContent } from "workspaces/uv/drawer.slint";
import { StatusBar } from "shell/status_bar.slint";
