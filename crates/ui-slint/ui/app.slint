            label-selected-parts-only: root.label-selected-parts-only;
            label-sort-parts: root.label-sort-parts;
            parts-query <=> root.parts-query;
            parts-selected-only <=> root.parts-selected-only;
            parts-sort-by-name <=> root.parts-sort-by-name;
            parts-items: root.parts-items;
            scene-items: root.scene-items;
            label-parts-row-size: root.label-parts-row-size;
            parts-row-height <=> root.parts-row-height;
            rename-active: root.rename-active;
            rename-value: root.rename-value;
            scene-pin-requested(a0) => { root.scene-pin-requested(a0); }
            scene-requested() => { root.scene-requested(); }
            parts-query-changed(a0) => { root.parts-query-changed(a0); }
            parts-selected-only-changed(a0) => { root.parts-selected-only-changed(a0); }
            parts-sort-changed(a0) => { root.parts-sort-changed(a0); }
            parts-row-height-changed(a0) => { root.parts-row-height-changed(a0); }
