            scene-context-requested(a0, a1, a2) => { root.scene-context-requested(a0, a1, a2); }
            rename-edited(a0) => { root.rename-edited(a0); }
            rename-committed(a0) => { root.rename-committed(a0); }
            scene-toggle-visibility(a0) => { root.scene-toggle-visibility(a0); }
            scene-toggle-lock(a0) => { root.scene-toggle-lock(a0); }
            part-color-picker-open(a0) => { root.part-color-picker-open(a0); }
        }


        // Tela inicial (Home).
        if home-open: home-focus := HomeDialog {
            width: parent.width;
            height: parent.height;
            home-texts: root.home-texts;
            recovery-open: root.recovery-open;
            recent-projects: root.recent-projects;
            show-home-on-start: root.show-home-on-start;
            home-closed() => { root.home-closed(); }
            recovery-keep-requested() => { root.recovery-keep-requested(); }
            open-project-requested() => { root.open-project-requested(); }
            recovery-recover-requested() => { root.recovery-recover-requested(); }
            home-recent-opened(a0) => { root.home-recent-opened(a0); }
            show-home-on-start-set(a0) => { root.show-home-on-start-set(a0); }
            settings-requested() => { root.settings-requested(); }
        }

        // Diálogo modal de recuperação de sessão.
        if recovery-open && !home-open: recovery-focus := RecoveryDialog {
            width: parent.width;
            height: parent.height;
            recovery-keep: root.recovery-keep;
            recovery-discard: root.recovery-discard;
            recovery-recover: root.recovery-recover;
            recovery-title: root.recovery-title;
            recovery-body: root.recovery-body;
            recovery-detail: root.recovery-detail;
