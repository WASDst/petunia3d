                                            width: 70px; height: 26px; border-radius: 4px;
                                            background: root.double-tap-interval-ms == 200 ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "200 ms"; color: root.double-tap-interval-ms == 200 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.double-tap-interval-set(200); } }
                                        }
                                        Rectangle {
                                            width: 70px; height: 26px; border-radius: 4px;
                                            background: root.double-tap-interval-ms == 350 ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "350 ms"; color: root.double-tap-interval-ms == 350 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.double-tap-interval-set(350); } }
                                        }
                                        Rectangle {
                                            width: 70px; height: 26px; border-radius: 4px;
                                            background: root.double-tap-interval-ms == 500 ? DesignTokens.accent : DesignTokens.surface;
                                            border-width: 1px; border-color: DesignTokens.border;
                                            Text { text: "500 ms"; color: root.double-tap-interval-ms == 500 ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                            TouchArea { clicked => { root.double-tap-interval-set(500); } }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px; alignment: center;
                                        Slider {
                                            horizontal-stretch: 1; minimum: 0; maximum: 1000;
                                            value: root.double-tap-interval-ms;
                                            accessible-label: root.label-double-tap-interval;
                                            changed(value) => { root.double-tap-interval-set(Math.round(value)); }
                                            released(value) => { root.double-tap-interval-released(Math.round(value)); }
                                        }
                                        Text {
                                            text: root.double-tap-interval-ms == 0 ? "Desativado (0)" : "\{root.double-tap-interval-ms} ms";
                                            color: DesignTokens.text-secondary; font-size: 10px; width: 85px; horizontal-alignment: right; vertical-alignment: center;
                                        }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: root.label-drag-threshold; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px; alignment: center;
                                        Slider {
                                            horizontal-stretch: 1; minimum: 2; maximum: 16;
                                            value: root.drag-threshold-px;
                                            accessible-label: root.label-drag-threshold;
                                            changed(value) => { root.drag-threshold-set(Math.round(value)); }
                                        }
                                        Text {
                                            text: "\{Math.round(root.drag-threshold-px)} px";
                                            color: DesignTokens.text-secondary; font-size: 10px; width: 85px; horizontal-alignment: right; vertical-alignment: center;
                                        }
                                    }

                                    Text { text: root.label-snap-radius; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }
                                    HorizontalLayout {
                                        spacing: 8px; alignment: center;
                                        Slider {
                                            horizontal-stretch: 1; minimum: 4; maximum: 48;
                                            value: root.snap-radius-px;
                                            accessible-label: root.label-snap-radius;
                                            changed(value) => { root.snap-radius-set(Math.round(value)); }
                                        }
                                        Text {
                                            text: "\{Math.round(root.snap-radius-px)} px";
                                            color: DesignTokens.text-secondary; font-size: 10px; width: 85px; horizontal-alignment: right; vertical-alignment: center;
                                        }
                                    }

                                    Rectangle {
                                        height: 30px; border-radius: 4px;
                                        background: root.click-move-click ? DesignTokens.accent : DesignTokens.surface;
                                        border-width: 1px; border-color: root.click-move-click ? DesignTokens.focus-ring : DesignTokens.border;
                                        accessible-role: checkbox;
                                        accessible-checkable: true;
                                        accessible-checked: root.click-move-click;
                                        accessible-label: root.label-click-move-click;
                                        accessible-description: root.label-click-move-click-hint;
                                        accessible-action-default => { root.click-move-click-set(!root.click-move-click); }
                                        HorizontalLayout {
                                            padding-left: 10px; alignment: center;
                                            Text { text: root.label-click-move-click; color: root.click-move-click ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.click-move-click-set(!root.click-move-click); } }
                                    }
                                    Text { text: root.label-click-move-click-hint; color: DesignTokens.text-muted; font-size: 10px; wrap: word-wrap; }

                                    Rectangle {
                                        height: 30px; border-radius: 4px;
                                        background: root.workplane-prefer-ground ? DesignTokens.accent : DesignTokens.surface;
                                        border-width: 1px; border-color: root.workplane-prefer-ground ? DesignTokens.focus-ring : DesignTokens.border;
                                        accessible-role: checkbox;
                                        accessible-checkable: true;
                                        accessible-checked: root.workplane-prefer-ground;
                                        accessible-label: root.label-workplane-prefer-ground;
                                        accessible-description: root.label-workplane-prefer-ground-hint;
                                        accessible-action-default => { root.workplane-prefer-ground-set(!root.workplane-prefer-ground); }
                                        HorizontalLayout {
                                            padding-left: 10px; alignment: center;
                                            Text { text: root.label-workplane-prefer-ground; color: root.workplane-prefer-ground ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.workplane-prefer-ground-set(!root.workplane-prefer-ground); } }
                                    }
                                    Text { text: root.label-workplane-prefer-ground-hint; color: DesignTokens.text-muted; font-size: 10px; wrap: word-wrap; }

                                    Rectangle {
                                        height: 30px; border-radius: 4px;
                                        background: root.studio-light-follows-camera ? DesignTokens.accent : DesignTokens.surface;
                                        border-width: 1px; border-color: root.studio-light-follows-camera ? DesignTokens.focus-ring : DesignTokens.border;
                                        accessible-role: checkbox;
