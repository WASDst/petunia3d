            command-executed(a0) => { root.command-executed(a0); }
        }

        // Toast de status: componente transversal do design system.
        StatusToast {
            shown: root.toast-visible;
            message: root.status-message;
            severity-color: root.status-color;
            available-width: root.width - 32px;
            x: (root.width - self.width) / 2;
            y: root.toast-visible ? root.height - 30px - self.height - 20px : root.height - 30px - self.height - 6px;
            animate y { duration: Motion.medium; easing: ease-out; }
        }

        // Painel flutuante do canvas PAINT.
        if paint-canvas-panel-visible: PaintCanvasPanel {
            width: parent.width;
            height: parent.height;
            canvas-panel-w <=> root.canvas-panel-w;
            canvas-panel-h <=> root.canvas-panel-h;
            canvas-panel-x <=> root.canvas-panel-x;
