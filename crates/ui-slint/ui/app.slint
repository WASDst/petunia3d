                                    Rectangle {
                                        border-radius: 6px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                        VerticalLayout {
                                            padding: 10px; spacing: 6px;
                                            HorizontalLayout { Text { text: "W: Alternar Seleção (Select / Box Select)"; color: DesignTokens.text-secondary; font-size: 10px; } Rectangle { horizontal-stretch: 1; } Text { text: "Alt+W: Subdividir (Subdivide)"; color: DesignTokens.text-secondary; font-size: 10px; } }
                                            HorizontalLayout { Text { text: "G: Mover / Transladar"; color: DesignTokens.text-secondary; font-size: 10px; } Rectangle { horizontal-stretch: 1; } Text { text: "Tab: Modo de Seleção (V/E/F/Obj)"; color: DesignTokens.text-secondary; font-size: 10px; } }
                                            HorizontalLayout { Text { text: "R: Rotacionar"; color: DesignTokens.text-secondary; font-size: 10px; } Rectangle { horizontal-stretch: 1; } Text { text: "F1 / F2 / F3: Workspaces (Model/Paint/UV)"; color: DesignTokens.text-secondary; font-size: 10px; } }
                                            HorizontalLayout { Text { text: "S: Escalonar"; color: DesignTokens.text-secondary; font-size: 10px; } Rectangle { horizontal-stretch: 1; } Text { text: "Espaço: Micro-Inspector flutuante"; color: DesignTokens.text-secondary; font-size: 10px; } }
                                            HorizontalLayout { Text { text: "Shift+A: Adicionar Primitiva"; color: DesignTokens.text-secondary; font-size: 10px; } Rectangle { horizontal-stretch: 1; } Text { text: "Ctrl+Z / Ctrl+Y: Desfazer / Refazer"; color: DesignTokens.text-secondary; font-size: 10px; } }
                                        }
                                    }
                                }

                                // --- TAB 3: ACESSIBILIDADE ---
                                if root.settings-tab == 3: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: "Acessibilidade & Inclusão"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }

                                    Rectangle {
                                        height: 32px; border-radius: 4px;
                                        background: root.colorblind-axes ? DesignTokens.accent : DesignTokens.surface;
                                        border-width: 1px; border-color: root.colorblind-axes ? DesignTokens.focus-ring : DesignTokens.border;
                                        HorizontalLayout {
                                            padding-left: 10px; alignment: center;
                                            Text { text: "Diferenciação Não-Cromática de Eixos (Daltonismo)"; color: root.colorblind-axes ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.colorblind-axes-set(!root.colorblind-axes); } }
                                    }

                                    Rectangle {
                                        height: 32px; border-radius: 4px;
                                        background: root.reduced-motion ? DesignTokens.accent : DesignTokens.surface;
                                        border-width: 1px; border-color: root.reduced-motion ? DesignTokens.focus-ring : DesignTokens.border;
                                        HorizontalLayout {
                                            padding-left: 10px; alignment: center;
                                            Text { text: "Redução de Movimento (Sensibilidade Vestibular)"; color: root.reduced-motion ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.reduced-motion-set(!root.reduced-motion); } }
                                    }

                                    Rectangle {
                                        height: 32px; border-radius: 4px;
                                        background: root.multiselection-measure-tag ? DesignTokens.accent : DesignTokens.surface;
                                        border-width: 1px; border-color: root.multiselection-measure-tag ? DesignTokens.focus-ring : DesignTokens.border;
                                        HorizontalLayout {
                                            padding-left: 10px; alignment: center;
                                            Text { text: "Tags de Medida em Multiseleção de Arestas"; color: root.multiselection-measure-tag ? DesignTokens.canvas : DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.multiselection-measure-tag-set(!root.multiselection-measure-tag); } }
                                    }

                                    Rectangle { height: 1px; background: DesignTokens.border; }

                                    Text { text: "Tecnologia Assistiva"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }
                                    Rectangle {
                                        border-radius: 6px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                        VerticalLayout {
                                            padding: 12px; spacing: 6px;
                                            Text { text: "Leitor de tela: rótulos e papéis existem só em parte dos controles; conformidade WCAG ainda não foi auditada."; color: DesignTokens.warning; font-size: 11px; font-weight: 600; wrap: word-wrap; }
                                            Text { text: "Teclado: atalhos globais funcionam; foco por Tab entre controles ainda é parcial."; color: DesignTokens.text-secondary; font-size: 10px; wrap: word-wrap; }
                                            Text { text: "Recursos ativos: alto contraste (tema), escala de UI, movimento reduzido e eixos sem depender de cor."; color: DesignTokens.text-secondary; font-size: 10px; wrap: word-wrap; }
                                        }
                                    }
                                }

                                // --- TAB 4: FERRAMENTAS & MODELAGEM ---
                                if root.settings-tab == 4: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: "Parâmetros Padrão de Modelagem"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }

                                    Rectangle {
                                        border-radius: 6px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                        VerticalLayout {
                                            padding: 12px; spacing: 8px;
                                            Text { text: "Bisel (Round Edge / Bevel)"; color: DesignTokens.text-primary; font-size: 11px; font-weight: 700; }
                                            Rectangle {
                                                height: 32px; border-radius: 4px;
                                                background: root.bevel-clamp-overlap ? DesignTokens.surface-raised : (bevel-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                                border-width: 1px; border-color: root.bevel-clamp-overlap ? DesignTokens.accent : DesignTokens.border;
                                                HorizontalLayout {
                                                    padding-left: 10px; padding-right: 10px;
                                                    Text { text: "Clamp Overlap (evita auto-interseção de geometria)"; color: DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Text { text: root.bevel-clamp-overlap ? "Ativado" : "Desativado"; color: root.bevel-clamp-overlap ? DesignTokens.accent : DesignTokens.text-muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                }
                                                bevel-touch := TouchArea { clicked => { root.toggle-bevel-clamp-overlap(); } }
                                            }
                                            Rectangle { height: 1px; background: DesignTokens.border; }
                                            Text { text: "Perfil & Esboço 2D (Draw Profile)"; color: DesignTokens.text-primary; font-size: 11px; font-weight: 700; }
                                            Text { text: "• Workplane automático: Ground (XZ), Face ativa ou Vista ortográfica"; color: DesignTokens.text-secondary; font-size: 10px; }
                                            Text { text: "• Gerar volume direto por arraste de profundidade ou Enter"; color: DesignTokens.text-secondary; font-size: 10px; }
                                            Rectangle { height: 1px; background: DesignTokens.border; }
                                            Text { text: "Fatiador (Slice / Loop Cut)"; color: DesignTokens.text-primary; font-size: 11px; font-weight: 700; }
                                            Rectangle {
                                                height: 32px; border-radius: 4px;
                                                background: root.slice-trim ? DesignTokens.surface-raised : (slice-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                                border-width: 1px; border-color: root.slice-trim ? DesignTokens.accent : DesignTokens.border;
                                                HorizontalLayout {
                                                    padding-left: 10px; padding-right: 10px;
                                                    Text { text: "Modo Trim (remove lado cortado ao invés de split)"; color: DesignTokens.text-primary; font-size: 11px; vertical-alignment: center; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Text { text: root.slice-trim ? "Trim (Ativado)" : "Split (Desativado)"; color: root.slice-trim ? DesignTokens.accent : DesignTokens.text-muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                }
                                                slice-touch := TouchArea { clicked => { root.slice-trim-set(!root.slice-trim); } }
                                            }
                                        }
                                    }
                                }

                                // --- TAB 5: VIEWPORT 3D ---
                                if root.settings-tab == 5: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: "Renderização e Shading do Viewport"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }

                                    Rectangle {
                                        border-radius: 6px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                        VerticalLayout {
                                            padding: 12px; spacing: 8px;
                                            Rectangle {
                                                height: 32px; border-radius: 4px;
                                                background: root.is-wireframe ? DesignTokens.surface-raised : (wire-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                                border-width: 1px; border-color: root.is-wireframe ? DesignTokens.accent : DesignTokens.border;
                                                HorizontalLayout {
                                                    padding-left: 10px; padding-right: 10px;
                                                    Text { text: "Wireframe Overlay sobreposto"; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Text { text: root.is-wireframe ? "Ativado" : "Desativado"; color: root.is-wireframe ? DesignTokens.accent : DesignTokens.text-muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                }
                                                wire-touch := TouchArea { clicked => { root.toggle-wireframe-requested(); } }
                                            }
                                            Rectangle {
                                                height: 32px; border-radius: 4px;
                                                background: root.show-face-orientation ? DesignTokens.surface-raised : (face-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                                border-width: 1px; border-color: root.show-face-orientation ? DesignTokens.accent : DesignTokens.border;
                                                HorizontalLayout {
                                                    padding-left: 10px; padding-right: 10px;
                                                    Text { text: "Orientação de Faces (Normais frontais/traseiras)"; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Text { text: root.show-face-orientation ? "Ativado" : "Desativado"; color: root.show-face-orientation ? DesignTokens.accent : DesignTokens.text-muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                }
                                                face-touch := TouchArea { clicked => { root.toggle-face-orientation(); } }
                                            }
                                            Rectangle {
                                                height: 32px; border-radius: 4px;
                                                background: proj-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                                border-width: 1px; border-color: DesignTokens.border;
                                                HorizontalLayout {
                                                    padding-left: 10px; padding-right: 10px;
                                                    Text { text: "Projeção da Câmera"; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Text { text: root.is-orthographic ? "Ortográfica" : "Perspectiva"; color: DesignTokens.accent; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                }
                                                proj-touch := TouchArea { clicked => { root.toggle-projection-requested(); } }
                                            }
                                            Rectangle {
                                                height: 32px; border-radius: 4px;
                                                HorizontalLayout {
                                                    padding-left: 10px; padding-right: 10px;
                                                    Text { text: "Grade de Chão (Ground Grid)"; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Text { text: "Passo 1.0 m (Subdivisões 0.1 m)"; color: DesignTokens.text-secondary; font-size: 10px; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                }

                                // --- TAB 6: PLUGINS & EXTENSÕES ---
                                if root.settings-tab == 6: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: "Extensões & Plugins"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }
                                    Rectangle {
                                        border-radius: 6px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                        VerticalLayout {
                                            padding: 12px; spacing: 8px;
                                            Text { text: "Nenhuma extensão é carregada por esta interface nesta versão."; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; wrap: word-wrap; }
                                            Text { text: "Importar OBJ e exportar glTF são recursos nativos, acessíveis pelo menu Arquivo."; color: DesignTokens.text-secondary; font-size: 10px; wrap: word-wrap; }
                                        }
                                    }
                                }

                                // --- TAB 7: MCP & AUTOMAÇÃO ---
                                if root.settings-tab == 7: VerticalLayout {
                                    spacing: 12px;

                                    Text { text: "Automação (MCP)"; color: DesignTokens.text-primary; font-size: 12px; font-weight: 700; }

                                    Rectangle {
                                        border-radius: 6px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                                        VerticalLayout {
                                            padding: 12px; spacing: 8px;
                                            Text { text: "O servidor MCP é um componente separado; esta tela não o inicia nem monitora seu estado."; color: DesignTokens.text-primary; font-size: 11px; font-weight: 600; wrap: word-wrap; }
                                            Text { text: "Mutações do documento passam por comandos transacionais com Undo/Redo."; color: DesignTokens.text-secondary; font-size: 10px; wrap: word-wrap; }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: DesignTokens.border; }

                                Text {
                                    text: root.shell-info;
                                    color: DesignTokens.text-muted;
                                    font-size: 10px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
