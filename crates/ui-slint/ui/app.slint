    // Présentation locale: les filtres/données restent projetés par Rust.
    private property <int> paint-drawer-tab: 1;
    private property <int> uv-drawer-tab: 1;
    private property <int> animate-drawer-tab: 1;
    private property <int> drawer-tab: root.active-workspace == "PAINT" ? root.paint-drawer-tab
        : root.active-workspace == "UV" ? root.uv-drawer-tab
        : root.active-workspace == "ANIMATE" ? root.animate-drawer-tab : 0;
    in-out property <string> scene-stats: "";
    in-out property <string> uv-stats: "";
    in-out property <string> current-theme: "petunia-dark";
    in-out property <int> settings-tab: 0;
    /// Busca na barra lateral das Preferências.
    in-out property <string> settings-query: "";
    /// Comparação sem diferenciar maiúsculas (Slint não tem `contains`).
    pure callback text-matches(string, string) -> bool;
    // F6 alterna o foco de teclado entre a viewport e a régua do Inspector.
    in-out property <int> f6-rail-token: 0;
    // 0 Header, 1 Tools, 2 Surface, 3 Structure, 4 Properties, 5 Drawer, 6 Context.
    in-out property <int> focus-region: 2;
    private property <int> region-focus-epoch: 0;
    in-out property <bool> f6-in-rail: root.focus-region == 3 || root.focus-region == 4;
    property <bool> regional-focus-blocked: root.home-open || root.recovery-open
        || root.command-search-visible || root.settings-visible || root.reference-manager-visible
        || root.menu-open != "" || root.context-menu-open;
    in-out property <float> ui-scale: 1.0;
    in-out property <string> icon-theme: "outline";
    in-out property <string> active-language: "pt-BR";

    in-out property <string> selection-domain: "OBJECT";
    in-out property <string> active-tool: "select";
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <string> status-message: "Ready";
    /// 0 info, 1 sucesso, 2 aviso, 3 erro.
    in-out property <int> status-severity: 0;
    property <bool> toast-visible: false;
    property <color> status-color: root.status-severity == 3 ? DesignTokens.danger
        : (root.status-severity == 2 ? DesignTokens.warning
        : (root.status-severity == 1 ? DesignTokens.success : DesignTokens.info));
    changed status-message => {
        if root.status-severity > 0 {
            root.toast-visible = true;
            toast-timer.running = false;
            toast-timer.running = true;
        } else {
            root.toast-visible = false;
        }
    }
    decal-playback-timer := Timer {
        interval: 33ms;
        running: root.decal-playing;
        triggered => { root.decal-playback-tick(0.033); }
    }

    toast-timer := Timer {
        interval: 3200ms;
        running: false;
        triggered => {
            root.toast-visible = false;
            self.running = false;
        }
    }
