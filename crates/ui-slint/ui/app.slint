            paint-canvas-grid-commands: root.paint-canvas-grid-commands;
            uv-selected-commands: root.uv-selected-commands;
            toggle-paint-show-uv() => { root.toggle-paint-show-uv(); }
            paint-2d-select(a0, a1, a2, a3, a4, a5, a6) => { root.paint-2d-select(a0, a1, a2, a3, a4, a5, a6); }
            paint-2d-stroke(a0, a1, a2, a3, a4) => { root.paint-2d-stroke(a0, a1, a2, a3, a4); }
