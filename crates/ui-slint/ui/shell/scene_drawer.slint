// Gaveta de cena no shell compacto.
import { DesignTokens, Tr } from "../tokens.slint";
import { PetuniaIcons } from "../petunia_icons.slint";
import { PartsFilterRow, PartsRowSizeControl } from "../inspector/sections.slint";
import { SceneItem } from "../types.slint";
import { ScrollView } from "std-widgets.slint";
import { TopAction } from "../components/controls.slint";

export component SceneDrawerOverlay inherits Rectangle {
    in property <string> label-parts;
    in-out property <bool> scene-drawer-pinned;
    in property <string> label-search-parts;
    in property <string> label-selected-parts-only;
    in property <string> label-sort-parts;
    in-out property <string> parts-query;
    in-out property <bool> parts-selected-only;
    in-out property <bool> parts-sort-by-name;
    in property <[SceneItem]> parts-items;
    in property <[SceneItem]> scene-items;
    in property <string> label-parts-row-size;
    in-out property <float> parts-row-height;
    in property <bool> rename-active;
    in property <string> rename-value;
    callback scene-pin-requested(bool);
    callback scene-requested();
    callback parts-query-changed(string);
    callback parts-selected-only-changed(bool);
    callback parts-sort-changed(bool);
    callback parts-row-height-changed(float);
    callback scene-select(string, bool);
    callback scene-context-requested(string, float, float);
    callback rename-edited(string);
    callback rename-committed(string);
    callback scene-toggle-visibility(string);
    callback scene-toggle-lock(string);
    callback part-color-picker-open(string);

    
    y: 42px;
    width: 250px;
    
    background: DesignTokens.surface-raised;
    border-width: 1px;
    border-color: DesignTokens.border;
    border-radius: 6px;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            Text {
                text: root.label-parts;
                color: DesignTokens.text-primary;
                font-size: DesignTokens.font-default;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            TopAction {
                icon-svg: PetuniaIcons.pin;
                semantic-label: scene-drawer-pinned ? Tr.t("sl.unpin_parts") : Tr.t("sl.pin_parts");
                clicked => {
                    root.scene-drawer-pinned = !root.scene-drawer-pinned;
                    root.scene-pin-requested(root.scene-drawer-pinned);
                }
            }
            TopAction {
                icon-svg: PetuniaIcons.close;
                semantic-label: Tr.t("sl.close_scene_drawer");
                clicked => { root.scene-requested(); }
            }
        }

        Rectangle { height: 1px; background: DesignTokens.border; }

        PartsFilterRow {
            horizontal-stretch: 1;
            search-label: root.label-search-parts;
            search-id: "compact-parts-search";
            selected-only-label: root.label-selected-parts-only;
            sort-label: root.label-sort-parts;
            query <=> root.parts-query;
            selected-only <=> root.parts-selected-only;
            sort-by-name <=> root.parts-sort-by-name;
            visible-count: root.parts-items.length;
            total-count: root.scene-items.length;
            query-changed(query) => { root.parts-query-changed(query); }
            selected-only-changed(enabled) => { root.parts-selected-only-changed(enabled); }
            sort-changed(enabled) => { root.parts-sort-changed(enabled); }
        }
        PartsRowSizeControl {
            horizontal-stretch: 1;
            semantic-label: root.label-parts-row-size;
            accessibility-id: "compact-parts-row-height";
            value <=> root.parts-row-height;
            value-changed(value) => { root.parts-row-height-changed(value); }
        }

        ScrollView {
            accessible-role: list;
            accessible-label: root.label-parts;
            accessible-item-count: root.parts-items.length;
            VerticalLayout {
                spacing: 4px;
                alignment: start;

                for item in root.parts-items: Rectangle {
                    height: root.parts-row-height * 1px;
                    accessible-role: list-item;
                    accessible-label: item.name;
                    accessible-item-selectable: true;
                    accessible-item-selected: item.selected;
                    border-radius: 4px;
                    background: item.selected ? DesignTokens.surface-hover : transparent;
                    border-width: row-focus.has-focus ? 2px : (item.selected ? 1px : 0px);
                    // Ativo (amarelo) ≠ selecionado (laranja): a
                    // referência das operações sempre identificável.
                    border-color: row-focus.has-focus ? DesignTokens.focus-ring : (item.active ? DesignTokens.selection-active : DesignTokens.selection);
                    // Linha operável por teclado: Enter/Espaço seleciona;
                    // Shift+F10/Menu abrem o menu de contexto da linha.
                    row-focus := FocusScope {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        key-pressed(event) => {
                            if event.text == Key.Return || event.text == " " {
                                root.scene-select(item.id, false);
                                return accept;
                            }
                            if (event.text == Key.F10 && event.modifiers.shift) || event.text == Key.Menu {
                                root.scene-context-requested(item.id, (self.absolute-position.x + 8px) / 1px, (self.absolute-position.y + self.height) / 1px);
                                return accept;
                            }
                            reject
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        TouchArea {
                            property <bool> extend: false;
                            pointer-event(event) => {
                                self.extend = event.modifiers.shift;
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                    root.scene-context-requested(
                                        item.id,
                                        (self.absolute-position.x + self.mouse-x) / 1px,
                                        (self.absolute-position.y + self.mouse-y) / 1px,
                                    );
                                }
                            }
                            clicked => { row-focus.focus(); root.scene-select(item.id, self.extend); }
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: 6px;

                                 Image {
                                     source: item.tris == 0 ? PetuniaIcons.draw-profile : PetuniaIcons.cube;
                                     width: 12px;
                                     height: 12px;
                                     colorize: item.selected ? DesignTokens.accent : DesignTokens.text-muted;
                                 }

                                 if root.rename-active && item.selected: TextInput {
                                     text: root.rename-value;
                                     horizontal-stretch: 1;
                                     font-size: DesignTokens.font-default;
                                     color: DesignTokens.text-primary;
                                     single-line: true;
                                     init => { self.focus(); }
                                     edited => { root.rename-edited(self.text); }
                                     accepted => { root.rename-committed(self.text); }
                                 }

                                 if !(root.rename-active && item.selected): Text {
                                     text: item.name;
                                     color: item.selected ? DesignTokens.text-primary : DesignTokens.text-secondary;
                                     font-size: DesignTokens.font-default;
                                     font-weight: item.selected ? 600 : 400;
                                     vertical-alignment: center;
                                     horizontal-stretch: 1;
                                     overflow: elide;
                                 }

                                 Text {
                                     text: item.tris == 0 ? "\{item.verts} pts · 2D" : "\{item.verts}v · \{item.tris}t";
                                     color: DesignTokens.text-muted;
                                     font-size: DesignTokens.font-caption;
                                     vertical-alignment: center;
                                 }
                            }
                        }

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            Image {
                                source: item.visible ? PetuniaIcons.eye : PetuniaIcons.eye-hidden;
                                width: 13px;
                                height: 13px;
                                colorize: item.visible ? DesignTokens.text-secondary : DesignTokens.text-muted;
                            }
                            TouchArea {
                                clicked => { root.scene-toggle-visibility(item.id); }
                            }
                        }

                         Rectangle {
                             width: 20px;
                             height: 20px;
                             Image {
                                 source: item.locked ? PetuniaIcons.lock : PetuniaIcons.unlock;
                                 width: 13px;
                                 height: 13px;
                                 colorize: item.locked ? DesignTokens.accent : DesignTokens.text-muted;
                             }
                             TouchArea {
                                 clicked => { root.scene-toggle-lock(item.id); }
                             }
                         }

                         Rectangle {
                             width: 20px;
                             height: 20px;
                             accessible-role: button;
                             accessible-label: Tr.t("sl.part_selection_color");
                             Rectangle {
                                 width: 13px;
                                 height: 13px;
                                 border-radius: 3px;
                                 background: item.has-custom-color ? item.custom-color : DesignTokens.selection;
                                 border-width: 1px;
                                 border-color: item.has-custom-color ? DesignTokens.text-primary : DesignTokens.border;
                             }
                             TouchArea {
                                 clicked => {
                                     root.part-color-picker-open(item.id);
                                 }
                             }
                         }
                    }
                }
            }
        }
    }

}
