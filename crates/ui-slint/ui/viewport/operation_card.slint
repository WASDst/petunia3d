// Card de operação em andamento.
import { ToolCard } from "../components/controls.slint";
import { ViewportOperationHud } from "../viewport/operation_hud.slint";

export component OperationCard inherits ToolCard {
    in property <string> operation-hud-title;
    in property <string> operation-hud-hint;
    in property <[string]> operation-hud-lines;
    in property <string> operation-hud-subject;

    x: 14px;
    y: 58px;
    title: root.operation-hud-title;
    collapsed: false;

    ViewportOperationHud {
        operation-hud-hint: root.operation-hud-hint;
        operation-hud-lines: root.operation-hud-lines;
        operation-hud-subject: root.operation-hud-subject;
    }

}
