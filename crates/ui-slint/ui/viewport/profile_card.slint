// Card do perfil DRAW.
import { DesignTokens, Tr } from "../tokens.slint";
import { NumericField, ToolCard } from "../components/controls.slint";

export component ProfileCard inherits ToolCard {
    in property <string> label-model-profile;
    in-out property <bool> tool-properties-collapsed;
    in property <string> label-profile-plane;
    in property <bool> profile-workplane-locked;
    in property <string> label-profile-plane-auto;
    in property <string> profile-workplane;
    in property <string> label-profile-plane-ground;
    in property <string> label-profile-plane-face;
    in property <string> label-profile-plane-view;
    in property <string> label-profile-look-at-plane;
    in property <float> trace-threshold;
    in property <float> extension-radius;
    in property <float> extension-length;
    in property <float> extension-angle;
    in property <float> extension-sides;
    in property <float> extension-tolerance;
    in property <string> label-profile-points;
    in property <int> profile-point-count;
    in property <bool> profile-closed;
    in property <string> label-profile-close;
    in property <bool> profile-parametric;
    in property <float> profile-width;
    in property <float> profile-height;
    in property <bool> profile-ellipse;
    in property <int> profile-segments;
    in property <string> label-profile-depth;
    in property <float> profile-depth;
    in property <string> label-profile-wall-thickness;
    in property <float> profile-wall-thickness;
    in property <bool> profile-has-curves;
    in property <string> label-profile-sharp-corners;
    in property <string> label-profile-smooth-curves;
    in property <string> label-profile-smoothness;
    in property <float> profile-smoothness;
    in property <string> profile-volume-mode;
    in property <string> label-profile-revolve;
    in property <string> label-profile-sweep;
    in property <string> label-profile-generate;
    in property <float> profile-revolve-angle;
    in property <string> label-profile-add-rect;
    in property <string> label-profile-add-circle;
    in property <string> hint-model-profile;
    callback profile-set-workplane-auto();
    callback profile-set-workplane-ground();
    callback profile-set-workplane-face();
    callback profile-set-workplane-view();
    callback profile-look-at-plane();
    callback extension-parameter-set(string,string) -> bool;
    callback profile-close();
    callback profile-dimension-gesture(int);
    callback profile-dimension-set(string, string) -> bool;
    callback profile-depth-set(string) -> bool;
    callback profile-wall-thickness-set(string) -> bool;
    callback profile-clear-curves();
    callback profile-smooth-curves();
    callback profile-smoothness-set(string) -> bool;
    callback profile-enter-revolve();
    callback profile-enter-sweep();
    callback profile-generate();
    callback profile-revolve-angle-set(string) -> bool;
    callback profile-volume-confirm();
    callback profile-volume-cancel();
    callback add-profile-rectangle(float, float);
    callback add-profile-circle(float, int);

    x: 14px;
    y: 58px;
    title: root.label-model-profile;
    collapsed: root.tool-properties-collapsed;
    collapse-toggled => { root.tool-properties-collapsed = !root.tool-properties-collapsed; }

    HorizontalLayout {
        spacing: 4px;
        height: 24px;
        Text { text: root.label-profile-plane; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 44px; vertical-alignment: center; }
        Rectangle {
            horizontal-stretch: 1; border-radius: 4px;
            background: !root.profile-workplane-locked ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
            border-width: 1px; border-color: !root.profile-workplane-locked ? DesignTokens.accent : DesignTokens.border;
            Text { text: root.label-profile-plane-auto; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
            TouchArea { clicked => { root.profile-set-workplane-auto(); } }
        }
        Rectangle {
            horizontal-stretch: 1; border-radius: 4px;
            background: root.profile-workplane-locked && root.profile-workplane == "Ground" ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
            border-width: 1px; border-color: root.profile-workplane-locked && root.profile-workplane == "Ground" ? DesignTokens.accent : DesignTokens.border;
            Text { text: root.label-profile-plane-ground; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
            TouchArea { clicked => { root.profile-set-workplane-ground(); } }
        }
        Rectangle {
            horizontal-stretch: 1; border-radius: 4px;
            background: root.profile-workplane-locked && root.profile-workplane == "Face" ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
            border-width: 1px; border-color: root.profile-workplane-locked && root.profile-workplane == "Face" ? DesignTokens.accent : DesignTokens.border;
            Text { text: root.label-profile-plane-face; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
            TouchArea { clicked => { root.profile-set-workplane-face(); } }
        }
        Rectangle {
            horizontal-stretch: 1; border-radius: 4px;
            background: root.profile-workplane-locked && root.profile-workplane == "View" ? DesignTokens.accent.transparentize(0.7) : DesignTokens.surface;
            border-width: 1px; border-color: root.profile-workplane-locked && root.profile-workplane == "View" ? DesignTokens.accent : DesignTokens.border;
            Text { text: root.label-profile-plane-view; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; color: DesignTokens.text-primary; }
            TouchArea { clicked => { root.profile-set-workplane-view(); } }
        }
    }

    Rectangle {
        height: 24px; border-radius: 4px; background: DesignTokens.surface;
        border-width: 1px; border-color: DesignTokens.border;
        Text { text: root.label-profile-look-at-plane; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.profile-look-at-plane(); } }
    }

    NumericField {label:Tr.t("extensions.threshold");value:root.trace-threshold;step:1;
        text-committed(text)=>{return root.extension-parameter-set("threshold",text);}
        scrubbed(delta,fine)=>{root.extension-parameter-set("threshold","\{root.trace-threshold+delta*(fine?0.1:1)}");}
    }
    NumericField { label: Tr.t("extensions.radius"); value: root.extension-radius; step: 0.01; scrubbed(delta,fine) => { root.extension-parameter-set("radius","\{root.extension-radius + delta * 0.01 * (fine ? 0.1 : 1)}"); } text-committed(text) => { return root.extension-parameter-set("radius",text); } }
    NumericField { label: Tr.t("extensions.length"); value: root.extension-length; step: 0.01; scrubbed(delta,fine) => { root.extension-parameter-set("length","\{root.extension-length + delta * 0.01 * (fine ? 0.1 : 1)}"); } text-committed(text) => { return root.extension-parameter-set("length",text); } }
    NumericField { label: Tr.t("extensions.angle"); value: root.extension-angle; step: 1; scrubbed(delta,fine) => { root.extension-parameter-set("angle","\{root.extension-angle + delta * 1 * (fine ? 0.1 : 1)}"); } text-committed(text) => { return root.extension-parameter-set("angle",text); } }
    NumericField { label: Tr.t("extensions.sides"); value: root.extension-sides; step: 1; scrubbed(delta,fine) => { root.extension-parameter-set("sides","\{root.extension-sides + delta * 1 * (fine ? 0.1 : 1)}"); } text-committed(text) => { return root.extension-parameter-set("sides",text); } }
    NumericField { label: Tr.t("extensions.tolerance"); value: root.extension-tolerance; step: 0.001; scrubbed(delta,fine) => { root.extension-parameter-set("tolerance","\{root.extension-tolerance + delta * 0.001 * (fine ? 0.1 : 1)}"); } text-committed(text) => { return root.extension-parameter-set("tolerance",text); } }
    Text { text: "\{root.label-profile-points}: \{root.profile-point-count}"; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; }
    if !root.profile-closed: Rectangle {
        height: 26px; border-radius: 4px; background: DesignTokens.surface;
        border-width: 1px; border-color: DesignTokens.border;
        Text { text: root.label-profile-close; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.profile-close(); } }
    }
    if root.profile-parametric: VerticalLayout {
        spacing: 5px;
        NumericField { label: Tr.t("sl.width"); value: root.profile-width; step: 0.1;
            scrub-started => { root.profile-dimension-gesture(0); }
            scrub-finished => { root.profile-dimension-gesture(1); }
            scrub-cancelled(value) => { root.profile-dimension-gesture(2); }
            text-committed(text) => { return root.profile-dimension-set("width",text); }
            scrubbed(delta,fine) => { root.profile-dimension-set("width","\{root.profile-width + delta * (fine ? 0.01 : 0.1)}"); }
        }
        NumericField { label: Tr.t("sl.height"); value: root.profile-height; step: 0.1;
            scrub-started => { root.profile-dimension-gesture(0); }
            scrub-finished => { root.profile-dimension-gesture(1); }
            scrub-cancelled(value) => { root.profile-dimension-gesture(2); }
            text-committed(text) => { return root.profile-dimension-set("height",text); }
            scrubbed(delta,fine) => { root.profile-dimension-set("height","\{root.profile-height + delta * (fine ? 0.01 : 0.1)}"); }
        }
        if root.profile-ellipse: NumericField { label: Tr.t("extensions.sides"); value: root.profile-segments; step: 1;
            text-committed(text) => { return root.profile-dimension-set("segments",text); }
        }
    }
    if root.profile-closed: HorizontalLayout {
        spacing: 5px; height: 28px;
        Text { text: root.label-profile-depth; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 56px; vertical-alignment: center; }
        NumericField {
            label: ""; value: root.profile-depth; horizontal-stretch: 1; step: 0.1;
            text-committed(text) => { root.profile-depth-set(text); }
            scrubbed(delta, fine) => { root.profile-depth-set("\{root.profile-depth + delta * (fine ? 0.01 : 0.1)}"); }
        }
    }
    if root.profile-closed: HorizontalLayout {
        spacing: 5px; height: 28px;
        Text { text: root.label-profile-wall-thickness; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 80px; vertical-alignment: center; }
        NumericField {
            label: ""; value: root.profile-wall-thickness; horizontal-stretch: 1; step: 0.05;
            text-committed(text) => { root.profile-wall-thickness-set(text); }
            scrubbed(delta, fine) => { root.profile-wall-thickness-set("\{root.profile-wall-thickness + delta * (fine ? 0.01 : 0.05)}"); }
        }
    }
    HorizontalLayout {
        spacing: 5px; height: 26px;
        Rectangle {
            horizontal-stretch: 1; border-radius: 4px;
            background: root.profile-has-curves ? DesignTokens.accent.transparentize(0.8) : DesignTokens.surface;
            border-width: 1px; border-color: root.profile-has-curves ? DesignTokens.accent : DesignTokens.border;
            Text {
                text: root.profile-has-curves ? root.label-profile-sharp-corners : root.label-profile-smooth-curves;
                color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    if root.profile-has-curves {
                        root.profile-clear-curves();
                    } else {
                        root.profile-smooth-curves();
                    }
                }
            }
        }
    }
    if root.profile-has-curves: HorizontalLayout {
        spacing: 5px; height: 28px;
        Text { text: root.label-profile-smoothness; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 80px; vertical-alignment: center; }
        NumericField {
            label: ""; value: root.profile-smoothness; horizontal-stretch: 1; step: 0.01;
            text-committed(text) => { root.profile-smoothness-set(text); }
            scrubbed(delta, fine) => { root.profile-smoothness-set("\{root.profile-smoothness + delta * (fine ? 0.002 : 0.01)}"); }
        }
    }
    if root.profile-volume-mode == "none" && root.profile-point-count >= 2: HorizontalLayout {
        spacing: 5px; height: 28px;
        Rectangle {
            horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
            Text { text: root.label-profile-revolve; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.profile-enter-revolve(); } }
        }
        Rectangle {
            horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
            Text { text: root.label-profile-sweep; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.profile-enter-sweep(); } }
        }
        if root.profile-closed: Rectangle {
            horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.accent;
            Text { text: root.label-profile-generate; color: DesignTokens.on-accent; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.profile-generate(); } }
        }
    }
    if root.profile-volume-mode != "none": VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 24px; border-radius: 4px; background: DesignTokens.accent.transparentize(0.85);
            border-width: 1px; border-color: DesignTokens.accent;
            Text {
                text: root.profile-volume-mode == "extrude" ? Tr.t("sl.extrude_preview_live") :
                      (root.profile-volume-mode == "revolve" ? "Revolve Preview (Live)" : "Sweep Preview (Live)");
                color: DesignTokens.accent; font-size: DesignTokens.font-caption; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        if root.profile-volume-mode == "revolve": HorizontalLayout {
            spacing: 5px; height: 28px;
            Text { text: Tr.t("sl.angle"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 56px; vertical-alignment: center; }
            NumericField {
                label: ""; value: root.profile-revolve-angle; horizontal-stretch: 1; step: 5.0;
                text-committed(text) => { root.profile-revolve-angle-set(text); }
                scrubbed(delta, fine) => { root.profile-revolve-angle-set("\{root.profile-revolve-angle + delta * (fine ? 1.0 : 5.0)}"); }
            }
        }
        HorizontalLayout {
            spacing: 6px; height: 28px;
            Rectangle {
                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.accent;
                Text { text: Tr.t("sl.confirm_enter"); color: DesignTokens.on-accent; font-size: DesignTokens.font-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.profile-volume-confirm(); } }
            }
            Rectangle {
                horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
                Text { text: Tr.t("sl.cancel_esc"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.profile-volume-cancel(); } }
            }
        }
    }
    HorizontalLayout {
        spacing: 5px; height: 26px;
        Rectangle {
            horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
            Text { text: root.label-profile-add-rect; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.add-profile-rectangle(2.0, 1.0); } }
        }
        Rectangle {
            horizontal-stretch: 1; border-radius: 4px; background: DesignTokens.surface; border-width: 1px; border-color: DesignTokens.border;
            Text { text: root.label-profile-add-circle; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.add-profile-circle(1.0, 16); } }
        }
    }
    Text { text: root.hint-model-profile; color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; wrap: word-wrap; }

}
