// Gizmo de vista (eixos) do MODEL.
import { DesignTokens } from "../tokens.slint";

export component GizmoOverlay inherits Rectangle {
    in property <string> gizmo-x-commands;
    in property <string> gizmo-y-commands;
    in property <string> gizmo-z-commands;
    in property <string> gizmo-x-arrow-commands;
    in property <string> gizmo-y-arrow-commands;
    in property <string> gizmo-z-arrow-commands;
    in property <string> gizmo-x-scale-commands;
    in property <string> gizmo-y-scale-commands;
    in property <string> gizmo-z-scale-commands;
    in property <string> gizmo-x-rotate-commands;
    in property <string> gizmo-y-rotate-commands;
    in property <string> gizmo-z-rotate-commands;
    in property <string> gizmo-plane-yz-commands;
    in property <string> gizmo-plane-xz-commands;
    in property <string> gizmo-plane-xy-commands;
    in property <string> gizmo-view-roll-commands;
    in property <bool> gizmo-center-active;
    in property <bool> gizmo-center-hover;
    in property <bool> gizmo-gpu;
    in property <length> gizmo-origin-x;
    in property <length> gizmo-origin-y;
    in property <bool> colorblind-axes;
    in property <length> gizmo-x-label-x;
    in property <length> gizmo-x-end-x;
    in property <length> gizmo-x-label-y;
    in property <length> gizmo-x-end-y;
    in property <length> gizmo-y-label-x;
    in property <length> gizmo-y-end-x;
    in property <length> gizmo-y-label-y;
    in property <length> gizmo-y-end-y;
    in property <length> gizmo-z-label-x;
    in property <length> gizmo-z-end-x;
    in property <length> gizmo-z-label-y;
    in property <length> gizmo-z-end-y;
    pure callback gizmo-handle-color(int, color) -> color;
    pure callback gizmo-handle-width(int) -> length;

    x: 0;
    y: 0;
    
    
    background: transparent;

    // Hierarquia do gizmo: o eixo ativo domina, o eixo sob o
    // cursor clareia, os demais esmaecem durante o arrasto.
    Path {
        commands: root.gizmo-x-commands;
        fit: ImageFit.preserve;
        stroke: root.gizmo-handle-color(0, DesignTokens.axis-x);
        stroke-width: root.gizmo-handle-width(0);
        fill: transparent;
    }
    Path {
        commands: root.gizmo-y-commands;
        fit: ImageFit.preserve;
        stroke: root.gizmo-handle-color(1, DesignTokens.axis-y);
        stroke-width: root.gizmo-handle-width(1);
        fill: transparent;
    }
    Path {
        commands: root.gizmo-z-commands;
        fit: ImageFit.preserve;
        stroke: root.gizmo-handle-color(2, DesignTokens.axis-z);
        stroke-width: root.gizmo-handle-width(2);
        fill: transparent;
    }
    Path {
        commands: root.gizmo-x-arrow-commands;
        fit: ImageFit.preserve;
        stroke: transparent;
        fill: root.gizmo-handle-color(0, DesignTokens.axis-x);
    }
    Path {
        commands: root.gizmo-y-arrow-commands;
        fit: ImageFit.preserve;
        stroke: transparent;
        fill: root.gizmo-handle-color(1, DesignTokens.axis-y);
    }
    Path {
        commands: root.gizmo-z-arrow-commands;
        fit: ImageFit.preserve;
        stroke: transparent;
        fill: root.gizmo-handle-color(2, DesignTokens.axis-z);
    }
    Path { commands: root.gizmo-x-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(0, DesignTokens.axis-x); }
    Path { commands: root.gizmo-y-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(1, DesignTokens.axis-y); }
    Path { commands: root.gizmo-z-scale-commands; fit: ImageFit.preserve; stroke: DesignTokens.canvas; stroke-width: 1px; fill: root.gizmo-handle-color(2, DesignTokens.axis-z); }
    Path { commands: root.gizmo-x-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(0, DesignTokens.axis-x).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
    Path { commands: root.gizmo-y-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(1, DesignTokens.axis-y).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
    Path { commands: root.gizmo-z-rotate-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(2, DesignTokens.axis-z).transparentize(0.32); stroke-width: 1.5px; fill: transparent; }
    Path { commands: root.gizmo-plane-yz-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(0, DesignTokens.axis-x); stroke-width: 1px; fill: root.gizmo-handle-color(0, DesignTokens.axis-x).transparentize(0.65); }
    Path { commands: root.gizmo-plane-xz-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(1, DesignTokens.axis-y); stroke-width: 1px; fill: root.gizmo-handle-color(1, DesignTokens.axis-y).transparentize(0.65); }
    Path { commands: root.gizmo-plane-xy-commands; fit: ImageFit.preserve; stroke: root.gizmo-handle-color(2, DesignTokens.axis-z); stroke-width: 1px; fill: root.gizmo-handle-color(2, DesignTokens.axis-z).transparentize(0.65); }
    Path { commands: root.gizmo-view-roll-commands; fit: ImageFit.preserve; stroke: root.gizmo-center-active || root.gizmo-center-hover ? DesignTokens.accent : DesignTokens.text-secondary.transparentize(0.4); stroke-width: 1.5px; fill: transparent; }
    if !root.gizmo-gpu: Rectangle {
        x: gizmo-origin-x - 6px;
        y: gizmo-origin-y - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.gizmo-center-active ? DesignTokens.accent : (root.gizmo-center-hover ? DesignTokens.accent.transparentize(0.2) : DesignTokens.text-primary);
        border-width: 1.5px;
        border-color: DesignTokens.canvas;
    }
    if root.colorblind-axes: Rectangle {
        for axis-badge in [
            { label: "X", x: root.gizmo-x-label-x != 0px ? root.gizmo-x-label-x : root.gizmo-x-end-x, y: root.gizmo-x-label-y != 0px ? root.gizmo-x-label-y : root.gizmo-x-end-y, tint: DesignTokens.axis-x },
            { label: "Y", x: root.gizmo-y-label-x != 0px ? root.gizmo-y-label-x : root.gizmo-y-end-x, y: root.gizmo-y-label-y != 0px ? root.gizmo-y-label-y : root.gizmo-y-end-y, tint: DesignTokens.axis-y },
            { label: "Z", x: root.gizmo-z-label-x != 0px ? root.gizmo-z-label-x : root.gizmo-z-end-x, y: root.gizmo-z-label-y != 0px ? root.gizmo-z-label-y : root.gizmo-z-end-y, tint: DesignTokens.axis-z },
        ]: Rectangle {
            x: axis-badge.x - 8px;
            y: axis-badge.y - 8px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: DesignTokens.hud-surface;
            border-width: 1px;
            border-color: axis-badge.tint.transparentize(0.2);
            drop-shadow-blur: DesignTokens.elevation-1-blur;
            drop-shadow-color: DesignTokens.elevation-1-color;
            Text {
                text: axis-badge.label;
                color: axis-badge.tint;
                font-size: DesignTokens.font-caption;
                font-weight: 700;
                font-family: "monospace";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

}
