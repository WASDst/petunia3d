// Extraído de app.slint (Slint Rescue, website/docs/09-ui/slint-rescue-plan.md §5):
// recebe estado projetado e emite callbacks; não conhece documento nem malha.
import { DesignTokens, Motion, Tr } from "../tokens.slint";
import { PetuniaIcons } from "../petunia_icons.slint";
import { TopAction } from "../components/controls.slint";

export component SplitViewRegion inherits Rectangle {
    in property <string> split-preset;
    in property <image> split-view-image;
    callback split-orbit(float, float);
    callback split-pan(float, float);
    callback split-preset-requested(string);
    callback split-resized(float, float);
    callback split-toggle-requested();
    callback split-zoom(float);
    y: 0px;
    clip: true;
    background: DesignTokens.canvas;
    border-width: 1px;
    border-color: DesignTokens.border;

    changed width => { root.split-resized(self.width / 1px, self.height / 1px); }
    changed height => { root.split-resized(self.width / 1px, self.height / 1px); }
    init => { root.split-resized(self.width / 1px, self.height / 1px); }

    Image {
        width: 100%;
        height: 100%;
        image-fit: contain;
        source: root.split-view-image;
    }

    split-touch := TouchArea {
        property <bool> orbiting: false;
        property <bool> panning: false;
        property <length> last-x;
        property <length> last-y;
        mouse-cursor: (self.orbiting || self.panning) ? grabbing : default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
                if event.button == PointerEventButton.left { self.orbiting = true; }
                else if event.button == PointerEventButton.middle || event.button == PointerEventButton.right { self.panning = true; }
            } else if event.kind == PointerEventKind.up {
                self.orbiting = false;
                self.panning = false;
            }
        }
        moved => {
            if self.orbiting {
                root.split-orbit((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
            } else if self.panning {
                root.split-pan((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
            }
            self.last-x = self.mouse-x;
            self.last-y = self.mouse-y;
        }
        scroll-event(event) => {
            root.split-zoom(event.delta-y / 1px);
            return accept;
        }
    }

    // Presets da vista secundária + fechar
    Rectangle {
        x: 8px;
        y: 8px;
        height: 28px;
        width: split-presets.preferred-width + 8px;
        border-radius: DesignTokens.radius-panel;
        background: DesignTokens.surface-raised.with-alpha(0.94);
        border-width: 1px;
        border-color: DesignTokens.border;
        split-presets := HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            for entry in [
                { id: "persp", label: Tr.t("sl.split_persp") },
                { id: "front", label: Tr.t("sl.split_front") },
                { id: "back", label: Tr.t("sl.split_back") },
                { id: "left", label: Tr.t("sl.split_left") },
                { id: "right", label: Tr.t("sl.split_right") },
                { id: "top", label: Tr.t("sl.split_top") },
                { id: "iso21", label: "2:1" },
            ]: Rectangle {
                width: max(34px, pill-text.preferred-width + 14px);
                border-radius: DesignTokens.radius-control;
                background: root.split-preset == entry.id ? DesignTokens.accent : (pill-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-hover.with-alpha(0));
                animate background { duration: Motion.fast; easing: ease-out; }
                accessible-role: button;
                accessible-label: entry.label;
                accessible-checked: root.split-preset == entry.id;
                pill-text := Text { text: entry.label; color: root.split-preset == entry.id ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                pill-touch := TouchArea { clicked => { root.split-preset-requested(entry.id); } }
            }
            TopAction {
                icon-svg: PetuniaIcons.close;
                semantic-label: Tr.t("sl.split_close");
                width: 24px;
                height: 22px;
                clicked => { root.split-toggle-requested(); }
            }
        }
    }
}
