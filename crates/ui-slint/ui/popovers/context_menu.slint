// Menu de contexto.
import { ContextMenuItem } from "../components/controls.slint";
import { DesignTokens, Tr } from "../tokens.slint";

export component ContextMenuOverlay inherits Rectangle {
    in-out property <bool> context-menu-open;
    in property <length> context-menu-x;
    in property <length> context-menu-y;
    in property <string> context-menu-title;
    in property <string> context-menu-mode;
    in property <bool> context-menu-visible;
    in property <bool> context-menu-locked;
    in property <bool> context-menu-isolated;
    in property <bool> context-menu-can-move-up;
    in property <bool> context-menu-can-move-down;
    in property <string> modeling-mode;
    in property <string> selection-domain;
    in property <string> label-edit-pivot;
    in property <string> label-origin-to-geometry;
    in property <string> label-origin-to-bottom;
    in property <string> label-origin-to-cursor;
    in property <string> label-origin-to-selection;
    in property <string> label-geometry-to-origin;
    callback click-away-requested();
    callback context-menu-action(string);

    z: 100;
    x: 0;
    y: 0;

    TouchArea {
        z: 0;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.context-menu-open = false;
                root.click-away-requested();
            }
        }
        clicked => {
            root.context-menu-open = false;
            root.click-away-requested();
        }
    }

    context-menu-panel := Rectangle {
        z: 1;
        x: min(root.context-menu-x, max(0px, parent.width - self.width - 8px));
        y: min(root.context-menu-y, max(0px, parent.height - self.height - 8px));
        width: 220px;
        height: context-menu-layout.preferred-height;
        background: DesignTokens.surface-raised;
        border-width: 1px;
        border-color: DesignTokens.border;
        border-radius: 6px;
        drop-shadow-blur: DesignTokens.elevation-2-blur;
        drop-shadow-color: DesignTokens.elevation-2-color;
        drop-shadow-offset-y: DesignTokens.elevation-2-offset;

        context-menu-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;

                Text {
                    text: root.context-menu-title;
                    color: DesignTokens.text-muted;
                    font-size: DesignTokens.font-caption;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            if root.context-menu-mode != "viewport": ContextMenuItem {
                label: Tr.t("sl.rename");
                shortcut: "F2";
                clicked => { root.context-menu-open = false; root.context-menu-action("rename"); }
            }
            if root.context-menu-mode != "viewport": ContextMenuItem {
                label: Tr.t("sl.duplicate");
                shortcut: "Shift+D";
                clicked => { root.context-menu-open = false; root.context-menu-action("duplicate"); }
            }
            if root.context-menu-mode != "viewport": ContextMenuItem {
                label: root.context-menu-visible ? Tr.t("sl.hide") : Tr.t("sl.show");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("visibility"); }
            }
            if root.context-menu-mode != "viewport": ContextMenuItem {
                label: root.context-menu-locked ? Tr.t("sl.unlock") : Tr.t("sl.lock");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("lock"); }
            }
            if root.context-menu-mode != "viewport": ContextMenuItem {
                label: root.context-menu-isolated ? Tr.t("sl.un_isolate") : Tr.t("sl.isolate");
                shortcut: "Numpad /";
                clicked => { root.context-menu-open = false; root.context-menu-action("isolate"); }
            }
            if root.context-menu-mode != "viewport" && root.context-menu-can-move-up: ContextMenuItem {
                label: Tr.t("sl.move_up");
                shortcut: "Alt+Up";
                clicked => { root.context-menu-open = false; root.context-menu-action("move_up"); }
            }
            if root.context-menu-mode != "viewport" && root.context-menu-can-move-down: ContextMenuItem {
                label: Tr.t("sl.move_down");
                shortcut: "Alt+Down";
                clicked => { root.context-menu-open = false; root.context-menu-action("move_down"); }
            }
            if root.context-menu-mode == "viewport": ContextMenuItem {
                label: Tr.t("sl.select_all");
                shortcut: "A";
                clicked => { root.context-menu-open = false; root.context-menu-action("select_all"); }
            }
            if root.context-menu-mode == "viewport": ContextMenuItem {
                label: Tr.t("sl.clear_selection");
                shortcut: "Alt+A";
                clicked => { root.context-menu-open = false; root.context-menu-action("clear_selection"); }
            }
            if root.context-menu-mode == "viewport": ContextMenuItem {
                label: Tr.t("sl.invert_selection");
                shortcut: "Ctrl+I";
                clicked => { root.context-menu-open = false; root.context-menu-action("invert_selection"); }
            }
            if root.context-menu-mode == "viewport" && root.modeling-mode == "DRAW": ContextMenuItem {
                label: Tr.t("sl.shape_unite");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("draw_unite"); }
            }
            if root.context-menu-mode == "viewport" && root.modeling-mode == "DRAW": ContextMenuItem {
                label: Tr.t("sl.shape_subtract");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("draw_subtract"); }
            }
            if root.context-menu-mode == "viewport" && root.modeling-mode == "DRAW": ContextMenuItem {
                label: Tr.t("sl.shape_intersect");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("draw_intersect"); }
            }
            if root.context-menu-mode == "viewport" && root.modeling-mode == "DRAW": ContextMenuItem {
                label: Tr.t("sl.shape_exclude");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("draw_exclude"); }
            }
            if root.context-menu-mode == "viewport" && root.modeling-mode == "DRAW": ContextMenuItem {
                label: Tr.t("sl.workplane_from_selection");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("workplane_from_selection"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                label: Tr.t("sl.edge_loop");
                shortcut: "Alt+Click";
                clicked => { root.context-menu-open = false; root.context-menu-action("edge_loop"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                label: Tr.t("sl.edge_ring");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("edge_ring"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                label: Tr.t("sl.face_loop");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("face_loop"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                label: Tr.t("sl.separate_selection");
                shortcut: "P";
                clicked => { root.context-menu-open = false; root.context-menu-action("separate_selection"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                label: Tr.t("sl.extrude");
                shortcut: "E";
                clicked => { root.context-menu-open = false; root.context-menu-action("extrude"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain == "FACE": ContextMenuItem {
                label: Tr.t("sl.inset");
                shortcut: "I";
                clicked => { root.context-menu-open = false; root.context-menu-action("inset"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                label: Tr.t("sl.bevel");
                shortcut: "Ctrl+B";
                clicked => { root.context-menu-open = false; root.context-menu-action("bevel"); }
            }
            if root.context-menu-mode == "viewport": ContextMenuItem {
                label: Tr.t("sl.subdivide");
                shortcut: "Alt+W";
                clicked => { root.context-menu-open = false; root.context-menu-action("subdivide"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain == "EDGE": ContextMenuItem {
                label: Tr.t("sl.loop_cut");
                shortcut: "Ctrl+R";
                clicked => { root.context-menu-open = false; root.context-menu-action("loop_cut"); }
            }
            if root.context-menu-mode == "viewport" && (root.selection-domain == "VERTEX" || root.selection-domain == "EDGE"): ContextMenuItem {
                label: Tr.t("sl.connect");
                shortcut: "J";
                clicked => { root.context-menu-open = false; root.context-menu-action("connect"); }
            }
            if root.context-menu-mode == "viewport" && (root.selection-domain == "VERTEX" || root.selection-domain == "EDGE"): ContextMenuItem {
                label: Tr.t("sl.make_face_edge");
                shortcut: "F";
                clicked => { root.context-menu-open = false; root.context-menu-action("make_face"); }
            }
            if root.context-menu-mode == "viewport" && (root.selection-domain == "VERTEX" || root.selection-domain == "EDGE"): ContextMenuItem {
                label: Tr.t("sl.merge");
                shortcut: "M";
                clicked => { root.context-menu-open = false; root.context-menu-action("merge"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain != "OBJECT": ContextMenuItem {
                label: Tr.t("sl.dissolve");
                shortcut: "Ctrl+X";
                clicked => { root.context-menu-open = false; root.context-menu-action("dissolve"); }
            }
            if root.context-menu-mode == "viewport": ContextMenuItem {
                label: Tr.t("sl.slice");
                shortcut: "Shift+K";
                clicked => { root.context-menu-open = false; root.context-menu-action("slice"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain == "EDGE": ContextMenuItem {
                label: Tr.t("sl.mark_clear_seam");
                shortcut: "U";
                clicked => { root.context-menu-open = false; root.context-menu-action("mark_seam"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain == "FACE": ContextMenuItem {
                label: Tr.t("sl.flip_normals");
                shortcut: "Alt+N";
                clicked => { root.context-menu-open = false; root.context-menu-action("flip_normals"); }
            }
            if root.context-menu-mode == "viewport" && (root.selection-domain == "OBJECT" || root.selection-domain == "FACE"): ContextMenuItem {
                label: Tr.t("sl.shade_smooth");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("shade_smooth"); }
            }
            if root.context-menu-mode == "viewport" && (root.selection-domain == "OBJECT" || root.selection-domain == "FACE"): ContextMenuItem {
                label: Tr.t("sl.shade_flat");
                shortcut: "";
                clicked => { root.context-menu-open = false; root.context-menu-action("shade_flat"); }
            }
            if root.context-menu-mode == "viewport" && root.selection-domain == "OBJECT": ContextMenuItem {
                label: Tr.t("sl.duplicate");
                shortcut: "Shift+D";
                clicked => { root.context-menu-open = false; root.context-menu-action("duplicate"); }
            }
            ContextMenuItem {
                label: Tr.t("sl.frame_selection");
                shortcut: "F";
                clicked => { root.context-menu-action("frame"); }
            }
            if root.selection-domain == "OBJECT": ContextMenuItem {
                label: Tr.t("sl.set_as_boolean_operand");
                shortcut: "";
                clicked => { root.context-menu-action("boolean_operand"); }
            }

            if root.selection-domain == "OBJECT": Rectangle { height: 1px; background: DesignTokens.border; }

            if root.selection-domain == "OBJECT": ContextMenuItem {
                label: root.label-edit-pivot;
                shortcut: "Insert";
                clicked => { root.context-menu-action("toggle_edit_pivot"); }
            }
            if root.selection-domain == "OBJECT": ContextMenuItem {
                label: root.label-origin-to-geometry;
                shortcut: "";
                clicked => { root.context-menu-action("origin_to_geometry"); }
            }
            if root.selection-domain == "OBJECT": ContextMenuItem {
                label: root.label-origin-to-bottom;
                shortcut: "";
                clicked => { root.context-menu-action("origin_to_bottom"); }
            }
            if root.selection-domain == "OBJECT": ContextMenuItem {
                label: root.label-origin-to-cursor;
                shortcut: "";
                clicked => { root.context-menu-action("origin_to_cursor"); }
            }
            if root.selection-domain == "OBJECT": ContextMenuItem {
                label: root.label-origin-to-selection;
                shortcut: "";
                clicked => { root.context-menu-action("origin_to_selection"); }
            }
            if root.selection-domain == "OBJECT": ContextMenuItem {
                label: root.label-geometry-to-origin;
                shortcut: "";
                clicked => { root.context-menu-action("geometry_to_origin"); }
            }

            if root.selection-domain == "OBJECT" || root.context-menu-mode != "viewport": Rectangle { height: 1px; background: DesignTokens.border; }

            if root.selection-domain == "OBJECT" || root.context-menu-mode != "viewport": ContextMenuItem {
                label: Tr.t("sl.clear_all_transforms");
                shortcut: "Alt+Backspace";
                clicked => { root.context-menu-open = false; root.context-menu-action("clear_all_transforms"); }
            }
            if root.selection-domain == "OBJECT" || root.context-menu-mode != "viewport": ContextMenuItem {
                label: Tr.t("sl.clear_location");
                shortcut: "Alt+G";
                clicked => { root.context-menu-open = false; root.context-menu-action("clear_location"); }
            }
            if root.selection-domain == "OBJECT" || root.context-menu-mode != "viewport": ContextMenuItem {
                label: Tr.t("sl.clear_rotation");
                shortcut: "Alt+R";
                clicked => { root.context-menu-open = false; root.context-menu-action("clear_rotation"); }
            }
            if root.selection-domain == "OBJECT" || root.context-menu-mode != "viewport": ContextMenuItem {
                label: Tr.t("sl.clear_scale");
                shortcut: "Alt+S";
                clicked => { root.context-menu-open = false; root.context-menu-action("clear_scale"); }
            }

            Rectangle { height: 1px; background: DesignTokens.border; }

            ContextMenuItem {
                label: Tr.t("sl.delete");
                shortcut: "Del";
                danger: true;
                clicked => { root.context-menu-action("delete"); }
            }
        }
    }

}
