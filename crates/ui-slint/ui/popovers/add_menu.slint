// Popover de criação de primitivas: lista com ícone, nome e atalho em duas
// colunas, altura pelo conteúdo. Não modal (o foco fica no invocador; setas
// movem o destaque do shell). Clicar fora fecha pelo apanhador do contêiner.
import { DesignTokens, Tr } from "../tokens.slint";
import { PetuniaIcons } from "../petunia_icons.slint";

struct AddMenuEntry {
    id: string,
    icon: image,
    label: string,
    shortcut: string,
    description: string,
}

component AddMenuRow inherits Rectangle {
    in property <AddMenuEntry> entry;
    in property <bool> highlighted;
    callback activated;

    height: 32px;
    border-radius: DesignTokens.radius-control;
    background: root.highlighted || touch.has-hover ? DesignTokens.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.entry.label;
    accessible-description: root.entry.description;
    accessible-action-default => { root.activated(); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Image {
            source: root.entry.icon;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            colorize: DesignTokens.text-primary;
        }
        Text {
            text: root.entry.label;
            horizontal-stretch: 1;
            color: DesignTokens.text-primary;
            font-size: DesignTokens.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.entry.shortcut;
            color: DesignTokens.text-secondary;
            font-size: DesignTokens.font-caption;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

export component AddMenuPopover inherits Rectangle {
    in property <int> add-menu-highlight;
    callback add-primitive-requested(string);
    callback add-menu-changed(bool);

    // A ordem segue `add-menu-ids` do shell (navegação por setas).
    property <[AddMenuEntry]> entries: [
        { id: "cube", icon: PetuniaIcons.cube, label: Tr.t("sl.cube"), shortcut: "1", description: Tr.t("sl.parametric_6_sided_hexahedral_box_with_width") },
        { id: "sphere", icon: PetuniaIcons.sphere, label: Tr.t("sl.sphere"), shortcut: "2", description: Tr.t("sl.uv_sphere_parameterized_by_longitude_segment") },
        { id: "cylinder", icon: PetuniaIcons.cylinder, label: Tr.t("sl.cylinder"), shortcut: "3", description: Tr.t("sl.parametric_circular_cylinder_with_top_bottom") },
        { id: "plane", icon: PetuniaIcons.plane, label: Tr.t("sl.plane_2"), shortcut: "4", description: Tr.t("sl.flat_2d_quad_rectangular_plane_surface_posit") },
        { id: "cone", icon: PetuniaIcons.cone, label: Tr.t("sl.cone"), shortcut: "5", description: Tr.t("sl.conical_geometry_tapering_to_a_single_apex_v") },
        { id: "capsule", icon: PetuniaIcons.capsule, label: Tr.t("sl.capsule"), shortcut: "6", description: Tr.t("sl.cylindrical_body_capped_by_two_hemispherical") },
        { id: "torus", icon: PetuniaIcons.torus, label: Tr.t("sl.torus"), shortcut: "7", description: Tr.t("sl.donut_shaped_revolution_ring_with_major_and_") },
        { id: "circle", icon: PetuniaIcons.circle, label: Tr.t("sl.circle"), shortcut: "8", description: Tr.t("sl.2d_planar_boundary_circle_polygon_or_n_gon_d") },
        { id: "icosphere", icon: PetuniaIcons.icosphere, label: Tr.t("sl.icosphere"), shortcut: "9", description: Tr.t("sl.polyhedral_geodesic_sphere_composed_of_equil") },
        { id: "wedge", icon: PetuniaIcons.wedge, label: Tr.t("sl.wedge"), shortcut: "0", description: Tr.t("sl.right_angled_triangular_prism_3d_ramp_mesh") },
    ];
    property <length> column-width: 156px;
    property <int> rows: Math.ceil(root.entries.length / 2);

    x: 14px;
    y: 58px;
    width: 2 * root.column-width + 3 * 6px;
    height: grid.preferred-height;
    border-radius: DesignTokens.radius-panel;
    background: DesignTokens.surface-raised;
    border-width: 1px;
    border-color: DesignTokens.border;
    drop-shadow-blur: DesignTokens.elevation-2-blur;
    drop-shadow-color: DesignTokens.elevation-2-color;
    drop-shadow-offset-y: DesignTokens.elevation-2-offset;
    accessible-role: list;
    accessible-label: Tr.t("sl.add_primitive");

    // Engole o press dentro do cartão (fora dele, o apanhador fecha).
    TouchArea { }

    grid := VerticalLayout {
        padding: 6px;
        spacing: 2px;
        for row in root.rows: HorizontalLayout {
            spacing: 6px;
            for column in 2: Rectangle {
                property <int> index: row * 2 + column;
                width: root.column-width;
                height: 32px;
                if self.index < root.entries.length: AddMenuRow {
                    width: parent.width;
                    entry: root.entries[parent.index];
                    highlighted: root.add-menu-highlight == parent.index;
                    activated => {
                        root.add-primitive-requested(root.entries[parent.index].id);
                        root.add-menu-changed(false);
                    }
                }
            }
        }
    }
}
