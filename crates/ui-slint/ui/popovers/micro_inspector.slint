// Micro Inspector flutuante.
import { DesignTokens, Tr } from "../tokens.slint";
import { IconDisplay, IconSet } from "@lucide";

export component MicroInspector inherits Rectangle {
    in property <length> micro-inspector-x;
    in property <length> micro-inspector-y;
    in property <string> active-tool;
    in property <bool> measure-visible;
    in property <float> measure-distance;
    in property <float> measure-dx;
    in property <float> measure-dy;
    in property <float> measure-dz;
    in property <float> measure-angle-deg;
    in property <float> pos-x;
    in property <float> pos-y;
    in property <float> pos-z;
    in property <float> rot-x;
    in property <float> rot-y;
    in property <float> rot-z;
    callback micro-inspector-toggle();
    callback active-tool-changed(string);
    callback command-executed(string);

    
    
    width: 250px;
    height: 200px;
    border-radius: 8px;
    background: DesignTokens.surface-raised;
    border-width: 1.5px;
    border-color: DesignTokens.accent;
    drop-shadow-blur: DesignTokens.elevation-2-blur;
    drop-shadow-color: DesignTokens.elevation-2-color;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // Cabeçalho com título e botão de fechar
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: Tr.t("sl.micro_inspector");
                color: DesignTokens.accent;
                font-size: DesignTokens.font-small;
                font-weight: 700;
            }
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: close-touch.has-hover ? DesignTokens.surface-hover : transparent;
                IconDisplay {
                    icon: IconSet.X;
                    size: 12px;
                    stroke: DesignTokens.text-muted;
                }
                close-touch := TouchArea {
                    clicked => { root.micro-inspector-toggle(); }
                }
            }
        }

        // Ferramentas de Transformação Rápida
        HorizontalLayout {
            spacing: 4px;
            alignment: stretch;
            for tool in [
                { id: "select", label: Tr.t("sl.select"), icon: IconSet.MousePointer2 },
                { id: "move", label: Tr.t("sl.move"), icon: IconSet.Move3d },
                { id: "rotate", label: Tr.t("sl.rotate"), icon: IconSet.RotateCcw },
                { id: "scale", label: Tr.t("sl.scale"), icon: IconSet.Maximize2 },
                { id: "measure", label: Tr.t("sl.measure"), icon: IconSet.ArrowUpDown },
            ]: Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 4px;
                background: root.active-tool == tool.id ? DesignTokens.accent.transparentize(0.75) : (tool-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface);
                border-width: root.active-tool == tool.id ? 1px : 0px;
                border-color: DesignTokens.accent;
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    IconDisplay {
                        icon: tool.icon;
                        size: 13px;
                        stroke: root.active-tool == tool.id ? DesignTokens.accent : DesignTokens.text-primary;
                    }
                }
                tool-touch := TouchArea {
                    clicked => {
                        root.active-tool-changed(tool.id);
                        root.micro-inspector-toggle();
                    }
                }
            }
        }

        Rectangle { height: 1px; background: DesignTokens.border; }

        // Resumo de Dados: Se fita métrica visível ou coordenadas de posição
        if root.measure-visible: VerticalLayout {
            spacing: 2px;
            Text { text: Tr.t("sl.distance") + root.measure-distance + "m"; color: DesignTokens.measure; font-size: DesignTokens.font-small; font-weight: 700; font-family: "monospace"; }
            Text { text: "Δ: X " + root.measure-dx + "  Y " + root.measure-dy + "  Z " + root.measure-dz; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-family: "monospace"; }
            Text { text: Tr.t("sl.angle_2") + root.measure-angle-deg + "°"; color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; }
        }

        if !root.measure-visible: VerticalLayout {
            spacing: 2px;
            Text { text: Tr.t("sl.transform_quick_readout"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; font-weight: 700; }
            Text { text: Tr.t("sl.pos") + root.pos-x + ", " + root.pos-y + ", " + root.pos-z; color: DesignTokens.text-primary; font-size: DesignTokens.font-caption; font-family: "monospace"; }
            Text { text: Tr.t("sl.rot") + root.rot-x + "°, " + root.rot-y + "°, " + root.rot-z + "°"; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; font-family: "monospace"; }
        }

        Rectangle { height: 1px; background: DesignTokens.border; }

        // Ações de Modelagem Direta
        HorizontalLayout {
            spacing: 4px;
            for act in [
                { id: "model.extrude", label: Tr.t("sl.extrude") },
                { id: "model.inset", label: Tr.t("sl.inset") },
                { id: "model.bevel", label: Tr.t("sl.bevel") },
                { id: "model.loop_cut", label: Tr.t("sl.loop_cut") },
            ]: Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                border-radius: 4px;
                background: act-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface;
                Text {
                    text: act.label;
                    color: DesignTokens.text-primary;
                    font-size: DesignTokens.font-caption;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                act-touch := TouchArea {
                    clicked => {
                        root.command-executed(act.id);
                        root.micro-inspector-toggle();
                    }
                }
            }
        }

        // Rodapé com atalho
        Text {
            text: Tr.t("sl.space_close_esc_cancel");
            color: DesignTokens.text-muted;
            font-size: DesignTokens.font-caption;
            horizontal-alignment: center;
        }
    }

}
