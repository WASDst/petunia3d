// Part-selection color picker: hue ring + saturation/value triangle.
// The shell projects presentation state; callbacks preserve the color entrypoint.
import { ColorPresets, DesignTokens, Tr } from "../tokens.slint";
import { PetuniaIcons } from "../petunia_icons.slint";
import { IconButton } from "../components/base.slint";
import { ColorSwatch, NumericField } from "../components/controls.slint";

export component PartColorPopover inherits Rectangle {
    in-out property <bool> part-color-popover-open;
    in property <string> part-color-popover-name;
    in property <image> color-wheel-image;
    in property <color> part-color-preview;
    in property <string> part-color-hex;
    in property <float> part-color-hue;
    in property <float> part-color-saturation;
    in property <float> part-color-value;
    callback part-color-wheel-interacted(float, float, bool);
    callback part-color-hex-entered(string) -> bool;
    callback part-color-hsv-entered(int, string) -> bool;
    callback part-color-hsv-adjusted(int, float);
    callback part-color-preset-clicked(color);
    callback part-color-reset-requested();
    property <bool> hex-invalid: false;

    // A same-color action may not emit changed part-color-hex. Restore both the
    // validation state and the TextInput draft explicitly at every valid action.
    function restore-hex-display() {
        root.hex-invalid = false;
        hex-input.text = root.part-color-hex;
    }
    function accept-hsv(channel: int, text: string) -> bool {
        if root.part-color-hsv-entered(channel, text) {
            root.restore-hex-display();
            return true;
        }
        return false;
    }
    function adjust-hsv(channel: int, delta: float) {
        root.part-color-hsv-adjusted(channel, delta);
        root.restore-hex-display();
    }
    init => { root.restore-hex-display(); }
    changed part-color-hex => { root.restore-hex-display(); }
    changed part-color-popover-open => {
        if root.part-color-popover-open { root.restore-hex-display(); }
    }

    TouchArea {
        clicked => { root.part-color-popover-open = false; }
    }

    Rectangle {
        x: min(max(8px, parent.width - self.width - 340px), parent.width - self.width - 8px);
        y: 80px;
        width: 220px;
        height: part-color-layout.preferred-height + 20px;
        border-radius: DesignTokens.radius-panel;
        background: DesignTokens.surface-raised;
        border-width: 1px;
        border-color: DesignTokens.border;
        drop-shadow-blur: DesignTokens.elevation-2-blur;
        drop-shadow-color: DesignTokens.elevation-2-color;
        drop-shadow-offset-y: DesignTokens.elevation-2-offset;

        TouchArea { clicked => {} }

        part-color-layout := VerticalLayout {
            width: parent.width;
            padding: 10px;
            spacing: DesignTokens.space-sm;

            HorizontalLayout {
                Text {
                    text: root.part-color-popover-name != "" ? "\{Tr.t("sl.part_selection_color")}: \{root.part-color-popover-name}" : Tr.t("sl.part_selection_color");
                    color: DesignTokens.text-primary;
                    font-size: DesignTokens.font-small;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IconButton {
                    icon-svg: PetuniaIcons.close;
                    semantic-label: Tr.t("sl.close_color_picker");
                    clicked => { root.part-color-popover-open = false; }
                }
            }

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 130px;
                    height: 130px;
                    border-radius: DesignTokens.radius-pill;
                    // Real RGB pixels remain untinted; only the surrounding UI
                    // receives the shared neutral surface treatment.
                    Image {
                        width: 130px;
                        height: 130px;
                        source: root.color-wheel-image;
                        image-fit: contain;
                    }
                    TouchArea {
                        mouse-cursor: crosshair;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                root.part-color-wheel-interacted(self.mouse-x / 1px, self.mouse-y / 1px, true);
                                root.restore-hex-display();
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.part-color-wheel-interacted(self.mouse-x / 1px, self.mouse-y / 1px, false);
                                root.restore-hex-display();
                            }
                        }
                    }
                }
            }

            // Typed and keyboard alternatives to both pointer surfaces.
            HorizontalLayout {
                spacing: DesignTokens.space-xs;
                NumericField {
                    label: Tr.t("sl.picker_hue_short");
                    full-label: Tr.t("sl.picker_hue");
                    value: root.part-color-hue;
                    step: 1;
                    label-color: DesignTokens.text-secondary;
                    accessible-value-minimum: 0;
                    accessible-value-maximum: 360;
                    accessible-value-step: 1;
                    accessible-action-increment => { root.adjust-hsv(0, 1); }
                    accessible-action-decrement => { root.adjust-hsv(0, -1); }
                    scrubbed(delta, fine) => { root.adjust-hsv(0, delta * (fine ? 0.1 : 1)); }
                    scrub-cancelled(value) => { root.accept-hsv(0, value); }
                    text-committed(text) => { root.accept-hsv(0, text); }
                }
                NumericField {
                    label: Tr.t("sl.picker_saturation_short");
                    full-label: Tr.t("sl.picker_saturation");
                    value: root.part-color-saturation * 100;
                    step: 1;
                    label-color: DesignTokens.text-secondary;
                    accessible-value-minimum: 0;
                    accessible-value-maximum: 100;
                    accessible-value-step: 1;
                    accessible-action-increment => { root.adjust-hsv(1, 1); }
                    accessible-action-decrement => { root.adjust-hsv(1, -1); }
                    scrubbed(delta, fine) => { root.adjust-hsv(1, delta * (fine ? 0.1 : 1)); }
                    scrub-cancelled(value) => { root.accept-hsv(1, value); }
                    text-committed(text) => { root.accept-hsv(1, text); }
                }
                NumericField {
                    label: Tr.t("sl.picker_value_short");
                    full-label: Tr.t("sl.picker_value");
                    value: root.part-color-value * 100;
                    step: 1;
                    label-color: DesignTokens.text-secondary;
                    accessible-value-minimum: 0;
                    accessible-value-maximum: 100;
                    accessible-value-step: 1;
                    accessible-action-increment => { root.adjust-hsv(2, 1); }
                    accessible-action-decrement => { root.adjust-hsv(2, -1); }
                    scrubbed(delta, fine) => { root.adjust-hsv(2, delta * (fine ? 0.1 : 1)); }
                    scrub-cancelled(value) => { root.accept-hsv(2, value); }
                    text-committed(text) => { root.accept-hsv(2, text); }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: DesignTokens.control-height;
                    height: DesignTokens.control-height;
                    border-radius: DesignTokens.radius-control;
                    background: root.part-color-preview;
                    border-width: 1px;
                    border-color: DesignTokens.border;
                }
                Text {
                    text: Tr.t("sl.picker_hex_short");
                    color: DesignTokens.text-secondary;
                    font-size: DesignTokens.font-small;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: DesignTokens.control-height;
                    border-radius: DesignTokens.radius-control;
                    background: DesignTokens.input-surface;
                    border-width: hex-input.has-focus ? 2px : 1px;
                    border-color: root.hex-invalid ? DesignTokens.danger
                        : hex-input.has-focus ? DesignTokens.focus-ring : DesignTokens.border;
                    hex-input := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: root.part-color-hex;
                        color: DesignTokens.text-primary;
                        font-size: DesignTokens.font-small;
                        vertical-alignment: center;
                        accessible-label: Tr.t("sl.picker_hex");
                        accessible-description: root.hex-invalid ? Tr.t("sl.picker_hex_invalid") : Tr.t("sl.picker_hex_hint");
                        single-line: true;
                        edited => { root.hex-invalid = false; }
                        accepted => {
                            if root.part-color-hex-entered(self.text) {
                                root.restore-hex-display();
                            } else {
                                root.hex-invalid = true;
                            }
                        }
                    }
                }
            }

            Text {
                text: "\{Tr.t("sl.picker_rgb_short")}: \{Math.round(root.part-color-preview.red * 255)} / \{Math.round(root.part-color-preview.green * 255)} / \{Math.round(root.part-color-preview.blue * 255)}";
                color: DesignTokens.text-secondary;
                font-size: DesignTokens.font-small;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: DesignTokens.space-xs;
                alignment: center;
                for preset in [ColorPresets.tag-orange, ColorPresets.tag-cyan, ColorPresets.tag-violet,
                    ColorPresets.tag-green, ColorPresets.tag-amber, ColorPresets.tag-red]: ColorSwatch {
                    swatch-color: preset;
                    selected: root.part-color-preview == preset;
                    semantic-label: "\{Tr.t("sl.color_swatch")} · \{Tr.t("sl.picker_rgb_short")}: \{Math.round(preset.red * 255)} / \{Math.round(preset.green * 255)} / \{Math.round(preset.blue * 255)}";
                    clicked => {
                        root.part-color-preset-clicked(preset);
                        root.restore-hex-display();
                    }
                }
            }

            IconButton {
                icon-svg: PetuniaIcons.refresh;
                label: Tr.t("sl.reset_to_default_color");
                semantic-label: Tr.t("sl.reset_to_default_color");
                clicked => {
                    root.part-color-reset-requested();
                    root.restore-hex-display();
                }
            }
        }
    }
}
