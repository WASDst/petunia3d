// Diálogo modal de recuperação de sessão.
import { DesignTokens } from "../tokens.slint";
import { DialogActionButton } from "../shell/dialog_action.slint";
import { ModalFocusBoundary } from "../shell/modal_focus_boundary.slint";

export component RecoveryDialog inherits ModalFocusBoundary {
    in property <string> recovery-keep;
    in property <string> recovery-discard;
    in property <string> recovery-recover;
    in property <string> recovery-title;
    in property <string> recovery-body;
    in property <string> recovery-detail;
    callback recovery-discard-requested();
    callback recovery-keep-requested();
    callback recovery-recover-requested();

    x: 0;
    y: 0;
    
    
    background: DesignTokens.scrim;
    initial-focus => { recovery-keep.focus(); }
    first-focus => { recovery-discard.focus(); }
    last-focus => { recovery-recover.focus(); }
    dismiss-requested => { }
    TouchArea { }

    Rectangle {
        width: 460px;
        accessible-role: groupbox;
        accessible-label: root.recovery-title;
        height: recovery-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: 96px;
        border-radius: 8px;
        background: DesignTokens.surface-raised;
        border-width: 1px;
        border-color: DesignTokens.border;

        recovery-layout := VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                text: root.recovery-title;
                color: DesignTokens.text-primary;
                font-size: DesignTokens.font-exceptional;
                font-weight: 700;
            }
            Text {
                text: root.recovery-body;
                color: DesignTokens.text-secondary;
                font-size: DesignTokens.font-small;
                wrap: word-wrap;
            }
            Text {
                text: root.recovery-detail;
                color: DesignTokens.text-muted;
                font-size: DesignTokens.font-caption;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;

                recovery-discard := DialogActionButton {
                    label: root.recovery-discard;
                    semantic-label: root.recovery-discard;
                    danger: true;
                    clicked => { root.recovery-discard-requested(); }
                }
                recovery-keep := DialogActionButton {
                    label: root.recovery-keep;
                    semantic-label: root.recovery-keep;
                    clicked => { root.recovery-keep-requested(); }
                }
                recovery-recover := DialogActionButton {
                    label: root.recovery-recover;
                    semantic-label: root.recovery-recover;
                    primary: true;
                    clicked => { root.recovery-recover-requested(); }
                }
            }
        }
    }

}
