// Diálogo de Preferências.
import { ColorPresets, DesignTokens, Tr } from "../tokens.slint";
import { DropdownButton, IconButton } from "../components/base.slint";
import { KeymapActionEntry, KeymapProfileEntry, ThemeEntry } from "../types.slint";
import { ModalFocusBoundary } from "../shell/modal_focus_boundary.slint";
import { PanelDragHandle, PanelResizeGrip, PetuniaSlider, TopAction } from "../components/controls.slint";
import { PetuniaIcons } from "../petunia_icons.slint";
import { ScrollView } from "std-widgets.slint";

export component SettingsDialog inherits Rectangle {
    in property <bool> settings-focus-active;
    in-out property <bool> settings-visible;
    in property <string> label-preferences;
    in-out property <length> settings-panel-w;
    in-out property <length> settings-panel-h;
    in-out property <length> settings-panel-x;
    in-out property <length> settings-panel-y;
    in-out property <string> settings-query;
    in-out property <int> settings-tab;
    in property <[ThemeEntry]> themes;
    in property <float> ui-scale;
    in property <string> icon-theme;
    in property <image> color-wheel-image;
    in property <string> label-accent-color;
    in property <string> label-accent-color-hint;
    in property <string> accent-color-hex;
    in property <string> selection-color-hex;
    in property <color> selection-color;
    in property <string> label-selection-color;
    in property <string> label-highlight-thickness;
    in-out property <float> selection-thickness;
    in property <string> active-language;
    in property <[KeymapProfileEntry]> keymap-profiles;
    in property <string> active-keymap-id;
    in property <[KeymapActionEntry]> keymap-rows;
    in property <string> tool-activation;
    in property <bool> invert-vertical-drag;
    in property <string> label-invert-vertical-drag;
    in property <int> double-tap-interval-ms;
    in property <string> label-double-tap-interval;
    in property <string> label-drag-threshold;
    in property <float> drag-threshold-px;
    in property <string> label-snap-radius;
    in property <float> snap-radius-px;
    in property <bool> click-move-click;
    in property <string> label-click-move-click;
    in property <string> label-click-move-click-hint;
    in property <bool> show-tool-labels;
    in property <string> label-show-tool-labels;
    in property <string> label-show-tool-labels-hint;
    in property <bool> workplane-prefer-ground;
    in property <string> label-workplane-prefer-ground;
    in property <string> label-workplane-prefer-ground-hint;
    in property <bool> studio-light-follows-camera;
    in property <string> label-studio-light-follows-camera;
    in property <string> label-studio-light-follows-camera-hint;
    in property <bool> colorblind-axes;
    in property <bool> reduced-motion;
    in property <bool> multiselection-measure-tag;
    in property <bool> bevel-clamp-overlap;
    in property <bool> slice-trim;
    in property <bool> is-wireframe;
    in property <bool> show-face-orientation;
    in property <bool> is-orthographic;
    in property <string> shell-info;
    callback click-away-requested();
    callback settings-closed();
    pure callback text-matches(string, string) -> bool;
    callback theme-changed(string);
    callback ui-scale-set(float);
    callback icon-theme-set(string);
    callback accent-color-set(string);
    callback accent-color-wheel-interacted(float, float, bool);
    callback selection-color-set(string);
    callback selection-color-wheel-interacted(float, float, bool);
    callback selection-thickness-set(float);
    callback selection-thickness-released(float);
    callback language-changed(string);
    callback keymap-changed(string);
    callback keymap-profile-create();
    callback keymap-profile-delete(string);
    callback keymap-capture-requested(string);
    callback keymap-binding-reset(string);
    callback tool-activation-set(string);
    callback invert-vertical-drag-set(bool);
    callback double-tap-interval-set(int);
    callback double-tap-interval-released(int);
    callback drag-threshold-set(float);
    callback snap-radius-set(float);
    callback click-move-click-set(bool);
    callback show-tool-labels-set(bool);
    callback workplane-prefer-ground-set(bool);
    callback studio-light-follows-camera-set(bool);
    callback colorblind-axes-set(bool);
    callback reduced-motion-set(bool);
    callback multiselection-measure-tag-set(bool);
    callback toggle-bevel-clamp-overlap();
    callback slice-trim-set(bool);
    callback toggle-wireframe-requested();
    callback toggle-face-orientation();
    callback toggle-projection-requested();

    in property <string> active-keymap-name: "";
    property <bool> accent-wheel-open: false;
    property <bool> selection-wheel-open: false;
    property <bool> keymap-dropdown-open: false;
    property <string> shortcut-query: "";

    x: 0;
    y: 0;
    
    
    z: root.settings-focus-active ? 20 : 0;
    background: DesignTokens.scrim;
    TouchArea { clicked => { root.click-away-requested(); } }
    settings-panel := ModalFocusBoundary {
        active: root.settings-focus-active;
        initial-focus => { settings-search.focus(); }
        first-focus => { settings-close.focus(); }
        last-focus => { settings-close.focus(); }
        dismiss-requested => { root.settings-visible = false; root.settings-closed(); }
        accessible-role: groupbox;
        accessible-label: root.label-preferences != "" ? root.label-preferences : Tr.t("sl.settings");
        width: min(root.settings-panel-w > 0px ? root.settings-panel-w : 660px, parent.width - 40px);
        height: min(root.settings-panel-h > 0px ? root.settings-panel-h : 520px, parent.height - 40px);
        x: root.settings-panel-x < 0px ? (parent.width - self.width) / 2 : clamp(root.settings-panel-x, 0px, max(parent.width - self.width, 0px));
        y: root.settings-panel-y < 0px ? (parent.height - self.height) / 2 : clamp(root.settings-panel-y, 0px, max(parent.height - self.height, 0px));
        border-radius: 8px;
        background: DesignTokens.surface-raised;
        border-width: 1px;
        border-color: DesignTokens.border;
        drop-shadow-blur: DesignTokens.elevation-2-blur;
        drop-shadow-color: DesignTokens.elevation-2-color;
        drop-shadow-offset-y: DesignTokens.elevation-2-offset;

        // Captura cliques no card para que não atravessem para o scrim de fundo
        TouchArea { clicked => {} }

        PanelResizeGrip {
            z: 10;
            x: parent.width - self.width;
            y: parent.height - self.height;
            panel-w: settings-panel.width;
            panel-h: settings-panel.height;
            max-w: root.width - 40px;
            max-h: root.height - 40px;
            resized-to(w, h) => { root.settings-panel-w = w; root.settings-panel-h = h; }
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Cabeçalho do painel (arraste para mover, duplo clique recentraliza)
            Rectangle {
                height: 48px;
                background: DesignTokens.surface;
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;

                PanelDragHandle {
                    panel-x: settings-panel.x;
                    panel-y: settings-panel.y;
                    max-x: root.width - settings-panel.width;
                    max-y: root.height - settings-panel.height;
                    moved-to(x, y) => { root.settings-panel-x = x; root.settings-panel-y = y; }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout { alignment: center; HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Image {
                            source: PetuniaIcons.settings;
                            width: 16px;
                            height: 16px;
                            colorize: DesignTokens.accent;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                        }
                        Text {
                            text: root.label-preferences != "" ? root.label-preferences : Tr.t("sl.settings");
                            color: DesignTokens.text-primary;
                            font-size: DesignTokens.font-exceptional;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    } }

                    VerticalLayout { alignment: center;
                    settings-close := TopAction {
                        icon-svg: PetuniaIcons.close;
                        semantic-label: Tr.t("sl.close_settings");
                        clicked => {
                            root.settings-visible = false;
                            root.settings-closed();
                        }
                    }
                    }
                }
            }

            Rectangle { height: 1px; background: DesignTokens.border; }

            // Corpo: Barra lateral de categorias + Painel de conteúdo
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // Sidebar de seções
                Rectangle {
                    width: 175px;
                    background: DesignTokens.surface;
                    border-bottom-left-radius: 8px;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;

                        // Busca: filtra as abas por nome e palavras-chave (F7, §5.4).
                        Rectangle {
                            height: 30px;
                            border-radius: 4px;
                            background: DesignTokens.canvas;
                            border-width: 1px;
                            border-color: settings-search.has-focus ? DesignTokens.focus-ring : DesignTokens.border;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                Image {
                                    y: (parent.height - self.height) / 2;
                                    source: PetuniaIcons.search;
                                    width: 13px;
                                    height: 13px;
                                    colorize: DesignTokens.text-muted;
                                    image-fit: contain;
                                }
                                settings-search := TextInput {
                                    text <=> root.settings-query;
                                    color: DesignTokens.text-primary;
                                    font-size: DesignTokens.font-small;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accessible-label: Tr.t("sl.settings_search");
                                }
                            }
                            if root.settings-query == "": Text {
                                x: 27px;
                                text: Tr.t("sl.settings_search");
                                color: DesignTokens.text-muted;
                                font-size: DesignTokens.font-small;
                                vertical-alignment: center;
                            }
                        }

                        if root.text-matches(Tr.t("sl.appearance") + " " + Tr.t("sl.settings_kw_0"), root.settings-query): Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: root.settings-tab == 0 ? DesignTokens.accent : (tab0-touch.has-hover ? DesignTokens.surface-hover : transparent);
                            accessible-role: tab;
                            accessible-label: Tr.t("sl.appearance");
                            accessible-checked: root.settings-tab == 0;
                            accessible-action-default => { root.settings-tab = 0; }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout { alignment: center; Image { source: PetuniaIcons.paint-palette; width: 14px; height: 14px; colorize: root.settings-tab == 0 ? DesignTokens.on-accent : DesignTokens.text-secondary; image-fit: contain; } }
                                Text { text: Tr.t("sl.appearance"); color: root.settings-tab == 0 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                            }
                            tab0-touch := TouchArea { clicked => { root.settings-tab = 0; } }
                        }
                        if root.text-matches(Tr.t("sl.language_region") + " " + Tr.t("sl.settings_kw_1"), root.settings-query): Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: root.settings-tab == 1 ? DesignTokens.accent : (tab1-touch.has-hover ? DesignTokens.surface-hover : transparent);
                            accessible-role: tab;
                            accessible-label: Tr.t("sl.language_region");
                            accessible-checked: root.settings-tab == 1;
                            accessible-action-default => { root.settings-tab = 1; }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout { alignment: center; Image { source: PetuniaIcons.language; width: 14px; height: 14px; colorize: root.settings-tab == 1 ? DesignTokens.on-accent : DesignTokens.text-secondary; image-fit: contain; } }
                                Text { text: Tr.t("sl.language_region"); color: root.settings-tab == 1 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                            }
                            tab1-touch := TouchArea { clicked => { root.settings-tab = 1; } }
                        }
                        if root.text-matches(Tr.t("sl.keyboard_shortcuts") + " " + Tr.t("sl.settings_kw_2"), root.settings-query): Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: root.settings-tab == 2 ? DesignTokens.accent : (tab2-touch.has-hover ? DesignTokens.surface-hover : transparent);
                            accessible-role: tab;
                            accessible-label: Tr.t("sl.keyboard_shortcuts");
                            accessible-checked: root.settings-tab == 2;
                            accessible-action-default => { root.settings-tab = 2; }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout { alignment: center; Image { source: PetuniaIcons.keyboard; width: 14px; height: 14px; colorize: root.settings-tab == 2 ? DesignTokens.on-accent : DesignTokens.text-secondary; image-fit: contain; } }
                                Text { text: Tr.t("sl.keyboard_shortcuts"); color: root.settings-tab == 2 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                            }
                            tab2-touch := TouchArea { clicked => { root.settings-tab = 2; } }
                        }
                        if root.text-matches(Tr.t("sl.accessibility") + " " + Tr.t("sl.settings_kw_3"), root.settings-query): Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: root.settings-tab == 3 ? DesignTokens.accent : (tab3-touch.has-hover ? DesignTokens.surface-hover : transparent);
                            accessible-role: tab;
                            accessible-label: Tr.t("sl.accessibility");
                            accessible-checked: root.settings-tab == 3;
                            accessible-action-default => { root.settings-tab = 3; }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout { alignment: center; Image { source: PetuniaIcons.eye; width: 14px; height: 14px; colorize: root.settings-tab == 3 ? DesignTokens.on-accent : DesignTokens.text-secondary; image-fit: contain; } }
                                Text { text: Tr.t("sl.accessibility"); color: root.settings-tab == 3 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                            }
                            tab3-touch := TouchArea { clicked => { root.settings-tab = 3; } }
                        }
                        if root.text-matches(Tr.t("sl.tools") + " " + Tr.t("sl.settings_kw_4"), root.settings-query): Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: root.settings-tab == 4 ? DesignTokens.accent : (tab4-touch.has-hover ? DesignTokens.surface-hover : transparent);
                            accessible-role: tab;
                            accessible-label: Tr.t("sl.tools");
                            accessible-checked: root.settings-tab == 4;
                            accessible-action-default => { root.settings-tab = 4; }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout { alignment: center; Image { source: PetuniaIcons.cube; width: 14px; height: 14px; colorize: root.settings-tab == 4 ? DesignTokens.on-accent : DesignTokens.text-secondary; image-fit: contain; } }
                                Text { text: Tr.t("sl.tools"); color: root.settings-tab == 4 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                            }
                            tab4-touch := TouchArea { clicked => { root.settings-tab = 4; } }
                        }
                        if root.text-matches(Tr.t("sl.3d_viewport") + " " + Tr.t("sl.settings_kw_5"), root.settings-query): Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: root.settings-tab == 5 ? DesignTokens.accent : (tab5-touch.has-hover ? DesignTokens.surface-hover : transparent);
                            accessible-role: tab;
                            accessible-label: Tr.t("sl.3d_viewport");
                            accessible-checked: root.settings-tab == 5;
                            accessible-action-default => { root.settings-tab = 5; }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout { alignment: center; Image { source: PetuniaIcons.display; width: 14px; height: 14px; colorize: root.settings-tab == 5 ? DesignTokens.on-accent : DesignTokens.text-secondary; image-fit: contain; } }
                                Text { text: Tr.t("sl.3d_viewport"); color: root.settings-tab == 5 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                            }
                            tab5-touch := TouchArea { clicked => { root.settings-tab = 5; } }
                        }
                        if root.text-matches(Tr.t("sl.plugins") + " " + Tr.t("sl.settings_kw_6"), root.settings-query): Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: root.settings-tab == 6 ? DesignTokens.accent : (tab6-touch.has-hover ? DesignTokens.surface-hover : transparent);
                            accessible-role: tab;
                            accessible-label: Tr.t("sl.plugins");
                            accessible-checked: root.settings-tab == 6;
                            accessible-action-default => { root.settings-tab = 6; }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout { alignment: center; Image { source: PetuniaIcons.cpu; width: 14px; height: 14px; colorize: root.settings-tab == 6 ? DesignTokens.on-accent : DesignTokens.text-secondary; image-fit: contain; } }
                                Text { text: Tr.t("sl.plugins"); color: root.settings-tab == 6 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                            }
                            tab6-touch := TouchArea { clicked => { root.settings-tab = 6; } }
                        }
                        if root.text-matches(Tr.t("sl.mcp_automation") + " " + Tr.t("sl.settings_kw_7"), root.settings-query): Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: root.settings-tab == 7 ? DesignTokens.accent : (tab7-touch.has-hover ? DesignTokens.surface-hover : transparent);
                            accessible-role: tab;
                            accessible-label: Tr.t("sl.mcp_automation");
                            accessible-checked: root.settings-tab == 7;
                            accessible-action-default => { root.settings-tab = 7; }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout { alignment: center; Image { source: PetuniaIcons.terminal; width: 14px; height: 14px; colorize: root.settings-tab == 7 ? DesignTokens.on-accent : DesignTokens.text-secondary; image-fit: contain; } }
                                Text { text: Tr.t("sl.mcp_automation"); color: root.settings-tab == 7 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                            }
                            tab7-touch := TouchArea { clicked => { root.settings-tab = 7; } }
                        }
                        if root.text-matches(Tr.t("sl.settings_about") + " " + Tr.t("sl.settings_kw_8"), root.settings-query): Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: root.settings-tab == 8 ? DesignTokens.accent : (tab8-touch.has-hover ? DesignTokens.surface-hover : transparent);
                            accessible-role: tab;
                            accessible-label: Tr.t("sl.settings_about");
                            accessible-checked: root.settings-tab == 8;
                            accessible-action-default => { root.settings-tab = 8; }
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout { alignment: center; Image { source: PetuniaIcons.help; width: 14px; height: 14px; colorize: root.settings-tab == 8 ? DesignTokens.on-accent : DesignTokens.text-secondary; image-fit: contain; } }
                                Text { text: Tr.t("sl.settings_about"); color: root.settings-tab == 8 ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                            }
                            tab8-touch := TouchArea { clicked => { root.settings-tab = 8; } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle { width: 1px; background: DesignTokens.border; }

                // Painel de Conteúdo com rolagem
                ScrollView {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 14px;

                        // --- TAB 0: APARÊNCIA ---
                        if root.settings-tab == 0: VerticalLayout {
                            spacing: 12px;

                            Text { text: Tr.t("sl.interface_theme"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 8px;
                                for theme in root.themes: Rectangle {
                                    width: 140px; height: 30px; border-radius: 4px;
                                    background: theme.active ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    Text {
                                        text: theme.name;
                                        color: theme.active ? DesignTokens.on-accent : DesignTokens.text-primary;
                                        font-size: DesignTokens.font-small; font-weight: 600;
                                        vertical-alignment: center; horizontal-alignment: center;
                                    }
                                    TouchArea { clicked => { root.theme-changed(theme.id); } }
                                }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            Text { text: Tr.t("sl.ui_scale_zoom"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 52px; height: 28px; border-radius: 4px;
                                    background: (root.ui-scale <= 0.95) ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    Text { text: "90%"; color: (root.ui-scale <= 0.95) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                    TouchArea { clicked => { root.ui-scale-set(0.9); } }
                                }
                                Rectangle {
                                    width: 52px; height: 28px; border-radius: 4px;
                                    background: (root.ui-scale > 0.95 && root.ui-scale <= 1.12) ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    Text { text: "100%"; color: (root.ui-scale > 0.95 && root.ui-scale <= 1.12) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                    TouchArea { clicked => { root.ui-scale-set(1.0); } }
                                }
                                Rectangle {
                                    width: 52px; height: 28px; border-radius: 4px;
                                    background: (root.ui-scale > 1.12 && root.ui-scale <= 1.35) ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    Text { text: "125%"; color: (root.ui-scale > 1.12 && root.ui-scale <= 1.35) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                    TouchArea { clicked => { root.ui-scale-set(1.25); } }
                                }
                                Rectangle {
                                    width: 52px; height: 28px; border-radius: 4px;
                                    background: (root.ui-scale > 1.35 && root.ui-scale <= 1.6) ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    Text { text: "150%"; color: (root.ui-scale > 1.35 && root.ui-scale <= 1.6) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                    TouchArea { clicked => { root.ui-scale-set(1.5); } }
                                }
                                Rectangle {
                                    width: 52px; height: 28px; border-radius: 4px;
                                    background: (root.ui-scale > 1.6 && root.ui-scale <= 1.85) ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    Text { text: "175%"; color: (root.ui-scale > 1.6 && root.ui-scale <= 1.85) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                    TouchArea { clicked => { root.ui-scale-set(1.75); } }
                                }
                                Rectangle {
                                    width: 52px; height: 28px; border-radius: 4px;
                                    background: (root.ui-scale > 1.85) ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    Text { text: "200%"; color: (root.ui-scale > 1.85) ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                    TouchArea { clicked => { root.ui-scale-set(2.0); } }
                                }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            Text { text: Tr.t("sl.icon_style"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 100px; height: 30px; border-radius: 4px;
                                    background: root.icon-theme == "outline" ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        padding-left: 10px;
                                        alignment: start;
                                        Image { source: PetuniaIcons.cube; colorize: DesignTokens.text-primary; width: 16px; height: 16px; y: (parent.height - self.height) / 2; image-fit: contain; }
                                        Text { text: Tr.t("sl.outline"); color: root.icon-theme == "outline" ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    TouchArea { clicked => { root.icon-theme-set("outline"); } }
                                }
                                Rectangle {
                                    width: 100px; height: 30px; border-radius: 4px;
                                    background: root.icon-theme == "filled" ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        padding-left: 10px;
                                        alignment: start;
                                        Image { source: PetuniaIcons.cube; colorize: DesignTokens.text-primary; width: 16px; height: 16px; y: (parent.height - self.height) / 2; image-fit: contain; }
                                        Text { text: Tr.t("sl.filled"); color: root.icon-theme == "filled" ? DesignTokens.on-accent : DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; vertical-alignment: center; }
                                    }
                                    TouchArea { clicked => { root.icon-theme-set("filled"); } }
                                }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            Text { text: root.label-accent-color; color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                            Text { text: root.label-accent-color-hint; color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-violet;
                                    border-width: root.accent-color-hex == "#B58CFF" ? 2px : 1px;
                                    border-color: root.accent-color-hex == "#B58CFF" ? DesignTokens.focus-ring : DesignTokens.border;
                                    accessible-role: button;
                                    accessible-label: root.label-accent-color + " #B58CFF";
                                    TouchArea { clicked => { root.accent-color-set("#B58CFF"); } }
                                }
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.accent-blue;
                                    border-width: root.accent-color-hex == "#5B8CFF" ? 2px : 1px;
                                    border-color: root.accent-color-hex == "#5B8CFF" ? DesignTokens.focus-ring : DesignTokens.border;
                                    accessible-role: button;
                                    accessible-label: root.label-accent-color + " #5B8CFF";
                                    TouchArea { clicked => { root.accent-color-set("#5B8CFF"); } }
                                }
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.accent-teal;
                                    border-width: root.accent-color-hex == "#2BB5A0" ? 2px : 1px;
                                    border-color: root.accent-color-hex == "#2BB5A0" ? DesignTokens.focus-ring : DesignTokens.border;
                                    accessible-role: button;
                                    accessible-label: root.label-accent-color + " #2BB5A0";
                                    TouchArea { clicked => { root.accent-color-set("#2BB5A0"); } }
                                }
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.accent-pink;
                                    border-width: root.accent-color-hex == "#E86FB0" ? 2px : 1px;
                                    border-color: root.accent-color-hex == "#E86FB0" ? DesignTokens.focus-ring : DesignTokens.border;
                                    accessible-role: button;
                                    accessible-label: root.label-accent-color + " #E86FB0";
                                    TouchArea { clicked => { root.accent-color-set("#E86FB0"); } }
                                }
                                Rectangle {
                                    height: 28px; min-width: 90px; border-radius: 4px;
                                    background: root.accent-wheel-open ? DesignTokens.accent : (accent-wheel-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface);
                                    border-width: 1px; border-color: root.accent-wheel-open ? DesignTokens.focus-ring : DesignTokens.border;
                                    accessible-role: button;
                                    accessible-label: Tr.t("sl.color_wheel");
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 4px; alignment: center;
                                        Image {
                                            source: PetuniaIcons.paint-palette;
                                            width: 13px; height: 13px;
                                            colorize: root.accent-wheel-open ? DesignTokens.on-accent : DesignTokens.text-secondary;
                                            image-fit: contain;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: Tr.t("sl.color_wheel");
                                            color: root.accent-wheel-open ? DesignTokens.on-accent : DesignTokens.text-primary;
                                            font-size: DesignTokens.font-caption; font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    accent-wheel-touch := TouchArea { clicked => { root.accent-wheel-open = !root.accent-wheel-open; } }
                                }
                                Rectangle {
                                    width: 100px; height: 28px; border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    accessible-role: button;
                                    accessible-label: Tr.t("sl.reset_accent");
                                    Text { text: Tr.t("sl.reset_accent"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                                    TouchArea { clicked => { root.accent-color-set(""); } }
                                }
                            }
                            if root.accent-wheel-open: HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 130px;
                                    height: 130px;
                                    border-radius: DesignTokens.radius-pill;
                                    Image {
                                        width: 130px;
                                        height: 130px;
                                        source: root.color-wheel-image;
                                        image-fit: contain;
                                    }
                                    TouchArea {
                                        mouse-cursor: crosshair;
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                root.accent-color-wheel-interacted(self.mouse-x / 1px, self.mouse-y / 1px, true);
                                            }
                                        }
                                        moved => {
                                            if self.pressed {
                                                root.accent-color-wheel-interacted(self.mouse-x / 1px, self.mouse-y / 1px, false);
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            Text { text: Tr.t("sl.viewport_selection_color"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                // Preset 1: Blender Orange
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-orange;
                                    border-width: root.selection-color-hex == "#E96A00" ? 2px : 1px;
                                    border-color: root.selection-color-hex == "#E96A00" ? DesignTokens.focus-ring : DesignTokens.border;
                                    TouchArea { clicked => { root.selection-color-set("#E96A00"); } }
                                }
                                // Preset 2: Electric Cyan
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-cyan;
                                    border-width: root.selection-color-hex == "#00D2FF" ? 2px : 1px;
                                    border-color: root.selection-color-hex == "#00D2FF" ? DesignTokens.focus-ring : DesignTokens.border;
                                    TouchArea { clicked => { root.selection-color-set("#00D2FF"); } }
                                }
                                // Preset 4: Emerald Green
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-green;
                                    border-width: root.selection-color-hex == "#10B981" ? 2px : 1px;
                                    border-color: root.selection-color-hex == "#10B981" ? DesignTokens.focus-ring : DesignTokens.border;
                                    TouchArea { clicked => { root.selection-color-set("#10B981"); } }
                                }
                                // Preset 5: Amber Gold
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-amber;
                                    border-width: root.selection-color-hex == "#F59E0B" ? 2px : 1px;
                                    border-color: root.selection-color-hex == "#F59E0B" ? DesignTokens.focus-ring : DesignTokens.border;
                                    TouchArea { clicked => { root.selection-color-set("#F59E0B"); } }
                                }
                                // Preset 6: Coral Red
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 4px; background: ColorPresets.tag-red;
                                    border-width: root.selection-color-hex == "#EF4444" ? 2px : 1px;
                                    border-color: root.selection-color-hex == "#EF4444" ? DesignTokens.focus-ring : DesignTokens.border;
                                    TouchArea { clicked => { root.selection-color-set("#EF4444"); } }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 4px;
                                    background: root.selection-color;
                                    border-width: 1px; border-color: DesignTokens.border;
                                }
                                Rectangle {
                                    height: 28px; min-width: 90px; border-radius: 4px;
                                    background: root.selection-wheel-open ? DesignTokens.accent : (sel-wheel-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface);
                                    border-width: 1px; border-color: root.selection-wheel-open ? DesignTokens.focus-ring : DesignTokens.border;
                                    accessible-role: button;
                                    accessible-label: Tr.t("sl.color_wheel");
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 4px; alignment: center;
                                        Image {
                                            source: PetuniaIcons.paint-palette;
                                            width: 13px; height: 13px;
                                            colorize: root.selection-wheel-open ? DesignTokens.on-accent : DesignTokens.text-secondary;
                                            image-fit: contain;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: Tr.t("sl.color_wheel");
                                            color: root.selection-wheel-open ? DesignTokens.on-accent : DesignTokens.text-primary;
                                            font-size: DesignTokens.font-caption; font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    sel-wheel-touch := TouchArea { clicked => { root.selection-wheel-open = !root.selection-wheel-open; } }
                                }
                                Rectangle {
                                    width: 90px; height: 28px; border-radius: 4px;
                                    background: DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    accessible-role: button;
                                    accessible-label: Tr.t("sl.reset_e96a00");
                                    Text {
                                        text: Tr.t("sl.reset_e96a00");
                                        color: DesignTokens.text-secondary;
                                        font-size: DesignTokens.font-caption;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                    TouchArea { clicked => { root.selection-color-set("#E96A00"); } }
                                }
                            }
                            if root.selection-wheel-open: HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 130px;
                                    height: 130px;
                                    border-radius: DesignTokens.radius-pill;
                                    Image {
                                        width: 130px;
                                        height: 130px;
                                        source: root.color-wheel-image;
                                        image-fit: contain;
                                    }
                                    TouchArea {
                                        mouse-cursor: crosshair;
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                root.selection-color-wheel-interacted(self.mouse-x / 1px, self.mouse-y / 1px, true);
                                            }
                                        }
                                        moved => {
                                            if self.pressed {
                                                root.selection-color-wheel-interacted(self.mouse-x / 1px, self.mouse-y / 1px, false);
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            Text { text: root.label-highlight-thickness; color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 8px;
                                PetuniaSlider {
                                    horizontal-stretch: 1;
                                    minimum: 1; maximum: 6;
                                    value <=> root.selection-thickness;
                                    accessible-label: root.label-highlight-thickness;
                                    changed(value) => { root.selection-thickness-set(value); }
                                    released(value) => { root.selection-thickness-released(value); }
                                }
                                Text { text: "\{round(root.selection-thickness * 10) / 10} px"; color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; width: 44px; horizontal-alignment: right; vertical-alignment: center; }
                            }
                        }

                        // --- TAB 1: IDIOMA & REGIÃO ---
                        if root.settings-tab == 1: VerticalLayout {
                            spacing: 12px;

                            Text { text: Tr.t("sl.interface_language"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 160px; height: 32px; border-radius: 4px;
                                    background: root.active-language == "pt-BR" ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    Text {
                                        text: Tr.t("sl.portugues_brasil");
                                        color: root.active-language == "pt-BR" ? DesignTokens.on-accent : DesignTokens.text-primary;
                                        font-size: DesignTokens.font-small; font-weight: 600;
                                        vertical-alignment: center; horizontal-alignment: center;
                                    }
                                    TouchArea { clicked => { root.language-changed("pt-BR"); } }
                                }
                                Rectangle {
                                    width: 160px; height: 32px; border-radius: 4px;
                                    background: root.active-language == "en" ? DesignTokens.accent : DesignTokens.surface;
                                    border-width: 1px; border-color: DesignTokens.border;
                                    Text {
                                        text: Tr.t("sl.english_us");
                                        color: root.active-language == "en" ? DesignTokens.on-accent : DesignTokens.text-primary;
                                        font-size: DesignTokens.font-small; font-weight: 600;
                                        vertical-alignment: center; horizontal-alignment: center;
                                    }
                                    TouchArea { clicked => { root.language-changed("en"); } }
                                }
                            }

                            Rectangle { height: 1px; background: DesignTokens.border; }

                            Text { text: Tr.t("sl.localization_status"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                            Rectangle {
                                border-radius: 6px; background: DesignTokens.surface;
                                border-width: 1px; border-color: DesignTokens.border;
                                VerticalLayout {
                                    padding: 12px; spacing: 6px;
                                    Text { text: Tr.t("sl.partial_coverage_menus_and_tooltips_are_tran"); color: DesignTokens.warning; font-size: DesignTokens.font-small; font-weight: 600; wrap: word-wrap; }
                                    Text { text: Tr.t("sl.migration_of_literal_strings_to_textid_in_pr"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                                    Text { text: Tr.t("sl.automatic_fallback_to_english_when_a_key_is_"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; }
                                    Text { text: Tr.t("sl.target_canonical_vocabulary_point_round_edge"); color: DesignTokens.text-muted; font-size: DesignTokens.font-caption; wrap: word-wrap; }
                                }
                            }
                        }

                        // --- TAB 2: TECLADO & ATALHOS ---
                        if root.settings-tab == 2: VerticalLayout {
                            spacing: 12px;

                            Text { text: Tr.t("sl.keyboard_shortcut_profile"); color: DesignTokens.text-primary; font-size: DesignTokens.font-default; font-weight: 700; }
                            DropdownButton {
                                value: root.active-keymap-name != "" ? root.active-keymap-name : Tr.t("sl.keymap_default");
                                semantic-label: Tr.t("sl.keyboard_shortcut_profile");
                                open: root.keymap-dropdown-open;
                                open-requested => { root.keymap-dropdown-open = !root.keymap-dropdown-open; }
                            }
                            if root.keymap-dropdown-open: Rectangle {
                                border-radius: 4px;
                                background: DesignTokens.surface;
                                border-width: 1px;
                                border-color: DesignTokens.border;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    for profile in root.keymap-profiles: Rectangle {
                                        height: 28px;
                                        border-radius: 3px;
                                        background: profile.active ? DesignTokens.accent : (profile-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            Text {
                                                text: profile.name;
                                                color: profile.active ? DesignTokens.on-accent : DesignTokens.text-primary;
                                                font-size: DesignTokens.font-small;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            if profile.custom: Text {
                                                text: Tr.t("sl.keymap_custom_badge");
                                                color: profile.active ? DesignTokens.on-accent : DesignTokens.text-muted;
                                                font-size: DesignTokens.font-caption;
                                                vertical-alignment: center;
                                            }
                                        }
                                        profile-touch := TouchArea {
                                            clicked => {
                                                root.keymap-dropdown-open = false;
                                                root.keymap-changed(profile.id);
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 28px;
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: new-keymap-touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.border;
                                    accessible-role: button;
                                    accessible-label: Tr.t("sl.keymap_new_profile");
                                    Text { text: Tr.t("sl.keymap_new_profile"); color: DesignTokens.text-primary; font-size: DesignTokens.font-small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    new-keymap-touch := TouchArea { clicked => { root.keymap-profile-create(); } }
                                }
                                if root.active-keymap-id.starts-with("user-"): Rectangle {
                                    height: 28px;
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: del-keymap-touch.has-hover ? DesignTokens.danger.transparentize(0.8) : DesignTokens.surface;
                                    border-width: 1px;
                                    border-color: DesignTokens.danger;
                                    accessible-role: button;
                                    accessible-label: Tr.t("sl.keymap_delete_profile");
                                    Text { text: Tr.t("sl.keymap_delete_profile"); color: DesignTokens.danger; font-size: DesignTokens.font-small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                    del-keymap-touch := TouchArea { clicked => { root.keymap-profile-delete(root.active-keymap-id); } }
                                }
                            }
                            Text { text: Tr.t("sl.keymap_editor_hint"); color: DesignTokens.text-secondary; font-size: DesignTokens.font-caption; wrap: word-wrap; }

                            // Busca de atalhos
                            Rectangle {
                                height: 30px;
                                border-radius: 4px;
                                background: DesignTokens.canvas;
                                border-width: 1px;
                                border-color: shortcut-search.has-focus ? DesignTokens.focus-ring : DesignTokens.border;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    Image {
                                        y: (parent.height - self.height) / 2;
                                        source: PetuniaIcons.search;
                                        width: 13px;
                                        height: 13px;
                                        colorize: DesignTokens.text-muted;
                                        image-fit: contain;
                                    }
                                    shortcut-search := TextInput {
                                        text <=> root.shortcut-query;
                                        color: DesignTokens.text-primary;
                                        font-size: DesignTokens.font-small;
                                        vertical-alignment: center;
                                        single-line: true;
                                        accessible-label: Tr.t("sl.search_shortcuts");
                                    }
                                }
                                if root.shortcut-query == "": Text {
                                    x: 27px;
                                    text: Tr.t("sl.search_shortcuts");
                                    color: DesignTokens.text-muted;
                                    font-size: DesignTokens.font-small;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                for row in root.keymap-rows: Rectangle {
                                    property <bool> matches: root.shortcut-query == "" || root.text-matches(row.label + " " + row.shortcut + " " + row.action, root.shortcut-query);
                                    visible: self.matches;
                                    height: self.matches ? 26px : 0px;
                                    border-radius: 4px;
                                    background: row.capturing ? DesignTokens.accent.transparentize(0.8) : (row-touch.has-hover ? DesignTokens.surface-hover : transparent);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 4px;
                                        spacing: 6px;
                                        Text {
                                            text: row.label;
                                            color: DesignTokens.text-primary;
                                            font-size: DesignTokens.font-caption;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Rectangle {
                                            width: 118px;
                                            height: 22px;
                                            y: 2px;
                                            border-radius: 3px;
                                            background: DesignTokens.surface;
                                            border-width: 1px;
                                            border-color: row.capturing ? DesignTokens.focus-ring : (row.conflict ? DesignTokens.warning : DesignTokens.border);
                                            accessible-role: button;
                                            accessible-label: row.label + ": " + row.shortcut;
                                            Text {
                                                text: row.capturing ? Tr.t("sl.keymap_press_key") : (row.shortcut == "" ? "—" : row.shortcut);
                                                color: row.conflict ? DesignTokens.warning : DesignTokens.text-primary;
                                                font-size: DesignTokens.font-caption;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            row-touch := TouchArea { clicked => { root.keymap-capture-requested(row.action); } }
                                        }
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            y: 2px;
                                            border-radius: 3px;
                                            background: reset-row-touch.has-hover ? DesignTokens.surface-hover : transparent;
                                            accessible-role: button;
                                            accessible-label: Tr.t("sl.keymap_reset_binding");
                                            Image {
                                                source: PetuniaIcons.close;
                                                width: 11px;
                                                height: 11px;
                                                colorize: DesignTokens.text-muted;
                                                x: (parent.width - self.width) / 2;
