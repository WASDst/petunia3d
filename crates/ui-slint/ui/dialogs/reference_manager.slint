// Painel flutuante do gerenciador de referências.
import { DesignTokens, Tr } from "../tokens.slint";
import { IconButton } from "../components/base.slint";
import { IconDisplay, IconSet } from "@lucide";
import { PanelDragHandle, PanelResizeGrip, TopAction } from "../components/controls.slint";
import { ReferenceDetails, ReferenceTile } from "../dialogs/references.slint";
import { ReferenceSlotData } from "../types.slint";

export component ReferenceManagerPanel inherits Rectangle {
    in-out property <length> ref-panel-w;
    in-out property <length> ref-panel-h;
    in-out property <length> ref-panel-x;
    in-out property <length> ref-panel-y;
    in property <int> reference-total-count;
    in-out property <bool> ref-clear-confirm;
    in-out property <bool> reference-manager-visible;
    in property <[ReferenceSlotData]> reference-slots;
    in-out property <int> ref-selected;
    callback reference-clear-all();
    callback reference-manager-closed();
    callback reference-slot-pick(string);
    callback reference-slot-remove(string);
    callback reference-slot-align(string);
    callback reference-slot-toggle-visible(string);
    callback reference-slot-toggle-lock(string);
    callback reference-slot-set-param(string, string, float);

    x: 0;
    y: 0;
    
    
    // Painel flutuante não modal: sem scrim, a viewport continua visível e utilizável.
    ref-panel := Rectangle {
        // Compacto e ancorado à esquerda por padrão: a viewport segue visível.
        width: min(root.ref-panel-w > 0px ? root.ref-panel-w : 600px, parent.width - 40px);
        height: min(root.ref-panel-h > 0px ? root.ref-panel-h : ref-content.preferred-height + 49px, parent.height - 80px);
        x: root.ref-panel-x < 0px ? min(60px, max(parent.width - self.width, 0px)) : clamp(root.ref-panel-x, 0px, max(parent.width - self.width, 0px));
        y: root.ref-panel-y < 0px ? min(56px, max(parent.height - self.height, 0px)) : clamp(root.ref-panel-y, 0px, max(parent.height - self.height, 0px));
        border-radius: 8px;
        background: DesignTokens.surface-raised;
        border-width: 1px;
        border-color: DesignTokens.border;
        drop-shadow-blur: DesignTokens.elevation-2-blur;
        drop-shadow-color: DesignTokens.elevation-2-color;
        drop-shadow-offset-y: DesignTokens.elevation-2-offset;

        TouchArea { clicked => {} }

        PanelResizeGrip {
            z: 10;
            x: parent.width - self.width;
            y: parent.height - self.height;
            panel-w: ref-panel.width;
            panel-h: ref-panel.height;
            max-w: root.width - 40px;
            max-h: root.height - 80px;
            resized-to(w, h) => { root.ref-panel-w = w; root.ref-panel-h = h; }
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header
            Rectangle {
                height: 48px;
                background: DesignTokens.surface;
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;

                PanelDragHandle {
                    panel-x: ref-panel.x;
                    panel-y: ref-panel.y;
                    max-x: root.width - ref-panel.width;
                    max-y: root.height - ref-panel.height;
                    moved-to(x, y) => { root.ref-panel-x = x; root.ref-panel-y = y; }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout { alignment: center; HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        IconDisplay {
                            icon: IconSet.Image;
                            size: 16px;
                            stroke: DesignTokens.accent;
                        }
                        Text {
                            text: Tr.t("sl.reference_images");
                            color: DesignTokens.text-primary;
                            font-size: DesignTokens.font-exceptional;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "(\{root.reference-total-count} " + Tr.t("sl.active").to-lowercase() + ")";
                            color: DesignTokens.text-muted;
                            font-size: DesignTokens.font-default;
                            vertical-alignment: center;
                        }
                    } }

                    VerticalLayout { alignment: center; HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        if !root.ref-clear-confirm && root.reference-total-count > 0: IconButton {
                            icon: IconSet.Trash2;
                            label: Tr.t("sl.clear_all");
                            semantic-label: Tr.t("sl.clear_all");
                            clicked => { root.ref-clear-confirm = true; }
                        }
                        if root.ref-clear-confirm: Text {
                            text: Tr.t("sl.ref_clear_confirm");
                            color: DesignTokens.text-secondary;
                            font-size: DesignTokens.font-small;
                            vertical-alignment: center;
                        }
                        if root.ref-clear-confirm: IconButton {
                            icon: IconSet.Trash2;
                            label: Tr.t("sl.ref_clear_yes");
                            semantic-label: Tr.t("sl.ref_clear_yes");
                            clicked => {
                                root.ref-clear-confirm = false;
                                root.reference-clear-all();
                            }
                        }
                        if root.ref-clear-confirm: IconButton {
                            icon: IconSet.X;
                            label: Tr.t("sl.cancel");
                            semantic-label: Tr.t("sl.cancel");
                            clicked => { root.ref-clear-confirm = false; }
                        }

                        TopAction {
                            icon: IconSet.X;
                            semantic-label: Tr.t("sl.close_reference_manager");
                            clicked => {
                                root.reference-manager-visible = false;
                                root.reference-manager-closed();
                            }
                        }
                    } }
                }
            }

            Rectangle { height: 1px; background: DesignTokens.border; }

            // Grade 3 × 2 de vistas + ajustes da selecionada: as seis cabem
            // sem rolagem em 1280 × 800 (plano de UI F7, §5.5).
            ref-content := VerticalLayout {
                vertical-stretch: 1;
                padding: 12px;
                spacing: 10px;

                Text {
                    text: Tr.t("sl.ref_help");
                    color: DesignTokens.text-muted;
                    font-size: DesignTokens.font-caption;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    for i in 3: ReferenceTile {
                        horizontal-stretch: 1;
                        slot: root.reference-slots[i];
                        selected: root.ref-selected == i;
                        load-label: Tr.t("sl.load_image");
                        select => { root.ref-selected = i; }
                        pick-image => { root.reference-slot-pick(root.reference-slots[i].axis); }
                        remove-image => { root.reference-slot-remove(root.reference-slots[i].axis); }
                        align-view => { root.reference-slot-align(root.reference-slots[i].axis); }
                        toggle-visible => { root.reference-slot-toggle-visible(root.reference-slots[i].axis); }
                        toggle-lock => { root.reference-slot-toggle-lock(root.reference-slots[i].axis); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    for i in 3: ReferenceTile {
                        horizontal-stretch: 1;
                        slot: root.reference-slots[i + 3];
                        selected: root.ref-selected == i + 3;
                        load-label: Tr.t("sl.load_image");
                        select => { root.ref-selected = i + 3; }
                        pick-image => { root.reference-slot-pick(root.reference-slots[i + 3].axis); }
                        remove-image => { root.reference-slot-remove(root.reference-slots[i + 3].axis); }
                        align-view => { root.reference-slot-align(root.reference-slots[i + 3].axis); }
                        toggle-visible => { root.reference-slot-toggle-visible(root.reference-slots[i + 3].axis); }
                        toggle-lock => { root.reference-slot-toggle-lock(root.reference-slots[i + 3].axis); }
                    }
                }
                if root.reference-slots[root.ref-selected].has-image: ReferenceDetails {
                    slot: root.reference-slots[root.ref-selected];
                    set-param(param, val) => { root.reference-slot-set-param(root.reference-slots[root.ref-selected].axis, param, val); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

}
