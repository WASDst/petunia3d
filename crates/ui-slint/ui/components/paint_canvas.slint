import { DesignTokens } from "../tokens.slint";

export component BrushCursor inherits Rectangle {
    in property <length> diameter;
    in property <float> hardness;
    in property <float> strength;
    in property <color> tint;
    in property <bool> erase;
    /// Pixel: borda sempre dura, sem anel de núcleo.
    in property <bool> hard-edge;
    /// Superfície inclinada: o círculo do carimbo é visto como elipse
    /// (achatamento no eixo Y local, depois o giro em graus).
    in property <float> squash: 1.0;
    in property <float> tilt: 0.0;
    width: max(root.diameter, 2px);
    height: self.width;
    // O Slint só transforma elementos filhos: o anel vive num retângulo interno.
    ring := Rectangle {
        width: parent.width;
        height: parent.height;
        transform-rotation: root.tilt * 1deg;
        transform-scale-y: root.squash;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: root.erase ? DesignTokens.danger : DesignTokens.cursor-light;
        background: (root.erase ? DesignTokens.danger : root.tint).with-alpha(0.04 + 0.32 * clamp(root.strength, 0, 1));
        // Contorno escuro interno: o anel lê bem sobre superfícies claras e escuras.
        Rectangle {
            x: 1.5px;
            y: 1.5px;
            width: parent.width - 3px;
            height: parent.height - 3px;
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: DesignTokens.cursor-dark;
        }
        if !root.hard-edge && root.hardness > 0.02 && root.hardness < 0.98 && root.width > 10px: Rectangle {
            width: parent.width * root.hardness;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: DesignTokens.cursor-light.transparentize(0.3);
        }
    }
    // O ponto central marca o cursor e não se deforma.
    Rectangle {
        x: (parent.width - 3px) / 2;
        y: (parent.height - 3px) / 2;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: DesignTokens.cursor-light;
        border-width: 1px;
        border-color: DesignTokens.cursor-dark;
    }
}

/// Superfície do canvas de pintura 2D: raster, wireframe UV, grade de pixels, pan (botão do meio)
/// e zoom (roda). Mesma superfície no Inspector (pequena) e na janela flutuante (grande).
export component PaintCanvasSurface inherits Rectangle {
    in property <image> canvas-image;
    /// Cursor do pincel no canvas (mesmo diâmetro em tela do viewport).
    in property <bool> show-brush: false;
    in property <length> brush-diameter;
    in property <float> brush-hardness;
    in property <float> brush-strength;
    in property <color> brush-tint;
    in property <bool> brush-erase;
    in property <bool> brush-hard-edge;
    in property <int> zoom: 1;
    in property <bool> show-uv: false;
    in property <string> uv-commands: "";
    in property <bool> show-grid: false;
    in property <string> grid-commands: "";
    /// Ferramenta Select: clique/caixa selecionam faces pelo UV.
    in property <bool> select-mode: false;
    /// Faces selecionadas (caixa de 256 × 256, V para cima).
    in property <string> selected-commands: "";
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    /// x, y normalizados na textura, fase, Shift, largura da textura em px.
    callback stroke(float, float, int, bool, float);
    callback zoom-step(int);
    /// x0, y0, x1, y1 em frações da textura; Shift, Ctrl, Alt.
    callback select-region(float, float, float, float, bool, bool, bool);
    // A textura cabe no canvas sem deformar (proporção da imagem).
    property <float> fit: min(root.width / 1px / max(1, root.canvas-image.width), root.height / 1px / max(1, root.canvas-image.height));

    background: DesignTokens.canvas;
    border-width: 1px;
    border-color: DesignTokens.border;
    clip: true;

    raster := Image {
        width: max(1, root.canvas-image.width) * root.fit * root.zoom * 1px;
        height: max(1, root.canvas-image.height) * root.fit * root.zoom * 1px;
        x: (root.width - self.width) / 2 + root.pan-x;
        y: (root.height - self.height) / 2 + root.pan-y;
        image-fit: fill;
        image-rendering: pixelated;
        source: root.canvas-image;
    }

    if root.show-uv: Path {
        width: raster.width;
        height: raster.height;
        x: raster.x;
        y: raster.y;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 256;
        viewbox-height: 256;
        fill: transparent;
        stroke: DesignTokens.uv-wire;
        stroke-width: 1px;
        commands: root.uv-commands;
    }

    if root.selected-commands != "": Path {
        width: raster.width;
        height: raster.height;
        x: raster.x;
        y: raster.y;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 256;
        viewbox-height: 256;
        fill: DesignTokens.accent.transparentize(0.75);
        stroke: DesignTokens.accent;
        stroke-width: 1px;
        commands: root.selected-commands;
    }

    if root.show-grid && root.grid-commands != "": Path {
        width: 100%;
        height: 100%;
        fill: transparent;
        stroke: DesignTokens.border.transparentize(0.35);
        stroke-width: 1px;
        commands: root.grid-commands;
    }

    surface-touch := TouchArea {
        property <bool> panning: false;
        property <bool> shift-line: false;
        property <bool> selecting: false;
        property <length> select-x;
        property <length> select-y;
        property <length> last-x;
        property <length> last-y;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.middle || event.button == PointerEventButton.right {
                    self.panning = true;
                    self.last-x = self.mouse-x;
                    self.last-y = self.mouse-y;
                } else if event.button == PointerEventButton.left && root.select-mode {
                    self.selecting = true;
                    self.select-x = self.mouse-x;
                    self.select-y = self.mouse-y;
                } else if event.button == PointerEventButton.left {
                    self.shift-line = event.modifiers.shift;
                    root.stroke((self.mouse-x - raster.x) / raster.width, (self.mouse-y - raster.y) / raster.height, 0, self.shift-line, raster.width / 1px);
                }
            } else if event.kind == PointerEventKind.up {
                if self.panning {
                    self.panning = false;
                } else if self.selecting && event.button == PointerEventButton.left {
                    self.selecting = false;
                    root.select-region(
                        (self.select-x - raster.x) / raster.width, (self.select-y - raster.y) / raster.height,
                        (self.mouse-x - raster.x) / raster.width, (self.mouse-y - raster.y) / raster.height,
                        event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
                } else if event.button == PointerEventButton.left {
                    root.stroke((self.mouse-x - raster.x) / raster.width, (self.mouse-y - raster.y) / raster.height, 2, self.shift-line, raster.width / 1px);
                }
            }
        }
        moved => {
            if self.panning {
                root.pan-x += self.mouse-x - self.last-x;
                root.pan-y += self.mouse-y - self.last-y;
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
            } else if self.pressed && !self.selecting {
                root.stroke((self.mouse-x - raster.x) / raster.width, (self.mouse-y - raster.y) / raster.height, 1, self.shift-line, raster.width / 1px);
            }
        }
        scroll-event(event) => {
            if event.delta-y != 0px {
                root.zoom-step(event.delta-y > 0px ? 1 : -1);
                return accept;
            }
            reject
        }
    }

    // Caixa de seleção em andamento.
    if surface-touch.selecting: Rectangle {
        x: min(surface-touch.select-x, surface-touch.mouse-x);
        y: min(surface-touch.select-y, surface-touch.mouse-y);
        width: abs(surface-touch.mouse-x - surface-touch.select-x);
        height: abs(surface-touch.mouse-y - surface-touch.select-y);
        border-width: 1px;
        border-color: DesignTokens.accent;
        background: DesignTokens.accent.transparentize(0.85);
    }

    if root.show-brush && !root.select-mode && surface-touch.has-hover && !surface-touch.panning: BrushCursor {
        diameter: root.brush-diameter;
        hardness: root.brush-hardness;
        strength: root.brush-strength;
        tint: root.brush-tint;
        erase: root.brush-erase;
        hard-edge: root.brush-hard-edge;
        x: surface-touch.mouse-x - self.width / 2;
        y: surface-touch.mouse-y - self.height / 2;
    }
}
