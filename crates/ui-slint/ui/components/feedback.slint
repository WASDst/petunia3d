import { DesignTokens, Motion } from "../tokens.slint";

/// Tooltip rico moderno (Blender / VS Code / Figma style):
/// Cabeçalho com título em destaque e badge kbd estilizado para o atalho,
/// corpo com micro-explicação em texto secundário e rodapé de dicas/gestos.
export component RichTooltip inherits Rectangle {
    in property <string> title;
    in property <string> shortcut: "";
    in property <string> description: "";
    in property <string> hint: "";

    background: DesignTokens.surface-raised;
    border-radius: 6px;
    border-width: 1px;
    border-color: DesignTokens.border;
    drop-shadow-color: DesignTokens.elevation-1-color;
    drop-shadow-blur: DesignTokens.elevation-1-blur;
    drop-shadow-offset-y: DesignTokens.elevation-1-offset;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;
        min-width: 130px;
        max-width: 280px;

        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            Text {
                text: root.title;
                color: DesignTokens.text-primary;
                font-size: DesignTokens.font-small;
                font-weight: 700;
                vertical-alignment: center;
            }

            if root.shortcut != "": Rectangle {
                background: DesignTokens.surface-hover;
                border-width: 1px;
                border-color: DesignTokens.border;
                border-radius: 3px;
                height: 16px;

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    alignment: center;

                    Text {
                        text: root.shortcut;
                        color: DesignTokens.accent;
                        font-size: DesignTokens.font-caption;
                        font-weight: 600;
                        font-family: "monospace";
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        if root.description != "": Text {
            text: root.description;
            color: DesignTokens.text-secondary;
            font-size: DesignTokens.font-caption;
            wrap: word-wrap;
        }

        if root.hint != "": Text {
            text: root.hint;
            color: DesignTokens.text-muted;
            font-size: DesignTokens.font-caption;
            wrap: word-wrap;
        }
    }
}


/// Toast transitório canônico do shell.
/// Informação crítica deve possuir também representação persistente/recuperável;
/// este componente é apenas feedback não bloqueante.
export component StatusToast inherits Rectangle {
    in property <bool> shown: false;
    in property <string> message: "";
    in property <color> severity-color: DesignTokens.info;
    in property <length> available-width: 600px;

    width: min(root.available-width, max(220px, toast-text.preferred-width + 44px));
    height: 34px;
    opacity: root.shown ? 1.0 : 0.0;
    animate opacity { duration: Motion.medium; easing: ease-out; }
    border-radius: DesignTokens.radius-panel;
    background: DesignTokens.surface-raised;
    border-width: 1px;
    border-color: root.severity-color;
    drop-shadow-blur: DesignTokens.elevation-2-blur;
    drop-shadow-color: DesignTokens.elevation-2-color;
    drop-shadow-offset-y: DesignTokens.elevation-2-offset;
    accessible-role: text;
    accessible-label: root.message;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;

        Rectangle {
            width: 3px;
            height: 16px;
            border-radius: 1.5px;
            background: root.severity-color;
            y: (parent.height - self.height) / 2;
        }

        toast-text := Text {
            text: root.message;
            color: DesignTokens.text-primary;
            font-size: DesignTokens.font-default;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
